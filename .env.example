# Transactional email provider API key
EMAIL_API_KEY=
# Destination email address for form submissions
CONTACT_TO_ADDRESS=
# Cloudflare Turnstile secret key for server-side verification
TURNSTILE_SECRET=
# Cloudflare Turnstile site key for client-side challenge
PUBLIC_TURNSTILE_SITE_KEY=
# Base public URL of the deployed application
PUBLIC_SITE_URL=
# Web3Forms secret access key (server-only; MUST NOT use a PUBLIC_ prefix)
WEB3FORMS_KEY=
# Optional public HTTPS simulator URL for the portfolio-owned BITS demo tab.
# Also allow its exact origin in vercel.json frame-src before deployment.
# Leave empty to show the simulator-unavailable state. Never put secrets here.
PUBLIC_ZK_SIMULATOR_URL=
