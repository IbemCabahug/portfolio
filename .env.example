# Resend API key; configure BOTH this and CONTACT_TO_ADDRESS or leave BOTH empty.
# A partial pair fails closed with HTTP 503 (no automatic provider downgrade).
EMAIL_API_KEY=
# Destination email address for form submissions
CONTACT_TO_ADDRESS=
# Cloudflare Turnstile secret key for server-side verification
TURNSTILE_SECRET=
# Cloudflare Turnstile site key for client-side challenge
PUBLIC_TURNSTILE_SITE_KEY=
# Base public URL of the deployed application
PUBLIC_SITE_URL=
# Public Web3Forms delivery key (returned to the browser in browser-assisted mode).
# This is NOT a privileged secret. Provider-side abuse enforcement must be verified.
# Do not put Resend or other privileged API credentials here.
WEB3FORMS_KEY=
# Optional public HTTPS simulator URL for the portfolio-owned BITS demo tab.
# Also allow its exact origin in vercel.json frame-src before deployment.
# Leave empty to show the simulator-unavailable state. Never put secrets here.
PUBLIC_ZK_SIMULATOR_URL=
