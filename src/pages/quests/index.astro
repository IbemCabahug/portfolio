---
import TavernLayout from '../../layouts/TavernLayout.astro';
import { getCollection } from 'astro:content';
import ThematicIcon from '../../components/icons/ThematicIcon.astro';
import { getProjectTelemetry } from '../../lib/github';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);

const projectTelemetries = await Promise.all(
  projects.map(async (p) => {
    const telemetry = await getProjectTelemetry(p.data.sourceUrl);
    return { slug: p.data.slug, telemetry };
  })
);
const telemetryMap = new Map(projectTelemetries.map((pt) => [pt.slug, pt.telemetry]));
---

<TavernLayout
  title="Quest Board — Nhovem Cabahug"
  description="The Guild Quest Board of Nhovem Cabahug — completed missions, production bounties, and ongoing expeditions."
  location="quests"
>
  <div class="max-w-4xl mx-auto py-6 sm:py-8 px-4">
    {/* Notice Board Header */}
    <header class="mb-10 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 mb-3 rounded border border-[var(--brass)] bg-[var(--wood-deep)]/90 text-xs font-semibold tracking-wider uppercase text-[var(--candle)]">
        <ThematicIcon name="scroll" class="w-3.5 h-3.5 text-[var(--candle)]" />
        <span>Guild Notice Board · Projects & Case Studies</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-[var(--candle)] mb-2 tracking-wide font-serif drop-shadow">
        The Quest Board
      </h1>
      <span class="block text-xs uppercase tracking-widest text-[var(--brass)] font-sans font-bold mb-3">Projects & Production Case Studies</span>
      <p class="text-base sm:text-lg text-[var(--parchment)]/90 max-w-2xl mx-auto leading-relaxed">
        Parchment notices inscribed by guilds and patrons. Review verified production software, system architecture dossiers, and active software projects.
      </p>
    </header>

    {/* Vertical Stacked Quest Ledger */}
    <div class="flex flex-col gap-8">
      {projects.map((project) => {
        const isShipped = project.data.status === 'Shipped';
        const telemetry = telemetryMap.get(project.data.slug);

        return (
          <article
            class="relative bg-[#f6eee0] text-[var(--ink)] rounded-md border-2 border-[var(--brass)] shadow-2xl p-6 sm:p-8 flex flex-col md:flex-row gap-6 lg:gap-8 items-center md:items-start transition-all duration-200 hover:shadow-brass/20 focus-within:ring-2 focus-within:ring-[var(--brass)]"
            style="background-image: radial-gradient(#e2d5be 1px, transparent 1px); background-size: 20px 20px;"
          >
            {/* Left Column: Project Emblem & Status Badge */}
            <div class="flex flex-col items-center flex-shrink-0 w-32 sm:w-36 text-center">
              <div class="w-28 h-28 sm:w-32 sm:h-32 rounded-xl border-2 border-[var(--brass)] bg-[#1e1208] shadow-md p-2 flex items-center justify-center overflow-hidden group">
                {project.data.thumbnail ? (
                  <img
                    src={project.data.thumbnail}
                    alt={`${project.data.title} emblem`}
                    class="w-full h-full object-contain rounded-lg transition-transform duration-300 group-hover:scale-105"
                    loading="lazy"
                  />
                ) : (
                  <ThematicIcon name="swords" class="w-12 h-12 text-[var(--candle)]" />
                )}
              </div>

              {/* RPG Status Badge */}
              <div class="mt-3">
                <span
                  class={`inline-flex items-center gap-1.5 text-xs uppercase font-extrabold tracking-wider px-3 py-1 rounded-full border shadow-xs ${
                    isShipped
                      ? 'bg-[var(--wood-deep)] text-[var(--candle)] border-[var(--brass)]'
                      : 'bg-[var(--stone)] text-[var(--parchment)] border-stone-500'
                  }`}
                >
                  <span class={`w-2 h-2 rounded-full ${isShipped ? 'bg-emerald-400' : 'bg-amber-400 animate-pulse'}`} aria-hidden="true"></span>
                  {project.data.status}
                </span>
              </div>
            </div>

            {/* Right Column: Quest Briefing & Actions */}
            <div class="flex-1 flex flex-col justify-between w-full">
              <div>
                {/* Meta Header: Category & Role */}
                <div class="flex flex-wrap items-center justify-between gap-2 pb-2 mb-2 border-b border-[var(--brass)]/30 text-xs">
                  <span class="font-extrabold uppercase tracking-widest text-[#7c531d]">
                    Quest #{project.data.order} · {isShipped ? 'Completed Bounty' : 'Active Expedition'}
                  </span>
                  <span class="font-semibold text-[var(--ink)]/80 italic">
                    Role: {project.data.role}
                  </span>
                </div>

                {/* Quest Title */}
                <h2 class="text-xl sm:text-2xl font-bold mb-2.5 text-[var(--ink)] leading-snug font-serif">
                  <a
                    href={`/quests/${project.data.slug}`}
                    class="underline hover:text-[var(--ember)] focus-visible:outline-2 focus-visible:outline-[var(--brass)] focus-visible:outline-offset-2"
                  >
                    {project.data.title}
                  </a>
                </h2>

                {/* Mission Summary */}
                <p class="text-sm sm:text-base text-[var(--ink)]/90 mb-4 leading-relaxed">
                  {project.data.summary}
                </p>

                {/* Arsenal & Technologies */}
                <div class="mb-4">
                  <strong class="text-xs uppercase tracking-wider text-[var(--ink)]/80 block mb-2 font-bold">
                    Arsenal & Stack:
                  </strong>
                  <ul class="flex flex-wrap gap-1.5" aria-label="Technologies used">
                    {project.data.stack.map((tech: string) => (
                      <li class="text-xs px-2.5 py-0.5 border border-[var(--brass)]/80 bg-[#ede4d3] text-[var(--ink)] font-semibold rounded-sm shadow-2xs">
                        {tech}
                      </li>
                    ))}
                  </ul>
                </div>

                {/* Build-Time GitHub Telemetry or Vault Architecture Pill */}
                {telemetry ? (
                  <div class="mb-4 p-2.5 rounded bg-[#ebdcc4]/70 border border-[var(--brass)]/60 text-xs font-mono text-[var(--wood-deep)] flex flex-wrap items-center gap-x-4 gap-y-1.5 shadow-2xs">
                    <span class="inline-flex items-center gap-1 font-bold text-[#633a0e]">
                      <svg class="w-3.5 h-3.5 text-[var(--brass)]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                      </svg>
                      <span>{telemetry.owner}/{telemetry.repo}</span>
                    </span>

                    <span class="inline-flex items-center gap-1 font-semibold text-[var(--ink)]/85">
                      <span class="text-amber-600" aria-hidden="true">★</span>
                      <span>{telemetry.stars} {telemetry.stars === 1 ? 'star' : 'stars'}</span>
                    </span>

                    <span class="inline-flex items-center gap-1 text-[var(--ink)]/80">
                      <span class="text-emerald-700 font-bold" aria-hidden="true">●</span>
                      <span>Branch: <span class="font-bold">{telemetry.defaultBranch}</span></span>
                    </span>

                    <span class="inline-flex items-center gap-1 text-[var(--ink)]/80">
                      <span>Pushed:</span>
                      <time datetime={telemetry.pushedAt} class="font-semibold text-[var(--ink)]">{telemetry.pushedRelative}</time>
                    </span>

                    {telemetry.latestCommit && (
                      <div class="w-full pt-1.5 mt-0.5 border-t border-[var(--brass)]/30 flex items-center gap-2 text-[11px] text-[var(--ink)]/80 truncate">
                        <span class="px-1.5 py-0.2 rounded bg-[var(--wood-deep)] text-[var(--candle)] font-bold font-mono text-[10px]">
                          {telemetry.latestCommit.sha}
                        </span>
                        <span class="truncate font-sans italic" title={telemetry.latestCommit.message}>
                          "{telemetry.latestCommit.message}"
                        </span>
                      </div>
                    )}
                  </div>
                ) : project.data.sourceUrl ? (
                  <div class="mb-4 p-2.5 rounded bg-[#ebdcc4]/70 border border-[var(--brass)]/60 text-xs font-mono text-[var(--wood-deep)] flex items-center justify-between gap-2 shadow-2xs">
                    <span class="inline-flex items-center gap-1.5 font-semibold text-[#633a0e]">
                      <svg class="w-3.5 h-3.5 text-[var(--brass)]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                      </svg>
                      <span>Public GitHub Repository</span>
                    </span>
                    <span class="text-[11px] text-[var(--ink)]/70 italic">Verified Repository</span>
                  </div>
                ) : (
                  <div class="mb-4 p-2.5 rounded bg-[#e3d7c1]/60 border border-[var(--brass)]/50 text-xs font-mono text-[var(--wood-deep)] flex items-center justify-between gap-2 shadow-2xs">
                    <span class="inline-flex items-center gap-1.5 font-semibold text-[#5c3c16]">
                      <svg class="w-3.5 h-3.5 text-stone-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                      </svg>
                      <span>Device-Hardened Vault Architecture</span>
                    </span>
                    <span class="text-[11px] text-stone-700 italic">Offline Storage · Zero Cloud Exfiltration</span>
                  </div>
                )}
              </div>

              {/* Action Buttons */}
              <div class="flex flex-wrap items-center gap-3 pt-3 border-t border-[var(--brass)]/30">
                <a
                  href={`/quests/${project.data.slug}`}
                  class="inline-flex items-center gap-2 justify-center min-h-[44px] px-5 py-2 bg-[var(--wood-deep)] text-[var(--candle)] font-bold text-sm rounded hover:bg-black transition-colors focus-visible:outline-2 focus-visible:outline-[var(--brass)] focus-visible:outline-offset-2 shadow"
                >
                  <span>Inspect Case Study Dossier</span>
                  <ThematicIcon name="external" class="w-3.5 h-3.5 text-[var(--candle)]" />
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    {/* Return to Tavern Navigation */}
    <div class="mt-14 text-center">
      <a
        href="/tavern"
        class="inline-flex items-center justify-center min-h-[44px] px-6 py-2 border-2 border-[var(--brass)] text-[var(--parchment)] font-bold rounded hover:bg-[var(--parchment)] hover:text-[var(--wood-deep)] transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)]"
      >
        &larr; Return to Main Tavern
      </a>
    </div>
  </div>
</TavernLayout>
