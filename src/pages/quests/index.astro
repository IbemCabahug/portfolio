---
import TavernLayout from '../../layouts/TavernLayout.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<TavernLayout
  title="Quest Board — Nhovem Cabahug"
  description="The Quest Board of Nhovem Cabahug — completed exploits, production systems, and ongoing ventures."
  location="quests"
>
  <div class="max-w-4xl mx-auto py-6">
    <header class="mb-10 text-center">
      <h1 class="text-3xl sm:text-4xl font-bold text-[var(--candle)] mb-3 tracking-wide">
        The Quest Board
      </h1>
      <p class="text-base sm:text-lg text-[var(--parchment)]/90 max-w-2xl mx-auto leading-relaxed">
        Parchment notices pinned by travellers, guilds, and patrons. Review completed contracts, verified production software, and active expeditions.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projects.map((project) => (
        <article class="bg-[var(--parchment)] text-[var(--ink)] p-6 rounded border-2 border-[var(--brass)] shadow-xl flex flex-col justify-between transition-transform duration-200 hover:-translate-y-1 focus-within:ring-2 focus-within:ring-[var(--brass)]">
          <div>
            <div class="flex justify-between items-start gap-2 mb-3">
              <span class={`text-xs uppercase font-bold tracking-wider px-2 py-1 rounded ${project.data.status === 'Shipped' ? 'bg-[var(--wood-deep)] text-[var(--candle)]' : 'bg-[var(--stone)] text-[var(--parchment)]'}`}>
                {project.data.status}
              </span>
              <span class="text-xs font-semibold text-[var(--ink)]/80 italic">
                {project.data.role}
              </span>
            </div>

            <h2 class="text-xl font-bold mb-2 text-[var(--ink)] leading-snug">
              <a href={`/quests/${project.data.slug}`} class="underline hover:text-[var(--ember)] focus-visible:outline-2 focus-visible:outline-[var(--brass)] focus-visible:outline-offset-2">
                {project.data.title}
              </a>
            </h2>

            <p class="text-sm text-[var(--ink)]/90 mb-4 leading-relaxed">
              {project.data.summary}
            </p>
          </div>

          <div>
            <div class="mb-5 pt-3 border-t border-[var(--brass)]/30">
              <strong class="text-xs uppercase tracking-wider text-[var(--ink)]/80 block mb-2">Arsenal</strong>
              <ul class="flex flex-wrap gap-1.5" aria-label="Technologies used">
                {project.data.stack.map((tech: string) => (
                  <li class="text-xs px-2 py-0.5 border border-[var(--brass)] bg-[var(--parchment)] font-medium rounded-sm">
                    {tech}
                  </li>
                ))}
              </ul>
            </div>

            <div class="flex flex-col gap-2.5">
              <a
                href={`/quests/${project.data.slug}`}
                class="inline-flex items-center justify-center min-h-[44px] px-4 bg-[var(--wood-deep)] text-[var(--candle)] font-bold text-sm rounded hover:bg-black transition-colors focus-visible:outline-2 focus-visible:outline-[var(--brass)] focus-visible:outline-offset-2"
              >
                Inspect Case Study
              </a>

              <div class="flex gap-2">
                {project.data.liveUrl && (
                  <a
                    href={project.data.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex-1 inline-flex items-center justify-center min-h-[44px] px-3 border border-[var(--wood-deep)] text-[var(--wood-deep)] font-semibold text-xs rounded hover:bg-[var(--wood-deep)] hover:text-[var(--parchment)] transition-colors focus-visible:outline-2 focus-visible:outline-[var(--brass)] focus-visible:outline-offset-2"
                  >
                    Play / View Live
                  </a>
                )}
                {project.data.sourceUrl && (
                  <a
                    href={project.data.sourceUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex-1 inline-flex items-center justify-center min-h-[44px] px-3 border border-[var(--wood-deep)] text-[var(--wood-deep)] font-semibold text-xs rounded hover:bg-[var(--wood-deep)] hover:text-[var(--parchment)] transition-colors focus-visible:outline-2 focus-visible:outline-[var(--brass)] focus-visible:outline-offset-2"
                  >
                    Source Code
                  </a>
                )}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-12 text-center">
      <a
        href="/tavern"
        class="inline-flex items-center justify-center min-h-[44px] px-6 py-2 border-2 border-[var(--brass)] text-[var(--parchment)] font-semibold rounded hover:bg-[var(--parchment)] hover:text-[var(--wood-deep)] transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)]"
      >
        &larr; Return to Main Tavern
      </a>
    </div>
  </div>
</TavernLayout>
