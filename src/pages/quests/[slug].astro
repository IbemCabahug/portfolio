---
import TavernLayout from '../../layouts/TavernLayout.astro';
import { getCollection, render } from 'astro:content';
import ThematicIcon from '../../components/icons/ThematicIcon.astro';
import InteractiveEmbed from '../../components/InteractiveEmbed.astro';
import BitsAttendanceSimulator from '../../components/simulators/BitsAttendanceSimulator.astro';
import MimicVaultSimulator from '../../components/simulators/MimicVaultSimulator.astro';
import { getProjectTelemetry } from '../../lib/github';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((entry, index) => ({
    params: { slug: entry.data.slug },
    props: {
      entry,
      prevProject: index > 0 ? projects[index - 1] : null,
      nextProject: index < projects.length - 1 ? projects[index + 1] : null,
    },
  }));
}

const { entry, prevProject, nextProject } = Astro.props;
const { Content } = await render(entry);
const telemetry = await getProjectTelemetry(entry.data.sourceUrl);
---

<TavernLayout title={`${entry.data.title} — Nhovem Cabahug`} description={entry.data.summary || ''} location="quests">
  <div class="max-w-4xl mx-auto py-4">
    <nav class="mb-6 flex justify-between items-center" aria-label="Breadcrumb">
      <a
        href="/quests"
        class="inline-flex items-center gap-1.5 min-h-[44px] text-sm font-semibold text-[var(--candle)] underline hover:text-[var(--parchment)] focus-visible:outline-2 focus-visible:outline-[var(--brass)] focus-visible:outline-offset-2"
      >
        &larr; Back to Quest Board
      </a>
      <span class="text-xs text-[var(--parchment)]/70 uppercase tracking-widest font-mono">
        Bounty Dossier #{entry.data.order}
      </span>
    </nav>

    <article class="bg-[var(--parchment)] text-[var(--ink)] p-6 sm:p-10 rounded shadow-2xl border-2 border-[var(--brass)]">
      <header class="border-b-2 border-[var(--brass)] pb-6 mb-8">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
          <span class={`text-xs uppercase font-bold tracking-wider px-2.5 py-1 rounded ${entry.data.status === 'Shipped' ? 'bg-[var(--wood-deep)] text-[var(--candle)]' : 'bg-[var(--stone)] text-[var(--parchment)]'}`}>
            ● {entry.data.status}
          </span>
          <span class="text-sm font-semibold italic text-[var(--ink)]/80">
            Role: {entry.data.role}
          </span>
        </div>

        <div class="flex flex-col sm:flex-row gap-6 items-start mb-6">
          {entry.data.thumbnail && (
            <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-xl border-2 border-[var(--brass)] bg-[#1e1208] shadow-md p-2 flex-shrink-0 flex items-center justify-center overflow-hidden">
              <img
                src={entry.data.thumbnail}
                alt={`${entry.data.title} emblem`}
                class="w-full h-full object-contain rounded-lg"
                width="112"
                height="112"
                loading="lazy"
                decoding="async"
              />
            </div>
          )}
          <div class="flex-1">
            <h1 class="text-2xl sm:text-3xl font-bold text-[var(--ink)] mb-3 leading-tight font-serif">
              {entry.data.title}
            </h1>
            {entry.data.summary && (
              <p class="text-base text-[var(--ink)]/90 leading-relaxed max-w-[70ch]">
                {entry.data.summary}
              </p>
            )}
          </div>
        </div>

        <div class="mb-6">
          <strong class="text-xs uppercase tracking-wider text-[var(--ink)]/80 block mb-2 font-mono">Technologies & Stack</strong>
          <ul class="flex flex-wrap gap-2" aria-label="Tech stack">
            {entry.data.stack.map((tech: string) => (
              <li class="text-xs font-semibold px-2.5 py-1 border border-[var(--brass)] bg-[var(--parchment)] rounded text-[var(--ink)]">
                {tech}
              </li>
            ))}
          </ul>
        </div>

        <div class="flex flex-wrap gap-4">
          {entry.data.liveUrl && !entry.data.allowFraming && (
            <a
              href={entry.data.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 justify-center min-h-[44px] px-5 py-2 bg-[var(--wood-deep)] text-[var(--candle)] font-bold text-sm rounded hover:bg-black transition-colors focus-visible:outline-2 focus-visible:outline-[var(--brass)] focus-visible:outline-offset-2"
            >
              <ThematicIcon name="play" class="w-4 h-4 text-[var(--candle)]" />
              <span>Launch Live Application</span>
            </a>
          )}
          {entry.data.sourceUrl && (
            <a
              href={entry.data.sourceUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 justify-center min-h-[44px] px-5 py-2 border-2 border-[var(--wood-deep)] text-[var(--wood-deep)] font-bold text-sm rounded hover:bg-[var(--wood-deep)] hover:text-[var(--parchment)] transition-colors focus-visible:outline-2 focus-visible:outline-[var(--brass)] focus-visible:outline-offset-2"
            >
              <ThematicIcon name="code" class="w-4 h-4" />
              <span>Inspect Source Code</span>
            </a>
          )}
        </div>

        {/* Live GitHub Telemetry or Offline Device Architecture Strip */}
        {telemetry ? (
          <div class="mt-6 p-3 sm:p-4 rounded-md bg-[#ede4d3]/80 border border-[var(--brass)]/70 text-xs font-mono text-[var(--wood-deep)] shadow-2xs">
            <div class="flex flex-wrap items-center justify-between gap-2 pb-2.5 mb-2.5 border-b border-[var(--brass)]/30">
              <span class="inline-flex items-center gap-2 font-bold text-[#633a0e] text-xs sm:text-sm">
                <ThematicIcon name="code" class="w-4 h-4 text-[var(--brass)]" />
                <span>GitHub Repository: {telemetry.owner}/{telemetry.repo}</span>
              </span>
              <div class="flex flex-wrap items-center gap-3 text-xs text-[var(--ink)]/85">
                <span class="inline-flex items-center gap-1 font-semibold">
                  <span class="text-amber-600">★</span> {telemetry.stars} {telemetry.stars === 1 ? 'star' : 'stars'}
                </span>
                <span>Branch: <strong class="font-bold text-[var(--ink)]">{telemetry.defaultBranch}</strong></span>
                <span>Pushed: <strong class="font-bold text-[var(--ink)]">{telemetry.pushedRelative}</strong></span>
              </div>
            </div>

            {telemetry.latestCommit && (
              <div class="flex flex-wrap items-center justify-between gap-2 text-[11px] text-[var(--ink)]/85">
                <div class="flex items-center gap-2 min-w-0 max-w-[85%]">
                  <a
                    href={telemetry.latestCommit.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-1.5 py-0.5 rounded bg-[var(--wood-deep)] text-[var(--candle)] font-mono text-[10px] font-bold hover:bg-black transition-colors shrink-0"
                    title="View commit on GitHub"
                  >
                    {telemetry.latestCommit.sha}
                  </a>
                  <span class="truncate font-sans italic" title={telemetry.latestCommit.message}>
                    "{telemetry.latestCommit.message}"
                  </span>
                </div>
                <span class="text-[10px] text-[var(--ink)]/70 shrink-0 font-mono">{telemetry.latestCommit.dateFormatted}</span>
              </div>
            )}
          </div>
        ) : !entry.data.sourceUrl ? (
          <div class="mt-6 p-3 sm:p-4 rounded-md bg-[#e3d7c1]/60 border border-[var(--brass)]/50 text-xs font-mono text-[var(--wood-deep)] flex flex-wrap items-center justify-between gap-2 shadow-2xs">
            <span class="inline-flex items-center gap-2 font-semibold text-[#5c3c16] text-xs sm:text-sm">
              <svg class="w-4 h-4 text-stone-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <span>Offline Device-Hardened Architecture</span>
            </span>
            <span class="text-[11px] text-stone-700 italic">No network exfiltration permissions · Local keystore hardware-anchored</span>
          </div>
        ) : null}
      </header>

      {entry.data.slug === 'arcanetyper' && entry.data.allowFraming && entry.data.liveUrl && (
        <InteractiveEmbed liveUrl={entry.data.liveUrl} title={entry.data.title} />
      )}

      {entry.data.slug === 'bits' && (
        <BitsAttendanceSimulator />
      )}

      {entry.data.slug === 'mimic' && (
        <MimicVaultSimulator />
      )}

      <div class="quest-case-study prose max-w-none text-[var(--ink)]">
        <Content />
      </div>

      {/* Cross-Quest Navigation Footer */}
      <footer class="mt-14 pt-8 border-t-2 border-[var(--brass)]/50">
        <div class="grid grid-cols-1 sm:grid-cols-3 items-center gap-4">
          {/* Slot 1: Previous Quest (Aligned Left) */}
          <div class="flex justify-center sm:justify-start">
            {prevProject ? (
              <a
                href={`/quests/${prevProject.data.slug}`}
                class="inline-flex items-center gap-1.5 min-h-[44px] px-3.5 py-2 border border-[var(--brass)] bg-[#e8dbbe] text-[var(--wood-deep)] font-semibold text-xs sm:text-sm rounded hover:bg-[var(--brass)] transition-colors focus-visible:outline-2 focus-visible:outline-[var(--brass)] focus-visible:outline-offset-2 text-center"
              >
                &larr; Prev: {prevProject.data.title.split('—')[0].trim()}
              </a>
            ) : null}
          </div>

          {/* Slot 2: Quest Board Overview (Always Dead-Center) */}
          <div class="flex justify-center">
            <a
              href="/quests"
              class="inline-flex items-center justify-center min-h-[44px] px-5 py-2 bg-[var(--wood-deep)] text-[var(--candle)] font-bold text-sm rounded hover:bg-black transition-colors focus-visible:outline-2 focus-visible:outline-[var(--brass)] focus-visible:outline-offset-2 text-center shadow-md whitespace-nowrap"
            >
              Quest Board Overview
            </a>
          </div>

          {/* Slot 3: Next Quest (Aligned Right) */}
          <div class="flex justify-center sm:justify-end">
            {nextProject ? (
              <a
                href={`/quests/${nextProject.data.slug}`}
                class="inline-flex items-center gap-1.5 min-h-[44px] px-3.5 py-2 border border-[var(--brass)] bg-[#e8dbbe] text-[var(--wood-deep)] font-semibold text-xs sm:text-sm rounded hover:bg-[var(--brass)] transition-colors focus-visible:outline-2 focus-visible:outline-[var(--brass)] focus-visible:outline-offset-2 text-center"
              >
                Next: {nextProject.data.title.split('—')[0].trim()} &rarr;
              </a>
            ) : null}
          </div>
        </div>
      </footer>
    </article>
  </div>
</TavernLayout>

<style is:global>
  .quest-case-study h2 {
    font-size: 1.45rem;
    font-weight: 700;
    margin-top: 2.25rem;
    margin-bottom: 0.85rem;
    border-bottom: 1px solid rgba(168, 122, 39, 0.4);
    padding-bottom: 0.35rem;
    color: var(--ink);
    font-family: var(--font-serif, serif);
  }
  .quest-case-study h3 {
    font-size: 1.2rem;
    font-weight: 700;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    color: var(--wood-deep);
  }
  .quest-case-study p {
    margin-bottom: 1.15rem;
    line-height: 1.75;
    max-width: 72ch;
  }
  .quest-case-study ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .quest-case-study li {
    margin-bottom: 0.6rem;
    line-height: 1.65;
    max-width: 70ch;
  }
  .quest-case-study blockquote {
    border-left: 4px solid var(--brass);
    background: rgba(168, 122, 39, 0.08);
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    border-radius: 0 0.5rem 0.5rem 0;
    font-style: italic;
    color: var(--wood-deep);
  }
  .quest-case-study pre {
    background: #1a0f06 !important;
    color: var(--candle) !important;
    padding: 1.25rem;
    border-radius: 0.5rem;
    border: 1px solid var(--brass);
    overflow-x: auto;
    margin: 1.5rem 0;
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .quest-case-study code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.875em;
  }
  .quest-case-study p code,
  .quest-case-study li code {
    background: rgba(43, 24, 9, 0.1);
    color: var(--wood-deep);
    padding: 0.15rem 0.35rem;
    border-radius: 0.25rem;
    border: 1px solid rgba(168, 122, 39, 0.25);
    font-weight: 600;
  }
  .quest-case-study table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9rem;
  }
  .quest-case-study th,
  .quest-case-study td {
    padding: 0.75rem;
    border: 1px solid rgba(168, 122, 39, 0.35);
    text-align: left;
  }
  .quest-case-study th {
    background: rgba(168, 122, 39, 0.15);
    font-weight: 700;
    color: var(--wood-deep);
  }
</style>
