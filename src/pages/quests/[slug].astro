---
import TavernLayout from '../../layouts/TavernLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(entry => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<TavernLayout title={entry.data.title} description={entry.data.summary || ''} location="quests">
  <h1>{entry.data.title}</h1>

  <dl>
    {entry.data.summary && (
      <>
        <dt>Summary</dt>
        <dd>{entry.data.summary}</dd>
      </>
    )}

    <dt>Role</dt>
    <dd>{entry.data.role}</dd>

    <dt>Status</dt>
    <dd>{entry.data.status}</dd>

    <dt>Stack</dt>
    <dd>{entry.data.stack.join(', ')}</dd>

    {entry.data.liveUrl && (
      <>
        <dt>Live URL</dt>
        <dd><a href={entry.data.liveUrl}>{entry.data.liveUrl}</a></dd>
      </>
    )}

    {entry.data.sourceUrl && (
      <>
        <dt>Source URL</dt>
        <dd><a href={entry.data.sourceUrl}>{entry.data.sourceUrl}</a></dd>
      </>
    )}

  </dl>

  <Content />

  <a href="/quests">Back to all quests</a>
</TavernLayout>
