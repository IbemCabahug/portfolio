---
import TavernLayout from '../../layouts/TavernLayout.astro';
import { getCollection } from 'astro:content';
import ThematicIcon from '../../components/icons/ThematicIcon.astro';

const allTales = await getCollection('tales');
const tales = allTales.sort((a, b) => a.data.order - b.data.order);

// Collect unique tags
const allTags = Array.from(new Set(tales.flatMap((t) => t.data.tags)));
---

<TavernLayout
  title="Field Dispatches — Nhovem Cabahug"
  description="Technical chronicles, systems architecture deep dives, and engineering reflections from the workbench of Nhovem Cabahug."
  location="tales"
>
  <div class="max-w-4xl mx-auto py-6 sm:py-8 px-4">
    {/* Breadcrumbs */}
    <nav class="mb-6 flex justify-between items-center" aria-label="Breadcrumb">
      <a
        href="/tavern"
        class="inline-flex items-center gap-1.5 min-h-[44px] text-sm font-semibold text-[var(--candle)] underline hover:text-[var(--parchment)] focus-visible:outline-2 focus-visible:outline-[var(--brass)] focus-visible:outline-offset-2"
      >
        &larr; Return to Main Tavern
      </a>
      <span class="text-xs text-[var(--parchment)]/70 uppercase tracking-widest font-mono">
        Tavern Archive · {tales.length} Dispatches
      </span>
    </nav>

    {/* Section Header */}
    <header class="mb-10 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 mb-3 rounded border border-[var(--brass)] bg-[var(--wood-deep)]/90 text-xs font-semibold tracking-wider uppercase text-[var(--candle)]">
        <ThematicIcon name="scroll" class="w-3.5 h-3.5 text-[var(--candle)]" />
        <span>The Scribe's Desk · Technical Writing & Architecture</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-[var(--candle)] mb-2 tracking-wide font-serif drop-shadow">
        Field Dispatches
      </h1>
      <span class="block text-xs uppercase tracking-widest text-[var(--brass)] font-sans font-bold mb-3">
        Tavern Tales from the Engineering Workbench
      </span>
      <p class="text-base sm:text-lg text-[var(--parchment)]/90 max-w-2xl mx-auto leading-relaxed">
        Deep architectural dissections of production systems, offline-first web experiences, hardware integrations, and reliable UI state machines.
      </p>
    </header>

    {/* Tag Filter Strip */}
    <div class="mb-8 p-3 rounded-md bg-[#1e1208]/80 border border-[var(--brass)]/50 flex flex-wrap items-center gap-2 text-xs">
      <span class="text-[var(--brass)] font-bold uppercase tracking-wider text-[11px] mr-1">Topics:</span>
      {allTags.map((tag) => (
        <span class="px-2.5 py-1 rounded bg-[#2b190c] border border-[var(--brass)]/40 text-[var(--candle)] text-xs font-medium">
          {tag}
        </span>
      ))}
    </div>

    {/* Vertical Stacked Dispatch Cards */}
    <div class="flex flex-col gap-8">
      {tales.map((tale) => (
        <article
          class="relative bg-[#f6eee0] text-[var(--ink)] rounded-md border-2 border-[var(--brass)] shadow-2xl p-6 sm:p-8 flex flex-col justify-between transition-all duration-200 hover:shadow-brass/20 focus-within:ring-2 focus-within:ring-[var(--brass)]"
          style="background-image: radial-gradient(#e2d5be 1px, transparent 1px); background-size: 20px 20px;"
        >
          <div>
            {/* Metadata Header */}
            <div class="flex flex-wrap items-center justify-between gap-2 mb-3 pb-3 border-b border-[var(--brass)]/30 text-xs font-mono">
              <div class="flex items-center gap-2 text-[var(--wood-deep)] font-semibold">
                <time datetime={tale.data.publishDate}>{tale.data.publishDate}</time>
                <span>&bull;</span>
                <span class="px-2 py-0.5 rounded bg-[var(--wood-deep)] text-[var(--candle)] font-bold">
                  {tale.data.readTime}
                </span>
              </div>
              <span class="text-stone-700 italic font-sans font-medium">
                By {tale.data.author}
              </span>
            </div>

            {/* Title */}
            <h2 class="text-xl sm:text-2xl font-bold font-serif text-[var(--wood-deep)] mb-3 leading-snug">
              <a
                href={`/tales/${tale.id}`}
                class="hover:text-[#a05a18] transition-colors focus-visible:outline-2 focus-visible:outline-[var(--brass)]"
              >
                {tale.data.title}
              </a>
            </h2>

            {/* Description */}
            <p class="text-sm sm:text-base text-[var(--ink)]/90 leading-relaxed mb-6">
              {tale.data.description}
            </p>
          </div>

          {/* Footer: Tags & Read CTA */}
          <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-[var(--brass)]/30">
            <div class="flex flex-wrap gap-1.5" aria-label="Article topics">
              {tale.data.tags.map((tag: string) => (
                <span class="text-[11px] font-mono font-semibold px-2 py-0.5 rounded bg-[#e8dbbe] text-[var(--wood-deep)] border border-[var(--brass)]/50">
                  {tag}
                </span>
              ))}
            </div>

            <a
              href={`/tales/${tale.id}`}
              class="inline-flex items-center justify-center min-h-[44px] px-5 py-2 bg-[var(--wood-deep)] text-[var(--candle)] font-bold text-xs sm:text-sm rounded hover:bg-black transition-colors focus-visible:outline-2 focus-visible:outline-[var(--brass)] focus-visible:outline-offset-2 ml-auto"
            >
              <span>Read Technical Dispatch &rarr;</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    {/* Section Footer */}
    <footer class="mt-12 text-center border-t border-[var(--brass)]/40 pt-6">
      <p class="text-xs text-[var(--parchment)]/70">
        All dispatches authored by Nhovem Cabahug based on verified production codebases and academic research.
      </p>
    </footer>
  </div>
</TavernLayout>
