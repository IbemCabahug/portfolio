---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThematicIcon from '../../components/icons/ThematicIcon.astro';

const profileEntry = await getEntry('profile', 'main');
const profile = profileEntry?.data;

const rawProjects = await getCollection('projects');
const projectsList = [...rawProjects].sort((a, b) => a.data.order - b.data.order);

const rawTales = await getCollection('tales');
const talesList = [...rawTales].sort((a, b) => a.data.order - b.data.order);

// Key technical highlights per project to showcase architecture trade-offs & proof of work
const technicalHighlights: Record<string, { problem: string; decisions: string[]; verification: string }> = {
  arcanetyper: {
    problem:
      'Browser typing tools often reduce input to static word counts without measuring cadence, input consistency, or real-time pressure.',
    decisions: [
      'Engineered an HTML5 Canvas game loop handling falling word physics, collision detection, and combo states at steady 60fps.',
      'Implemented real-time 1v1 multiplayer duels with Supabase WebSocket channels, handling room codes and live progress sync.',
      'Measured raw speed vs. accuracy-adjusted WPM using per-keystroke timestamps rather than naive post-hoc word counting.',
      'Integrated Web Audio API for synthetic audio feedback with zero external sound asset dependencies.',
    ],
    verification: 'Shipped at v2.2.6 · 100% solo architecture · Live deployed with active player leaderboards.',
  },
  bits: {
    problem:
      'Manual employee attendance logging resulted in time discrepancies, missed overtime calculations, and split-shift data collisions.',
    decisions: [
      'Built the biometric overtime routing layer on ZKTeco hardware, capturing 3rd/4th scans without overwriting standard shift checkouts.',
      'Designed PostgreSQL schema migrations to record discrete OT start and end timestamps.',
      'Eliminated punch-time normalization discrepancies that caused real-time dashboard hours to disagree with audit logs.',
      'Created batch overtime assignment workflows and split-shift daily report aggregations.',
    ],
    verification: 'Deployed in production across 4 role-scoped portals with 25 relational models over 6 months.',
  },
  mimic: {
    problem:
      'Privacy tools that rely solely on disguise or steganography fail as soon as an adversary identifies the software package.',
    decisions: [
      'Implemented on-device AES-256 authenticated encryption for photos, documents, and private vault notes.',
      'Built under a zero-trust, zero-telemetry architecture: no accounts, no cloud sync, and zero outbound network traffic.',
      'Paired an authentic, fully playable 2–8 player social deduction party game with the underlying cryptographic vault.',
    ],
    verification: 'Zero network telemetry · Tested local storage encryption on physical Android devices.',
  },
};

const title = profile ? `${profile.name} — Technical Portfolio & Proof of Work` : "Technical Portfolio & Proof of Work";
const description = "The Field Ledger: Technical proof-of-work showcase, architecture trade-offs, live applications, and verified engineering competencies.";
---

<BaseLayout title={title} description={description} noScript={true}>
  <div class="min-h-screen bg-[var(--wood-deep)] p-4 sm:p-8 flex justify-center">
    <div class="w-full max-w-4xl bg-[var(--parchment)] text-[var(--ink)] p-6 sm:p-12 shadow-2xl rounded-sm border-2 border-[var(--brass)]">
      
      {/* Field Ledger Header */}
      {profile && (
        <header id="about-heading" class="mb-12 pb-8 border-b-2 border-[var(--brass)] scroll-mt-16">
          <div class="inline-flex items-center gap-2 px-3 py-1 mb-4 rounded border border-[var(--brass)] bg-[var(--wood-deep)] text-[var(--candle)] text-xs font-bold tracking-wider uppercase">
            <ThematicIcon name="ledger" class="w-4 h-4 text-[var(--candle)]" />
            <span>The Field Ledger · Simple Zero-JS Portfolio</span>
          </div>

          <h1 class="text-3xl sm:text-5xl font-extrabold mb-3 text-[var(--ink)] font-serif tracking-tight">
            {profile.name}
          </h1>

          <p class="text-lg sm:text-xl mb-4 font-bold text-[#7c531d]">
            {profile.title}
          </p>

          <p class="text-base max-w-[75ch] leading-relaxed mb-6 text-[var(--ink)]/90">
            {profile.tagline} Focused on accessible web architecture, strict quality budgets, systems performance, and AI-assisted software development where all architectural trade-offs, schema decisions, and test validations remain strictly human-driven.
          </p>

          <div class="flex flex-wrap items-center gap-x-8 gap-y-2 text-sm font-semibold text-[var(--ink)]/80">
            <div><strong class="text-[var(--ink)]">Location:</strong> {profile.location}</div>
            <div><strong class="text-[var(--ink)]">Availability:</strong> {profile.availability}</div>
          </div>
        </header>
      )}

      <div class="space-y-14">
        {/* Section 1: Flagship Proof-of-Work Projects */}
        <section aria-labelledby="projects-heading">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between mb-8 pb-3 border-b-2 border-[var(--brass)] gap-2">
            <div>
              <h2 id="projects-heading" class="text-2xl sm:text-3xl font-bold text-[var(--ink)] font-serif scroll-mt-16">
                Proof of Work: Featured Systems & Projects
              </h2>
              <p class="text-sm text-[var(--ink)]/80 mt-1">
                Concrete evidence of production software contributions, technical trade-offs, and live applications.
              </p>
            </div>
            <a
              href="/quests"
              class="text-xs uppercase font-bold tracking-wider text-[#7c531d] hover:underline inline-flex items-center min-h-[44px]"
            >
              View Full Quest Catalog &rarr;
            </a>
          </div>

          <div class="space-y-12">
            {projectsList.map((project) => {
              const highlights = technicalHighlights[project.data.slug];
              const isShipped = project.data.status === 'Shipped';

              return (
                <article class="bg-[#fcf7ee] border-2 border-[var(--brass)]/80 rounded p-6 sm:p-8 shadow-md">
                  {/* Project Header */}
                  <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4 pb-3 border-b border-[var(--brass)]/40">
                    <div>
                      <span class="text-xs font-extrabold uppercase tracking-wider text-[#7c531d] block mb-1">
                        Quest #{project.data.order} · {project.data.role}
                      </span>
                      <h3 class="text-2xl font-bold font-serif text-[var(--ink)]">
                        {project.data.title}
                      </h3>
                    </div>
                    <div>
                      <span class={`inline-flex items-center gap-1.5 text-xs uppercase font-extrabold px-3 py-1 rounded-full border ${
                        isShipped ? 'bg-[var(--wood-deep)] text-[var(--candle)] border-[var(--brass)]' : 'bg-[var(--stone)] text-[var(--parchment)] border-stone-500'
                      }`}>
                        <span class={`w-2 h-2 rounded-full ${isShipped ? 'bg-emerald-400' : 'bg-amber-400'}`} aria-hidden="true"></span>
                        {project.data.status}
                      </span>
                    </div>
                  </header>

                  {/* Summary */}
                  {project.data.summary && (
                    <p class="text-base text-[var(--ink)]/90 leading-relaxed mb-6 font-medium">
                      {project.data.summary}
                    </p>
                  )}

                  {/* Architecture & Engineering Decisions Breakdown */}
                  {highlights && (
                    <div class="space-y-4 mb-6 p-4 sm:p-5 bg-[#ede4d3]/70 rounded border border-[var(--brass)]/40">
                      <div>
                        <strong class="text-xs uppercase tracking-wider text-[#7c531d] font-bold block mb-1">
                          Problem & Requirements:
                        </strong>
                        <p class="text-sm text-[var(--ink)]/90 leading-relaxed">
                          {highlights.problem}
                        </p>
                      </div>

                      <div>
                        <strong class="text-xs uppercase tracking-wider text-[#7c531d] font-bold block mb-2">
                          Key Architectural Decisions & Engineering Trade-Offs:
                        </strong>
                        <ul class="list-disc pl-5 space-y-1.5 text-sm text-[var(--ink)]/90">
                          {highlights.decisions.map((decision) => (
                            <li class="leading-relaxed">{decision}</li>
                          ))}
                        </ul>
                      </div>

                      <div class="pt-2 border-t border-[var(--brass)]/30 text-xs font-semibold text-[var(--ink)]/80">
                        <strong class="text-[#7c531d]">Proof Point / Verification:</strong> {highlights.verification}
                      </div>
                    </div>
                  )}

                  {/* Technologies Arsenal */}
                  <div class="mb-6">
                    <strong class="text-xs uppercase tracking-wider text-[var(--ink)]/80 block mb-2 font-bold">
                      Stack & Tooling:
                    </strong>
                    <ul class="flex flex-wrap gap-1.5 text-xs font-semibold">
                      {project.data.stack.map((tech: string) => (
                        <li class="px-2.5 py-1 border border-[var(--brass)] bg-[var(--parchment)] text-[var(--ink)] rounded-sm">
                          {tech}
                        </li>
                      ))}
                    </ul>
                  </div>

                  {/* Action Buttons */}
                  <div class="flex flex-wrap items-center gap-3 pt-4 border-t border-[var(--brass)]/30">
                    <a
                      href={`/quests/${project.data.slug}`}
                      class="inline-flex items-center gap-2 justify-center px-4 py-2 bg-[var(--wood-deep)] text-[var(--candle)] font-bold text-xs rounded hover:bg-black transition-colors focus-visible:outline-2 focus-visible:outline-[var(--brass)] focus-visible:outline-offset-2 min-h-[44px]"
                    >
                      <span>Read Architectural Case Study</span>
                      <ThematicIcon name="external" class="w-3.5 h-3.5 text-[var(--candle)]" />
                    </a>
                  </div>
                </article>
              );
            })}
          </div>
        </section>

        {/* Section 2: Demonstrated Technical Competencies */}
        <section aria-labelledby="competencies-heading" class="pt-6">
          <div class="mb-6 pb-2 border-b-2 border-[var(--brass)]">
            <h2 id="competencies-heading" class="text-2xl font-bold text-[var(--ink)] font-serif scroll-mt-16">
              Demonstrated Technical Competencies
            </h2>
            <p class="text-sm text-[var(--ink)]/80 mt-1">
              Skills verified through functional code, production OJT deployments, and measurable performance standards.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-[#fcf7ee] border border-[var(--brass)]/80 p-5 rounded">
              <h3 class="text-base font-bold text-[var(--ink)] mb-2 font-serif flex items-center gap-2">
                <ThematicIcon name="play" class="w-4 h-4 text-[#7c531d]" />
                <span>Frontend & Web Architecture</span>
              </h3>
              <p class="text-xs text-[var(--ink)]/80 mb-3 leading-relaxed">
                Astro, TypeScript, Tailwind CSS, HTML5 Canvas, Web Audio API, WCAG 2.1 AA Compliance, Responsive Layouts.
              </p>
              <div class="text-xs font-semibold text-[#7c531d] border-t border-[var(--brass)]/30 pt-2">
                <strong>Proof:</strong> Arcane Typer (Canvas 60fps loop) & Portfolio (Lighthouse 100/100, 0-byte JS mode).
              </div>
            </div>

            <div class="bg-[#fcf7ee] border border-[var(--brass)]/80 p-5 rounded">
              <h3 class="text-base font-bold text-[var(--ink)] mb-2 font-serif flex items-center gap-2">
                <ThematicIcon name="terminal" class="w-4 h-4 text-[#7c531d]" />
                <span>Backend & Real-Time Systems</span>
              </h3>
              <p class="text-xs text-[var(--ink)]/80 mb-3 leading-relaxed">
                Node.js, Express.js, Supabase, WebSockets, REST APIs, Biometric scan ingestion, Multi-shift business logic.
              </p>
              <div class="text-xs font-semibold text-[#7c531d] border-t border-[var(--brass)]/30 pt-2">
                <strong>Proof:</strong> BITS (Overtime routing layer) & Supabase 1v1 duels in Arcane Typer.
              </div>
            </div>

            <div class="bg-[#fcf7ee] border border-[var(--brass)]/80 p-5 rounded">
              <h3 class="text-base font-bold text-[var(--ink)] mb-2 font-serif flex items-center gap-2">
                <ThematicIcon name="code" class="w-4 h-4 text-[#7c531d]" />
                <span>Databases & Data Integrity</span>
              </h3>
              <p class="text-xs text-[var(--ink)]/80 mb-3 leading-relaxed">
                PostgreSQL, SQLite, Schema Migrations, ZKTeco hardware punch-time normalisation, Relational model design.
              </p>
              <div class="text-xs font-semibold text-[#7c531d] border-t border-[var(--brass)]/30 pt-2">
                <strong>Proof:</strong> BITS attendance tracking (25 models) & Arcane Typer leaderboard schema.
              </div>
            </div>

            <div class="bg-[#fcf7ee] border border-[var(--brass)]/80 p-5 rounded">
              <h3 class="text-base font-bold text-[var(--ink)] mb-2 font-serif flex items-center gap-2">
                <ThematicIcon name="ledger" class="w-4 h-4 text-[#7c531d]" />
                <span>Engineering Rigor & Quality Gates</span>
              </h3>
              <p class="text-xs text-[var(--ink)]/80 mb-3 leading-relaxed">
                Automated regression testing, Puppeteer, Lighthouse audits, 12 Quality Budgets (contrast, layout shifts, no-JS fallbacks).
              </p>
              <div class="text-xs font-semibold text-[#7c531d] border-t border-[var(--brass)]/30 pt-2">
                <strong>Proof:</strong> 99/99 passing contrast tests, zero-runtime-JS enforcement script, Astro check clean.
              </div>
            </div>
          </div>
        </section>

        {/* Section 3: Field Dispatches & Technical Writing */}
        <section aria-labelledby="tales-heading" class="pt-6">
          <div class="mb-6 pb-2 border-b-2 border-[var(--brass)] flex flex-col sm:flex-row sm:items-end justify-between gap-2">
            <div>
              <h2 id="tales-heading" class="text-2xl font-bold text-[var(--ink)] font-serif">
                Field Dispatches & Technical Writing
              </h2>
              <p class="text-sm text-[var(--ink)]/80 mt-1">
                Deep architectural breakdowns of offline-first systems, biometric hardware integration, and UI state machines.
              </p>
            </div>
            <a
              href="/tales"
              class="text-xs font-bold text-[#7c531d] hover:text-[var(--ember)] underline inline-flex items-center min-h-[44px]"
            >
              Browse All Dispatches &rarr;
            </a>
          </div>

          <div class="flex flex-col gap-4">
            {talesList.map((tale) => (
              <article class="bg-[#fcf7ee] border border-[var(--brass)]/80 p-5 rounded">
                <div class="flex flex-wrap items-center justify-between gap-2 mb-2 text-xs font-mono text-[#7c531d]">
                  <span>{tale.data.publishDate} &bull; {tale.data.readTime}</span>
                  <div class="flex flex-wrap gap-1">
                    {tale.data.tags.slice(0, 3).map((tag: string) => (
                      <span class="px-1.5 py-0.5 rounded bg-[#e8dbbe] border border-[var(--brass)]/40 text-[10px] font-semibold text-[var(--wood-deep)]">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
                <h3 class="text-base sm:text-lg font-bold text-[var(--ink)] mb-2 font-serif">
                  <a href={`/tales/${tale.id}`} class="hover:underline">
                    {tale.data.title}
                  </a>
                </h3>
                <p class="text-xs sm:text-sm text-[var(--ink)]/85 mb-3 leading-relaxed">
                  {tale.data.description}
                </p>
                <div class="border-t border-[var(--brass)]/30 pt-2 flex justify-end">
                  <a
                    href={`/tales/${tale.id}`}
                    class="text-xs font-bold text-[#7c531d] hover:text-[var(--ember)] underline inline-flex items-center min-h-[44px]"
                  >
                    Read Technical Dispatch &rarr;
                  </a>
                </div>
              </article>
            ))}
          </div>
        </section>

        {/* Section 4: Formal Resume Cross-Link Card */}
        <section aria-labelledby="resume-card-heading" class="pt-6 scroll-mt-16" id="resume-card-heading-section">
          <div class="bg-[#24170d] text-[var(--parchment)] border-2 border-[var(--brass)] p-6 sm:p-8 rounded shadow-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
            <div>
              <div class="flex items-center gap-2 text-[var(--candle)] mb-2">
                <ThematicIcon name="resume" class="w-5 h-5 text-[var(--candle)]" />
                <h2 id="resume-card-heading" class="text-xl font-bold font-serif scroll-mt-16">
                  Need the Formal Chronological Resume?
                </h2>
              </div>
              <p class="text-sm text-[var(--parchment)]/90 leading-relaxed max-w-xl">
                For HR recruiters and ATS screening: inspect verified academic credentials from Cebu Technological University (CTU Danao), DOST-SEI trainings, language proficiencies, and print-ready ATS format.
              </p>
            </div>

            <div class="flex flex-col sm:flex-row gap-3 flex-shrink-0 w-full md:w-auto">
              <a
                href="/resume"
                class="inline-flex items-center justify-center px-5 py-2.5 bg-[var(--brass)] text-[var(--wood-deep)] font-bold text-sm rounded hover:bg-[var(--candle)] transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)] min-h-[44px]"
              >
                View Full Resume &rarr;
              </a>
              {profile?.resumeFile && (
                <a
                  href={profile.resumeFile}
                  download
                  class="inline-flex items-center justify-center px-4 py-2.5 border border-[var(--brass)] text-[var(--candle)] font-bold text-sm rounded hover:bg-[var(--brass)] hover:text-[var(--wood-deep)] transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)] min-h-[44px]"
                >
                  Download PDF
                </a>
              )}
            </div>
          </div>
        </section>

        {/* Section 4: Direct Channels & Contact */}
        <section aria-labelledby="contact-heading" class="pt-6 min-h-[60vh]">
          <div class="mb-6 pb-2 border-b-2 border-[var(--brass)]">
            <h2 id="contact-heading" class="text-2xl font-bold text-[var(--ink)] font-serif scroll-mt-16">
              Direct Contact & Professional Channels
            </h2>
            <p class="text-sm text-[var(--ink)]/80 mt-1">
              Available for AI-assisted developer roles, frontend contracts, and software development opportunities.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
            <a
              href="mailto:cabahugnhovem@gmail.com"
              class="flex items-center gap-3 p-4 border-2 border-[var(--brass)]/80 bg-[#fcf7ee] rounded hover:bg-[var(--brass)]/20 transition-colors focus-visible:outline-2 focus-visible:outline-[var(--brass)] min-h-[44px]"
            >
              <ThematicIcon name="raven" class="w-5 h-5 text-[#7c531d] flex-shrink-0" />
              <div class="min-w-0">
                <strong class="text-sm font-bold text-[var(--ink)] block">Email Direct</strong>
                <span class="text-xs text-[var(--ink)]/80 truncate block">cabahugnhovem@gmail.com</span>
              </div>
            </a>

            <a
              href="https://github.com/IbemCabahug"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 p-4 border-2 border-[var(--brass)]/80 bg-[#fcf7ee] rounded hover:bg-[var(--brass)]/20 transition-colors focus-visible:outline-2 focus-visible:outline-[var(--brass)] min-h-[44px]"
            >
              <ThematicIcon name="github" class="w-5 h-5 text-[#7c531d] flex-shrink-0" />
              <div class="min-w-0">
                <strong class="text-sm font-bold text-[var(--ink)] block">GitHub Repositories</strong>
                <span class="text-xs text-[var(--ink)]/80 truncate block">github.com/IbemCabahug</span>
              </div>
            </a>

            <a
              href="/messenger?compose=true"
              class="flex items-center gap-3 p-4 border-2 border-[var(--brass)]/80 bg-[#fcf7ee] rounded hover:bg-[var(--brass)]/20 transition-colors focus-visible:outline-2 focus-visible:outline-[var(--brass)] min-h-[44px]"
            >
              <ThematicIcon name="scroll" class="w-5 h-5 text-[#7c531d] flex-shrink-0" />
              <div class="min-w-0">
                <strong class="text-sm font-bold text-[var(--ink)] block">Messenger's Corner</strong>
                <span class="text-xs text-[var(--ink)]/80 block">Interactive Tavern Dispatch</span>
              </div>
            </a>
          </div>
          
          <div class="mt-8 pt-6 border-t-2 border-[var(--brass)]/50 flex flex-wrap items-center justify-between gap-4 text-sm font-bold">
            <a
              href="/"
              class="inline-flex items-center gap-1.5 text-[var(--ink)] hover:text-[var(--ember)] underline min-h-[44px] focus-visible:outline-2 focus-visible:outline-[var(--brass)]"
            >
              <span>&larr; Return to Home / Entrance</span>
            </a>
            <div>
              <a
                href="/tavern"
                class="inline-flex items-center gap-1.5 text-[#7c531d] hover:text-[var(--ember)] underline min-h-[44px] focus-visible:outline-2 focus-visible:outline-[var(--brass)]"
              >
                <ThematicIcon name="tavern" class="w-4 h-4 text-[#7c531d]" />
                <span>Enter Illustrated Tavern &rarr;</span>
              </a>
            </div>
          </div>
        </section>
      </div>

    </div>
  </div>
</BaseLayout>
