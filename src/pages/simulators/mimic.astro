---
/**
 * Standalone Mimic Vault simulator page for iframe embedding inside the Transceiver.
 * No layout chrome — renders the interactive smartphone simulator component within a themed container.
 */
import '../../styles/global.css';
import MimicVaultSimulator from '../../components/simulators/MimicVaultSimulator.astro';
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Mimic Vault Simulator — Transceiver Embed</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Creepster&family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');

    :root {
      --parchment: #f5e6c8;
      --ink: #1a0f00;
      --wood-deep: #2b180a;
      --brass: #c9a84c;
      --candle: #ffe4a0;
      --ember: #d5803b;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      width: 100%;
      height: 100%;
      overflow: auto;
      background: #080a0f;
      color: #f1efe8;
      font-family: 'Inter', system-ui, sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    body {
      display: flex;
      justify-content: center;
      padding: 12px;
      min-height: 100vh;
    }

    .mimic-simulator-card {
      margin: 0 auto !important;
      max-width: 600px;
      width: 100%;
    }

    /* Styled scrollbar */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #080a0f; }
    ::-webkit-scrollbar-thumb { background: #6b21a8; border-radius: 3px; }
  </style>
</head>
<body>
  <MimicVaultSimulator compact={true} />
</body>
</html>
