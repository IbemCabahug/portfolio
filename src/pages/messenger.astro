---
import TavernLayout from '../layouts/TavernLayout.astro';
import { getCollection, getEntry } from 'astro:content';

const links = await getCollection('links');
const profileEntry = await getEntry('profile', 'main');
const profile = profileEntry?.data;
const mailLink = links.find((l) => l.data.icon === 'mail');
const githubLink = links.find((l) => l.data.icon === 'github');
const mailAddress = mailLink?.data.url.replace('mailto:', '') || profile?.email || 'ncabahug223@gmail.com';
const githubUrl = githubLink?.data.url || profile?.github || 'https://github.com/IbemCabahug';
---

<TavernLayout
  title="The Courier's Roost — Messenger's Corner — Nhovem Cabahug"
  description="Step inside The Courier's Roost: an interactive 2.5D tavern aviary to send word, inspect GitHub telemetry, or review credentials."
  location="messenger"
>
  <div class="roost-page-wrapper">
    <!-- Atmospheric Room Intro Header -->
    <header class="roost-header text-center mb-6 px-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--stone)]/60 border border-[var(--brass)]/40 text-[var(--candle)] text-xs font-semibold tracking-wider uppercase mb-2">
        <span>Tavern Aviary &bull; Chamber IV</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-[var(--candle)] mb-2 tracking-wide drop-shadow-md">
        The Courier's Roost
      </h1>
      <p class="text-sm sm:text-base text-[var(--parchment)]/90 max-w-xl mx-auto leading-relaxed">
        Tucked beyond the taproom archway lies the messenger roost, attended day and night. Inspect the interactive fixtures around the chamber to send a raven, consult the arcane transceiver, or inspect the master scribe's ledger.
      </p>
    </header>

    <!-- 2.5D Interactive Tavern Room Scene (Desktop & Tablet) -->
    <section class="scene-container" aria-label="Interactive Courier's Roost Chamber">
      <picture>
        <source
          media="(min-width: 769px)"
          srcset="/art/messengers-corner-1280.webp 1280w, /art/messengers-corner-2560.webp 2560w"
          sizes="(max-width: 2560px) 100vw, 2560px"
        />
        <img
          src="/art/messengers-corner-1280.webp"
          width="2560"
          height="1429"
          alt="The Courier's Roost: a warm timber tavern room with a perched raven, an enchanted machine in the wall alcove, a scribe desk with candle, a hanging satchel, and a doorway returning to the tavern."
          loading="eager"
          fetchpriority="high"
          class="scene-background"
        />
      </picture>

      <div class="scene-overlay" aria-hidden="false">
        <!-- Hotspot 1: Perched Raven (Email Dispatch) -->
        <button
          type="button"
          id="trigger-perch-raven"
          class="scene-object scene-hotspot"
          aria-label="Send a Raven (Direct Email Dispatch)"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="dialog-raven"
          style="left: 0.9%; top: 38.5%; width: 9.3%; z-index: 3;"
        >
          <img
            src="/art/raven-perched-463.webp"
            srcset="/art/raven-perched-231.webp 231w, /art/raven-perched-463.webp 463w"
            sizes="(max-width: 1280px) 118px, 236px"
            width="463"
            height="512"
            alt=""
            loading="eager"
            decoding="async"
            class="raven-sprite"
          />
          <span class="scene-tooltip" data-placement="right">Send Word (Email)</span>
        </button>

        <!-- Hotspot 2: Arcane Transceiver (GitHub Telemetry) -->
        <button
          type="button"
          id="trigger-arcane-machine"
          class="scene-object scene-hotspot"
          aria-label="The Arcane Transceiver (GitHub Engineering Record)"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="dialog-machine"
          style="left: 47.6%; top: 35.5%; width: 26.6%; z-index: 3;"
        >
          <img
            src="/art/enchanted-case-study-device-1152.webp"
            srcset="/art/enchanted-case-study-device-576.webp 576w, /art/enchanted-case-study-device-1152.webp 1152w"
            sizes="(max-width: 1280px) 340px, 680px"
            width="1152"
            height="577"
            alt=""
            loading="eager"
            decoding="async"
            class="machine-sprite"
          />
          <span class="scene-tooltip" data-placement="top">Arcane Transceiver (GitHub)</span>
        </button>

        <!-- Hotspot 3: Scribe's Rolltop Desk (Full Resume) -->
        <button
          type="button"
          id="trigger-scribe-desk"
          class="scene-object scene-hotspot desk-hotspot"
          aria-label="The Master Scribe's Ledger (Professional Resume)"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="dialog-desk"
          style="left: 21.0%; top: 50.4%; width: 21.9%; height: 26.6%; z-index: 3;"
        >
          <div class="desk-glow-cue" aria-hidden="true"></div>
          <span class="scene-tooltip" data-placement="top">Scribe's Ledger (Resume)</span>
        </button>

        <!-- Hotspot 4: Hanging Courier Satchel (Field Status & Coordinates) -->
        <button
          type="button"
          id="trigger-courier-satchel"
          class="scene-object scene-hotspot satchel-hotspot"
          aria-label="Courier's Field Satchel (Availability & Coordinates)"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="dialog-satchel"
          style="left: 14.4%; top: 49.0%; width: 4.7%; height: 21.0%; z-index: 3;"
        >
          <div class="satchel-glow-cue" aria-hidden="true"></div>
          <span class="scene-tooltip" data-placement="bottom">Field Satchel (Status)</span>
        </button>

        <!-- Hotspot 5: Arched Doorway to Main Tavern -->
        <a
          href="/tavern"
          id="trigger-tavern-door"
          class="scene-object scene-hotspot door-hotspot"
          aria-label="Return through the Archway to the Main Tavern"
          style="left: 80.1%; top: 37.1%; width: 6.0%; height: 35.7%; z-index: 3;"
        >
          <div class="door-light-cue" aria-hidden="true"></div>
          <span class="scene-tooltip" data-placement="left">Main Tavern (Return)</span>
        </a>

        <!-- Modal Backdrop -->
        <div id="dialog-backdrop" class="dialog-backdrop" hidden aria-hidden="true"></div>

        <!-- Modal 1: Raven Email Dispatch -->
        <div
          id="dialog-raven"
          class="tavern-panel"
          role="dialog"
          aria-modal="true"
          aria-labelledby="raven-dialog-title"
          hidden
        >
          <div class="panel-header">
            <div class="flex items-center gap-3">
              <span class="panel-badge-icon" aria-hidden="true">
                <svg class="w-7 h-7 text-[var(--brass)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"/>
                  <line x1="16" y1="8" x2="2" y2="22"/>
                  <line x1="17.5" y1="15" x2="9" y2="15"/>
                </svg>
              </span>
              <div>
                <span class="text-xs uppercase font-extrabold tracking-widest text-[var(--ember)]">Priority Dispatch</span>
                <h2 id="raven-dialog-title" class="text-xl sm:text-2xl font-bold text-[var(--candle)]">Send Word via Email</h2>
              </div>
            </div>
            <button type="button" class="close-panel-btn" aria-label="Close Email Dispatch">&times;</button>
          </div>

          <div class="panel-body space-y-3.5">
            <p class="text-sm text-[var(--parchment)]/90 leading-relaxed">
              Whisper your message into the roost. The messenger raven carries word directly to Nhovem's personal console for project inquiries, full-time engineering roles, and technical consultations.
            </p>

            <div class="p-3.5 rounded-lg bg-[var(--wood-deep)]/80 border border-[var(--brass)]/50 space-y-2.5">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="text-xs uppercase tracking-wider text-[var(--brass)] font-semibold">Direct Electronic Address</span>
                <span class="text-xs text-emerald-400 font-mono flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                  Active & Monitored
                </span>
              </div>

              <div class="flex flex-wrap items-center gap-2 bg-black/40 px-3 py-2 rounded border border-[var(--brass)]/30 font-mono text-sm sm:text-base text-[var(--candle)]">
                <span class="select-all font-bold flex-1" id="modal-email-address">{mailAddress}</span>
                <button
                  type="button"
                  id="modal-copy-email-btn"
                  class="text-xs px-3 py-1 bg-[var(--brass)] text-black font-bold rounded hover:bg-[var(--candle)] transition-colors cursor-pointer focus-visible:outline-2 focus-visible:outline-[var(--candle)]"
                  title="Copy email to clipboard"
                  aria-label="Copy email address"
                >
                  Copy
                </button>
                <span id="modal-copy-status" class="text-xs text-emerald-400 font-bold hidden" role="status" aria-live="polite">Copied!</span>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs text-[var(--parchment)]/80">
              <div class="p-2.5 rounded bg-black/20 border border-[var(--brass)]/20">
                <strong class="text-[var(--candle)] block mb-0.5">Turnaround Time</strong>
                Typically responds within 24–48 hours.
              </div>
              <div class="p-2.5 rounded bg-black/20 border border-[var(--brass)]/20">
                <strong class="text-[var(--candle)] block mb-0.5">Primary Topics</strong>
                Full-stack roles, UI architecture, contracts.
              </div>
            </div>
          </div>

          <div class="panel-actions">
            <a
              href={`mailto:${mailAddress}`}
              class="inline-flex items-center justify-center min-h-[44px] px-6 py-2 bg-[var(--brass)] text-black font-bold text-sm rounded hover:bg-[var(--candle)] transition-colors shadow-md"
            >
              Compose Missive &rarr;
            </a>
            <button type="button" class="close-panel-btn-secondary min-h-[44px] px-4 py-2 text-sm text-[var(--parchment)]/80 hover:text-[var(--candle)]">
              Return to Roost
            </button>
          </div>
        </div>

        <!-- Modal 2: Arcane Transceiver (GitHub Engineering Record) -->
        <div
          id="dialog-machine"
          class="tavern-panel"
          role="dialog"
          aria-modal="true"
          aria-labelledby="machine-dialog-title"
          hidden
        >
          <div class="panel-header">
            <div class="flex items-center gap-3">
              <span class="panel-badge-icon" aria-hidden="true">
                <svg class="w-7 h-7 text-[var(--brass)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="3"/>
                  <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                </svg>
              </span>
              <div>
                <span class="text-xs uppercase font-extrabold tracking-widest text-[var(--ember)]">Guild Archives</span>
                <h2 id="machine-dialog-title" class="text-xl sm:text-2xl font-bold text-[var(--candle)]">The Arcane Transceiver</h2>
              </div>
            </div>
            <button type="button" class="close-panel-btn" aria-label="Close Arcane Transceiver">&times;</button>
          </div>

          <div class="panel-body space-y-2.5">
            <p class="text-xs sm:text-sm text-[var(--parchment)]/90 leading-relaxed">
              This brass-and-crystal terminal synchronizes live telemetry from Nhovem's engineering forge. Inspect verified code repositories, TypeScript architecture, and active web experiments.
            </p>

            <div class="space-y-2">
              <div class="p-2.5 rounded bg-[var(--wood-deep)]/80 border border-[var(--brass)]/40 hover:border-[var(--brass)] transition-colors">
                <div class="flex items-center justify-between gap-2 mb-0.5">
                  <span class="font-bold text-[var(--candle)] font-mono text-xs sm:text-sm">ArcaneTyper</span>
                  <span class="text-[10px] sm:text-[11px] px-2 py-0.5 rounded bg-[var(--stone)] text-[var(--parchment)] font-mono">TypeScript &bull; Canvas &bull; Audio API</span>
                </div>
                <p class="text-[11px] sm:text-xs text-[var(--parchment)]/80 leading-snug">
                  Gamified typing RPG engine with real-time dynamic sound synthesis, responsive canvas rendering, and zero runtime dependencies.
                </p>
              </div>

              <div class="p-2.5 rounded bg-[var(--wood-deep)]/80 border border-[var(--brass)]/40 hover:border-[var(--brass)] transition-colors">
                <div class="flex items-center justify-between gap-2 mb-0.5">
                  <span class="font-bold text-[var(--candle)] font-mono text-xs sm:text-sm">BITS — Guild Kiosk</span>
                  <span class="text-[10px] sm:text-[11px] px-2 py-0.5 rounded bg-[var(--stone)] text-[var(--parchment)] font-mono">Next.js &bull; Tailwind &bull; Analytics</span>
                </div>
                <p class="text-[11px] sm:text-xs text-[var(--parchment)]/80 leading-snug">
                  High-throughput information kiosk and student telemetry dashboard built for rapid search, offline resilience, and accessibility.
                </p>
              </div>

              <div class="p-2.5 rounded bg-[var(--wood-deep)]/80 border border-[var(--brass)]/40 hover:border-[var(--brass)] transition-colors">
                <div class="flex items-center justify-between gap-2 mb-0.5">
                  <span class="font-bold text-[var(--candle)] font-mono text-xs sm:text-sm">MIMIC — Dossier Explorer</span>
                  <span class="text-[10px] sm:text-[11px] px-2 py-0.5 rounded bg-[var(--stone)] text-[var(--parchment)] font-mono">React &bull; State Machine &bull; CSS Art</span>
                </div>
                <p class="text-[11px] sm:text-xs text-[var(--parchment)]/80 leading-snug">
                  Interactive state-driven creature inspection tool featuring custom micro-animations and accessibility-first keyboard navigation.
                </p>
              </div>
            </div>

            <div class="flex items-center justify-between p-2 rounded bg-black/30 border border-[var(--brass)]/30 text-xs font-mono text-[var(--parchment)]">
              <span>GitHub Handle: <strong class="text-[var(--candle)]">@IbemCabahug</strong></span>
              <span class="text-emerald-400">Verified Contributor</span>
            </div>
          </div>

          <div class="panel-actions">
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center min-h-[44px] px-6 py-2 bg-[var(--brass)] text-black font-bold text-sm rounded hover:bg-[var(--candle)] transition-colors shadow-md"
            >
              Inspect GitHub Profile &rarr;
            </a>
            <button type="button" class="close-panel-btn-secondary min-h-[44px] px-4 py-2 text-sm text-[var(--parchment)]/80 hover:text-[var(--candle)]">
              Close Transceiver
            </button>
          </div>
        </div>

        <!-- Modal 3: Scribe's Ledger (Professional Resume) -->
        <div
          id="dialog-desk"
          class="tavern-panel"
          role="dialog"
          aria-modal="true"
          aria-labelledby="desk-dialog-title"
          hidden
        >
          <div class="panel-header">
            <div class="flex items-center gap-3">
              <span class="panel-badge-icon" aria-hidden="true">
                <svg class="w-7 h-7 text-[var(--brass)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14 2 14 8 20 8"/>
                  <line x1="16" y1="13" x2="8" y2="13"/>
                  <line x1="16" y1="17" x2="8" y2="17"/>
                  <polyline points="10 9 9 9 8 9"/>
                </svg>
              </span>
              <div>
                <span class="text-xs uppercase font-extrabold tracking-widest text-[var(--ember)]">Master Ledger</span>
                <h2 id="desk-dialog-title" class="text-xl sm:text-2xl font-bold text-[var(--candle)]">The Scribe's Ledger</h2>
              </div>
            </div>
            <button type="button" class="close-panel-btn" aria-label="Close Scribe's Ledger">&times;</button>
          </div>

          <div class="panel-body space-y-3">
            <p class="text-xs sm:text-sm text-[var(--parchment)]/90 leading-relaxed">
              Carefully inscribed under the candlelight rests Nhovem's professional credentials: chronological engineering history, core stack proficiencies, and formal education.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs">
              <div class="p-2.5 rounded bg-[var(--wood-deep)]/80 border border-[var(--brass)]/30">
                <span class="text-[var(--brass)] uppercase tracking-wider font-extrabold block mb-1">Title & Discipline</span>
                <strong class="text-[var(--candle)] text-sm block">Full-Stack Developer</strong>
                <span class="text-[var(--parchment)]/80">Frontend Engineering &bull; UI/UX Systems</span>
              </div>

              <div class="p-2.5 rounded bg-[var(--wood-deep)]/80 border border-[var(--brass)]/30">
                <span class="text-[var(--brass)] uppercase tracking-wider font-extrabold block mb-1">Education</span>
                <strong class="text-[var(--candle)] text-sm block">B.S. in Information Technology</strong>
                <span class="text-[var(--parchment)]/80">University Level Degree</span>
              </div>
            </div>

            <div class="p-2.5 rounded bg-black/30 border border-[var(--brass)]/30 space-y-1.5">
              <span class="text-xs uppercase tracking-wider text-[var(--brass)] font-semibold block">Core Arsenal & Weaponry</span>
              <div class="flex flex-wrap gap-1.5">
                <span class="px-2 py-0.5 rounded bg-[var(--wood-deep)] border border-[var(--brass)]/40 text-[var(--candle)] text-xs font-mono">TypeScript</span>
                <span class="px-2 py-0.5 rounded bg-[var(--wood-deep)] border border-[var(--brass)]/40 text-[var(--candle)] text-xs font-mono">React / Next.js</span>
                <span class="px-2 py-0.5 rounded bg-[var(--wood-deep)] border border-[var(--brass)]/40 text-[var(--candle)] text-xs font-mono">Astro</span>
                <span class="px-2 py-0.5 rounded bg-[var(--wood-deep)] border border-[var(--brass)]/40 text-[var(--candle)] text-xs font-mono">Node.js</span>
                <span class="px-2 py-0.5 rounded bg-[var(--wood-deep)] border border-[var(--brass)]/40 text-[var(--candle)] text-xs font-mono">Tailwind CSS</span>
                <span class="px-2 py-0.5 rounded bg-[var(--wood-deep)] border border-[var(--brass)]/40 text-[var(--candle)] text-xs font-mono">PostgreSQL</span>
                <span class="px-2 py-0.5 rounded bg-[var(--wood-deep)] border border-[var(--brass)]/40 text-[var(--candle)] text-xs font-mono">REST / GraphQL</span>
                <span class="px-2 py-0.5 rounded bg-[var(--wood-deep)] border border-[var(--brass)]/40 text-[var(--candle)] text-xs font-mono">Git & CI/CD</span>
              </div>
            </div>

            <p class="text-xs text-[var(--parchment)]/80 italic">
              Formatted for immediate digital review and clean paper print/PDF export with zero styling loss.
            </p>
          </div>

          <div class="panel-actions">
            <a
              href="/resume"
              class="inline-flex items-center justify-center min-h-[44px] px-6 py-2 bg-[var(--brass)] text-black font-bold text-sm rounded hover:bg-[var(--candle)] transition-colors shadow-md"
            >
              View Full Web Resume &rarr;
            </a>
            <button type="button" class="close-panel-btn-secondary min-h-[44px] px-4 py-2 text-sm text-[var(--parchment)]/80 hover:text-[var(--candle)]">
              Close Ledger
            </button>
          </div>
        </div>

        <!-- Modal 4: Satchel Status & Coordinates -->
        <div
          id="dialog-satchel"
          class="tavern-panel"
          role="dialog"
          aria-modal="true"
          aria-labelledby="satchel-dialog-title"
          hidden
        >
          <div class="panel-header">
            <div class="flex items-center gap-3">
              <span class="panel-badge-icon" aria-hidden="true">
                <svg class="w-7 h-7 text-[var(--brass)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/>
                  <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
                </svg>
              </span>
              <div>
                <span class="text-xs uppercase font-extrabold tracking-widest text-[var(--ember)]">Field Satchel</span>
                <h2 id="satchel-dialog-title" class="text-xl sm:text-2xl font-bold text-[var(--candle)]">Coordinates & Availability</h2>
              </div>
            </div>
            <button type="button" class="close-panel-btn" aria-label="Close Field Satchel">&times;</button>
          </div>

          <div class="panel-body space-y-2.5">
            <p class="text-xs sm:text-sm text-[var(--parchment)]/90 leading-relaxed">
              Packed and prepared for long campaigns across realms. The courier's current physical station and deployment status are documented below:
            </p>

            <div class="space-y-2 text-xs sm:text-sm">
              <div class="flex items-center justify-between p-2.5 rounded bg-[var(--wood-deep)]/80 border border-[var(--brass)]/40">
                <span class="text-[var(--brass)] font-semibold">Current Quest Status:</span>
                <span class="inline-flex items-center gap-1.5 text-emerald-400 font-bold">
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block animate-pulse"></span>
                  {profile?.availability || 'Available for New Quests'}
                </span>
              </div>

              <div class="flex items-center justify-between p-2.5 rounded bg-[var(--wood-deep)]/80 border border-[var(--brass)]/40">
                <span class="text-[var(--brass)] font-semibold">Realm Station:</span>
                <span class="text-[var(--candle)] font-bold">{profile?.location || 'Lapu-Lapu City, Philippines'}</span>
              </div>

              <div class="flex items-center justify-between p-2.5 rounded bg-[var(--wood-deep)]/80 border border-[var(--brass)]/40">
                <span class="text-[var(--brass)] font-semibold">Deployment Radius:</span>
                <span class="text-[var(--candle)]">Remote Worldwide &bull; Hybrid / Relocation</span>
              </div>

              <div class="flex items-center justify-between p-2.5 rounded bg-[var(--wood-deep)]/80 border border-[var(--brass)]/40">
                <span class="text-[var(--brass)] font-semibold">Timezone Overlap:</span>
                <span class="text-[var(--candle)]">UTC+8 (Covers APAC, EMEA, & Americas)</span>
