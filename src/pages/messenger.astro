    min-height: 44px;
    margin-left: auto;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.1s ease;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
  }
  .close-panel-btn:is(:hover, :focus-visible) {
    background: var(--candle, #fdf6e3);
    border-color: var(--candle, #fdf6e3);
    color: #000;
    outline: 2px solid var(--candle, #fdf6e3);
    outline-offset: 2px;
  }
  .close-panel-btn:active {
    transform: scale(0.97);
  }

  .close-panel-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--wood-deep, #1a1005);
    border: 1px solid rgba(213, 128, 59, 0.4);
    color: var(--candle, #fdf6e3);
    padding: 8px 16px;
    font-size: 0.8125rem;
    border-radius: 4px;
    cursor: pointer;
    font-weight: 600;
    min-height: 44px;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .close-panel-btn-secondary:is(:hover, :focus-visible) {
    background: rgba(0, 0, 0, 0.8);
    border-color: var(--candle, #fdf6e3);
    color: #fff;
  }

  /* Template selection pill styling */
  .template-pill, .mobile-template-pill {
    background: rgba(26, 16, 5, 0.85);
    border: 1px solid rgba(213, 128, 59, 0.4);
    color: var(--parchment, #e6d3a8);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 6px 8px;
    border-radius: 6px;
    cursor: pointer;
    text-align: center;
    transition: all 0.18s ease-out;
  }
  .template-pill:hover, .mobile-template-pill:hover {
    background: rgba(213, 128, 59, 0.2);
    border-color: var(--candle, #fdf6e3);
  }
  .template-pill.active, .mobile-template-pill.active {
    background: var(--brass, #8b6b4a);
    color: #1a1005;
    font-weight: bold;
    border-color: #ffd782;
    box-shadow: 0 0 10px rgba(213, 128, 59, 0.4);
  }

  /* Hotspots disabled when dialog is open */
  .disabled-by-dialog {
    pointer-events: none;
  }
  .disabled-by-dialog .scene-tooltip {
    opacity: 0 !important;
  }

  /* Corner brass brackets for authentic RPG dispatch slip aesthetics */
  .dispatch-slip {
    position: relative;
  }
  .corner-bracket {
    position: absolute;
    width: 12px;
    height: 12px;
    pointer-events: none;
  }
  .corner-bracket.top-left {
    top: 4px;
    left: 4px;
    border-top: 2px solid var(--brass);
    border-left: 2px solid var(--brass);
  }
  .corner-bracket.top-right {
    top: 4px;
    right: 4px;
    border-top: 2px solid var(--brass);
    border-right: 2px solid var(--brass);
  }

  /* Responsive Display Rules: 2.5D visual chamber active in landscape & tablet portrait */
  @media (min-width: 601px), (orientation: landscape) {
    .roost-header {
      display: none;
    }
    .scene-container {
      display: block;
    }
    .narrow-dispatch-stack {
      display: none;
    }
  }

  /* Narrow portrait mobile phones (<= 600px): Clean atmospheric tactile dispatch stack */
  @media (max-width: 600px) and (orientation: portrait) {
    .roost-page-wrapper {
      height: auto;
      padding-bottom: 2.5rem;
    }
    .roost-header {
      display: block;
    }
    .scene-container {
      display: none;
    }
    .narrow-dispatch-stack {
      display: block;
    }
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .scene-tooltip,
    .scene-object img,
    .desk-glow-cue,
    .satchel-glow-cue,
    .door-light-cue,
    .tavern-panel,
    .screen-pulse-dot,
    .screen-bars .bar {
      transition: none !important;
      animation: none !important;
    }
    .scene-object:is(:hover, :focus-visible) img {
      transform: none !important;
    }
  }

  :root[data-motion="reduced"] .scene-tooltip,
  :root[data-motion="reduced"] .scene-object img,
  :root[data-motion="reduced"] .desk-glow-cue,
  :root[data-motion="reduced"] .satchel-glow-cue,
  :root[data-motion="reduced"] .door-light-cue,
  :root[data-motion="reduced"] .tavern-panel {
    transition: none !important;
    animation: none !important;
  }
  :root[data-motion="reduced"] .scene-object:is(:hover, :focus-visible) img {
    transform: none !important;
  }

  /* Labels off on limited-size devices, matching tavern room behavior */
  @media (max-width: 1000px) {
    .scene-tooltip {
      opacity: 0;
      visibility: hidden;
    }
  }

  /* Fine pointers get labels back on hover: ≤1000px */
  @media (max-width: 1000px) and (hover: hover) and (pointer: fine) {
    .scene-object:hover .scene-tooltip,
    .scene-object:focus-visible .scene-tooltip,
    .scene-object:focus-within .scene-tooltip {
      opacity: 1;
      visibility: visible;
    }
  }

  /* Keyboard focus always reveals the label, on every device */
  @media (max-width: 1000px) {
    .scene-object:focus-visible .scene-tooltip,
    .scene-object:focus-within .scene-tooltip {
      opacity: 1;
      visibility: visible;
    }
  }

  /* Transceiver in-world HUD screen optimization for rotated phone and limited devices */
  @media (max-width: 1000px), (max-height: 500px) and (orientation: landscape) {
    .screen-header,
    .screen-footer {
      background: transparent;
      border: none;
      padding: 1px 2px;
    }
    .screen-status-text,
    .screen-commit {
      display: none;
    }
    .screen-pulse-dot {
      width: 3px;
      height: 3px;
    }
    .screen-bars {
      height: 4px;
      gap: 1px;
    }
    .screen-bars .bar {
      width: 1px;
    }
  }
</style>

<script>
  import { initPerformanceGovernor } from '../lib/perf-governor';
  import { sendMissive } from '../lib/contact';
  import { soundEngine } from '../lib/sound-engine';

  function initMessengerPage() {
    initPerformanceGovernor();
    soundEngine.init();

    // ── Anti-Abuse Shield ──────────────────────────────
    const RATE_LIMIT_KEY = 'raven_sends';
    const COOLDOWN_MS = 60_000;  // 60 seconds between sends
    const MAX_PER_HOUR = 3;      // max 3 sends per hour
    let formLoadTime = Date.now();

    function getRateLimitData(): { timestamps: number[] } {
      try {
        const raw = localStorage.getItem(RATE_LIMIT_KEY);
        if (raw) return JSON.parse(raw);
      } catch {}
      return { timestamps: [] };
    }

    function checkRateLimit(): { allowed: boolean; reason?: string } {
      const data = getRateLimitData();
      const now = Date.now();
      const oneHourAgo = now - 3_600_000;
      // Clean old entries
      data.timestamps = data.timestamps.filter(t => t > oneHourAgo);
      localStorage.setItem(RATE_LIMIT_KEY, JSON.stringify(data));

      if (data.timestamps.length >= MAX_PER_HOUR) {
        return { allowed: false, reason: 'You have reached the hourly dispatch limit (3 ravens per hour). Please try again later.' };
      }
      if (data.timestamps.length > 0) {
        const lastSend = Math.max(...data.timestamps);
        const elapsed = now - lastSend;
        if (elapsed < COOLDOWN_MS) {
          const waitSec = Math.ceil((COOLDOWN_MS - elapsed) / 1000);
          return { allowed: false, reason: `Please wait ${waitSec}s before dispatching another raven.` };
        }
      }
      return { allowed: true };
    }

    function recordSendSuccess() {
      const data = getRateLimitData();
      data.timestamps.push(Date.now());
      localStorage.setItem(RATE_LIMIT_KEY, JSON.stringify(data));
    }

    function showFormError(errorId: string, message: string) {
      const el = document.getElementById(errorId);
      if (el) {
        el.textContent = message;
        el.classList.remove('hidden');
        setTimeout(() => el.classList.add('hidden'), 8000);
      }
    }
    // ── End Anti-Abuse Shield ──────────────────────────

    // Interactive Scene Hotspots and Modal Management
    const triggers = [
      { triggerId: 'trigger-perch-raven', dialogId: 'dialog-raven' },
      { triggerId: 'trigger-arcane-machine', dialogId: 'dialog-machine' },
      { triggerId: 'trigger-scribe-desk', dialogId: 'dialog-desk' },
      { triggerId: 'trigger-courier-satchel', dialogId: 'dialog-satchel' }
    ];

    const backdrop = document.getElementById('dialog-backdrop');
    const sceneObjects = document.querySelectorAll('.scene-object');
    let activeDialog: HTMLElement | null = null;
    let activeTrigger: HTMLElement | null = null;
    let unloadTransceiverFn: (() => void) | null = null;

    function getFocusableElements(el: HTMLElement): HTMLElement[] {
      return Array.from(el.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), input:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'));
    }

    function openDialog(dialog: HTMLElement, trigger: HTMLElement) {
      if (activeDialog) closeDialog();

      soundEngine.playParchmentRustle();
      activeDialog = dialog;
      activeTrigger = trigger;
      dialog.removeAttribute('hidden');
      dialog.setAttribute('aria-hidden', 'false');
      trigger.setAttribute('aria-expanded', 'true');

      sceneObjects.forEach((el) => {
        el.classList.add('disabled-by-dialog');
        el.setAttribute('tabindex', '-1');
      });

      if (backdrop) {
        backdrop.hidden = false;
        backdrop.setAttribute('aria-hidden', 'false');
      }

      dialog.hidden = false;
      dialog.scrollTop = 0;

      const focusables = getFocusableElements(dialog);
      if (focusables.length > 0) {
        focusables[0].focus({ preventScroll: true });
      }

      document.addEventListener('keydown', handleKeydown);
    }

    function closeDialog() {
      if (!activeDialog) return;

      if (activeDialog.id === 'dialog-machine' && unloadTransceiverFn) {
        unloadTransceiverFn();
      }

      soundEngine.playWoodClink();
      sceneObjects.forEach((el) => {
        el.classList.remove('disabled-by-dialog');
        el.removeAttribute('tabindex');
      });

      if (backdrop) {
        backdrop.hidden = true;
        backdrop.setAttribute('aria-hidden', 'true');
      }

      activeDialog.hidden = true;
      activeDialog.setAttribute('aria-hidden', 'true');

      if (activeTrigger) {
        activeTrigger.setAttribute('aria-expanded', 'false');
        activeTrigger.focus({ preventScroll: true });
      }

      activeDialog = null;
      activeTrigger = null;
      document.removeEventListener('keydown', handleKeydown);
    }

    function handleKeydown(e: KeyboardEvent) {
      if (e.key === 'Escape') {
        closeDialog();
        return;
      }
      if (e.key === 'Tab' && activeDialog) {
        const focusables = getFocusableElements(activeDialog);
        if (focusables.length === 0) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];

        if (e.shiftKey) {
          if (document.activeElement === first) {
            e.preventDefault();
            last.focus();
          }
        } else {
          if (document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      }
    }

    // Bind trigger buttons to their respective modals
    triggers.forEach(({ triggerId, dialogId }) => {
      const trigger = document.getElementById(triggerId);
      const dialog = document.getElementById(dialogId);
      if (trigger && dialog) {
        trigger.addEventListener('click', (e) => {
          e.preventDefault();
          openDialog(dialog, trigger);
        });
      }
    });

    // Satchel modal shortcut to Raven modal
    const satchelDispatchBtn = document.getElementById('satchel-dispatch-btn');
    const ravenDialog = document.getElementById('dialog-raven');
    const ravenTrigger = document.getElementById('trigger-perch-raven');
    if (satchelDispatchBtn && ravenDialog && ravenTrigger) {
      satchelDispatchBtn.addEventListener('click', () => {
        closeDialog();
        setTimeout(() => {
          openDialog(ravenDialog, ravenTrigger);
        }, 50);
      });
    }

    // Auto-open compose modal if arriving via ?compose=true or #compose
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('compose') === 'true' || window.location.hash === '#compose') {
      const ravenDialog = document.getElementById('dialog-raven');
      const ravenTrigger = document.getElementById('trigger-perch-raven');
      if (ravenDialog && ravenTrigger) {
        setTimeout(() => {
          openDialog(ravenDialog, ravenTrigger);
        }, 80);
      }
    }

    // Bind all close buttons inside panels
    document.querySelectorAll('.close-panel-btn, .close-panel-btn-secondary').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        closeDialog();
      });
    });

    // Clicking backdrop closes active dialog
    if (backdrop) {
      backdrop.addEventListener('click', () => {
        closeDialog();
      });
    }

    // Missive Template Selector logic (GitHub Issue style)
    function setupTemplatePills(selector: string, subjectInputId: string, bodyInputId: string) {
      const pills = document.querySelectorAll<HTMLButtonElement>(selector);
      const subjectInput = document.getElementById(subjectInputId) as HTMLInputElement | null;
      const bodyInput = document.getElementById(bodyInputId) as HTMLTextAreaElement | null;

      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          pills.forEach((p) => p.classList.remove('active'));
          pill.classList.add('active');

          const prefix = pill.getAttribute('data-prefix') || '';
          const subject = pill.getAttribute('data-subject') || '';
          const placeholder = pill.getAttribute('data-placeholder') || '';

          if (subjectInput) {
            subjectInput.value = `${prefix} ${subject}`;
          }
          if (bodyInput) {
            bodyInput.placeholder = placeholder;
            if (!bodyInput.value.trim()) {
              bodyInput.focus();
            }
          }
        });
      });
    }

    setupTemplatePills('.template-pill', 'desktop-missive-subject', 'desktop-missive-body');
    setupTemplatePills('.mobile-template-pill', 'mobile-missive-subject', 'mobile-missive-body');

    // Scalable Transceiver Project Simulations Registry
    interface TransceiverProject {
      id: string;
      name: string;
      subtitle: string;
      modalTitle: string;
      version: string;
      description: string;
      badges: string[];
      launchLabel: string;
      standaloneUrl: string;
      standaloneLabel: string;
      dossierPath: string;
      liveUrl: string;
      scalingMode: 'fit-canvas' | 'responsive';
      baseWidth?: number;
      baseHeight?: number;
      thumbnail: string;
      hudStatus: string;
      hudCommit: string;
    }

    const TRANSCEIVER_PROJECTS: TransceiverProject[] = [
      {
        id: 'arcanetyper',
        name: 'Arcane Typer',
        subtitle: 'Arcane Transmission // Live Simulation',
        modalTitle: 'The Arcane Transceiver — Arcane Typer',
        version: 'ArcaneTyper v2.2.6',
        description: "The brass coils resonate with arcane frequency, synchronizing with Nhovem's live HTML5 Canvas engine. Engage the transceiver below to initiate real-time typing physics, spellcasting incantations, and synthesized Web Audio directly inside this chamber.",
        badges: ['60 FPS HTML5 Canvas', 'Zero-Asset Web Audio', 'Supabase 1v1 Duels'],
        launchLabel: 'Engage Arcane Typer Trial',
        standaloneUrl: 'https://arcane-typer.vercel.app/',
        standaloneLabel: 'Launch in Standalone Window',
        dossierPath: '/quests/arcanetyper',
        liveUrl: 'https://arcane-typer.vercel.app/',
        scalingMode: 'fit-canvas',
        baseWidth: 800,
        baseHeight: 600,
        thumbnail: '/art/arcane-typer-splash.webp',
        hudStatus: 'ARCANE // 60FPS',
        hudCommit: 'CANVAS // LIVE'
      },
      {
        id: 'bits',
        name: 'BITS Engine',
        subtitle: 'Biometric Telemetry // Hardware Simulation',
        modalTitle: 'The Arcane Transceiver — BITS Engine',
        version: 'BITS Engine v1.0.4',
        description: 'Interfacing with the BukSU Integrated Terrestrial Scanner attendance telemetry system. Simulate live NFC and barcode punch streams, queue-sync pipelines, and edge offline validation state machine algorithms.',
        badges: ['Offline-First Edge Sync', 'Hardware Emulation', 'Queue Pipeline', 'Attendance Engine'],
        launchLabel: 'Engage BITS Engine Simulator',
        standaloneUrl: '/simulators/bits',
        standaloneLabel: 'Open Standalone Simulator',
        dossierPath: '/quests/bits',
        liveUrl: '/simulators/bits',
        scalingMode: 'responsive',
        thumbnail: '/art/bits-transceiver-splash.jpg',
        hudStatus: 'BITS // SYNC',
        hudCommit: 'EDGE // TELEMETRY'
      },
      {
        id: 'mimic',
        name: 'Mimic Vault',
        subtitle: 'Cryptographic Vault // App Simulation',
        modalTitle: 'The Arcane Transceiver — Mimic Vault',
        version: 'Mimic Vault v0.9.8',
        description: 'Awakening the encrypted party game mimicry simulation. Explore the complete onboarding journey, biometric and cryptographic vault unlocks, decoy vaults, and zero-knowledge recovery mechanics.',
        badges: ['AES-GCM-256 Vault', 'Decoy Chameleon UI', 'Zero-Knowledge Recovery', 'Mobile Simulation'],
        launchLabel: 'Engage Mimic Vault Simulator',
        standaloneUrl: '/simulators/mimic',
        standaloneLabel: 'Open Standalone Simulator',
        dossierPath: '/quests/mimic',
        liveUrl: '/simulators/mimic',
        scalingMode: 'responsive',
        thumbnail: '/art/mimic-transceiver-splash.jpg',
        hudStatus: 'MIMIC // VAULT',
        hudCommit: 'AES // ENCRYPTED'
      }
    ];

    // Setup Arcane Transceiver Scalable Simulation Browser
    function setupTransceiverSimulation() {
      const launchBtn = document.getElementById('transceiver-launch-btn');
      const unloadBtn = document.getElementById('transceiver-unload-btn');
      const fullscreenBtn = document.getElementById('transceiver-fullscreen-btn');
      const restingView = document.getElementById('transceiver-resting-view');
      const activeControls = document.getElementById('transceiver-active-controls');
      const frameContainer = document.getElementById('transceiver-frame-container');
      const machineDialog = document.getElementById('dialog-machine');

      const prevBtn = document.getElementById('transceiver-prev-btn');
      const nextBtn = document.getElementById('transceiver-next-btn');
      const subtitleEl = document.getElementById('transceiver-subtitle');
      const titleEl = document.getElementById('machine-dialog-title');
      const versionEl = document.getElementById('transceiver-version-text');
      const descEl = document.getElementById('transceiver-description');
      const badgesEl = document.getElementById('transceiver-badges');
      const launchLabelEl = document.getElementById('transceiver-launch-label');
      const standaloneLink = document.getElementById('transceiver-standalone-link') as HTMLAnchorElement | null;
      const standaloneLabel = document.getElementById('transceiver-standalone-label');
      const dossierLink = document.getElementById('transceiver-dossier-link') as HTMLAnchorElement | null;
      const indicatorsContainer = document.getElementById('transceiver-indicators');
      const contentEl = document.getElementById('transceiver-project-content');

      // In-world HUD screen elements
      const hudThumb = document.getElementById('transceiver-screen-thumb') as HTMLImageElement | null;
      const hudStatus = document.getElementById('transceiver-hud-status');
      const hudCommit = document.getElementById('transceiver-hud-commit');

      if (!launchBtn || !restingView || !activeControls || !frameContainer) return;

      const STORAGE_KEY = 'transceiver_last_project';
      let currentProjectIndex = 0;

      // Restore saved project preference
      try {
        const savedId = localStorage.getItem(STORAGE_KEY);
        if (savedId) {
          const idx = TRANSCEIVER_PROJECTS.findIndex(p => p.id === savedId);
          if (idx !== -1) currentProjectIndex = idx;
        }
      } catch {}

      function saveProjectPreference() {
        try {
          const proj = TRANSCEIVER_PROJECTS[currentProjectIndex];
          if (proj) {
            localStorage.setItem(STORAGE_KEY, proj.id);
          }
        } catch {}
      }

      function renderIndicators() {
        if (!indicatorsContainer) return;
        indicatorsContainer.innerHTML = '';
        TRANSCEIVER_PROJECTS.forEach((proj, idx) => {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = `transceiver-indicator-dot ${idx === currentProjectIndex ? 'active' : ''}`;
          dot.setAttribute('aria-label', `Navigate to ${proj.name} simulation`);
          dot.setAttribute('title', proj.name);
          dot.addEventListener('click', () => {
            if (currentProjectIndex !== idx) {
              soundEngine.playWoodClink();
              setProject(idx);
            }
          });
          indicatorsContainer.appendChild(dot);
        });
      }

      function updateIndicators() {
        if (!indicatorsContainer) return;
        const dots = indicatorsContainer.querySelectorAll('.transceiver-indicator-dot');
        dots.forEach((dot, idx) => {
          if (idx === currentProjectIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      function renderProject(animate = true) {
        const proj = TRANSCEIVER_PROJECTS[currentProjectIndex];
        if (!proj) return;

        if (subtitleEl) subtitleEl.textContent = proj.subtitle;
        if (titleEl) titleEl.textContent = proj.modalTitle;
        if (versionEl) versionEl.textContent = proj.version;
        if (descEl) descEl.textContent = proj.description;

        if (badgesEl) {
          badgesEl.innerHTML = proj.badges
            .map(b => `<span class="px-2 py-0.5 rounded bg-black/40 text-[var(--candle)] border border-[var(--brass)]/40 font-mono text-[10px]">${b}</span>`)
            .join('');
        }

        if (launchLabelEl) launchLabelEl.textContent = proj.launchLabel;

        if (standaloneLink) {
          standaloneLink.href = proj.standaloneUrl;
          if (standaloneLabel) standaloneLabel.textContent = proj.standaloneLabel;
        }

        if (dossierLink) {
          dossierLink.href = proj.dossierPath;
        }

        // Update in-world HUD screen
        if (hudThumb) {
          hudThumb.src = proj.thumbnail;
        }
        if (hudStatus) hudStatus.textContent = proj.hudStatus;
        if (hudCommit) hudCommit.textContent = proj.hudCommit;

        updateIndicators();
        saveProjectPreference();

        if (animate && contentEl) {
          contentEl.classList.remove('transceiver-content-fade');
          void contentEl.offsetWidth; // Force reflow
          contentEl.classList.add('transceiver-content-fade');
        }
      }

      function setProject(index: number) {
        currentProjectIndex = (index + TRANSCEIVER_PROJECTS.length) % TRANSCEIVER_PROJECTS.length;
        renderProject(true);
      }

      function prevProject() {
        soundEngine.playWoodClink();
        setProject(currentProjectIndex - 1);
      }

      function nextProject() {
        soundEngine.playWoodClink();
        setProject(currentProjectIndex + 1);
      }

      if (prevBtn) prevBtn.addEventListener('click', prevProject);
      if (nextBtn) nextBtn.addEventListener('click', nextProject);

      // Keyboard arrow navigation when resting view is active
      window.addEventListener('keydown', (e) => {
        if (!machineDialog || machineDialog.hidden) return;
        if (restingView.classList.contains('hidden')) return; // simulation is running

        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          prevProject();
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          nextProject();
        }
      });

      function fitArena() {
        const iframe = frameContainer.querySelector('iframe');
        if (!iframe) return;

        const proj = TRANSCEIVER_PROJECTS[currentProjectIndex];
        if (!proj) return;

        if (proj.scalingMode === 'fit-canvas') {
          const cw = frameContainer.clientWidth;
          const ch = frameContainer.clientHeight;
          if (!cw || !ch) return;

          const baseW = proj.baseWidth || 800;
          const baseH = proj.baseHeight || 600;
          const scale = Math.min(cw / baseW, ch / baseH);

          iframe.style.width = `${baseW}px`;
          iframe.style.height = `${baseH}px`;
          iframe.style.position = 'absolute';
          iframe.style.left = '50%';
          iframe.style.top = '50%';
          iframe.style.transform = `translate(-50%, -50%) scale(${scale})`;
          iframe.style.transformOrigin = 'center center';
        } else {
          // Responsive mode for BITS & Mimic
          iframe.style.width = '100%';
          iframe.style.height = '100%';
          iframe.style.position = 'relative';
          iframe.style.left = 'auto';
          iframe.style.top = 'auto';
          iframe.style.transform = 'none';
          iframe.style.transformOrigin = 'initial';
        }
      }

      function launchArena() {
        soundEngine.playWoodClink();
        const proj = TRANSCEIVER_PROJECTS[currentProjectIndex];
        if (!proj) return;

        const iframe = document.createElement('iframe');
        iframe.src = proj.liveUrl;
        iframe.title = `Live Simulation of ${proj.name} inside Arcane Transceiver`;
        iframe.className = 'border-0 w-full h-full';
        if (proj.scalingMode === 'fit-canvas') {
          iframe.setAttribute('scrolling', 'no');
        } else {
          iframe.setAttribute('scrolling', 'yes');
        }
        iframe.setAttribute('allow', 'autoplay; fullscreen');
        iframe.setAttribute('sandbox', 'allow-scripts allow-same-origin allow-popups allow-forms');
        iframe.loading = 'eager';

        frameContainer.innerHTML = '';
        frameContainer.appendChild(iframe);

        restingView.classList.add('hidden');
        activeControls.classList.remove('hidden');
        activeControls.classList.add('flex');
        frameContainer.classList.remove('hidden');

        fitArena();
        requestAnimationFrame(fitArena);
        setTimeout(fitArena, 150);
      }

      function unloadArena() {
        soundEngine.playWoodClink();
        frameContainer.innerHTML = '';
        frameContainer.classList.add('hidden');
        activeControls.classList.add('hidden');
        activeControls.classList.remove('flex');
        restingView.classList.remove('hidden');
      }

      function toggleFullscreen() {
        soundEngine.playWoodClink();
        const target = machineDialog || frameContainer;
        if (!document.fullscreenElement) {
          if (target && target.requestFullscreen) {
            target.requestFullscreen();
          }
        } else {
          if (document.exitFullscreen) {
            document.exitFullscreen();
          }
        }
      }

      const resizeObserver = new ResizeObserver(() => {
        if (!frameContainer.classList.contains('hidden')) {
          fitArena();
        }
      });
      resizeObserver.observe(frameContainer);
      window.addEventListener('resize', fitArena);

      launchBtn.addEventListener('click', launchArena);
      if (unloadBtn) unloadBtn.addEventListener('click', unloadArena);
      if (fullscreenBtn) fullscreenBtn.addEventListener('click', toggleFullscreen);

      unloadTransceiverFn = unloadArena;

      // Initialize indicators and project display
      renderIndicators();
      renderProject(false);
    }

    setupTransceiverSimulation();

    // Form Handling and Missive Dispatching
    const recipientEmail = 'cabahugnhovem@gmail.com';

    function handleMissiveSubmission(
      formId: string,
      nameId: string,
      emailId: string,
      subjectId: string,
      bodyId: string,
      isDesktop: boolean
    ) {
      const form = document.getElementById(formId) as HTMLFormElement | null;
      if (!form) return;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const errorContainerId = isDesktop ? 'desktop-raven-error' : 'mobile-raven-error';

        // Anti-abuse: honeypot check
        const honeypotId = isDesktop ? 'desktop-botcheck' : 'mobile-botcheck';
        const honeypot = document.getElementById(honeypotId) as HTMLInputElement | null;
        const botcheckValue = honeypot?.checked ? 'filled' : '';

        // Anti-abuse: time-to-submit check (< 2.5s = bot)
        if ((Date.now() - formLoadTime) < 2500) {
          // Silently accept (fake success) so bots don't retry
          return;
        }

        // Anti-abuse: rate limiting
        const rateCheck = checkRateLimit();
        if (!rateCheck.allowed) {
          showFormError(errorContainerId, rateCheck.reason || 'Rate limit exceeded.');
          return;
        }

        const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
        const originalBtnText = submitBtn ? submitBtn.textContent : '';
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'The Raven Takes Wing...';
        }

        const name = (document.getElementById(nameId) as HTMLInputElement)?.value.trim() || 'Traveler';
        const email = (document.getElementById(emailId) as HTMLInputElement)?.value.trim() || '';
        const subject = (document.getElementById(subjectId) as HTMLInputElement)?.value.trim() || 'Tavern Dispatch';
        const body = (document.getElementById(bodyId) as HTMLTextAreaElement)?.value.trim() || '';

        const fullFormattedBody = `Sender: ${name}\nReturn Address: ${email}\n\n--------------------------------------------------\n${body}\n--------------------------------------------------\n(Dispatched via Ibem's Tavern Messenger Roost)`;

        const result = await sendMissive({
          name,
          email,
          subject,
          message: body,
          botcheck: botcheckValue,
        });

        // Record successful send for rate limiting
        if (result.success) {
          recordSendSuccess();
        }

        // 2. If on desktop modal, show the receipt view
        if (isDesktop) {
          const composerView = document.getElementById('raven-composer-view');
          const receiptView = document.getElementById('raven-receipt-view');
          const receiptHeading = document.getElementById('receipt-heading');
          const receiptDesc = document.getElementById('receipt-desc');
          const receiptSubject = document.getElementById('receipt-subject');
          const receiptFrom = document.getElementById('receipt-from');
          const receiptBody = document.getElementById('receipt-body');
          const receiptGmailLink = document.getElementById('receipt-gmail-link') as HTMLAnchorElement | null;

          if (composerView && receiptView) {
            composerView.classList.add('hidden');
            receiptView.classList.remove('hidden');

            if (result.success) {
              if (receiptHeading) receiptHeading.textContent = 'Missive Delivered to Nhovem!';
              if (receiptDesc) {
                receiptDesc.textContent = 'The raven has successfully delivered your words directly to Nhovem’s console at cabahugnhovem@gmail.com.';
              }
            } else {
              if (receiptHeading) receiptHeading.textContent = 'The Raven Awaits Your Signal';
              if (receiptDesc) {
                receiptDesc.textContent = 'Your missive has been inscribed. Send it directly using Gmail Web or your email client:';
              }
              if (result.fallbackMailto) {
                window.location.href = result.fallbackMailto;
              }
            }

            if (receiptSubject) receiptSubject.textContent = subject;
            if (receiptFrom) receiptFrom.textContent = `${name} <${email}>`;
            if (receiptBody) receiptBody.textContent = body;

            if (receiptGmailLink && result.fallbackGmailUrl) {
              receiptGmailLink.href = result.fallbackGmailUrl;
            }

            // Setup copy formatted missive button
            const receiptCopyBtn = document.getElementById('receipt-copy-btn');
            if (receiptCopyBtn) {
              receiptCopyBtn.onclick = async () => {
                try {
                  await navigator.clipboard.writeText(fullFormattedBody);
                } catch {
                  const textarea = document.createElement('textarea');
                  textarea.value = fullFormattedBody;
                  document.body.appendChild(textarea);
                  textarea.select();
                  document.execCommand('copy');
                  document.body.removeChild(textarea);
                }
                const oldText = receiptCopyBtn.textContent;
                receiptCopyBtn.textContent = 'Copied to Clipboard!';
                setTimeout(() => {
                  receiptCopyBtn.textContent = oldText;
                }, 2500);
              };
            }

            // Reset button
            const resetBtn = document.getElementById('receipt-reset-btn');
            if (resetBtn) {
              resetBtn.onclick = () => {
                receiptView.classList.add('hidden');
                composerView.classList.remove('hidden');
                form.reset();
                if (submitBtn) {
                  submitBtn.disabled = false;
                  submitBtn.textContent = originalBtnText;
                }
              };
            }
          }
        } else {
          // Mobile form fallback
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = result.success ? '✓ Missive Delivered!' : originalBtnText;
            if (!result.success && result.fallbackMailto) {
              window.location.href = result.fallbackMailto;
            }
          }
        }
      });
    }


    handleMissiveSubmission(
      'desktop-raven-form',
      'desktop-sender-name',
      'desktop-sender-email',
      'desktop-missive-subject',
      'desktop-missive-body',
      true
    );

    handleMissiveSubmission(
      'mobile-raven-form',
      'mobile-sender-name',
      'mobile-sender-email',
      'mobile-missive-subject',
      'mobile-missive-body',
      false
    );

    // Mobile address copy button
    const mobileCopyBtn = document.getElementById('mobile-copy-email-btn');
    const mobileEmail = document.getElementById('mobile-email-address');
    const mobileStatus = document.getElementById('mobile-copy-status');

    if (mobileCopyBtn && mobileEmail && mobileStatus) {
      mobileCopyBtn.addEventListener('click', async () => {
        const email = mobileEmail.textContent?.trim() || recipientEmail;
        try {
          await navigator.clipboard.writeText(email);
        } catch {
          const textarea = document.createElement('textarea');
          textarea.value = email;
          document.body.appendChild(textarea);
          textarea.select();
          document.execCommand('copy');
          document.body.removeChild(textarea);
        }
        mobileStatus.classList.remove('hidden');
        mobileCopyBtn.textContent = 'Copied!';
        setTimeout(() => {
          mobileStatus.classList.add('hidden');
          mobileCopyBtn.textContent = 'Copy Address';
        }, 2500);
      });
    }
  }

  document.addEventListener('astro:page-load', initMessengerPage);
</script>
