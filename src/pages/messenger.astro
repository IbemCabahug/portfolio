    // Setup Arcane Transceiver Scalable Simulation Browser
    function setupTransceiverSimulation() {
      const launchBtn = document.getElementById('transceiver-launch-btn');
      const unloadBtn = document.getElementById('transceiver-unload-btn');
      const fullscreenBtn = document.getElementById('transceiver-fullscreen-btn');
