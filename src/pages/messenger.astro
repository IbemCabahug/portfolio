<script>
  // Interactive Scene Hotspots and Modal Management
  const triggers = [
    { triggerId: 'trigger-perch-raven', dialogId: 'dialog-raven' },
    { triggerId: 'trigger-arcane-machine', dialogId: 'dialog-machine' },
    { triggerId: 'trigger-scribe-desk', dialogId: 'dialog-desk' },
    { triggerId: 'trigger-courier-satchel', dialogId: 'dialog-satchel' }
  ];

  const backdrop = document.getElementById('dialog-backdrop');
  const sceneObjects = document.querySelectorAll('.scene-object');
  let activeDialog: HTMLElement | null = null;
  let activeTrigger: HTMLElement | null = null;

  function getFocusableElements(el: HTMLElement): HTMLElement[] {
    return Array.from(el.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])'));
  }

  function openDialog(dialog: HTMLElement, trigger: HTMLElement) {
    // Disable background scene objects for screen readers and tab navigation
    sceneObjects.forEach((el) => {
      el.classList.add('disabled-by-dialog');
      el.setAttribute('tabindex', '-1');
    });

    if (backdrop) {
      backdrop.hidden = false;
      backdrop.setAttribute('aria-hidden', 'false');
    }

    dialog.hidden = false;
    dialog.setAttribute('aria-hidden', 'false');
    trigger.setAttribute('aria-expanded', 'true');
    activeDialog = dialog;
    activeTrigger = trigger;

    const focusables = getFocusableElements(dialog);
    if (focusables.length) {
      focusables[0].focus();
    }

    document.addEventListener('keydown', handleKeydown);
  }

  function closeDialog() {
    if (!activeDialog) return;

    sceneObjects.forEach((el) => {
      el.classList.remove('disabled-by-dialog');
      el.removeAttribute('tabindex');
    });

    if (backdrop) {
      backdrop.hidden = true;
      backdrop.setAttribute('aria-hidden', 'true');
    }

    activeDialog.hidden = true;
    activeDialog.setAttribute('aria-hidden', 'true');

    if (activeTrigger) {
      activeTrigger.setAttribute('aria-expanded', 'false');
      activeTrigger.focus();
    }

    activeDialog = null;
    activeTrigger = null;
    document.removeEventListener('keydown', handleKeydown);
  }

  function handleKeydown(e: KeyboardEvent) {
    if (e.key === 'Escape') {
      closeDialog();
      return;
    }
    if (e.key === 'Tab' && activeDialog) {
      const focusables = getFocusableElements(activeDialog);
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];

      if (e.shiftKey) {
        if (document.activeElement === first) {
          e.preventDefault();
          last.focus();
        }
      } else {
        if (document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    }
  }

  // Bind trigger buttons to their respective modals
  triggers.forEach(({ triggerId, dialogId }) => {
    const trigger = document.getElementById(triggerId);
    const dialog = document.getElementById(dialogId);
    if (trigger && dialog) {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        openDialog(dialog, trigger);
      });
    }
  });

  // Bind all close buttons inside panels
  document.querySelectorAll('.close-panel-btn, .close-panel-btn-secondary').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      closeDialog();
    });
  });

  // Clicking backdrop closes active dialog
  if (backdrop) {
    backdrop.addEventListener('click', () => {
      closeDialog();
    });
  }

  // Copy Email Address helper function
  function setupCopyButton(btnId: string, textId: string, statusId: string) {
    const btn = document.getElementById(btnId);
    const textEl = document.getElementById(textId);
    const statusEl = document.getElementById(statusId);

    if (!btn || !textEl || !statusEl) return;

    btn.addEventListener('click', async () => {
      const text = textEl.textContent?.trim() || 'ncabahug223@gmail.com';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const textarea = document.createElement('textarea');
        textarea.value = text;
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
      }

      statusEl.classList.remove('hidden');
      const originalText = btn.textContent;
      btn.textContent = 'Copied!';
      setTimeout(() => {
        statusEl.classList.add('hidden');
        btn.textContent = originalText;
      }, 2500);
    });
  }

  // Setup copy buttons for both modal and mobile fallback
  setupCopyButton('modal-copy-email-btn', 'modal-email-address', 'modal-copy-status');
  setupCopyButton('mobile-copy-email-btn', 'mobile-email-address', 'mobile-copy-status');
</script>
