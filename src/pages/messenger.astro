  .panel-close-icon-btn:is(:hover, :focus-visible) {
    background: var(--brass, #8b6b4a);
    color: #1a1005;
    outline: 2px solid var(--candle, #fdf6e3);
  }

  
  /* Short landscape screens (<= 500px height in landscape) */
  .tavern-panel[hidden] {
    display: none !important;
  }

  /* Transceiver Full Viewport App Modal */
  #dialog-machine.transceiver-viewport-modal {
    width: min(95vw, 1120px);
