---
import TavernLayout from '../layouts/TavernLayout.astro';
import { getCollection, getEntry } from 'astro:content';
const links = await getCollection('links');
const profileEntry = await getEntry('profile', 'main');
const profile = profileEntry?.data;
const mailLink = links.find((l) => l.data.icon === 'mail');
const githubLink = links.find((l) => l.data.icon === 'github');
const mailAddress = mailLink?.data.url.replace('mailto:', '') || profile?.email || 'cabahugnhovem@gmail.com';
const githubUrl = githubLink?.data.url || profile?.github || 'https://github.com/IbemCabahug';
---

<TavernLayout
  title="The Courier's Roost — Messenger's Corner — Nhovem Cabahug"
  description="Step inside The Courier's Roost: an interactive 2.5D tavern aviary to send word, inspect GitHub telemetry, or review credentials."
  location="messenger"
>
  <div class="roost-page-wrapper">
    <!-- Atmospheric Room Intro Header -->
    <header class="roost-header text-center mb-6 px-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--stone)]/60 border border-[var(--brass)]/40 text-[var(--candle)] text-xs font-semibold tracking-wider uppercase mb-2">
        <span>Messenger's Aviary &bull; Contact & Direct Dispatch</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-[var(--candle)] mb-1 tracking-wide drop-shadow-md">
        The Courier's Roost
      </h1>
      <span class="block text-xs uppercase tracking-widest text-[var(--brass)] font-sans font-bold mb-2">Direct Contact & Communications Chamber</span>
      <p class="text-sm sm:text-base text-[var(--parchment)]/90 max-w-xl mx-auto leading-relaxed">
        Tucked beyond the taproom archway lies the messenger roost, attended day and night. Inspect the interactive fixtures around the chamber to send a raven, consult the arcane transceiver, or inspect the master scribe's ledger.
      </p>
    </header>

    <!-- 2.5D Interactive Tavern Room Scene (Desktop & Tablet) -->
    <section class="scene-container" aria-label="Interactive Courier's Roost Chamber">
      <picture>
        <source
          media="(min-width: 601px), (orientation: landscape)"
          srcset="/art/messengers-corner-1280.webp 1280w, /art/messengers-corner-2560.webp 2560w"
          sizes="(max-width: 2560px) 100vw, 2560px"
        />
        <img
          src="/art/messengers-corner-1280.webp"
          width="2560"
          height="1429"
          alt="The Courier's Roost: a warm timber tavern room with a perched raven, an enchanted machine in the wall alcove, a scribe desk with candle, a hanging satchel, and a doorway returning to the tavern."
          loading="eager"
          fetchpriority="high"
          class="scene-background"
        />
      </picture>

      <div class="scene-overlay" aria-hidden="false">
        <!-- Hotspot 1: Perched Raven (Email Dispatch) -->
        <button
          type="button"
          id="trigger-perch-raven"
          class="scene-object scene-hotspot"
          aria-label="Send a Raven (Direct Email Dispatch)"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="dialog-raven"
          style="left: 1.64%; top: 45.80%; width: 6.02%; z-index: 3;"
        >
          <img
            src="/art/new-raven-with-perch-448.webp"
            srcset="/art/new-raven-with-perch-224.webp 224w, /art/new-raven-with-perch-448.webp 448w"
            sizes="(max-width: 1280px) 80px, 160px"
            width="1121"
            height="1280"
            alt=""
            loading="eager"
            decoding="async"
            class="raven-sprite"
          />
          <span class="scene-tooltip" data-placement="top">Send Word (Email)</span>
        </button>

        <!-- Hotspot 2: Arcane Transceiver (Arcane Typer Live Simulation) -->
        <button
          type="button"
          id="trigger-arcane-machine"
          class="scene-object scene-hotspot machine-hotspot"
          aria-label="The Arcane Transceiver (Arcane Typer Live Simulation)"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="dialog-machine"
          style="left: 50.2%; top: 36.0%; width: 21.5%; z-index: 3;"
        >
          <img
            src="/art/enchanted-case-study-device-1152.webp"
            srcset="/art/enchanted-case-study-device-576.webp 576w, /art/enchanted-case-study-device-1152.webp 1152w"
            sizes="(max-width: 1280px) 275px, 550px"
            width="1152"
            height="577"
            alt=""
            loading="eager"
            decoding="async"
            class="machine-sprite"
          />
          <!-- In-World Arcane Telemetry HUD Screen -->
          <div class="transceiver-screen" aria-hidden="true">
            <img
              id="transceiver-screen-thumb"
              src="/art/arcane-typer-splash.webp"
              alt=""
              width="1004"
              height="582"
              loading="eager"
              decoding="async"
              class="screen-thumb-bg absolute inset-0 w-full h-full object-cover"
            />
            <div class="screen-scanlines"></div>
            
            <div class="screen-header">
              <span class="screen-pulse-dot"></span>
              <span id="transceiver-hud-status" class="screen-status-text">ARCANE // 60FPS</span>
            </div>

            <div class="screen-footer">
              <div class="screen-bars">
                <span class="bar bar-1"></span>
                <span class="bar bar-2"></span>
                <span class="bar bar-3"></span>
                <span class="bar bar-4"></span>
                <span class="bar bar-5"></span>
              </div>
              <span id="transceiver-hud-commit" class="screen-commit">CANVAS // LIVE</span>
            </div>
          </div>
          <span class="scene-tooltip" data-placement="top">Arcane Transceiver (Live Simulation)</span>
        </button>

        <!-- Hotspot 3: Scribe's Rolltop Desk (Full Resume) -->
        <button
          type="button"
          id="trigger-scribe-desk"
          class="scene-object scene-hotspot desk-hotspot"
          aria-label="The Master Scribe's Ledger (Professional Resume)"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="dialog-desk"
          style="left: 21.33%; top: 46.22%; width: 21.72%; height: 31.93%; z-index: 3;"
        >
          <img
            src="/art/scribe-desk-prop-tight.webp"
            width="278"
            height="228"
            alt=""
            loading="eager"
            decoding="async"
            class="desk-sprite"
          />
          <span class="scene-tooltip" data-placement="top">Scribe's Ledger (Resume)</span>
        </button>

        <!-- Hotspot 4: Hanging Courier Satchel (Field Status & Coordinates) -->
        <button
          type="button"
          id="trigger-courier-satchel"
          class="scene-object scene-hotspot satchel-hotspot"
          aria-label="Courier's Field Satchel (Availability & Coordinates)"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="dialog-satchel"
          style="left: 14.69%; top: 35.71%; width: 4.53%; height: 21.71%; z-index: 3;"
        >
          <img
            src="/art/courier-satchel-prop-tight.webp"
            width="58"
            height="155"
            alt=""
            loading="eager"
            decoding="async"
            class="satchel-sprite"
          />
          <span class="scene-tooltip" data-placement="bottom">Field Satchel (Status)</span>
        </button>

        <!-- Hotspot 5: Arched Doorway to Main Tavern -->
        <a
          href="/tavern"
          id="trigger-tavern-door"
          class="scene-object scene-hotspot door-hotspot"
          aria-label="Return through the Archway to the Main Tavern"
          style="left: 80.55%; top: 35.99%; width: 5.47%; height: 36.83%; z-index: 3;"
        >
          <img
            src="/art/door-to-tavern-prop-tight.webp"
            width="70"
            height="263"
            alt=""
            loading="eager"
            decoding="async"
            class="door-sprite"
          />
          <span class="scene-tooltip" data-placement="left">Main Tavern (Return)</span>
        </a>

        </div>
    </section>

    <!-- Hoisted Modals Outside scene-container -->
    <!-- Modal Backdrop -->
        <div id="dialog-backdrop" class="dialog-backdrop" hidden aria-hidden="true"></div>

        <!-- Modal 1: Raven Interactive Missive Composer -->
        <div
          id="dialog-raven"
          class="tavern-panel"
          role="dialog"
          aria-modal="true"
          aria-labelledby="raven-dialog-title"
          hidden
        >
          <div class="panel-header flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="panel-badge-icon" aria-hidden="true">
                <svg class="w-7 h-7 text-[var(--brass)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"/>
                  <line x1="16" y1="8" x2="2" y2="22"/>
                  <line x1="17.5" y1="15" x2="9" y2="15"/>
                </svg>
              </span>
              <div>
                <span class="text-xs uppercase font-extrabold tracking-widest text-[var(--ember)]">Priority Dispatch</span>
                <h2 id="raven-dialog-title" class="text-xl sm:text-2xl font-bold text-[var(--candle)]">Send Word with the Raven</h2>
              </div>
            </div>
          </div>

          <!-- Composer View -->
          <div id="raven-composer-view" class="panel-body space-y-3">
            <p class="text-xs sm:text-sm text-[var(--parchment)]/90 leading-relaxed">
              Inscribe your dispatch below. Selecting a missive category provides a structured template, and sealing the message routes it directly to Nhovem's console.
            </p>

            <!-- Template Categories (GitHub Issue Style) -->
            <div>
              <span class="block text-xs uppercase tracking-wider text-[var(--brass)] font-semibold mb-1.5">Select Dispatch Template</span>
              <div class="grid grid-cols-3 gap-1.5" role="radiogroup" aria-label="Missive template selection">
                <button
                  type="button"
                  class="template-pill active"
                  data-template="quest"
                  data-prefix="[Quest Offer]"
                  data-subject="Frontend / Web Project Inquiry"
                  data-placeholder="Describe the quest, target timeline, technology stack, and how you'd like to collaborate..."
                >
                  📜 Quest Offer
                </button>
                <button
                  type="button"
                  class="template-pill"
                  data-template="role"
                  data-prefix="[Guild Recruitment]"
                  data-subject="Junior Developer Role Opportunity"
                  data-placeholder="Share details about the junior developer role, team structure, remote/hybrid requirements, and company mission..."
                >
                  ⚔️ Recruitment
                </button>
                <button
                  type="button"
                  class="template-pill"
                  data-template="general"
                  data-prefix="[Tavern Greetings]"
                  data-subject="Greetings from a Fellow Traveler"
                  data-placeholder="Share your thoughts on the portfolio, say hello, or connect with Nhovem..."
                >
                  🍺 Tavern Chat
                </button>
              </div>
            </div>

            <!-- Form Fields -->
            <form id="desktop-raven-form" class="space-y-2.5">
              <input type="checkbox" name="botcheck" id="desktop-botcheck" class="hidden" style="display:none !important;position:absolute;left:-9999px;" tabindex="-1" autocomplete="off" aria-hidden="true" />
              <div id="desktop-raven-error" class="hidden text-xs text-red-400 bg-red-900/30 border border-red-500/50 rounded px-3 py-2" role="alert"></div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                <div>
                  <label for="desktop-sender-name" class="block text-xs text-[var(--parchment)]/80 font-medium mb-1">Your Name / Call-Sign <span class="text-[var(--ember)]">*</span></label>
                  <input
                    type="text"
                    id="desktop-sender-name"
                    name="senderName"
                    required
                    placeholder="e.g. Robin of the North"
                    class="tavern-input w-full px-3 py-1.5 text-xs sm:text-sm rounded bg-black/40 border border-[var(--brass)]/40 text-[var(--candle)] focus:border-[var(--candle)] focus:outline-none transition-colors"
                  />
                </div>
                <div>
                  <label for="desktop-sender-email" class="block text-xs text-[var(--parchment)]/80 font-medium mb-1">Your Return Address (Email) <span class="text-[var(--ember)]">*</span></label>
                  <input
                    type="email"
                    id="desktop-sender-email"
                    name="senderEmail"
                    required
                    placeholder="e.g. traveler@guild.com"
                    class="tavern-input w-full px-3 py-1.5 text-xs sm:text-sm rounded bg-black/40 border border-[var(--brass)]/40 text-[var(--candle)] focus:border-[var(--candle)] focus:outline-none transition-colors"
                  />
                </div>
              </div>

              <div>
                <label for="desktop-missive-subject" class="block text-xs text-[var(--parchment)]/80 font-medium mb-1">Missive Title / Subject <span class="text-[var(--ember)]">*</span></label>
                <input
                  type="text"
                  id="desktop-missive-subject"
                  name="subject"
                  required
                  value="[Quest Offer] Frontend / Web Project Inquiry"
                  class="tavern-input w-full px-3 py-1.5 text-xs sm:text-sm rounded bg-black/40 border border-[var(--brass)]/40 text-[var(--candle)] focus:border-[var(--candle)] focus:outline-none transition-colors"
                />
              </div>

              <div>
                <label for="desktop-missive-body" class="block text-xs text-[var(--parchment)]/80 font-medium mb-1">Sealed Message <span class="text-[var(--ember)]">*</span></label>
                <textarea
                  id="desktop-missive-body"
                  name="message"
                  required
                  rows="3"
                  placeholder="Describe the quest, target timeline, technology stack, and how you'd like to collaborate..."
                  class="tavern-input w-full px-3 py-2 text-xs sm:text-sm rounded bg-black/40 border border-[var(--brass)]/40 text-[var(--candle)] focus:border-[var(--candle)] focus:outline-none transition-colors resize-none"
                ></textarea>
              </div>

              <div class="flex flex-wrap items-center justify-between text-[11px] text-[var(--parchment)]/70 pt-0.5">
                <span>Destination: <strong class="text-[var(--candle)] font-mono">{mailAddress}</strong></span>
                <span>Turnaround: 24–48 hours</span>
              </div>

              <div class="panel-actions pt-2 flex flex-wrap items-center justify-between gap-3">
                <button
                  type="submit"
                  class="inline-flex items-center justify-center min-h-[44px] px-6 py-2 bg-[var(--brass)] text-black font-bold text-sm rounded hover:bg-[var(--candle)] transition-colors shadow-md cursor-pointer"
                >
                  Seal & Dispatch Raven &rarr;
                </button>
                <button
                  type="button"
                  class="close-panel-btn inline-flex items-center justify-center min-h-[44px] px-6 py-2 bg-[var(--brass)] text-black font-bold text-xs sm:text-sm rounded hover:bg-[var(--candle)] transition-colors cursor-pointer ml-auto"
                >
                  Return to Roost (Esc)
                </button>
              </div>
            </form>
          </div>

          <!-- Dispatch Receipt / Confirmation View (Hidden by default) -->
          <div id="raven-receipt-view" class="panel-body space-y-3 hidden" aria-live="polite">
            <div class="p-4 rounded bg-emerald-950/40 border border-emerald-500/40 text-center space-y-1.5">
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-full bg-emerald-500/20 text-emerald-400 mx-auto" aria-hidden="true">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"/>
                  <line x1="16" y1="8" x2="2" y2="22"/>
                  <line x1="17.5" y1="15" x2="9" y2="15"/>
                </svg>
              </span>
              <h3 class="text-base sm:text-lg font-bold text-emerald-400" id="receipt-heading">The Raven Takes Wing!</h3>
              <p class="text-xs text-[var(--parchment)]/90 max-w-md mx-auto" id="receipt-desc">
                Your missive has been prepared and routed to your email client. A copy of your sealed message is inscribed below for your records:
              </p>
            </div>

            <div class="p-3 rounded bg-black/40 border border-[var(--brass)]/30 font-mono text-xs text-[var(--parchment)]/90 space-y-1">
              <div class="text-[var(--brass)] font-bold mb-1 border-b border-[var(--brass)]/20 pb-1">DISPATCH RECORD</div>
              <p><strong class="text-[var(--candle)]">To:</strong> {mailAddress}</p>
              <p><strong class="text-[var(--candle)]">Subject:</strong> <span id="receipt-subject"></span></p>
              <p><strong class="text-[var(--candle)]">From:</strong> <span id="receipt-from"></span></p>
              <div class="mt-2 pt-2 border-t border-[var(--brass)]/20 whitespace-pre-wrap" id="receipt-body"></div>
            </div>

            <div class="panel-actions pt-2 flex flex-wrap items-center justify-between gap-3">
              <div class="flex flex-wrap items-center gap-2">
                <button
                  type="button"
                  id="receipt-copy-btn"
                  class="inline-flex items-center justify-center min-h-[44px] px-4 py-2 bg-[var(--wood-deep)] text-[var(--candle)] border border-[var(--brass)] font-bold text-xs sm:text-sm rounded hover:bg-black transition-colors cursor-pointer"
                >
                  Copy Formatted Missive
                </button>
                <a
                  id="receipt-gmail-link"
                  href={`https://mail.google.com/mail/?view=cm&fs=1&to=${mailAddress}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center min-h-[44px] px-4 py-2 bg-[var(--wood-deep)] text-[var(--candle)] border border-[var(--brass)] font-bold text-xs sm:text-sm rounded hover:bg-black transition-colors"
                >
                  Open in Gmail Webmail &rarr;
                </a>
                <button
                  type="button"
                  id="receipt-reset-btn"
                  class="min-h-[44px] px-3 py-2 text-xs sm:text-sm text-[var(--candle)]/80 hover:text-[var(--candle)] hover:underline cursor-pointer"
                >
                  Write Another Missive
                </button>
              </div>

              <button
                type="button"
                class="close-panel-btn inline-flex items-center justify-center min-h-[44px] px-6 py-2 bg-[var(--brass)] text-black font-bold text-xs sm:text-sm rounded hover:bg-[var(--candle)] transition-colors cursor-pointer ml-auto"
              >
                Return to Roost (Esc)
              </button>
            </div>
          </div>
        </div>

        <!-- Modal 2: Arcane Transceiver (Scalable Project Simulation Browser) -->
        <div
          id="dialog-machine"
          class="tavern-panel transceiver-viewport-modal"
          role="dialog"
          aria-modal="true"
          aria-labelledby="machine-dialog-title"
          hidden
        >
          <div class="panel-header flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <span class="panel-badge-icon" aria-hidden="true">
                <svg class="w-6 h-6 text-[var(--brass)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
              </span>
              <div>
                <span id="transceiver-subtitle" class="text-[10px] sm:text-xs uppercase font-extrabold tracking-widest text-[var(--ember)]">Arcane Transmission</span>
                <h2 id="machine-dialog-title" class="text-lg sm:text-xl font-bold text-[var(--candle)] leading-tight">The Arcane Transceiver — Live Trial</h2>
              </div>
            </div>

            <button
              type="button"
              class="close-panel-btn inline-flex items-center justify-center min-h-[36px] px-3 py-1 rounded bg-black/40 hover:bg-black text-[var(--candle)] border border-[var(--brass)]/50 text-xs font-bold transition-colors cursor-pointer"
              title="Close Transceiver (Esc)"
              aria-label="Close Transceiver"
            >
              <span>✕ Close</span>
            </button>
          </div>

          <div class="panel-body flex-1 min-h-0 flex flex-col gap-2.5 overflow-hidden">
            <!-- Transceiver Top Chamber Control Bar -->
            <div class="px-3 py-1.5 rounded bg-[var(--wood-deep)] border border-[var(--brass)]/60 flex items-center justify-between gap-2 shrink-0">
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-emerald-950/80 border border-emerald-500/60 text-emerald-400 font-mono text-[10px] sm:text-xs font-bold">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse" aria-hidden="true"></span>
                  <span>Signal Synchronized</span>
                </span>
                <span id="transceiver-version-text" class="text-[11px] font-mono text-[var(--parchment)]/70 hidden sm:inline">
                  ArcaneTyper v2.2.6
                </span>
              </div>

              <div id="transceiver-active-controls" class="hidden items-center gap-2">
                <button
                  type="button"
                  id="transceiver-fullscreen-btn"
                  class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-black/50 border border-[var(--brass)] text-[var(--candle)] font-mono text-xs hover:bg-black transition-colors cursor-pointer min-h-[32px]"
                  title="Toggle Fullscreen"
                >
                  <span>⛶</span>
                  <span class="hidden sm:inline">Fullscreen</span>
                </button>

                <button
                  type="button"
                  id="transceiver-unload-btn"
                  class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-red-950/70 border border-red-500/50 text-red-200 font-bold text-xs hover:bg-red-900 transition-colors cursor-pointer min-h-[32px]"
                  title="Disengage demo and free memory"
                >
                  <span>✕</span>
                  <span>Disengage</span>
                </button>
              </div>
            </div>

            <!-- Resting View: Dynamic Project Preview with Navigation -->
            <div id="transceiver-resting-view" class="flex-1 min-h-0 w-full rounded bg-[var(--wood-deep)]/80 border border-[var(--brass)]/40 flex flex-col items-center justify-center text-center overflow-hidden relative">
              <!-- Left Navigation Arrow -->
              <button
                type="button"
                id="transceiver-prev-btn"
                class="transceiver-nav-arrow transceiver-nav-prev"
                aria-label="Previous project simulation"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
                  <polyline points="15 18 9 12 15 6"/>
                </svg>
              </button>

              <!-- Right Navigation Arrow -->
              <button
                type="button"
                id="transceiver-next-btn"
                class="transceiver-nav-arrow transceiver-nav-next"
                aria-label="Next project simulation"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
                  <polyline points="9 6 15 12 9 18"/>
                </svg>
              </button>

              <!-- Dynamic Content Container (populated by JS) -->
              <div id="transceiver-project-content" class="p-4 sm:p-6 space-y-4 w-full max-w-xl mx-auto transceiver-content-fade">
                <p id="transceiver-description" class="text-xs sm:text-sm text-[var(--parchment)]/90 leading-relaxed">
                  <!-- Populated by JS -->
                </p>
                <div id="transceiver-badges" class="flex flex-wrap justify-center gap-1.5 pt-1">
                  <!-- Populated by JS -->
                </div>
              </div>

              <div class="flex flex-wrap items-center justify-center gap-3 pt-2 pb-3 px-4">
                <button
                  type="button"
                  id="transceiver-launch-btn"
                  class="inline-flex items-center gap-2 min-h-[44px] px-6 py-2.5 rounded-md bg-[var(--brass)] text-black font-bold text-xs sm:text-sm hover:bg-[var(--candle)] transition-all shadow-lg hover:shadow-[0_0_15px_rgba(218,165,32,0.4)] cursor-pointer focus-visible:outline-2 focus-visible:outline-[var(--candle)]"
                >
                  <svg class="w-4 h-4 text-black" viewBox="0 0 24 24" fill="currentColor">
                    <polygon points="5 3 19 12 5 21 5 3"/>
                  </svg>
                  <span id="transceiver-launch-label">Engage Arcane Typer Trial</span>
                </button>

