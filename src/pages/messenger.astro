  .tavern-panel::-webkit-scrollbar-thumb:hover,
  .tavern-scrollbar::-webkit-scrollbar-thumb:hover,
  .tavern-panel *::-webkit-scrollbar-thumb:hover {
    background: var(--candle, #ffe4a0);
  }
  .tavern-panel::-webkit-scrollbar-button,
  .tavern-scrollbar::-webkit-scrollbar-button,
  .tavern-panel *::-webkit-scrollbar-button {
    display: none;
    width: 0;
    height: 0;
  }

  .panel-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid rgba(213, 128, 59, 0.3);
