  .scene-tooltip[data-placement="top"] {
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
  }
  .scene-tooltip[data-placement="bottom"] {
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
  }
  .scene-tooltip[data-placement="left"] {
    right: calc(100% + 8px);
    top: 50%;
    transform: translateY(-50%);
  }
  .scene-tooltip[data-placement="right"] {
    left: calc(100% + 8px);
