<script>
  // Interactive Scene Hotspots and Modal Management
  const triggers = [
    { triggerId: 'trigger-perch-raven', dialogId: 'dialog-raven' },
    { triggerId: 'trigger-arcane-machine', dialogId: 'dialog-machine' },
    { triggerId: 'trigger-scribe-desk', dialogId: 'dialog-desk' },
    { triggerId: 'trigger-courier-satchel', dialogId: 'dialog-satchel' }
  ];

  const backdrop = document.getElementById('dialog-backdrop');
  const sceneObjects = document.querySelectorAll('.scene-object');
  let activeDialog: HTMLElement | null = null;
  let activeTrigger: HTMLElement | null = null;

  function getFocusableElements(el: HTMLElement): HTMLElement[] {
    return Array.from(el.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), input:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'));
  }

  function openDialog(dialog: HTMLElement, trigger: HTMLElement) {
    sceneObjects.forEach((el) => {
      el.classList.add('disabled-by-dialog');
      el.setAttribute('tabindex', '-1');
    });

    if (backdrop) {
      backdrop.hidden = false;
      backdrop.setAttribute('aria-hidden', 'false');
    }

    dialog.hidden = false;
    dialog.setAttribute('aria-hidden', 'false');
    trigger.setAttribute('aria-expanded', 'true');
    activeDialog = dialog;
    activeTrigger = trigger;

    const focusables = getFocusableElements(dialog);
    if (focusables.length) {
      focusables[0].focus();
    }

    document.addEventListener('keydown', handleKeydown);
  }

  function closeDialog() {
    if (!activeDialog) return;

    sceneObjects.forEach((el) => {
      el.classList.remove('disabled-by-dialog');
      el.removeAttribute('tabindex');
    });

    if (backdrop) {
      backdrop.hidden = true;
      backdrop.setAttribute('aria-hidden', 'true');
    }

    activeDialog.hidden = true;
    activeDialog.setAttribute('aria-hidden', 'true');

    if (activeTrigger) {
      activeTrigger.setAttribute('aria-expanded', 'false');
      activeTrigger.focus();
    }

    activeDialog = null;
    activeTrigger = null;
    document.removeEventListener('keydown', handleKeydown);
  }

  function handleKeydown(e: KeyboardEvent) {
    if (e.key === 'Escape') {
      closeDialog();
      return;
    }
    if (e.key === 'Tab' && activeDialog) {
      const focusables = getFocusableElements(activeDialog);
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];

      if (e.shiftKey) {
        if (document.activeElement === first) {
          e.preventDefault();
          last.focus();
        }
      } else {
        if (document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    }
  }

  // Bind trigger buttons to their respective modals
  triggers.forEach(({ triggerId, dialogId }) => {
    const trigger = document.getElementById(triggerId);
    const dialog = document.getElementById(dialogId);
    if (trigger && dialog) {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        openDialog(dialog, trigger);
      });
    }
  });

  // Satchel modal shortcut to Raven modal
  const satchelDispatchBtn = document.getElementById('satchel-dispatch-btn');
  const ravenDialog = document.getElementById('dialog-raven');
  const ravenTrigger = document.getElementById('trigger-perch-raven');
  if (satchelDispatchBtn && ravenDialog && ravenTrigger) {
    satchelDispatchBtn.addEventListener('click', () => {
      closeDialog();
      setTimeout(() => {
        openDialog(ravenDialog, ravenTrigger);
      }, 50);
    });
  }

  // Bind all close buttons inside panels
  document.querySelectorAll('.close-panel-btn, .close-panel-btn-secondary').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      closeDialog();
    });
  });

  // Clicking backdrop closes active dialog
  if (backdrop) {
    backdrop.addEventListener('click', () => {
      closeDialog();
    });
  }

  // Missive Template Selector logic (GitHub Issue style)
  function setupTemplatePills(selector: string, subjectInputId: string, bodyInputId: string) {
    const pills = document.querySelectorAll<HTMLButtonElement>(selector);
    const subjectInput = document.getElementById(subjectInputId) as HTMLInputElement | null;
    const bodyInput = document.getElementById(bodyInputId) as HTMLTextAreaElement | null;

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        pills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');

        const prefix = pill.getAttribute('data-prefix') || '';
        const subject = pill.getAttribute('data-subject') || '';
        const placeholder = pill.getAttribute('data-placeholder') || '';

        if (subjectInput) {
          subjectInput.value = `${prefix} ${subject}`;
        }
        if (bodyInput) {
          bodyInput.placeholder = placeholder;
          if (!bodyInput.value.trim()) {
            bodyInput.focus();
          }
        }
      });
    });
  }

  setupTemplatePills('.template-pill', 'desktop-missive-subject', 'desktop-missive-body');
  setupTemplatePills('.mobile-template-pill', 'mobile-missive-subject', 'mobile-missive-body');

  // Form Handling and Missive Dispatching
  const recipientEmail = 'ncabahug223@gmail.com';

  function handleMissiveSubmission(
    formId: string,
    nameId: string,
    emailId: string,
    subjectId: string,
    bodyId: string,
    isDesktop: boolean
  ) {
    const form = document.getElementById(formId) as HTMLFormElement | null;
    if (!form) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const name = (document.getElementById(nameId) as HTMLInputElement)?.value.trim() || 'Traveler';
      const email = (document.getElementById(emailId) as HTMLInputElement)?.value.trim() || '';
      const subject = (document.getElementById(subjectId) as HTMLInputElement)?.value.trim() || 'Tavern Dispatch';
      const body = (document.getElementById(bodyId) as HTMLTextAreaElement)?.value.trim() || '';

      const fullFormattedBody = `Sender: ${name}\nReturn Address: ${email}\n\n--------------------------------------------------\n${body}\n--------------------------------------------------\n(Dispatched via Ibem's Tavern Messenger Roost)`;

      // 1. Invoke mailto client
      const mailtoUrl = `mailto:${recipientEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(fullFormattedBody)}`;
      window.location.href = mailtoUrl;

      // 2. If on desktop modal, show the receipt view
      if (isDesktop) {
        const composerView = document.getElementById('raven-composer-view');
        const receiptView = document.getElementById('raven-receipt-view');
        const receiptSubject = document.getElementById('receipt-subject');
        const receiptFrom = document.getElementById('receipt-from');
        const receiptBody = document.getElementById('receipt-body');
        const receiptGmailLink = document.getElementById('receipt-gmail-link') as HTMLAnchorElement | null;

        if (composerView && receiptView) {
          composerView.classList.add('hidden');
          receiptView.classList.remove('hidden');

          if (receiptSubject) receiptSubject.textContent = subject;
          if (receiptFrom) receiptFrom.textContent = `${name} <${email}>`;
          if (receiptBody) receiptBody.textContent = body;

          if (receiptGmailLink) {
            receiptGmailLink.href = `https://mail.google.com/mail/?view=cm&fs=1&to=${recipientEmail}&su=${encodeURIComponent(subject)}&body=${encodeURIComponent(fullFormattedBody)}`;
          }

          // Setup copy formatted missive button
          const receiptCopyBtn = document.getElementById('receipt-copy-btn');
          if (receiptCopyBtn) {
            receiptCopyBtn.onclick = async () => {
              try {
                await navigator.clipboard.writeText(fullFormattedBody);
              } catch {
                const textarea = document.createElement('textarea');
                textarea.value = fullFormattedBody;
                document.body.appendChild(textarea);
                textarea.select();
                document.execCommand('copy');
                document.body.removeChild(textarea);
              }
              const oldText = receiptCopyBtn.textContent;
              receiptCopyBtn.textContent = 'Copied to Clipboard!';
              setTimeout(() => {
                receiptCopyBtn.textContent = oldText;
              }, 2500);
            };
          }

          // Reset button
          const resetBtn = document.getElementById('receipt-reset-btn');
          if (resetBtn) {
            resetBtn.onclick = () => {
              receiptView.classList.add('hidden');
              composerView.classList.remove('hidden');
              form.reset();
            };
          }
        }
      }
    });
  }

  handleMissiveSubmission(
    'desktop-raven-form',
    'desktop-sender-name',
    'desktop-sender-email',
    'desktop-missive-subject',
    'desktop-missive-body',
    true
  );

  handleMissiveSubmission(
    'mobile-raven-form',
    'mobile-sender-name',
    'mobile-sender-email',
    'mobile-missive-subject',
    'mobile-missive-body',
    false
  );

  // Mobile address copy button
  const mobileCopyBtn = document.getElementById('mobile-copy-email-btn');
  const mobileEmail = document.getElementById('mobile-email-address');
  const mobileStatus = document.getElementById('mobile-copy-status');

  if (mobileCopyBtn && mobileEmail && mobileStatus) {
    mobileCopyBtn.addEventListener('click', async () => {
      const email = mobileEmail.textContent?.trim() || recipientEmail;
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        const textarea = document.createElement('textarea');
        textarea.value = email;
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
      }
      mobileStatus.classList.remove('hidden');
      mobileCopyBtn.textContent = 'Copied!';
      setTimeout(() => {
        mobileStatus.classList.add('hidden');
        mobileCopyBtn.textContent = 'Copy Address';
      }, 2500);
    });
  }
</script>
