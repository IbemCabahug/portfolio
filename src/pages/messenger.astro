      scrollbar-width: thin;
      scrollbar-color: var(--brass, #a87a27) rgba(15, 10, 5, 0.85);
    }
  }

  .tavern-panel::-webkit-scrollbar,
  .tavern-scrollbar::-webkit-scrollbar,
  .tavern-panel *::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  .tavern-panel::-webkit-scrollbar-track,
  .tavern-scrollbar::-webkit-scrollbar-track,
  .tavern-panel *::-webkit-scrollbar-track {
    background: rgba(15, 10, 5, 0.85);
    border-radius: 4px;
