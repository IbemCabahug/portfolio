  }

  /* Minimum 44x44px touch target guarantee */
  .scene-object::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 44px;
    height: 44px;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .scene-object img {
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
    transition: filter 0.25s ease-out, transform 0.25s ease-out;
  }

  /* Sprite Hotspot Glow on Hover / Focus */
  .scene-object:is(:hover, :focus-visible) img {
    filter: brightness(1.16)
