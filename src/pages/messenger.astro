            </a>
          </div>
        </div>
      </article>

      <!-- 4. Roost Attendant Status -->
      {profile && (
        <div class="p-5 rounded-lg border border-[var(--brass)]/40 bg-[var(--wood-deep)]/60 text-[var(--parchment)] text-sm leading-relaxed text-center shadow-inner">
          <p class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1">
            <span class="inline-flex items-center gap-1.5 text-[var(--candle)] font-semibold">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block animate-pulse"></span>
              Availability: {profile.availability}
            </span>
            <span class="text-[var(--parchment)]/50">&bull;</span>
            <span>Stationed in: <strong class="text-[var(--parchment)]">{profile.location}</strong> (UTC+8)</span>
            <span class="text-[var(--parchment)]/50">&bull;</span>
            <span class="text-[var(--parchment)]/80">Open to Remote & Worldwide Roles</span>
          </p>
        </div>
      )}

      <!-- 5. Physical Return to Main Tavern -->
      <div class="pt-4 text-center">
        <a
          href="/tavern"
          class="inline-flex items-center justify-center min-h-[44px] px-8 py-3 border-2 border-[var(--brass)] bg-[var(--wood-deep)]/80 text-[var(--parchment)] font-bold text-base rounded-md hover:bg-[var(--parchment)] hover:text-[var(--wood-deep)] transition-all duration-200 focus-visible:outline-2 focus-visible:outline-[var(--candle)] shadow-lg hover:shadow-[0_0_15px_rgba(213,128,59,0.4)]"
        >
          &larr; Step back through the Archway to Main Tavern
        </a>
      </div>
    </section>
  </div>
</TavernLayout>

