    animation: modalPop 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .panel-close-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    min-width: 38px;
