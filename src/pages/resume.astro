---
import TavernLayout from '../layouts/TavernLayout.astro';
import { getCollection } from 'astro:content';

const profileEntries = await getCollection('profile');
const profile = profileEntries[0].data;

const resumeEntries = await getCollection('resume');
const resume = resumeEntries[0].data;

const pdfPath = '/Cabahug-Nhovem-Resume.pdf';
---

<TavernLayout
  title="Resume | Nhovem Cabahug"
  description="Nhovem Cabahug's Resume — IT & Administrative Support Intern, QA Testing, and AI-Assisted Development."
  location="resume"
>
  <style is:global>
    .print-only {
      display: none !important;
    }

    /* Inverse of .print-only: visible on screen, dropped on paper. Used for
       project links, where the screen shows a short label ("GitHub") and the
       printed page shows the full URL. A printed or downloaded PDF is often
       read on a phone with no hover and sometimes on paper entirely, where a
       bare "GitHub" gives the reader no way to reach the repo. */
    .screen-only {
      display: inline !important;
    }

    /* Force A4 with the same 12mm margins the PDF generator uses, so printing
       this page produces the document the download button produces.

       Without this the printed sheet takes whatever the browser or OS defaults
       to, which is US Letter on most machines. That is not a cosmetic
       difference: Letter is 216x279mm against A4's 210x297mm, so it is both
       narrower and 18mm SHORTER. At 12mm margins that leaves 964px of printable
       height against A4's 1032px, and the sheet currently renders 1036px — so
       printing on Letter silently reintroduces the three-page overflow that
       36478ab just fixed, while the downloaded PDF stays at two pages.

       Declaring the size here also pre-selects A4 in the browser's print
       dialog in Chrome and Edge, so the correct paper is chosen by default
       rather than requiring the reader to notice and change it. */
    @page {
      size: A4 portrait;
      margin: 12mm;
    }

    @media print {
      .print-only {
        display: inline !important;
      }
      .screen-only {
        display: none !important;
      }
      *, *::before, *::after {
        background: transparent !important;
        color: black !important;
        text-shadow: none !important;
        box-shadow: none !important;
      }
      html, body, .tavern-shell, .tavern-content {
        background: white !important;
        min-height: 0 !important;
      }
      nav, .no-print, .location-indicator {
        display: none !important;
      }
      a {
        text-decoration: none !important;
        color: black !important;
      }
      .entry, li {
        page-break-inside: avoid;
        break-inside: avoid;
      }
      .resume-sheet {
        border: none !important;
        box-shadow: none !important;
        border-radius: 0 !important;
        padding: 0 !important;
      }
      h1, h2, h3 {
        page-break-after: avoid;
        break-after: avoid;
      }

      /* FIT TO PAGE.
         Measured 2026-09-29: the sheet rendered 1524px tall against 1032px of
         A4 printable height (297mm less 12mm margins), i.e. 1.48 pages. Because
         .entry and li carry `break-inside: avoid`, a section that straddled the
         boundary was pushed whole onto the next sheet, producing three pages
         for what is a two-page document.

         The on-screen sheet is deliberately large and readable, so the
         compression here is print-only and leaves that untouched. Type drops
         from 14px to 11.5px with tighter leading, and the vertical rhythm is
         compressed, which brings the document comfortably inside two pages
         without orphaning a heading from its section.

         11.5px on paper is the usual lower bound for a dense technical resume
         and stays legible; going smaller would cost more in readability than it
         buys in pages. */
      .resume-sheet {
        font-size: 11.5px !important;
        line-height: 1.4 !important;
      }

      /* The sheet's own font-size does not cascade into children that carry an
         explicit Tailwind size utility. Measured in print media, the document
         still held a 36px name heading (text-3xl sm:text-4xl), seven 18px
         section headings (sm:text-lg), five 16px and fifty 14px elements, so
         setting font-size on .resume-sheet alone reclaimed only 94px of the
         492px overflow. Each size is scaled by roughly the same 0.82 ratio
         (11.5 / 14) so the hierarchy the screen version relies on survives onto
         paper instead of flattening to one size.

         Written as explicit sizes rather than a transform, so the text stays
         real, selectable text at a legible point size. */
      .resume-sheet h1 { font-size: 21px !important; }
      .resume-sheet h2 { font-size: 13px !important; }
      .resume-sheet h3 { font-size: 11.5px !important; }
      .resume-sheet p,
      .resume-sheet li,
      .resume-sheet dd,
      .resume-sheet .text-base,
      .resume-sheet .text-sm { font-size: 11.5px !important; }
      .resume-sheet .text-xs { font-size: 9.5px !important; }
      .resume-sheet a { font-size: 10px !important; }
      .resume-sheet header,
      .resume-sheet section {
        margin-bottom: 0.5rem !important;
      }
      .resume-sheet header {
        padding-bottom: 0.4rem !important;
      }
      /* Tailwind's space-y-1 sets margin-top on each <li>, not row-gap: the
         <ul> is display:block, so a row-gap override is silently ignored (it
         measured as applied while changing the height by 2px). Targeting the
         margin directly reclaims ~3px per bullet across the ~20 list items on
         the page. The project link line also sits closer to its title now that
         links stack beneath it, returning height that stacking consumed. */
      .resume-sheet ul > li + li { margin-top: 1px !important; }
      .resume-sheet .entry h3 + div { margin-top: 2px !important; }

      /* With the two project link lines now stacked under their titles, the
         sheet measures 1071px against A4's 1032px printable height. Selected
         Projects is the tallest block at 311px, and it carries the longest
         bullets on the page, so the paragraph leading is where reclaiming 40px
         is cheapest: 1.45 rather than 1.4 across roughly 40 wrapped lines.
         Slightly denser leading on paper is a far smaller cost than dropping
         content or shrinking type further. */
      .resume-sheet li,
      .resume-sheet p { line-height: 1.45 !important; }
      /* Sections are the natural page boundary, so allow one to break rather
         than shoving a whole block forward. The heading still travels with its
         first lines via the break-after: avoid rule above. */
      .resume-sheet section {
        break-inside: auto;
        page-break-inside: auto;
      }
      .resume-sheet .entry,
      .resume-sheet li {
        break-inside: avoid;
        page-break-inside: avoid;
      }
    }

    /* Resume document: clean white paper sheet styled for readability and print fidelity */
    .resume-sheet {
      background: #ffffff;
      color: #292524;
    }
  </style>

  <div class="max-w-4xl mx-auto py-6 sm:py-8 px-4">
    <nav class="no-print mb-6 flex justify-between items-center" aria-label="Breadcrumb">
      <a
        href="/tavern"
        class="inline-flex items-center gap-1.5 min-h-[44px] text-sm font-semibold text-[var(--candle)] underline hover:text-[var(--parchment)] focus-visible:outline-2 focus-visible:outline-[var(--brass)] focus-visible:outline-offset-2"
      >
        &larr; Return to Main Tavern
      </a>
      <span class="text-xs text-[var(--parchment)]/70 uppercase tracking-widest font-mono">
        Scribe's Ledger · Master Resume
      </span>
    </nav>

    <article class="resume-sheet border border-[#e7e5e4] border-t-4 border-t-[#c9a227] rounded-lg shadow-xl px-6 sm:px-10 py-8 sm:py-10 text-[14px] leading-relaxed">
      <!-- Header -->
      <header class="mb-6 border-b-2 border-[#1c1917] pb-4">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-[#1c1917] tracking-wider uppercase font-serif mb-2">
          {profile.name}
        </h1>
        
        <div class="flex flex-col sm:flex-row sm:flex-wrap items-start sm:items-center gap-x-2 gap-y-1 text-xs sm:text-sm text-[#44403c] font-medium">
          <a href={`tel:${resume.contact.phone}`} class="hover:text-[#92400e] hover:underline">{resume.contact.phone}</a>
          <span class="hidden sm:inline text-[#a8a29e]" aria-hidden="true">|</span>
          <a href={`mailto:${resume.contact.email}`} class="hover:text-[#92400e] hover:underline text-[#92400e]">{resume.contact.email}</a>
          <span class="hidden sm:inline text-[#a8a29e]" aria-hidden="true">|</span>
          <span>{resume.contact.location}</span>
        </div>

        <div class="flex flex-col sm:flex-row sm:flex-wrap items-start sm:items-center gap-x-2 gap-y-1 text-xs sm:text-sm text-[#44403c] font-medium mt-1">
          <span class="print-only">
            Portfolio: <a href={resume.contact.portfolioUrl} target="_blank" rel="noopener noreferrer" class="hover:text-[#78350f] text-[#92400e] underline">{resume.contact.portfolio}</a>
            <span class="text-[#a8a29e]" aria-hidden="true"> | </span>
          </span>
          <span>GitHub: <a href={resume.contact.githubUrl} target="_blank" rel="noopener noreferrer" class="hover:text-[#78350f] text-[#92400e] underline">{resume.contact.github}</a></span>
        </div>
      </header>

      <!-- Professional Summary -->
      <section class="mb-6">
        <h2 class="text-base sm:text-lg font-bold text-[#1c1917] tracking-wider uppercase font-serif mb-2 border-b border-[#d6d3d1] pb-1">
          Professional Summary
        </h2>
        <p class="text-sm leading-relaxed text-[#44403c] text-justify">
          {resume.summary}
        </p>
      </section>

      <!-- Core Skills -->
      <section class="mb-6">
        <h2 class="text-base sm:text-lg font-bold text-[#1c1917] tracking-wider uppercase font-serif mb-2 border-b border-[#d6d3d1] pb-1">
          Core Skills
        </h2>
        <div class="flex flex-col gap-1.5 text-sm">
          {resume.coreSkills.map((skill) => (
            <p class="entry leading-snug text-[#44403c]">
              <strong class="font-bold text-[#1c1917]">{skill.category}:</strong> {skill.items}
            </p>
          ))}
        </div>
      </section>

      <!-- Experience -->
      <section class="mb-6">
        <h2 class="text-base sm:text-lg font-bold text-[#1c1917] tracking-wider uppercase font-serif mb-3 border-b border-[#d6d3d1] pb-1">
          Experience
        </h2>
        <div class="flex flex-col gap-5">
          {resume.experience.map((exp) => (
            <article class="entry">
              <div class="flex flex-wrap items-baseline justify-between gap-x-3 mb-1">
                <h3 class="text-base font-bold text-[#1c1917]">
                  {exp.role} <span class="font-normal text-[#57534e]">— {exp.org}</span>
                </h3>
                <span class="text-xs sm:text-sm font-semibold text-[#78716c] whitespace-nowrap">
                  {exp.period} {exp.hours ? `(${exp.hours})` : ''}
                </span>
              </div>
              <ul class="list-disc pl-5 space-y-1.5 text-sm text-[#44403c] mt-1.5">
                {exp.bullets.map((bullet) => (
                  <li class="leading-relaxed">{bullet}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <!-- Selected Projects -->
      <section class="mb-6">
        <h2 class="text-base sm:text-lg font-bold text-[#1c1917] tracking-wider uppercase font-serif mb-3 border-b border-[#d6d3d1] pb-1">
          Selected Projects
        </h2>
        <div class="flex flex-col gap-4">
          {resume.projects.map((project) => (
            <article class="entry">
              <h3 class="text-base font-bold text-[#1c1917]">
                {project.name}
                {project.note && (
                  <span class="ml-1 text-xs font-semibold uppercase tracking-wider text-[#92400e]">
                    ({project.note})
                  </span>
                )}
              </h3>
              {/* Links sit on their own line, left-aligned under the title.

                  Previously the title and links shared one flex row with
                  justify-between, which put the links hard against the right
                  margin and made the two projects format differently depending
                  on how long the title was: Mimic's single link wrapped onto its
                  own line on screen while ArcaneTyper's two links stayed inline
                  beside the title. The same markup then behaved differently
                  again in print, where Mimic's link fitted back inline. One
                  project was formatted two ways depending on the output.

                  Stacking them removes the dependency on title length, so both
                  projects read identically on screen and on paper, and the
                  links start from the same left edge as the title. */}
              <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-0.5">
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs sm:text-sm font-semibold text-[#92400e] underline hover:text-[#78350f]"
                >
                  {project.urlLabel ?? project.url}
                </a>
                {project.extraLinks?.map((link) => (
                  <>
                    <span class="text-[#a8a29e] select-none" aria-hidden="true">·</span>
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-xs sm:text-sm font-semibold text-[#92400e] underline hover:text-[#78350f]"
                    >
                      <span class="screen-only">{link.label}</span>
                      <span class="print-only">{link.url}</span>
                    </a>
                  </>
                ))}
              </div>
              <ul class="list-disc pl-5 space-y-1 text-sm text-[#44403c] mt-1.5">
                {project.bullets.map((bullet) => (
                  <li class="leading-relaxed">{bullet}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <!-- Education -->
      <section class="mb-6">
        <h2 class="text-base sm:text-lg font-bold text-[#1c1917] tracking-wider uppercase font-serif mb-2 border-b border-[#d6d3d1] pb-1">
          Education
        </h2>
        <div class="flex flex-col gap-3">
          {resume.education.map((edu) => (
            <article class="entry">
              <h3 class="text-base font-bold text-[#1c1917]">{edu.credential}</h3>
              <div class="text-xs sm:text-sm text-[#57534e] font-medium mb-1">
                {edu.school} | {edu.period}
              </div>
              <div class="text-xs sm:text-sm text-[#44403c]">
                {edu.honors.join(' | ')}
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Training & Certifications -->
      <section class="mb-6">
        <h2 class="text-base sm:text-lg font-bold text-[#1c1917] tracking-wider uppercase font-serif mb-2 border-b border-[#d6d3d1] pb-1">
          Training & Certifications
        </h2>
        <div class="flex flex-col gap-2">
          {resume.training.map((train) => (
            <article class="entry text-sm text-[#44403c]">
              <strong class="font-bold text-[#1c1917]">{train.name}</strong> — {train.provider}, {train.hours}
            </article>
          ))}
        </div>
      </section>

      <!-- Languages -->
      <section>
        <h2 class="text-base sm:text-lg font-bold text-[#1c1917] tracking-wider uppercase font-serif mb-2 border-b border-[#d6d3d1] pb-1">
          Languages
        </h2>
        <p class="entry text-sm text-[#44403c]">
          {resume.languages.map((lang, idx) => (
            <>
              {idx > 0 ? ' | ' : ''}
              <span>{lang.name} ({lang.level})</span>
            </>
          ))}
        </p>
      </section>
    </article>

    <!-- Bottom Actions & Link to Portfolio Proof-of-Work -->
    <div class="no-print mt-12 pt-8 border-t border-[var(--brass)]/60 flex flex-col items-center gap-6">
      <div class="w-full p-5 bg-[#1e1208]/90 border border-[var(--brass)]/60 rounded text-sm text-[var(--parchment)]/90 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-xs">
        <div>
          <strong class="font-bold text-[var(--candle)] block sm:inline">Seeking Technical Proof of Work?</strong>
          <span class="sm:ml-1">Explore system architecture breakdowns, live deployed applications, and source code.</span>
        </div>
        <a
          href="/simple"
          class="inline-flex items-center gap-1.5 font-bold text-[var(--candle)] hover:text-[var(--parchment)] underline flex-shrink-0 min-h-[44px]"
        >
          <span>View Technical Showcase & Proof of Work</span> &rarr;
        </a>
      </div>

      <div class="flex flex-wrap justify-center w-full items-center gap-3">
        <a
          id="download-pdf"
          href={pdfPath}
          download="Cabahug-Nhovem-Resume.pdf"
          class="inline-flex items-center justify-center min-h-[44px] px-6 py-2 border border-[var(--brass)] hover:border-[var(--candle)] rounded transition-colors duration-200 uppercase tracking-widest text-sm text-[var(--candle)]"
        >
          Download PDF
        </a>
        <button
          type="button"
          id="print-resume"
          class="inline-flex items-center justify-center min-h-[44px] px-6 py-2 border border-[var(--brass)] hover:border-[var(--candle)] rounded transition-colors duration-200 uppercase tracking-widest text-sm text-[var(--candle)] cursor-pointer"
        >
          Print / Save this View
        </button>
      </div>
    </div>
  </div>

  <script>
    import { recordMilestone } from '../store/questlog';
    recordMilestone('resume');
  </script>

  <script is:inline>
    (() => {
      const printButton = document.getElementById('print-resume');
      printButton && printButton.addEventListener('click', () => window.print());
    })();
  </script>
</TavernLayout>
