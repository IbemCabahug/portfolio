---
import TavernLayout from '../layouts/TavernLayout.astro';
import { getCollection } from 'astro:content';

const profileEntries = await getCollection('profile');
const profile = profileEntries[0].data;

const resumeEntries = await getCollection('resume');
const resume = resumeEntries[0].data;

const pdfPath = '/Cabahug-Nhovem-Resume.pdf';
---

<TavernLayout
  title="Resume | Nhovem Cabahug"
  description="Nhovem Cabahug's Resume — IT & Administrative Support Intern, QA Testing, and AI-Assisted Development."
  location="resume"
>
  <style is:global>
    .print-only {
      display: none !important;
    }

    @media print {
      .print-only {
        display: inline !important;
      }
      *, *::before, *::after {
        background: transparent !important;
        color: black !important;
        text-shadow: none !important;
        box-shadow: none !important;
      }
      html, body, .tavern-shell, .tavern-content {
        background: white !important;
        min-height: 0 !important;
      }
      nav, .no-print, .location-indicator {
        display: none !important;
      }
      a {
        text-decoration: none !important;
        color: black !important;
      }
      .entry, li {
        page-break-inside: avoid;
        break-inside: avoid;
      }
      .resume-sheet {
        border: none !important;
        box-shadow: none !important;
        border-radius: 0 !important;
        padding: 0 !important;
      }
      h1, h2, h3 {
        page-break-after: avoid;
        break-after: avoid;
      }
    }

    /* Resume document: clean white paper sheet styled for readability and print fidelity */
    .resume-sheet {
      background: #ffffff;
      color: #292524;
    }
  </style>

  <div class="max-w-4xl mx-auto py-6 sm:py-8 px-4">
    <nav class="no-print mb-6 flex justify-between items-center" aria-label="Breadcrumb">
      <a
        href="/tavern"
        class="inline-flex items-center gap-1.5 min-h-[44px] text-sm font-semibold text-[var(--candle)] underline hover:text-[var(--parchment)] focus-visible:outline-2 focus-visible:outline-[var(--brass)] focus-visible:outline-offset-2"
      >
        &larr; Return to Main Tavern
      </a>
      <span class="text-xs text-[var(--parchment)]/70 uppercase tracking-widest font-mono">
        Scribe's Ledger · Master Resume
      </span>
    </nav>

    <article class="resume-sheet border border-[#e7e5e4] border-t-4 border-t-[#c9a227] rounded-lg shadow-xl px-6 sm:px-10 py-8 sm:py-10 text-[14px] leading-relaxed">
      <!-- Header -->
      <header class="mb-6 border-b-2 border-[#1c1917] pb-4">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-[#1c1917] tracking-wider uppercase font-serif mb-2">
          {profile.name}
        </h1>
        
        <div class="flex flex-col sm:flex-row sm:flex-wrap items-start sm:items-center gap-x-2 gap-y-1 text-xs sm:text-sm text-[#44403c] font-medium">
          <a href={`tel:${resume.contact.phone}`} class="hover:text-[#92400e] hover:underline">{resume.contact.phone}</a>
          <span class="hidden sm:inline text-[#a8a29e]" aria-hidden="true">|</span>
          <a href={`mailto:${resume.contact.email}`} class="hover:text-[#92400e] hover:underline text-[#92400e]">{resume.contact.email}</a>
          <span class="hidden sm:inline text-[#a8a29e]" aria-hidden="true">|</span>
          <span>{resume.contact.location}</span>
        </div>

        <div class="flex flex-col sm:flex-row sm:flex-wrap items-start sm:items-center gap-x-2 gap-y-1 text-xs sm:text-sm text-[#44403c] font-medium mt-1">
          <span class="print-only">
            Portfolio: <a href={resume.contact.portfolioUrl} target="_blank" rel="noopener noreferrer" class="hover:text-[#78350f] text-[#92400e] underline">{resume.contact.portfolio}</a>
            <span class="text-[#a8a29e]" aria-hidden="true"> | </span>
          </span>
          <span>GitHub: <a href={resume.contact.githubUrl} target="_blank" rel="noopener noreferrer" class="hover:text-[#78350f] text-[#92400e] underline">{resume.contact.github}</a></span>
        </div>
      </header>

      <!-- Professional Summary -->
      <section class="mb-6">
        <h2 class="text-base sm:text-lg font-bold text-[#1c1917] tracking-wider uppercase font-serif mb-2 border-b border-[#d6d3d1] pb-1">
          Professional Summary
        </h2>
        <p class="text-sm leading-relaxed text-[#44403c] text-justify">
          {resume.summary}
        </p>
      </section>

      <!-- Core Skills -->
      <section class="mb-6">
        <h2 class="text-base sm:text-lg font-bold text-[#1c1917] tracking-wider uppercase font-serif mb-2 border-b border-[#d6d3d1] pb-1">
          Core Skills
        </h2>
        <div class="flex flex-col gap-1.5 text-sm">
          {resume.coreSkills.map((skill) => (
            <p class="entry leading-snug text-[#44403c]">
              <strong class="font-bold text-[#1c1917]">{skill.category}:</strong> {skill.items}
            </p>
          ))}
        </div>
      </section>

      <!-- Experience -->
      <section class="mb-6">
        <h2 class="text-base sm:text-lg font-bold text-[#1c1917] tracking-wider uppercase font-serif mb-3 border-b border-[#d6d3d1] pb-1">
          Experience
        </h2>
        <div class="flex flex-col gap-5">
          {resume.experience.map((exp) => (
            <article class="entry">
              <div class="flex flex-wrap items-baseline justify-between gap-x-3 mb-1">
                <h3 class="text-base font-bold text-[#1c1917]">
                  {exp.role} <span class="font-normal text-[#57534e]">— {exp.org}</span>
                </h3>
                <span class="text-xs sm:text-sm font-semibold text-[#78716c] whitespace-nowrap">
                  {exp.period} {exp.hours ? `(${exp.hours})` : ''}
                </span>
              </div>
              <ul class="list-disc pl-5 space-y-1.5 text-sm text-[#44403c] mt-1.5">
                {exp.bullets.map((bullet) => (
                  <li class="leading-relaxed">{bullet}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <!-- Selected Projects -->
      <section class="mb-6">
        <h2 class="text-base sm:text-lg font-bold text-[#1c1917] tracking-wider uppercase font-serif mb-3 border-b border-[#d6d3d1] pb-1">
          Selected Projects
        </h2>
        <div class="flex flex-col gap-4">
          {resume.projects.map((project) => (
            <article class="entry">
              <div class="flex flex-wrap items-baseline justify-between gap-x-3">
                <h3 class="text-base font-bold text-[#1c1917]">
                  {project.name}
                  {project.note && (
                    <span class="ml-1 text-xs font-semibold uppercase tracking-wider text-[#92400e]">
                      ({project.note})
                    </span>
                  )}
                </h3>
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs sm:text-sm font-semibold text-[#92400e] underline hover:text-[#78350f]"
                >
                  {project.urlLabel ?? project.url}
                </a>
              </div>
              <ul class="list-disc pl-5 space-y-1 text-sm text-[#44403c] mt-1.5">
                {project.bullets.map((bullet) => (
                  <li class="leading-relaxed">{bullet}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <!-- Education -->
      <section class="mb-6">
        <h2 class="text-base sm:text-lg font-bold text-[#1c1917] tracking-wider uppercase font-serif mb-2 border-b border-[#d6d3d1] pb-1">
          Education
        </h2>
        <div class="flex flex-col gap-3">
          {resume.education.map((edu) => (
            <article class="entry">
              <h3 class="text-base font-bold text-[#1c1917]">{edu.credential}</h3>
              <div class="text-xs sm:text-sm text-[#57534e] font-medium mb-1">
                {edu.school} | {edu.period}
              </div>
              <div class="text-xs sm:text-sm text-[#44403c]">
                {edu.honors.join(' | ')}
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Training & Certifications -->
      <section class="mb-6">
        <h2 class="text-base sm:text-lg font-bold text-[#1c1917] tracking-wider uppercase font-serif mb-2 border-b border-[#d6d3d1] pb-1">
          Training & Certifications
        </h2>
        <div class="flex flex-col gap-2">
          {resume.training.map((train) => (
            <article class="entry text-sm text-[#44403c]">
              <strong class="font-bold text-[#1c1917]">{train.name}</strong> — {train.provider}, {train.hours}
            </article>
          ))}
        </div>
      </section>

      <!-- Languages -->
      <section>
        <h2 class="text-base sm:text-lg font-bold text-[#1c1917] tracking-wider uppercase font-serif mb-2 border-b border-[#d6d3d1] pb-1">
          Languages
        </h2>
        <p class="entry text-sm text-[#44403c]">
          {resume.languages.map((lang, idx) => (
            <>
              {idx > 0 ? ' | ' : ''}
              <span>{lang.name} ({lang.level})</span>
            </>
          ))}
        </p>
      </section>
    </article>

    <!-- Bottom Actions & Link to Portfolio Proof-of-Work -->
    <div class="no-print mt-12 pt-8 border-t border-[var(--brass)]/60 flex flex-col items-center gap-6">
      <div class="w-full p-5 bg-[#1e1208]/90 border border-[var(--brass)]/60 rounded text-sm text-[var(--parchment)]/90 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-xs">
        <div>
          <strong class="font-bold text-[var(--candle)] block sm:inline">Seeking Technical Proof of Work?</strong>
          <span class="sm:ml-1">Explore system architecture breakdowns, live deployed applications, and source code.</span>
        </div>
        <a
          href="/simple"
          class="inline-flex items-center gap-1.5 font-bold text-[var(--candle)] hover:text-[var(--parchment)] underline flex-shrink-0 min-h-[44px]"
        >
          <span>View Technical Showcase & Proof of Work</span> &rarr;
        </a>
      </div>

      <div class="flex flex-wrap justify-center w-full items-center gap-3">
        <a
          id="download-pdf"
          href={pdfPath}
          download="Cabahug-Nhovem-Resume.pdf"
          class="inline-flex items-center justify-center min-h-[44px] px-6 py-2 border border-[var(--brass)] hover:border-[var(--candle)] rounded transition-colors duration-200 uppercase tracking-widest text-sm text-[var(--candle)]"
        >
          Download PDF
        </a>
        <button
          type="button"
          id="print-resume"
          class="inline-flex items-center justify-center min-h-[44px] px-6 py-2 border border-[var(--brass)] hover:border-[var(--candle)] rounded transition-colors duration-200 uppercase tracking-widest text-sm text-[var(--candle)] cursor-pointer"
        >
          Print / Save this View
        </button>
      </div>
    </div>
  </div>

  <script>
    import { recordMilestone } from '../store/questlog';
    recordMilestone('resume');
  </script>

  <script is:inline>
    (() => {
      const printButton = document.getElementById('print-resume');
      printButton && printButton.addEventListener('click', () => window.print());
    })();
  </script>
</TavernLayout>
