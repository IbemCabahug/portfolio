---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Nhovem Cabahug - Web Developer" description="I build accessible, fast web applications with TypeScript and React." hideDefaultNav={true}>
  <div class="min-h-screen bg-[var(--wood-deep)] text-[var(--parchment)]">
    <div class="max-w-2xl mx-auto py-16 px-4">
      <h1 class="text-4xl font-bold mb-4 text-[var(--candle)]">Nhovem Cabahug</h1>
      <p class="text-lg mb-6">
        I build accessible, fast web applications with TypeScript and React. Recently shipped features and bug fixes for a biometric tracking system in production.
      </p>

      <div class="flex flex-wrap gap-4 mb-8 text-lg font-semibold">
        <a href="mailto:ncabahug223@gmail.com" class="underline hover:text-[var(--candle)] focus-visible:outline-2 focus-visible:outline-[var(--candle)]">ncabahug223@gmail.com</a>
        <a href="https://github.com/IbemCabahug" class="underline hover:text-[var(--candle)] focus-visible:outline-2 focus-visible:outline-[var(--candle)]">GitHub</a>
      </div>

      <div class="flex flex-col gap-4">
        <a href="/simple" class="flex items-center justify-center min-h-[44px] p-4 border-2 border-[var(--brass)] bg-[var(--wood-deep)] text-center font-semibold hover:bg-[var(--parchment)] hover:text-[var(--ink)] focus-visible:outline-2 focus-visible:outline-[var(--candle)]">Simple portfolio mode</a>
        <a href="/resume" class="flex items-center justify-center min-h-[44px] p-4 border-2 border-[var(--brass)] bg-[var(--wood-deep)] text-center font-semibold hover:bg-[var(--parchment)] hover:text-[var(--ink)] focus-visible:outline-2 focus-visible:outline-[var(--candle)]">Résumé</a>
        <a href="/tavern" class="flex items-center justify-center min-h-[44px] p-4 border-2 border-[var(--brass)] bg-[var(--wood-deep)] text-center font-semibold hover:bg-[var(--parchment)] hover:text-[var(--ink)] focus-visible:outline-2 focus-visible:outline-[var(--candle)]">Enter Ibem's Tavern</a>
      </div>
    </div>
  </div>
</BaseLayout>
