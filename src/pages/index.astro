---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Nhovem Cabahug — Web Developer & Software Engineer"
  description="I build accessible, fast web applications with TypeScript. I develop with AI assistance, and I review, test and make the architectural decisions myself."
  hideDefaultNav={true}
>
  <main id="main-content" class="min-h-screen bg-[var(--wood-deep)] text-[var(--parchment)]">
    {/* Atmospheric Tavern Threshold Hero */}
    <div class="relative overflow-hidden border-b-2 border-[var(--brass)] bg-[#140c05]">
      {/* Background Ambience Layer */}
      <div
        class="absolute inset-0 opacity-20 bg-cover bg-center pointer-events-none mix-blend-luminosity"
        style="background-image: url('/art/tavern-entrance-closed-1280.webp');"
        aria-hidden="true"
      ></div>
      <div class="absolute inset-0 bg-gradient-to-b from-[#140c05]/80 via-[#1e1208]/90 to-[var(--wood-deep)] pointer-events-none" aria-hidden="true"></div>

      <div class="relative max-w-5xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
        <header class="max-w-3xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 mb-4 rounded border border-[var(--brass)] bg-[var(--wood-deep)]/90 text-xs font-semibold tracking-wider uppercase text-[var(--candle)]">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
            Tavern Entrance · Available for Hire · Cebu, PH & Remote
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-[var(--candle)] mb-4 drop-shadow-sm font-serif">
            Nhovem Cabahug
          </h1>

          <p class="text-xl sm:text-2xl font-medium text-[var(--parchment)] mb-6 leading-snug">
            Web Developer & Software Engineer
          </p>

          <p class="text-base sm:text-lg text-[var(--parchment)]/90 leading-relaxed mb-8 max-w-2xl">
            I build accessible, fast web applications with TypeScript. I develop with AI assistance, and I review, test and make the architectural decisions myself. Recently shipped features and bug fixes for a biometric tracking system in production.
          </p>

          {/* Quick Direct Contacts */}
          <div class="flex flex-wrap items-center gap-4 text-sm font-medium">
            <a
              href="mailto:ncabahug223@gmail.com"
              class="inline-flex items-center gap-2 min-h-[44px] px-4 py-2 bg-[var(--stone)] text-[var(--candle)] border border-[var(--brass)] rounded hover:bg-[var(--brass)] hover:text-[var(--wood-deep)] transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)]"
              aria-label="Send a Raven — Email ncabahug223@gmail.com"
            >
              <span aria-hidden="true">✉</span> Send a Raven (Email)
            </a>
            <a
              href="https://github.com/IbemCabahug"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 min-h-[44px] px-4 py-2 bg-[var(--stone)] text-[var(--candle)] border border-[var(--brass)] rounded hover:bg-[var(--brass)] hover:text-[var(--wood-deep)] transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)]"
              aria-label="Inspect the Spellbook — GitHub Profile"
            >
              <span aria-hidden="true">⌨</span> Inspect GitHub Profile
            </a>
            <a
              href="/resume"
              class="inline-flex items-center gap-2 min-h-[44px] px-4 py-2 bg-transparent text-[var(--parchment)] border border-[var(--brass)]/80 rounded hover:bg-[var(--parchment)] hover:text-[var(--wood-deep)] transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)]"
            >
              <span>📄</span> View Full Résumé
            </a>
          </div>
        </header>
      </div>
    </div>

    {/* Dual-Track Experience Navigator */}
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
      <section aria-labelledby="paths-heading" class="mb-14">
        <h2 id="paths-heading" class="text-xs uppercase tracking-widest text-[var(--candle)] font-bold mb-4">
          Choose Your Path · Dual Experience Architecture
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {/* Path 1: Immersive Tavern */}
          <div class="bg-[#24170d] border-2 border-[var(--brass)] rounded p-6 flex flex-col justify-between shadow-lg">
            <div>
              <div class="text-2xl mb-2" aria-hidden="true">🍺</div>
              <h3 class="text-xl font-bold text-[var(--candle)] mb-2 font-serif">
                Ibem's Tavern
              </h3>
              <p class="text-sm text-[var(--parchment)]/90 leading-relaxed mb-4">
                The interactive, visual tavern experience. Explore the notice board, examine the shield wall of skills, and consult the Tavern Regular.
              </p>
            </div>
            <a
              href="/tavern"
              class="inline-flex items-center justify-center min-h-[44px] px-4 py-2 bg-[var(--brass)] text-[var(--wood-deep)] font-bold text-sm rounded hover:bg-[var(--candle)] transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)]"
            >
              Enter Ibem's Tavern →
            </a>
          </div>

          {/* Path 2: Simple Portfolio Mode */}
          <div class="bg-[#24170d] border-2 border-[var(--brass)] rounded p-6 flex flex-col justify-between shadow-lg">
            <div>
              <div class="text-2xl mb-2" aria-hidden="true">⚡</div>
              <h3 class="text-xl font-bold text-[var(--candle)] mb-2 font-serif">
                Simple Mode
              </h3>
              <p class="text-sm text-[var(--parchment)]/90 leading-relaxed mb-4">
                Fast-track recruiter view. Zero runtime JavaScript, clean linear typography, instant loading, and streamlined scannability.
              </p>
            </div>
            <a
              href="/simple"
              class="inline-flex items-center justify-center min-h-[44px] px-4 py-2 bg-transparent text-[var(--parchment)] border-2 border-[var(--brass)] font-bold text-sm rounded hover:bg-[var(--parchment)] hover:text-[var(--wood-deep)] transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)]"
            >
              Open Simple Mode →
            </a>
          </div>

          {/* Path 3: Quest Board */}
          <div class="bg-[#24170d] border-2 border-[var(--brass)] rounded p-6 flex flex-col justify-between shadow-lg">
            <div>
              <div class="text-2xl mb-2" aria-hidden="true">📜</div>
              <h3 class="text-xl font-bold text-[var(--candle)] mb-2 font-serif">
                The Quest Board
              </h3>
              <p class="text-sm text-[var(--parchment)]/90 leading-relaxed mb-4">
                Deep architectural case studies for Arcane Typer, BITS biometric production OJT, and Mimic API mocking tool.
              </p>
            </div>
            <a
              href="/quests"
              class="inline-flex items-center justify-center min-h-[44px] px-4 py-2 bg-transparent text-[var(--parchment)] border-2 border-[var(--brass)] font-bold text-sm rounded hover:bg-[var(--parchment)] hover:text-[var(--wood-deep)] transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)]"
            >
              View All Quests →
            </a>
          </div>
        </div>
      </section>

      {/* Flagship Projects Section */}
      <section aria-labelledby="featured-quests-heading" class="mb-14">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-6 pb-2 border-b border-[var(--brass)]/30 gap-2">
          <div>
            <h2 id="featured-quests-heading" class="text-2xl sm:text-3xl font-bold text-[var(--candle)] font-serif">
              Flagship Quests & Systems
            </h2>
            <p class="text-sm text-[var(--parchment)]/80 mt-1">
              Curated evidence of production contributions and independently architected web applications.
            </p>
          </div>
          <a
            href="/quests"
            class="text-sm font-semibold text-[var(--candle)] hover:underline inline-flex items-center min-h-[44px]"
          >
            Inspect Quest Board ({featuredProjects.length}) →
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {featuredProjects.map((project, idx) => {
            const rotations = ['-rotate-1', 'rotate-1', '-rotate-0.5'];
            const rotationClass = rotations[idx % rotations.length];
            const isShipped = project.data.status === 'Shipped';

            return (
              <article
                class={`relative bg-[#f5ecdc] text-[var(--ink)] p-6 rounded-sm border-2 border-[var(--brass)] shadow-xl flex flex-col justify-between transition-all duration-300 ${rotationClass} hover:rotate-0 hover:scale-[1.02] focus-within:ring-2 focus-within:ring-[var(--brass)]`}
                style="background-image: radial-gradient(#dfcfb5 1px, transparent 1px); background-size: 16px 16px;"
              >
                {/* Iron Tack */}
                <div
                  class="absolute -top-3 left-1/2 -translate-x-1/2 w-4 h-4 rounded-full bg-stone-800 border border-stone-500 shadow flex items-center justify-center z-20"
                  aria-hidden="true"
                >
                  <div class="w-1.5 h-1.5 rounded-full bg-stone-400"></div>
                </div>

                <div>
                  <div class="text-center pb-2 mb-3 border-b-2 border-[var(--brass)]/30">
                    <span class="text-[10px] uppercase font-extrabold tracking-widest text-[#6d4c1d] block">
                      {isShipped ? '📜 COMPLETED BOUNTY' : '⚔️ ACTIVE EXPEDITION'}
                    </span>
                    <span class="text-xs font-semibold text-[var(--ink)]/80 italic block">
                      {project.data.role}
                    </span>
                  </div>

                  {/* Project Emblem with Stamp */}
                  <div class="relative w-24 h-24 mx-auto my-2 rounded-xl border-2 border-[var(--brass)] bg-[#1e1208] shadow-inner p-1 flex items-center justify-center overflow-hidden">
                    {project.data.thumbnail ? (
                      <img
                        src={project.data.thumbnail}
                        alt={`${project.data.title} emblem`}
                        class="w-full h-full object-contain rounded-lg"
                        loading="lazy"
                      />
                    ) : (
                      <div class="text-2xl text-[var(--candle)] font-serif">⚔️</div>
                    )}

                    {/* Diagonal Stamp */}
                    {isShipped ? (
                      <div
                        class="absolute inset-0 flex items-center justify-center pointer-events-none select-none z-20"
                        aria-hidden="true"
                      >
                        <div
                          class="transform -rotate-12 border-3 border-red-700 text-red-800 bg-red-100/85 backdrop-blur-[1px] font-black text-xs px-2 py-0.5 uppercase tracking-widest shadow-md rounded-sm border-double border-red-800"
                          style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; letter-spacing: 0.15em;"
                        >
                          ★ SHIPPED ★
                        </div>
                      </div>
                    ) : (
                      <div
                        class="absolute inset-0 flex items-center justify-center pointer-events-none select-none z-20"
                        aria-hidden="true"
                      >
                        <div
                          class="transform rotate-12 border-3 border-amber-900 text-amber-950 bg-amber-100/90 backdrop-blur-[1px] font-black text-[10px] px-1.5 py-0.5 uppercase tracking-widest shadow-md rounded-sm border-dashed border-amber-900"
                          style="font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; letter-spacing: 0.12em;"
                        >
                          ⚔ IN PROGRESS ⚔
                        </div>
                      </div>
                    )}
                  </div>

                  <span class="sr-only">Status: {project.data.status}</span>

                  <h3 class="text-lg font-bold mb-2 text-[var(--ink)] text-center leading-snug font-serif">
                    <a
                      href={`/quests/${project.data.slug}`}
                      class="underline hover:text-[var(--ember)] focus-visible:outline-2 focus-visible:outline-[var(--brass)] focus-visible:outline-offset-2"
                    >
                      {project.data.title}
                    </a>
                  </h3>

                  <p class="text-sm text-[var(--ink)]/90 mb-4 leading-relaxed line-clamp-3">
                    {project.data.summary}
                  </p>
                </div>

                <div>
                  <div class="mb-4 pt-3 border-t border-[var(--brass)]/30">
                    <ul class="flex flex-wrap gap-1" aria-label="Key technologies">
                      {project.data.stack.slice(0, 4).map((tech: string) => (
                        <li class="text-xs px-2 py-0.5 border border-[var(--brass)] bg-[#ebe1ce] font-semibold rounded-sm">
                          {tech}
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="flex flex-col gap-2">
                    <a
                      href={`/quests/${project.data.slug}`}
                      class="inline-flex items-center justify-center min-h-[44px] px-3 bg-[var(--wood-deep)] text-[var(--candle)] font-bold text-xs rounded hover:bg-black transition-colors focus-visible:outline-2 focus-visible:outline-[var(--brass)] focus-visible:outline-offset-2"
                    >
                      Inspect Case Study Dossier →
                    </a>
                    {project.data.liveUrl && (
                      <a
                        href={project.data.liveUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center justify-center min-h-[44px] px-3 border border-[var(--wood-deep)] text-[var(--wood-deep)] font-semibold text-xs rounded hover:bg-[var(--wood-deep)] hover:text-[var(--parchment)] transition-colors focus-visible:outline-2 focus-visible:outline-[var(--brass)] focus-visible:outline-offset-2"
                      >
                        Play / View Live Demo ↗
                      </a>
                    )}
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </section>

      {/* Navigation Ledger & Footer */}
      <footer class="mt-16 pt-8 border-t-2 border-[var(--brass)] text-center text-sm text-[var(--parchment)]/70">
        <nav aria-label="Tavern Navigation" class="mb-6">
          <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2">
            <li><a href="/" class="hover:text-[var(--candle)] underline min-h-[44px] inline-flex items-center">Tavern Entrance</a></li>
            <li><a href="/tavern" class="hover:text-[var(--candle)] underline min-h-[44px] inline-flex items-center">Main Tavern</a></li>
            <li><a href="/quests" class="hover:text-[var(--candle)] underline min-h-[44px] inline-flex items-center">Quest Board</a></li>
            <li><a href="/tavern/skills" class="hover:text-[var(--candle)] underline min-h-[44px] inline-flex items-center">Adventurer's Badge</a></li>
            <li><a href="/tavern/npc" class="hover:text-[var(--candle)] underline min-h-[44px] inline-flex items-center">Tavern Regular</a></li>
            <li><a href="/messenger" class="hover:text-[var(--candle)] underline min-h-[44px] inline-flex items-center">Messenger's Corner</a></li>
            <li><a href="/resume" class="hover:text-[var(--candle)] underline min-h-[44px] inline-flex items-center">Résumé</a></li>
            <li><a href="/about" class="hover:text-[var(--candle)] underline min-h-[44px] inline-flex items-center">About</a></li>
            <li><a href="/simple" class="hover:text-[var(--candle)] underline min-h-[44px] inline-flex items-center">Simple Mode</a></li>
          </ul>
        </nav>
        <p class="max-w-xl mx-auto leading-relaxed text-xs">
          Environment art generated with AI and hand-edited by Nhovem Cabahug; all code, copy, tests, and architectural design by Nhovem Cabahug.
        </p>
      </footer>
    </div>
  </main>
</BaseLayout>
