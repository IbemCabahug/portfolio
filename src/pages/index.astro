---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ThematicIcon from '../components/icons/ThematicIcon.astro';
import InteractiveAvatar from '../components/InteractiveAvatar.astro';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Nhovem Cabahug — Web Developer & App Developer"
  description="I build accessible, fast web applications with TypeScript. I develop with AI assistance, and I review, test and make the architectural decisions myself."
  hideDefaultNav={true}
>
  <main id="main-content" class="min-h-screen bg-[var(--wood-deep)] text-[var(--parchment)]">
    {/* Atmospheric Tavern Threshold Hero */}
    <div class="relative overflow-hidden border-b-2 border-[var(--brass)] bg-[#140c05]">
      {/* Background Ambience Layer */}
      <div
        class="absolute inset-0 opacity-20 bg-cover bg-center pointer-events-none mix-blend-luminosity"
        style="background-image: url('/art/tavern-entrance-closed-1280.webp');"
        aria-hidden="true"
      ></div>
      <div class="absolute inset-0 bg-gradient-to-b from-[#140c05]/80 via-[#1e1208]/90 to-[var(--wood-deep)] pointer-events-none" aria-hidden="true"></div>

      <div class="relative max-w-5xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
        <div class="flex flex-col lg:flex-row items-center lg:items-start justify-between gap-8 lg:gap-12">
          <header class="flex-1 max-w-2xl text-center lg:text-left">
            <div class="inline-flex items-center gap-2 px-3 py-1 mb-4 rounded border border-[var(--brass)] bg-[var(--wood-deep)]/90 text-xs font-semibold tracking-wider uppercase text-[var(--candle)]">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
              Portfolio Entrance (Home) · Available for Hire · Cebu, PH & Remote
            </div>

            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-[var(--candle)] mb-4 drop-shadow-sm font-serif">
              Nhovem Cabahug
            </h1>

            <p class="text-xl sm:text-2xl font-medium text-[var(--parchment)] mb-6 leading-snug">
              Web Developer & App Developer
            </p>

            <p class="text-base sm:text-lg text-[var(--parchment)]/90 leading-relaxed mb-8 max-w-2xl">
              I build accessible, fast web applications with TypeScript. I develop with AI assistance, and I review, test and make the architectural decisions myself. Recently shipped features and bug fixes for a biometric tracking system in production.
            </p>

            {/* Quick Direct Contacts */}
            <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3 text-sm font-medium">
              <a
                href="/messenger?compose=true"
                class="inline-flex items-center gap-2 min-h-[44px] px-4 py-2 bg-[var(--stone)] text-[var(--candle)] border border-[var(--brass)] rounded hover:bg-[var(--brass)] hover:text-[var(--wood-deep)] transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)]"
                aria-label="Send a Raven — Dispatch missive via Messenger's Roost (Contact)"
              >
                <ThematicIcon name="raven" class="w-4 h-4 text-[var(--candle)]" />
                <span>Send a Raven <span class="text-xs opacity-80 font-normal font-sans">(Contact)</span></span>
              </a>

              {/* 1-Click Plaintext Email Copy Pill */}
              <div class="inline-flex items-center rounded bg-black/40 border border-[var(--brass)]/60 text-xs font-mono overflow-hidden min-h-[44px] shadow-sm">
                <a
                  href="mailto:ncabahug223@gmail.com"
                  class="px-3 py-2 text-[var(--candle)] hover:text-white transition-colors flex items-center gap-1.5 focus-visible:outline-2 focus-visible:outline-[var(--candle)]"
                  title="Direct mailto dispatch"
                >
                  <span class="text-[var(--ember)]">✉</span>
                  <span>ncabahug223@gmail.com</span>
                </a>
                <button
                  type="button"
                  id="hero-copy-email-btn"
                  class="px-2.5 py-2 bg-[var(--wood-deep)] hover:bg-[var(--stone)] text-[var(--candle)] border-l border-[var(--brass)]/50 transition-colors cursor-pointer flex items-center gap-1 font-sans text-xs font-semibold focus-visible:outline-2 focus-visible:outline-[var(--candle)]"
                  title="Copy email address to clipboard"
                  aria-label="Copy email address to clipboard"
                >
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                  </svg>
                  <span id="hero-copy-status">Copy</span>
                </button>
              </div>

              <a
                href="https://github.com/IbemCabahug"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 min-h-[44px] px-4 py-2 bg-[var(--stone)] text-[var(--candle)] border border-[var(--brass)] rounded hover:bg-[var(--brass)] hover:text-[var(--wood-deep)] transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)]"
                aria-label="Inspect GitHub Profile"
              >
                <ThematicIcon name="terminal" class="w-4 h-4 text-[var(--candle)]" />
                <span>GitHub</span>
              </a>
              <a
                href="/resume"
                class="inline-flex items-center gap-2 min-h-[44px] px-4 py-2 bg-transparent text-[var(--parchment)] border border-[var(--brass)]/80 rounded hover:bg-[var(--parchment)] hover:text-[var(--wood-deep)] transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)]"
              >
                <ThematicIcon name="resume" class="w-4 h-4 text-[var(--candle)]" />
                <span>Resume</span>
              </a>
            </div>
          </header>

          {/* Right Column: The Interactive Adventurer Guild Medallion */}
          <InteractiveAvatar />
        </div>
      </div>
    </div>

    {/* Dual-Track Experience Navigator */}
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
      <section aria-labelledby="paths-heading" class="mb-14">
        <h2 id="paths-heading" class="text-xs uppercase tracking-widest text-[var(--candle)] font-bold mb-4">
          Choose Your Path · Dual Experience Architecture
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {/* Path 1: Immersive Tavern */}
          <div class="bg-[#24170d] border-2 border-[var(--brass)] rounded p-6 flex flex-col justify-between shadow-lg">
            <div>
              <div class="text-[var(--candle)] mb-3" aria-hidden="true">
                <ThematicIcon name="tavern" class="w-8 h-8" />
              </div>
              <h3 class="text-xl font-bold text-[var(--candle)] mb-1 font-serif">
                Ibem's Tavern
              </h3>
              <span class="text-xs uppercase tracking-wider text-[var(--brass)] font-semibold block mb-2">Interactive RPG Showcase</span>
              <p class="text-sm text-[var(--parchment)]/90 leading-relaxed mb-4">
                The interactive, visual tavern experience. Explore the notice board, examine the shield wall of skills, and consult the Tavern Regular.
              </p>
            </div>
            <a
              href="/tavern"
              class="inline-flex items-center justify-center min-h-[44px] px-4 py-2 bg-[var(--brass)] text-[var(--wood-deep)] font-bold text-sm rounded hover:bg-[var(--candle)] transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)]"
            >
              Enter Ibem's Tavern →
            </a>
          </div>

          {/* Path 2: Simple Portfolio Mode */}
          <div class="bg-[#24170d] border-2 border-[var(--brass)] rounded p-6 flex flex-col justify-between shadow-lg">
            <div>
              <div class="text-[var(--candle)] mb-3" aria-hidden="true">
                <ThematicIcon name="ledger" class="w-8 h-8" />
              </div>
              <h3 class="text-xl font-bold text-[var(--candle)] mb-1 font-serif">
                The Field Ledger
              </h3>
              <span class="text-xs uppercase tracking-wider text-[var(--brass)] font-semibold block mb-2">Simple Portfolio · Zero-JS Mode</span>
              <p class="text-sm text-[var(--parchment)]/90 leading-relaxed mb-4">
                Fast-track recruiter view & technical proof of work. Zero runtime JavaScript, clean linear typography, architecture trade-offs, and verified project demos.
              </p>
            </div>
            <a
              href="/simple"
              class="inline-flex items-center justify-center min-h-[44px] px-4 py-2 bg-transparent text-[var(--parchment)] border-2 border-[var(--brass)] font-bold text-sm rounded hover:bg-[var(--parchment)] hover:text-[var(--wood-deep)] transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)]"
            >
              Open Field Ledger →
            </a>
          </div>

          {/* Path 3: Quest Board */}
          <div class="bg-[#24170d] border-2 border-[var(--brass)] rounded p-6 flex flex-col justify-between shadow-lg">
            <div>
              <div class="text-[var(--candle)] mb-3" aria-hidden="true">
                <ThematicIcon name="scroll" class="w-8 h-8" />
              </div>
              <h3 class="text-xl font-bold text-[var(--candle)] mb-1 font-serif">
                The Quest Board
              </h3>
              <span class="text-xs uppercase tracking-wider text-[var(--brass)] font-semibold block mb-2">Projects & Case Studies</span>
              <p class="text-sm text-[var(--parchment)]/90 leading-relaxed mb-4">
                Deep architectural case studies for Arcane Typer, BITS biometric production OJT, and Mimic API mocking tool.
              </p>
            </div>
            <a
              href="/quests"
              class="inline-flex items-center justify-center min-h-[44px] px-4 py-2 bg-transparent text-[var(--parchment)] border-2 border-[var(--brass)] font-bold text-sm rounded hover:bg-[var(--parchment)] hover:text-[var(--wood-deep)] transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)]"
            >
              View All Quests →
            </a>
          </div>
        </div>
      </section>

      {/* Flagship Projects Section */}
      <section aria-labelledby="featured-quests-heading" class="mb-14">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-6 pb-2 border-b border-[var(--brass)]/30 gap-2">
          <div>
            <h2 id="featured-quests-heading" class="text-2xl sm:text-3xl font-bold text-[var(--candle)] font-serif">
              Flagship Quests & Systems
            </h2>
            <p class="text-sm text-[var(--parchment)]/80 mt-1">
              Curated evidence of production contributions and independently architected web applications.
            </p>
          </div>
          <a
            href="/quests"
            class="text-sm font-semibold text-[var(--candle)] hover:underline inline-flex items-center min-h-[44px]"
          >
            Inspect Quest Board ({featuredProjects.length} Projects) →
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {featuredProjects.map((project) => (
            <article class="bg-[var(--parchment)] text-[var(--ink)] p-6 rounded border-2 border-[var(--brass)] shadow-xl flex flex-col justify-between">
              <div>
                <div class="flex justify-between items-start gap-2 mb-3">
                  <span class={`text-xs uppercase font-bold tracking-wider px-2 py-0.5 rounded ${project.data.status === 'Shipped' ? 'bg-[var(--wood-deep)] text-[var(--candle)]' : 'bg-[var(--stone)] text-[var(--parchment)]'}`}>
                    {project.data.status}
                  </span>
                  <span class="text-xs font-semibold text-[var(--ink)]/80 italic">
                    {project.data.role}
                  </span>
                </div>

                <div class="w-20 h-20 mx-auto my-3 rounded-xl border-2 border-[var(--brass)] bg-[#1e1208] shadow-md p-1.5 flex items-center justify-center overflow-hidden">
                  {project.data.thumbnail ? (
                    <img
                      src={project.data.thumbnail}
                      alt={`${project.data.title} emblem`}
                      class="w-full h-full object-contain rounded-lg"
                      loading="lazy"
                    />
                  ) : (
                    <ThematicIcon name="swords" class="w-10 h-10 text-[var(--candle)]" />
                  )}
                </div>

                <h3 class="text-lg font-bold mb-2 text-[var(--ink)] text-center leading-snug font-serif">
                  <a
                    href={`/quests/${project.data.slug}`}
                    class="underline hover:text-[var(--ember)] focus-visible:outline-2 focus-visible:outline-[var(--brass)] focus-visible:outline-offset-2"
                  >
                    {project.data.title}
                  </a>
                </h3>

                <p class="text-sm text-[var(--ink)]/90 mb-4 leading-relaxed line-clamp-3">
                  {project.data.summary}
                </p>
              </div>

              <div>
                <div class="mb-4 pt-3 border-t border-[var(--brass)]/30">
                  <ul class="flex flex-wrap gap-1" aria-label="Key technologies">
                    {project.data.stack.slice(0, 4).map((tech: string) => (
                      <li class="text-xs px-2 py-0.5 border border-[var(--brass)] bg-[var(--parchment)] font-medium rounded-sm">
                        {tech}
                      </li>
                    ))}
                    {project.data.stack.length > 4 && (
                      <li class="text-xs px-1.5 py-0.5 text-[var(--ink)]/70 font-semibold">
                        +{project.data.stack.length - 4}
                      </li>
                    )}
                  </ul>
                </div>

                <div class="flex flex-col gap-2">
                  <a
                    href={`/quests/${project.data.slug}`}
                    class="inline-flex items-center justify-center gap-1.5 min-h-[44px] px-3 bg-[var(--wood-deep)] text-[var(--candle)] font-bold text-xs rounded hover:bg-black transition-colors focus-visible:outline-2 focus-visible:outline-[var(--brass)] focus-visible:outline-offset-2"
                  >
                    <span>Inspect Case Study</span>
                    <ThematicIcon name="external" class="w-3 h-3 text-[var(--candle)]" />
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      {/* Navigation Ledger & Footer */}
      <footer class="mt-16 pt-8 border-t-2 border-[var(--brass)] text-center text-sm text-[var(--parchment)]/70">
        <nav aria-label="Tavern Navigation" class="mb-6">
          <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2">
            <li><a href="/" class="hover:text-[var(--candle)] underline min-h-[44px] inline-flex items-center">Entrance (Home)</a></li>
            <li><a href="/tavern" class="hover:text-[var(--candle)] underline min-h-[44px] inline-flex items-center">Main Tavern (Interactive)</a></li>
            <li><a href="/quests" class="hover:text-[var(--candle)] underline min-h-[44px] inline-flex items-center">Quest Board (Projects)</a></li>
            <li><a href="/tavern/skills" class="hover:text-[var(--candle)] underline min-h-[44px] inline-flex items-center">Adventurer's Badge (Skills)</a></li>
            <li><a href="/tavern/npc" class="hover:text-[var(--candle)] underline min-h-[44px] inline-flex items-center">Tavern Regular (FAQ)</a></li>
            <li><a href="/messenger" class="hover:text-[var(--candle)] underline min-h-[44px] inline-flex items-center">Messenger's Corner (Contact)</a></li>
            <li><a href="/resume" class="hover:text-[var(--candle)] underline min-h-[44px] inline-flex items-center">Resume</a></li>
            <li><a href="/about" class="hover:text-[var(--candle)] underline min-h-[44px] inline-flex items-center">About</a></li>
            <li><a href="/simple" class="hover:text-[var(--candle)] underline min-h-[44px] inline-flex items-center">Field Ledger (Simple Mode)</a></li>
          </ul>
        </nav>
        <p class="max-w-xl mx-auto leading-relaxed text-xs">
          Environment art generated with AI and hand-edited by Nhovem Cabahug; all code, copy, tests, and architectural design by Nhovem Cabahug.
        </p>
      </footer>
    </div>
  </main>
</BaseLayout>

<script>
  function initHeroCopy() {
    const copyBtn = document.getElementById('hero-copy-email-btn');
    const statusText = document.getElementById('hero-copy-status');
    const email = 'ncabahug223@gmail.com';

    if (copyBtn && statusText) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(email);
        } catch {
          const textarea = document.createElement('textarea');
          textarea.value = email;
          document.body.appendChild(textarea);
          textarea.select();
          document.execCommand('copy');
          document.body.removeChild(textarea);
        }
        statusText.textContent = 'Copied!';
        copyBtn.classList.add('text-emerald-400');
        setTimeout(() => {
          statusText.textContent = 'Copy';
          copyBtn.classList.remove('text-emerald-400');
        }, 2200);
      });
    }
  }

  document.addEventListener('astro:page-load', initHeroCopy);
</script>
