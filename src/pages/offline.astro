---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Lost in the Fog — Offline — Nhovem Cabahug"
  description="You have strayed beyond the kingdom's scrying range. Previously explored tavern rooms remain available in memory."
>
  <div class="min-h-[calc(100vh-3.5rem)] flex items-center justify-center p-4 sm:p-6 bg-[#120a04] text-[var(--parchment)] relative overflow-hidden select-none">
    {/* Background mystical fog and ember ambient styling */}
    <div class="absolute inset-0 opacity-20 pointer-events-none bg-[radial-gradient(circle_at_center,#b52c0b_0%,transparent_70%)]" aria-hidden="true"></div>
    <div class="absolute inset-0 opacity-10 pointer-events-none bg-[radial-gradient(ellipse_at_top,#ffe4a0_0%,transparent_60%)]" aria-hidden="true"></div>

    <div class="relative max-w-lg w-full bg-[#1c1208]/90 border border-[var(--brass)]/80 rounded-2xl p-6 sm:p-8 shadow-2xl backdrop-blur-sm text-center">
      {/* Mystical Lantern / Signal Icon */}
      <div class="mx-auto w-16 h-16 rounded-full bg-[#2a1708] border border-[var(--brass)] flex items-center justify-center mb-6 shadow-inner relative">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-[var(--candle)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636a9 9 0 010 12.728m0 0l-2.829-2.829m2.829 2.829L21 21M15.536 8.464a5 5 0 010 7.072m0 0l-2.829-2.829m-4.243 2.829a4.978 4.978 0 01-1.414-2.83m-1.414 5.658a9 9 0 01-2.167-9.238m7.824 2.167a1 1 0 111.414 1.414m-1.414-1.414L3 3m8.293 8.293l1.414 1.414" />
        </svg>
        <span class="absolute -top-1 -right-1 flex h-3.5 w-3.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-amber-500"></span>
        </span>
      </div>

      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#2b170a] border border-[var(--brass)]/60 text-xs font-semibold text-[var(--candle)] mb-4 tracking-wide uppercase">
        <span class="inline-block w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        <span>Ether Signal Disconnected</span>
      </div>

      <h1 class="text-2xl sm:text-3xl font-serif font-bold text-[var(--candle)] tracking-wide mb-3">
        Lost in the Realm's Fog
      </h1>

      <p class="text-sm sm:text-base text-[var(--parchment)]/85 leading-relaxed mb-6 font-sans">
        You appear to have strayed beyond the kingdom's scrying range. Fear not — any tavern rooms, quest scrolls, or ledger entries you previously explored remain safely stored in memory!
      </p>

      {/* Action Buttons */}
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-6">
        <button
          type="button"
          id="retry-connection-btn"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg bg-[var(--brass)] text-[var(--wood-deep)] font-bold text-sm hover:brightness-110 active:scale-95 transition-all shadow-md focus-visible:outline-2 focus-visible:outline-[var(--candle)] cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          Re-cast Scrying Spell
        </button>

        <a
          href="/tavern"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-lg bg-[#2b170a] border border-[var(--brass)]/80 text-[var(--candle)] font-semibold text-sm hover:bg-[var(--brass)] hover:text-[var(--wood-deep)] transition-all focus-visible:outline-2 focus-visible:outline-[var(--candle)]"
        >
          Return to Tavern
        </a>
      </div>

      {/* Cached Navigation Links */}
      <div class="pt-5 border-t border-[var(--brass)]/30 text-xs text-[var(--parchment)]/70">
        <span class="block mb-2 font-medium text-[var(--candle)]">Try accessing previously visited rooms:</span>
        <div class="flex flex-wrap justify-center gap-2">
          <a href="/" class="px-2.5 py-1 rounded bg-[#241307] hover:text-[var(--candle)] border border-[var(--brass)]/40 transition-colors">Entrance</a>
          <a href="/quests" class="px-2.5 py-1 rounded bg-[#241307] hover:text-[var(--candle)] border border-[var(--brass)]/40 transition-colors">Quest Board</a>
          <a href="/simple" class="px-2.5 py-1 rounded bg-[#241307] hover:text-[var(--candle)] border border-[var(--brass)]/40 transition-colors">Field Ledger</a>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    const retryBtn = document.getElementById('retry-connection-btn');
    if (retryBtn) {
      retryBtn.addEventListener('click', () => {
        retryBtn.textContent = 'Seeking connection...';
        retryBtn.classList.add('opacity-75', 'cursor-wait');
        window.location.reload();
      });
    }

    // Auto-reload when signal is restored
    window.addEventListener('online', () => {
      if (retryBtn) retryBtn.textContent = 'Signal found! Reconnecting...';
      setTimeout(() => window.location.reload(), 800);
    });
  </script>
</BaseLayout>
