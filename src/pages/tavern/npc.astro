---
import TavernLayout from '../../layouts/TavernLayout.astro';
import { getCollection } from 'astro:content';

const npcEntries = await getCollection('npc');
const questions = npcEntries
  .map(entry => entry.data)
  .sort((a, b) => a.order - b.order);
---

<TavernLayout title="Tavern Regular" description={`Ask the Tavern Regular about Nhovem Cabahug — ${questions.length} prepared answers about the developer, their work, and how to get in touch.`} location="npc">
  <div class="npc-page">
    <!-- Character portrait -->
    <picture>
      <source media="(min-width: 1024px)" srcset="/art/npc-table-2560.webp" />
      <img class="npc-scene-art" src="/art/npc-table-1280.webp" width="2560" height="1429" alt="" loading="eager" decoding="async" />
    </picture>
    <img class="npc-sprite" src="/art/tavern-regular-bust-1024.webp" srcset="/art/tavern-regular-bust-512.webp 512w, /art/tavern-regular-bust-1024.webp 1024w" sizes="(max-width: 1023px) 40vw, 42vw" width="1024" height="1205" alt="" loading="eager" decoding="async" />
    <picture>
      <source media="(min-width: 1024px)" srcset="/art/npc-table-front-2560.webp" />
      <img class="npc-table-front" src="/art/npc-table-front-1280.webp" width="2560" height="1429" alt="" loading="eager" decoding="async" />
    </picture>

    <div class="npc-dialogue-panel">
      <!-- No-JS fallback: all QA pairs visible as a flat list -->
      <div class="npc-fallback" id="npc-fallback">
        {questions.map((q) => (
          <div class="qa-pair">
            <h3>{q.question}</h3>
            {q.answer && <p>{q.answer}</p>}
          </div>
        ))}
        <div class="npc-actions">
          <a href="/tavern" class="npc-btn npc-btn-primary">Back to the Tavern</a>
        </div>
      </div>

      <div class="dialogue-stack" id="npc-stack" hidden>
        <ul class="dialogue-replies" id="npc-replies">
          {questions.map((q, i) => (
            <li>
              <button type="button" class="reply-btn" data-question-index={i}>
                {q.question}
              </button>
            </li>
          ))}
          <li>
            <button type="button" class="reply-btn farewell-btn">End conversation</button>
          </li>
        </ul>
        <div class="dialogue-band">
          <div class="panel-header">
            <h1 id="npc-title">The Tavern Regular</h1>
          </div>
          <p class="npc-disclosure">These replies are written in advance from portfolio facts; they are not generated by AI.</p>
          <div class="panel-body">
            <div class="dialogue-prose" id="npc-prose" tabindex="-1">
              <p>What would you like to know?</p>
            </div>
          </div>
          <div class="panel-actions">
            <a href="/tavern" class="close-panel-btn">Back to the Tavern</a>
          </div>
        </div>
      </div>
      <div id="npc-announce" class="visually-hidden" aria-live="polite" aria-atomic="true"></div>
    </div>
  </div>
</TavernLayout>

<style>
  html, body {
    background-color: var(--wood-deep);
  }
  .npc-page {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    height: auto;
    align-self: stretch;
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    overflow: hidden;
    background-color: var(--wood-deep);
  }

  .npc-page > picture {
    display: contents;
  }

  .npc-scene-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 100%;
  }

  .npc-table-front {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 100%;
    z-index: 2;
  }

  .npc-sprite {
    position: absolute;
    left: 2%;
    bottom: 0;
    width: 42%;
    height: auto;
    transform: translateY(34%);
    z-index: 1;
  }


  .npc-dialogue-panel {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 3;
  }
  .npc-dialogue-panel > * {
    pointer-events: auto;
  }
  .npc-dialogue-panel .dialogue-stack {
    position: absolute;
    left: 42%;
    right: 8%;
    bottom: 4%;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
    max-height: 92%;
  }
  .npc-dialogue-panel .dialogue-band {
    align-self: stretch;
    background: rgba(15, 10, 5, 0.80);
    border: 2px solid #8b6b4a;
    border-radius: 6px;
    padding: 14px 26px;
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 224px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.8);
  }
  .npc-dialogue-panel .panel-body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
  }
  .npc-dialogue-panel .dialogue-prose p {
    margin: 0 0 0.85em;
    line-height: 1.6;
  }
  .npc-dialogue-panel .dialogue-prose p:last-child {
    margin-bottom: 0;
  }
  .npc-dialogue-panel .dialogue-prose {
    max-width: 66ch; font-size: 1.1875rem; line-height: 1.5; text-align: left;
  }
  .npc-dialogue-panel .dialogue-replies {
    list-style: none;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: max-content;
    max-width: 44%;
    flex: 0 4 auto;
    min-height: 88px;
    overflow-y: auto;
    background: rgba(15, 10, 5, 0.80);
    border: 2px solid #8b6b4a;
    border-radius: 6px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.8);
    padding: 6px;
    gap: 4px;
  }
  .npc-dialogue-panel .dialogue-replies[hidden] {
    display: flex !important;
    visibility: hidden;
  }
  .npc-dialogue-panel :global(.dialogue-unread) {
    visibility: hidden;
  }
  .npc-dialogue-panel .panel-header {
    padding-bottom: 8px;
  }
  .npc-dialogue-panel .panel-header h1 {
    font-size: 1.25rem;
    margin: 0;
  }
  .npc-dialogue-panel .panel-actions {
    padding-top: 10px;
  }
  .npc-dialogue-panel .dialogue-replies .reply-btn {
    border: none;
    border-radius: 4px;
    width: 100%;
    position: relative;
    padding: 10px 12px 10px 28px;
  }
  .npc-dialogue-panel .dialogue-replies .reply-btn::before {
    content: "\25B8";
    position: absolute;
    left: 10px;
    opacity: 0;
    transition: opacity 0.15s ease-out;
  }
  .npc-dialogue-panel .dialogue-replies .reply-btn:hover::before,
  .npc-dialogue-panel .dialogue-replies .reply-btn:focus-visible::before { opacity: 1; }
  .npc-dialogue-panel .reply-btn.reply-visited { color: #a89880; }
  .npc-dialogue-panel .reply-btn.reply-visited:hover { color: #fdf6e3; }

  .npc-fallback {
    position: absolute;
    left: 4%;
    right: 4%;
    bottom: 2%;
    max-height: 92%;
    overflow-y: auto;
    padding: 20px 26px;
    background-color: var(--wood-deep);
    border-top: 2px solid var(--brass);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .npc-heading {
    font-size: 1.75rem;
    color: var(--candle);
    margin: 0 0 0.25rem 0;
  }

  .npc-disclosure {
    font-size: 0.8125rem;
    color: var(--parchment);
    opacity: 0.7;
    margin: 0 0 0.5rem 0;
    font-style: italic;
  }

  /* Fallback flat list */
  .qa-pair {
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(168, 122, 39, 0.3);
  }

  .qa-pair:last-child {
    border-bottom: none;
  }

  .qa-pair h3 {
    font-size: 1.1rem;
    color: var(--candle);
    margin: 0 0 0.5rem 0;
  }

  .qa-pair p {
    font-size: 1rem;
    color: var(--parchment);
    line-height: 1.6;
    margin: 0;
  }

  /* Buttons */
  .npc-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(168, 122, 39, 0.3);
  }

  .npc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 20px;
    font-size: 1rem;
    font-weight: 700;
    border-radius: 4px;
    cursor: pointer;
    min-height: 44px;
    text-decoration: none;
    border: none;
  }

  .npc-btn-primary {
    background: var(--parchment);
    color: var(--ink);
  }

  .npc-btn-primary:is(:hover, :focus-visible) {
    background: var(--candle);
  }

  /* Mobile: stack portrait above dialogue */
  @media (max-width: 639px) {
    .npc-page {
      flex: 0 0 auto;
      height: auto;
      aspect-ratio: auto;
      min-height: 100vh;
      max-width: 100%;
    }

    .npc-dialogue-panel .dialogue-stack {
      left: 4%;
      right: 4%;
      bottom: 2%;
      max-height: 88%;
    }

    .npc-dialogue-panel .dialogue-replies {
      max-width: 100%;
      width: 100%;
    }
  }
      :global(.tavern-shell) {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
      }
      :global(.tavern-shell > .tavern-content) {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
        padding: 0;
      }

</style>

<script>
  const fallback = document.getElementById('npc-fallback');
  const stack = document.getElementById('npc-stack');
  const replies = document.getElementById('npc-replies');
  const prose = document.getElementById('npc-prose');
  const announce = document.getElementById('npc-announce');

  if (fallback && stack && replies && prose && announce) {
    const qaPairs: { question: string; answer: string }[] = [];
    fallback.querySelectorAll('.qa-pair').forEach((pair) => {
      const h3 = pair.querySelector('h3');
      const p = pair.querySelector('p');
      qaPairs.push({
        question: h3?.textContent?.trim() || '',
        answer: p?.textContent?.trim() || '',
      });
    });

    fallback.hidden = true;
    stack.hidden = false;

    const TYPE_MS = 25;
    const PAUSE_AFTER: Record<string, number> = { '.': 8, '!': 8, '?': 8, ',': 4, ';': 4, ':': 4 };
    let typeTimer: number | null = null;
    let typingDone = true;
    let finishTyping: (() => void) | null = null;

    function stopTyping() {
      if (typeTimer !== null) { clearTimeout(typeTimer); typeTimer = null; }
    }

    function renderProse(text: string) {
      if (!prose) return;
      stopTyping();
      finishTyping = null;

      const plain = text.replace(/\s+/g, ' ').trim();

      const settle = () => {
        stopTyping();
        finishTyping = null;
        prose.textContent = plain;
        typingDone = true;
        if (announce) announce.textContent = plain;
        if (replies) replies.hidden = false;
      };

      if (document.documentElement.dataset.motion !== 'full') {
        settle();
        return;
      }

      typingDone = false;
      finishTyping = settle;
      if (replies) replies.hidden = true;

      const shown = document.createElement('span');
      shown.setAttribute('aria-hidden', 'true');
      const rest = document.createElement('span');
      rest.setAttribute('aria-hidden', 'true');
      rest.className = 'dialogue-unread';
      rest.textContent = plain;
      prose.textContent = '';
      prose.appendChild(shown);
      prose.appendChild(rest);

      let ci = 0;
      const step = () => {
        ci += 1;
        shown.textContent = plain.slice(0, ci);
        rest.textContent = plain.slice(ci);
        const ch = plain[ci - 1];
        if (ci >= plain.length) { settle(); return; }
        typeTimer = window.setTimeout(step, TYPE_MS * (PAUSE_AFTER[ch] ?? 1));
      };
      typeTimer = window.setTimeout(step, TYPE_MS);
    }

    const band = document.querySelector('.npc-dialogue-panel .dialogue-band');
    if (band) {
      band.addEventListener('click', () => {
        if (!typingDone && finishTyping) finishTyping();
      });
    }

    replies.querySelectorAll<HTMLButtonElement>('.reply-btn[data-question-index]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const index = parseInt(btn.getAttribute('data-question-index') || '0', 10);
        const pair = qaPairs[index];
        if (!pair) return;
        renderProse(pair.answer);
        btn.classList.add('reply-visited');
        prose.focus();
      });
    });

    const farewellBtn = replies.querySelector<HTMLButtonElement>('.farewell-btn');
    if (farewellBtn) {
      farewellBtn.addEventListener('click', () => {
        window.location.href = '/tavern';
      });
    }
  }
</script>
