---
import TavernLayout from '../../layouts/TavernLayout.astro';
import NpcDialogue from '../../components/NpcDialogue.astro';
import { getCollection } from 'astro:content';

const npcEntries = await getCollection('npc');
const questions = npcEntries
  .map(entry => entry.data)
  .sort((a, b) => a.order - b.order);

const dialogueReplies = questions.map((q, i) => ({
  id: i,
  question: q.question,
  answer: q.answer,
  offerLabel: q.offerLabel,
  offerHref: q.offerHref,
  followUp: q.followUp
}));
---

<TavernLayout title="Tavern Regular" description={`Ask the Tavern Regular about Nhovem Cabahug — ${questions.length} prepared answers about the developer, their work, and how to get in touch.`} location="npc">
  <div class="npc-page">
    <!-- Character portrait & Scene Art -->
    <picture>
      <source media="(min-width: 1024px)" srcset="/art/npc-table-2560.webp" />
      <img class="npc-scene-art" src="/art/npc-table-1280.webp" width="2560" height="1429" alt="" loading="eager" decoding="async" />
    </picture>
    <img class="npc-sprite" src="/art/tavern-regular-bust-1024.webp" srcset="/art/tavern-regular-bust-512.webp 512w, /art/tavern-regular-bust-1024.webp 1024w" sizes="(max-width: 1023px) 40vw, 42vw" width="1024" height="1205" alt="" loading="eager" decoding="async" />
    <picture>
      <source media="(min-width: 1024px)" srcset="/art/npc-table-front-2560.webp" />
      <img class="npc-table-front" src="/art/npc-table-front-1280.webp" width="2560" height="1429" alt="" loading="eager" decoding="async" />
    </picture>

    <!-- No-JS fallback: all QA pairs visible as a flat list when JS is disabled -->
    <div class="npc-fallback" id="npc-fallback">
      {questions.map((q) => (
        <div class="qa-pair">
          <h3>{q.question}</h3>
          {q.answer && <p>{q.answer}</p>}
        </div>
      ))}
      <div class="npc-actions">
        <a href="/tavern" class="npc-btn npc-btn-primary">Back to the Tavern</a>
      </div>
    </div>

    <!-- Unified Rotationally Responsive NPC Dialogue Engine -->
    <NpcDialogue
      npcId="regular"
      title="The Tavern Regular"
      initialBeats={["What would you like to know?"]}
      replies={dialogueReplies}
      farewell={{ question: "End conversation", href: "/tavern" }}
      closeLabel="Back to the Tavern"
      closeHref="/tavern"
      mode="page"
      stackId="npc-stack"
      repliesId="npc-replies"
    />
  </div>
</TavernLayout>

<style>
  html, body {
    background-color: var(--wood-deep);
  }
  .npc-page {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    height: auto;
    align-self: stretch;
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    overflow: hidden;
    background-color: var(--wood-deep);
  }

  .npc-page > picture {
    display: contents;
  }

  .npc-scene-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 100%;
  }

  .npc-table-front {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 100%;
    z-index: 2;
  }

  .npc-sprite {
    position: absolute;
    left: 2%;
    bottom: 0;
    width: 42%;
    height: auto;
    transform: translateY(34%);
    z-index: 1;
  }

  /* No-JS fallback container */
  .npc-fallback {
    position: absolute;
    left: 4%;
    right: 4%;
    bottom: 2%;
    max-height: 92%;
    overflow-y: auto;
    padding: 20px 26px;
    background-color: var(--wood-deep);
    border-top: 2px solid var(--brass);
    z-index: 10;
  }
  .npc-fallback[hidden] {
    display: none !important;
  }

  /* Themed Fantasy Scrollbars */
  .npc-fallback {
    scrollbar-width: thin;
    scrollbar-color: var(--brass, #c49a45) rgba(15, 10, 5, 0.6);
  }
  .npc-fallback::-webkit-scrollbar {
    width: 8px;
  }
  .npc-fallback::-webkit-scrollbar-track {
    background: rgba(15, 10, 5, 0.7);
    border-radius: 4px;
    border: 1px solid rgba(139, 107, 74, 0.3);
  }
  .npc-fallback::-webkit-scrollbar-thumb {
    background: linear-gradient(180deg, #d5a350, #8b6b4a);
    border-radius: 4px;
    border: 1px solid rgba(255, 230, 160, 0.4);
  }
  .npc-fallback::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(180deg, #f0c56f, #b8863b);
  }

  /* Fallback flat list */
  .qa-pair {
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(168, 122, 39, 0.3);
  }
  .qa-pair:last-child {
    border-bottom: none;
  }
  .qa-pair h3 {
    font-size: 1.1rem;
    color: var(--candle);
    margin: 0 0 0.5rem 0;
  }
  .qa-pair p {
    font-size: 1rem;
    color: var(--parchment);
    line-height: 1.6;
    margin: 0;
  }

  /* Buttons for fallback */
  .npc-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(168, 122, 39, 0.3);
  }
  .npc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 20px;
    font-size: 1rem;
    font-weight: 700;
    border-radius: 4px;
    cursor: pointer;
    min-height: 44px;
    text-decoration: none;
    border: none;
  }
  .npc-btn-primary {
    background: var(--parchment);
    color: var(--ink);
  }
  .npc-btn-primary:is(:hover, :focus-visible) {
    background: var(--candle);
  }

  /* Short landscape screens (<= 500px height in landscape) */
  @media (max-height: 500px) and (orientation: landscape) {
    .npc-sprite {
      left: 2%;
      bottom: 0;
      width: 32%;
      height: 92dvh;
      max-height: 92dvh;
      object-fit: contain;
      transform: none;
      z-index: 1;
    }
  }

  /* Mobile Portrait screens (<= 639px width in portrait) */
  @media (max-width: 639px) and (orientation: portrait) {
    .npc-page {
      height: 100dvh;
      position: relative;
    }
    .npc-scene-art {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 46dvh;
      object-fit: cover;
      object-position: 50% 30%;
    }
    .npc-sprite {
      position: absolute;
      top: 2dvh;
      left: 50%;
      transform: translateX(-50%);
      width: auto;
      height: 42dvh;
      max-width: 90vw;
      object-fit: contain;
      z-index: 1;
    }
    .npc-table-front {
      position: absolute;
      top: 32dvh;
      left: 0;
      width: 100%;
      height: 16dvh;
      object-fit: cover;
      object-position: 50% 50%;
      z-index: 2;
    }
  }

  :global(.tavern-shell) {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }
  :global(.tavern-shell > .tavern-content) {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    padding: 0;
  }
</style>
