---
import TavernLayout from '../../layouts/TavernLayout.astro';
import ThematicIcon from '../../components/icons/ThematicIcon.astro';
import NpcDialogue from '../../components/NpcDialogue.astro';

import { getCollection } from 'astro:content';

const skillsEntries = await getCollection('skills');
const skills = skillsEntries.map(entry => entry.data);

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);

const levelMap: Record<string, number> = {
  learning: 1,
  working: 2,
  confident: 3
};

const innkeeperEntries = await getCollection('innkeeper');
const innkeeperAll = innkeeperEntries
  .map(entry => entry.data)
  .sort((a: any, b: any) => a.order - b.order);
const innkeeperBeats = innkeeperAll.filter((d: any) => d.line);
const innkeeperReplies = innkeeperAll.filter((d: any) => d.question && d.offerHref);
const innkeeperFarewell = innkeeperAll.find((d: any) => d.question && !d.offerHref);

const npcEntries = await getCollection('npc');
const regularQuestions = npcEntries
  .map(entry => entry.data)
  .sort((a: any, b: any) => a.order - b.order);

const archivistEntries = await getCollection('archivist');
const archivistIntro = archivistEntries.find(e => e.data.type === 'intro');
const archivistBranches = archivistEntries
  .filter(e => e.data.type === 'branch')
  .sort((a, b) => a.data.order - b.data.order);

const archivistBeats = archivistIntro?.data.lines || [
  "Peace to your footsteps, traveller. I am the Archivist.",
  "I maintain the chronicle of Nhovem's works, decisions, and technical disciplines.",
  "Select a line of inquiry below, and I shall guide you through the records."
];

const archivistReplies = archivistBranches.map(b => ({
  id: b.id,
  question: b.data.question || '',
  lead: b.data.lead || '',
  answer: b.data.lead || '',
  inquiries: b.data.inquiries || []
}));

// Data structure for the interactive scene objects
const sceneObjects = [
  {
    id: 'shield-languages',
    type: 'shield',
    label: 'Languages',
    ariaLabel: 'View Languages skills',
    position: { left: '30.8%', bottom: '54.3%', width: '3.5%' },
    pixelHeight: 325,
    tooltipPlacement: 'left',
    zIndex: 3,
    action: { type: 'dialog', target: 'dialog-skills', filter: 'Languages' },
  },
  {
    id: 'shield-frameworks',
    type: 'shield',
    label: 'Frameworks',
    ariaLabel: 'View Frameworks skills',
    position: { left: '34.5%', bottom: '54.5%', width: '4%' },
    pixelHeight: 354,
    tooltipPlacement: 'top',
    zIndex: 3,
    action: { type: 'dialog', target: 'dialog-skills', filter: 'Frameworks' },
  },
  {
    id: 'shield-tools',
    type: 'shield',
    label: 'Tools',
    ariaLabel: 'View Tools skills',
    position: { left: '38.9%', bottom: '53.8%', width: '3.5%' },
    pixelHeight: 370,
    tooltipPlacement: 'top',
    zIndex: 3,
    action: { type: 'dialog', target: 'dialog-skills', filter: 'Tools' },
  },
  {
    id: 'shield-data',
    type: 'shield',
    label: 'Data',
    ariaLabel: 'View Data skills',
    position: { left: '30.7%', bottom: '46.2%', width: '3.5%' },
    pixelHeight: 321,
    tooltipPlacement: 'bottom',
    zIndex: 3,
    action: { type: 'dialog', target: 'dialog-skills', filter: 'Data' },
  },
  {
    id: 'shield-other',
    type: 'shield',
    label: 'Other',
    ariaLabel: 'View Other skills',
    position: { left: '34.7%', bottom: '46.5%', width: '3.5%' },
    pixelHeight: 319,
    tooltipPlacement: 'bottom',
    zIndex: 3,
    action: { type: 'dialog', target: 'dialog-skills', filter: 'Other' },
  },
  {
    id: 'shield-coming-soon',
    type: 'shield',
    label: 'Soon',
    ariaLabel: 'Coming soon',
    position: { left: '38.8%', bottom: '46.5%', width: '3.5%' },
    pixelHeight: 316,
    tooltipPlacement: 'bottom',
    zIndex: 3,
    action: { type: 'none' },
  }
];
---

<TavernLayout title="Ibem's Tavern - Nhovem Cabahug" description="Main Tavern Scene" location="tavern">
  <div class="scene-container">
    <picture>
      <source
        media="(min-width: 601px), (orientation: landscape)"
        srcset="/art/tavern-room-1280.webp 1280w, /art/tavern-room-2560.webp 2560w"
        sizes="100vw"
      />
      <img 
        src="/art/tavern-room-1280.webp"
        width="2560"
        height="1431"
        alt=""
        aria-hidden="true"
        loading="eager"
        fetchpriority="high"
        class="scene-background"
      />
    </picture>

    <div class="scene-overlay" aria-hidden="false">
      <!-- Characters & Objects -->
      <a href="/tavern/npc" id="trigger-regular" class="scene-object" aria-label="Talk to the Tavern Regular"
         style="left: 50.8%; bottom: 18.0%; width: 10.6%; z-index: 2;">
        <div class="ground-shadow"></div>
        <img src="/art/tavern-regular-seated-528.webp" 
             srcset="/art/tavern-regular-seated-264.webp 264w, /art/tavern-regular-seated-528.webp 528w" 
             sizes="(max-width: 1280px) 264px, 528px" 
             width="528" height="741" alt="" loading="lazy" decoding="async" />
         <span class="scene-tooltip" data-placement="bottom">Tavern Regular</span>
      </a>

      <!-- FIXED (M9): Non-JS fallback route exists for the Innkeeper dialogue. -->
      <a href="/tavern/npc" id="trigger-innkeeper" class="scene-object" aria-label="Talk to the Innkeeper"
              style="left: 48%; bottom: 25%; width: 6.6%; z-index: 1;">
        <div class="ground-shadow"></div>
        <img src="/art/innkeeper-neutral-516.webp" 
             srcset="/art/innkeeper-neutral-258.webp 258w, /art/innkeeper-neutral-516.webp 516w" 
             sizes="(max-width: 1280px) 258px, 516px" 
             width="516" height="1365" alt="" loading="lazy" decoding="async" />
        <span class="scene-tooltip" data-placement="top">Ask the Innkeeper</span>
      </a>

      <!-- The Hooded Archivist -->
      <a href="/tavern/archivist" id="trigger-archivist" class="scene-object" aria-label="Consult the Hooded Archivist"
         style="left: 20.8%; bottom: 24.8%; width: 6.4%; z-index: 2;">
        <div class="ground-shadow"></div>
        <img src="/art/archivist-neutral-520.webp"
             srcset="/art/archivist-neutral-260.webp 260w, /art/archivist-neutral-520.webp 520w"
             sizes="(max-width: 1280px) 260px, 520px"
             width="520" height="1263" alt="" loading="lazy" decoding="async" />
        <span class="scene-tooltip" data-placement="top">The Hooded Archivist</span>
      </a>

      <!-- Painted Object Hotspots -->
      {sceneObjects.map(obj => {
        if (obj.action.type === 'dialog') {
          return (
            <button type="button" class="scene-object scene-hotspot shield" id={`trigger-${obj.id}`}
                    aria-label={obj.ariaLabel} data-filter={obj.action.filter}
                    style={`left: ${obj.position.left}; bottom: ${obj.position.bottom}; width: ${obj.position.width}; z-index: ${obj.zIndex};`}>
              <img src={`/art/${obj.id}-256.webp`}
                   srcset={`/art/${obj.id}-128.webp 128w, /art/${obj.id}-256.webp 256w`}
                   sizes="(max-width: 1280px) 128px, 256px"
                   width="256" height={obj.pixelHeight} alt="" loading="lazy" decoding="async" />
              <span class="scene-tooltip" data-placement={obj.tooltipPlacement}>{obj.label}</span>
            </button>
          );
        }
        return (
            <button type="button" class="scene-object scene-hotspot shield" id={`trigger-${obj.id}`}
                    aria-label={obj.ariaLabel} disabled
                    style={`left: ${obj.position.left}; bottom: ${obj.position.bottom}; width: ${obj.position.width}; z-index: ${obj.zIndex}; cursor: default;`}>
              <img src={`/art/${obj.id}-256.webp`}
                   srcset={`/art/${obj.id}-128.webp 128w, /art/${obj.id}-256.webp 256w`}
                   sizes="(max-width: 1280px) 128px, 256px"
                   width="256" height={obj.pixelHeight} alt="" loading="lazy" decoding="async" />
              <span class="scene-tooltip" data-placement={obj.tooltipPlacement}>{obj.label}</span>
            </button>
        );
      })}

      <!-- Messenger's Corner Arched Doorway -->
      <a href="/messenger" id="trigger-door-roost" class="scene-object scene-hotspot door-hotspot"
         aria-label="Enter Messenger's Corner"
         style="left: 80.94%; bottom: 26.43%; width: 5.31%; height: 37.34%; z-index: 2;">
        <img
          src="/art/door-to-roost-prop-tight.webp"
          width="68"
          height="267"
          alt=""
          loading="lazy"
          decoding="async"
          class="door-roost-sprite"
        />
        <span class="scene-tooltip" data-placement="left">Messenger's Corner</span>
      </a>

      <a href="/quests" id="trigger-quest-board" class="scene-object scene-hotspot"
         aria-label="Inspect the Quest Board"
         aria-haspopup="dialog"
         aria-expanded="false"
         aria-controls="dialog-questboard"
         style="left: 90.6%; bottom: 41.5%; width: 5.5%; z-index: 2;">
        <img src="/art/quest-board-prop-512.webp"
             srcset="/art/quest-board-prop-256.webp 256w, /art/quest-board-prop-512.webp 512w"
             sizes="(max-width: 1280px) 256px, 512px"
             width="512" height="885" alt="" loading="lazy" decoding="async" />
        <span class="scene-tooltip" data-placement="bottom">Quest Board</span>
      </a>

      <!-- Red Horse Beer Litro Easter Egg (Frontdesk Bar Counter) -->
      <button
        type="button"
        id="trigger-beer"
        class="scene-object scene-hotspot beer-bottle-hotspot"
        aria-label="Inspect the mysterious bottle on the bar counter"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="dialog-beer-blackout"
        style="left: 60.5%; bottom: 44.5%; width: 1.35%; z-index: 3;"
      >
        <img
          src="/art/red-horse-litro.webp"
          width="62"
          height="197"
          alt=""
          loading="lazy"
          decoding="async"
          class="beer-bottle-sprite"
        />
      </button>

      <!-- Papers Hotspots -->

      <!-- Reserved Space: Dark centre floor -->
      <div class="reserved-dialogue-area" aria-hidden="true"></div>
    </div>
  </div>

  <!-- Orientation Suggestion Prompt: Visible only on narrow portrait viewports -->
  <div
    id="tavern-orientation-prompt"
    class="orientation-prompt"
    role="status"
    aria-live="polite"
  >
    <div class="orientation-prompt-visual" aria-hidden="true">
      <svg class="phone-rotate-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
        <path d="M12 18h.01"/>
      </svg>
      <span class="rotate-glyph">↻</span>
    </div>
    <div class="orientation-prompt-text">
      <p class="orientation-prompt-title">Rotate for Tavern View</p>
      <p class="orientation-prompt-body">The interactive chamber renders best in widescreen.</p>
    </div>
    <button
      type="button"
      id="dismiss-orientation-prompt"
      class="orientation-dismiss-btn"
      aria-label="Dismiss orientation suggestion"
    >
      ✕
    </button>
  </div>
  <script is:inline>
    try {
      if (sessionStorage.getItem('tavern_orientation_dismissed') === 'true') {
        document.getElementById('tavern-orientation-prompt')?.setAttribute('data-dismissed', 'true');
      }
    } catch (e) {}
  </script>

  <div class="narrow-links">
    <a href="/tavern/npc" id="narrow-regular" class="narrow-link">Talk to the Tavern Regular</a>
    <button type="button" class="narrow-link" id="narrow-innkeeper">Talk to the Innkeeper</button>
    <a href="/tavern/archivist" id="narrow-archivist" class="narrow-link">Consult the Archivist</a>
    <a href="/tavern/skills" id="narrow-skills" class="narrow-link">View Skills</a>
    <a href="/quests" id="narrow-questboard" class="narrow-link">Go to the Quest Board</a>
    <a href="/messenger" class="narrow-link">Go to Messenger's Corner</a>
    <button type="button" class="narrow-link" id="narrow-beer">🍺 An ice-cold bottle on the counter</button>
  </div>

  <!-- Global Modal Backdrop -->
  <div id="dialog-backdrop" class="dialog-backdrop" hidden aria-hidden="true"></div>

  <!-- Hoisted Modal Panels (Escaped from scene-container to guarantee full viewport scaling & no containment clipping) -->
  <!-- Skills Panel -->
  <div id="dialog-skills" class="tavern-panel skills-panel" role="dialog" aria-modal="true" aria-labelledby="skills-title" hidden>
    <div class="panel-header flex items-center justify-between">
      <div class="flex items-center gap-3">
        <img src="/art/adventurers-badge-384.webp" alt="" width="48" height="58" class="panel-icon" />
        <h2 id="skills-title">Skills & Arsenal</h2>
      </div>
    </div>
    <div class="panel-body skills-grid">
      {skills.map((group) => (
        <div class="skill-category" data-category={group.category}>
          <ul>
            {group.items.map((item) => (
              <li>
                <strong>{item.name}</strong>
                <span class="level-meter" role="img" aria-label={`${item.name}, ${item.level}, ${levelMap[item.level]} of 3`}>
                  <span class={`notch ${levelMap[item.level] >= 1 ? 'is-filled' : ''}`}></span>
                  <span class={`notch ${levelMap[item.level] >= 2 ? 'is-filled' : ''}`}></span>
                  <span class={`notch ${levelMap[item.level] >= 3 ? 'is-filled' : ''}`}></span>
                </span>
                <span class="level-word" aria-hidden="true">{item.level}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="panel-actions flex justify-end">
      <button type="button" class="close-panel-btn ml-auto">Close Skills (Esc)</button>
    </div>
  </div>

  <!-- Innkeeper Dialogue (Unified Architecture) -->
  <NpcDialogue
    npcId="innkeeper"
    title="The Innkeeper"
    showCloseIcon={false}
    portraitSrc="/art/innkeeper-portrait-519.webp"
    portraitWidth={519}
    portraitHeight={1365}
    initialBeats={innkeeperBeats.map((d: any) => d.line)}
    replies={innkeeperReplies.map((d: any) => ({
      question: d.question,
      answer: d.answer,
      offerLabel: d.offerLabel,
      offerHref: d.offerHref,
      followUp: d.followUp
    }))}
    farewell={innkeeperFarewell?.question ? {
      question: innkeeperFarewell.question,
      answer: innkeeperFarewell.answer || ''
    } : undefined}
    closeLabel="Close Dialogue (Esc)"
    mode="modal"
  />

  <!-- Tavern Regular Dialogue (In-Scene Unified Modal) -->
  <NpcDialogue
    npcId="regular"
    title="The Tavern Regular"
    showCloseIcon={false}
    portraitSrc="/art/tavern-regular-bust-1024.webp"
    portraitWidth={1024}
    portraitHeight={1205}
    initialBeats={["What would you like to know about Nhovem or the guild?"]}
    replies={regularQuestions.map((q: any) => ({
      question: q.question,
      answer: q.answer
    }))}
    farewell={{
      question: "End conversation",
      answer: "Safe journeys. Come back if you need any more answers about the developer."
    }}
    closeLabel="Close Dialogue (Esc)"
    mode="modal"
  />

  <!-- The Hooded Archivist Dialogue (In-Scene Unified Modal) -->
  <NpcDialogue
    npcId="archivist"
    title="The Hooded Archivist"
    showCloseIcon={false}
    portraitSrc="/art/archivist-neutral-520.webp"
    portraitWidth={520}
    portraitHeight={1263}
    initialBeats={archivistBeats}
    replies={archivistReplies}
    farewell={{
      question: "Conclude inquiry",
      answer: "May your craft be sound and your tests pass true. Return whenever the archives are needed."
    }}
    closeLabel="Close Archives (Esc)"
    mode="modal"
  />

  <!-- Quest Board Bounty Popup -->
  <div id="dialog-questboard" class="tavern-panel questboard-panel" role="dialog" aria-modal="true" aria-labelledby="questboard-title" hidden>
    <div class="panel-header flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-[#140b04] border border-[var(--brass)] flex items-center justify-center shrink-0 shadow">
          <ThematicIcon name="scroll" class="w-6 h-6 text-[var(--candle)]" />
        </div>
        <div>
          <span class="text-[10px] sm:text-xs uppercase font-extrabold tracking-widest text-[#d5803b]">Active Bounties & Proof of Work</span>
          <h2 id="questboard-title" class="text-xl sm:text-2xl font-bold text-[var(--candle)] font-serif leading-tight">
            The Quest Board
          </h2>
        </div>
      </div>
    </div>

    <div class="panel-body questboard-body">
      <p class="text-xs sm:text-sm text-[var(--parchment)]/90 leading-relaxed mb-3">
        Pinned upon the weathered tavern cork are active bounties and completed software development projects. Inspect any bounty notice to review the full architectural case study dossier.
      </p>

      <!-- 3 Pinned Bounty Cards Grid -->
      <div class="bounties-grid">
        {projects.map((project) => (
          <article class="bounty-slip" id={`bounty-${project.data.slug}`}>
            <div class="bounty-pin" aria-hidden="true"></div>

            <div class="bounty-top">
              <div class="flex items-center gap-2.5 mb-1.5">
                <div class="w-8 h-8 rounded-md border border-[var(--brass)] bg-[#1e1208] p-0.5 flex items-center justify-center shrink-0 overflow-hidden shadow-xs">
                  {project.data.thumbnail ? (
                    <img
                      src={project.data.thumbnail}
                      alt=""
                      class="w-full h-full object-contain rounded-xs"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <ThematicIcon name="swords" class="w-5 h-5 text-[var(--candle)]" />
                  )}
                </div>
                <h3 class="bounty-heading">
                  {project.data.title.split('—')[0].trim()}
                </h3>
              </div>

              <div class="flex items-center justify-between gap-1 text-[10px] font-mono mb-2">
                <span class="bounty-role text-[#5c3e21] font-semibold">{project.data.role}</span>
                <span class={`bounty-badge ${project.data.status === 'Shipped' ? 'badge-shipped' : 'badge-progress'}`}>
                  {project.data.status === 'Shipped' ? '● Shipped' : '◐ In Progress'}
                </span>
              </div>

              <p class="bounty-desc">
                {project.data.summary}
              </p>
            </div>

            <div class="bounty-bottom">
              <div class="bounty-tags mb-3">
                {project.data.stack.slice(0, 3).map((tech: string) => (
                  <span class="bounty-tag">{tech}</span>
                ))}
                {project.data.stack.length > 3 && (
                  <span class="bounty-tag opacity-80">+{project.data.stack.length - 3}</span>
                )}
              </div>

              <a
                href={`/quests/${project.data.slug}`}
                class="bounty-cta"
              >
                <span>Inspect Dossier &rarr;</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="panel-actions questboard-footer flex flex-wrap items-center justify-between gap-3 pt-3">
      <a
        href="/quests"
        class="inline-flex items-center gap-1.5 text-xs font-bold text-[var(--candle)] hover:underline min-h-[44px] px-2"
      >
        <ThematicIcon name="scroll" class="w-4 h-4 text-[var(--brass)]" />
        <span>Inspect Full Quest Catalog &rarr;</span>
      </a>

      <button
        type="button"
        class="close-panel-btn inline-flex items-center justify-center min-h-[44px] px-6 py-2 bg-[var(--brass)] text-black font-bold text-xs sm:text-sm rounded hover:bg-[var(--candle)] transition-colors cursor-pointer ml-auto"
      >
        Close Board (Esc)
      </button>
    </div>
  </div>

  <!-- Red Horse Senti Easter Egg Black Screen Overlay -->
  <div
    id="dialog-beer-blackout"
    class="beer-blackout-overlay fixed inset-0 z-[9999] flex flex-col items-center justify-center bg-black text-center p-6 select-none opacity-0 pointer-events-none cursor-pointer transition-opacity duration-300"
    role="dialog"
    aria-modal="true"
    aria-label="Senti Beer Lyrics"
    hidden
  >
    <!-- White Flash Burst Layer -->
    <div id="beer-flash" class="absolute inset-0 bg-white pointer-events-none z-30 opacity-0" aria-hidden="true"></div>

    <!-- Center Cinematic Stage (Pure Lyrics & Outro Image) -->
    <div class="beer-stage relative z-10 max-w-4xl mx-auto flex flex-col items-center justify-center px-4 py-8 pointer-events-none w-full">
      <div id="beer-lyrics-box" class="beer-lyrics-container min-h-[120px] flex items-center justify-center px-4 transition-opacity duration-300">
        <h2
          id="beer-active-lyric"
          class="beer-lyric-text text-xl sm:text-3xl md:text-4xl leading-relaxed tracking-tight select-none"
        ></h2>
      </div>

      <!-- Outro Image Container (Pure Image, No Subtitle / Lyrics) -->
      <div
        id="beer-outro-container"
        class="beer-outro-container hidden flex flex-col items-center justify-center pointer-events-none"
      >
        <div class="beer-outro-card relative flex flex-col items-center justify-center">
          <img
            id="beer-outro-img"
            src="/images/beer-outro.png"
            alt="Cold beer toast outro"
            width="445"
            height="449"
            class="beer-outro-img relative z-10 object-contain rounded-2xl select-none"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </div>

    <!-- Screen-Reader Accessible Dismiss (Visually Hidden) -->
    <button
      type="button"
      id="btn-close-beer-blackout"
      class="sr-only"
      aria-label="Return to the tavern"
    >
      Return to Tavern
    </button>
    <span id="beer-audio-status" class="sr-only" aria-live="polite"></span>
  </div>
</TavernLayout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400;1,700&display=swap');

  body, html {
    background-color: var(--wood-deep, #1a1005);
  }

  .scene-container {
    position: relative;
    container-type: inline-size;
    aspect-ratio: 2560 / 1431;
    width: min(100vw, calc((100dvh - var(--hud-height, 48px)) * (2560 / 1431)));
    height: min(calc(100dvh - var(--hud-height, 48px)), calc(100vw * (1431 / 2560)));
    max-width: 100vw;
    max-height: calc(100dvh - var(--hud-height, 48px));
    margin: auto;
    overflow: hidden;
    background-color: var(--wood-deep, #1a1005);
    flex-shrink: 0;
  }

  .scene-container picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .scene-background {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: fill;
  }

  .scene-overlay {
    position: absolute;
    inset: 0;
  }

  #trigger-innkeeper img,
  #trigger-archivist img {
    transition: opacity 0.25s ease-out;
  }

  .scene-container.innkeeper-away #trigger-innkeeper img,
  .scene-container.archivist-away #trigger-archivist img {
    opacity: 0;
    pointer-events: none;
  }

  .scene-object {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .scene-object::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 44px;
    height: 44px;
    transform: translate(-50%, -50%);
  }

  .scene-object img {
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
    will-change: transform, filter;
    transform: translateZ(0);
    -webkit-transform: translateZ(0);
  }

  /* Tooltip: visible by default */
  .scene-tooltip {
    position: absolute;
    pointer-events: none;
    background: var(--wood-deep, #1a1005);
    border: 1px solid #d5803b;
    color: #e6d3a8;
    padding: 4px 10px;
    font-size: clamp(0.5rem, 0.9cqw, 0.8125rem);
    font-weight: 600;
    border-radius: 4px;
    white-space: nowrap;
    opacity: 1;
    z-index: 100;
    box-shadow: 0 2px 8px rgba(0,0,0,0.6);
  }

  /* Placement variants */
  .scene-tooltip[data-placement="top"] {
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
  }
  .scene-tooltip[data-placement="bottom"] {
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
  }
  .scene-tooltip[data-placement="left"] {
    right: calc(100% + 8px);
    top: 50%;
    transform: translateY(-50%);
  }
  .scene-tooltip[data-placement="right"] {
    left: calc(100% + 8px);
    top: 50%;
    transform: translateY(-50%);
  }

  /* Measured label offsets - two drag sessions, scene 1437px and 1358px */
  #trigger-shield-languages .scene-tooltip { translate: 2.3cqw -4.4cqw; }
  #trigger-shield-tools .scene-tooltip { translate: 1.8cqw 0; }


  /* Highlight feedback - Single-pass GPU accelerated glow */
  .scene-object:is(:hover, :focus-visible) {
    filter: brightness(1.12) drop-shadow(0 0 10px rgba(213, 128, 59, 0.85));
  }

  .scene-object:focus-visible {
    outline: 2px solid rgba(213, 128, 59, 0.6);
    outline-offset: 2px;
  }

  /* Active state: brief press feedback */
  .scene-object:active {
    filter: brightness(1.2) drop-shadow(0 0 10px rgba(213, 128, 59, 0.95));
    transform: scale(0.98);
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .scene-tooltip { transition: none; }
    .scene-object { transition: none; }
    .scene-object:is(:hover, :focus-visible) {
      transform: none;
      /* Keep the glow and brightness, remove only the animation */
    }
    .scene-object:active {
      transform: none;
    }
  }

  :root[data-motion="reduced"] .scene-tooltip { transition: none; }
  :root[data-motion="reduced"] .scene-object { transition: none; }
  :root[data-motion="reduced"] .scene-object:is(:hover, :focus-visible) {
    transform: none;
    /* Keep the glow and brightness, remove only the animation */
  }
  :root[data-motion="reduced"] .scene-object:active {
    transform: none;
  }

  /* Arched Doorway Hotspot & Cutout Sprite */
  .door-hotspot {
    cursor: pointer;
    transition: filter 0.25s ease-out, transform 0.25s ease-out;
  }
  .door-hotspot::before {
    content: '';
    position: absolute;
    inset: -6px -12px;
    cursor: pointer;
  }
  .door-hotspot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    user-select: none;
  }

  /* Ground Shadow for Characters */
  .ground-shadow {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translate(-50%, 50%);
    width: 80%;
    height: 20px;
    background: radial-gradient(ellipse at center, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0) 70%);
    z-index: -1;
  }

  /* Reserved dialogue area */
  .reserved-dialogue-area {
    position: absolute;
    left: 30%;
    top: 75%;
    width: 40%;
    height: 20%;
    z-index: 5;
  }

  /* Narrow Screens (<= 768px) */
  .narrow-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .narrow-link {
