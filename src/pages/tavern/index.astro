  /* Fine pointers get their labels back on hover and on focus: 769px to 1000px */
  @media (max-width: 1000px) and (hover: hover) and (pointer: fine) {
    .scene-object:hover .scene-tooltip,
    .scene-object:focus-visible .scene-tooltip,
    .scene-object:focus-within .scene-tooltip {
      opacity: 1;
      visibility: visible;
    }
  }

  /* Keyboard focus always names its target, on every device and at every width */
  @media (max-width: 1000px) {
    .scene-object:focus-visible .scene-tooltip,
    .scene-object:focus-within .scene-tooltip {
      opacity: 1;
