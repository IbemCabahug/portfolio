  }

  .orientation-prompt-body {
    font-size: 0.8125rem;
    line-height: 1.35;
    color: #c4b195;
    margin: 2px 0 0;
  }

  .orientation-dismiss-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    border: none;
