  /* Global Backdrop */
  .dialog-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(8, 5, 2, 0.78);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 45;
    animation: backdropFade 0.2s ease-out forwards;
