    min-height: 44px; /* Maintain 44px min touch target */
  }

  /* F19: Orientation Prompt Base Styles */
  .orientation-prompt {
    display: none; /* Hidden by default; activated via portrait narrow media query */
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    margin: 16px auto 0;
    max-width: 440px;
    width: calc(100% - 32px);
    background: rgba(26, 16, 5, 0.95);
    border: 1px solid #8b6b4a;
    border-radius: 6px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.6);
    color: #f6efe2;
    box-sizing: border-box;
  }

  .orientation-prompt[data-dismissed="true"] {
    display: none !important;
  }

  .orientation-prompt-visual {
    display: flex;
    align-items: center;
    gap: 4px;
    color: var(--candle, #ffcc00);
    flex-shrink: 0;
  }

  .phone-rotate-icon {
