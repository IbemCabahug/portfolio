  <script type="application/json" id="innkeeper-data" is:inline set:html={JSON.stringify({
    replies: innkeeperReplies,
    farewell: innkeeperFarewell,
    beats: innkeeperBeats.map((d: any) => d.line),
  })} />
<script>
  import { initPerformanceGovernor } from '../../lib/perf-governor';
  import { soundEngine } from '../../lib/sound-engine';

  function initTavernPage() {
    initPerformanceGovernor();
    soundEngine.init();
    const triggerInnkeeper = document.getElementById('trigger-innkeeper');
    const narrowInnkeeper = document.getElementById('narrow-innkeeper');
    const triggerQuestBoard = document.getElementById('trigger-quest-board');
    
    const dialogSkills = document.getElementById('dialog-skills');
    const dialogInnkeeper = document.getElementById('dialog-innkeeper');
    const dialogQuestboard = document.getElementById('dialog-questboard');

    const sceneInteractives = document.querySelectorAll<HTMLElement>('.scene-object, .scene-papers, .scene-door');
    let activeDialog: HTMLElement | null = null;
    let activeTrigger: HTMLElement | null = null;

    function openDialog(dialog: HTMLElement, trigger: HTMLElement, filterCategory?: string) {
      soundEngine.playParchmentRustle();
      sceneInteractives.forEach(el => {
        el.classList.add('disabled-by-dialog');
        el.setAttribute('tabindex', '-1');
      });
      
      // Handle filtering for skills dialog
      if (dialog === dialogSkills) {
        const categories = dialog.querySelectorAll('.skill-category');
        categories.forEach(cat => {
          if (filterCategory && cat.getAttribute('data-category') !== filterCategory) {
            cat.classList.add('filtered-out');
          } else {
            cat.classList.remove('filtered-out');
          }
        });
      }
      
      dialog.hidden = false;
      dialog.setAttribute('aria-hidden', 'false');
      trigger.setAttribute('aria-expanded', 'true');
      activeDialog = dialog;
      activeTrigger = trigger;
      
      if (dialog === dialogSkills) {
        const icon = dialog.querySelector('.panel-icon');
        if (icon) {
          if (filterCategory) {
            const shieldId = trigger.id.replace('trigger-', '');
            icon.setAttribute('src', `/art/${shieldId}-256.webp`);
            icon.removeAttribute('srcset');
          } else {
            icon.setAttribute('src', '/art/adventurers-badge-384.webp');
          }
        }
        const title = dialog.querySelector('#skills-title');
        if (title) {
          title.textContent = filterCategory ? filterCategory : 'Skills & Arsenal';
        }
      }
      
      const focusables = getFocusableElements(dialog);
      if (focusables.length) focusables[0].focus({ preventScroll: true });
      
      document.addEventListener('keydown', handleKeydown);
    }

    function closeDialog() {
      if (!activeDialog) return;
      soundEngine.playWoodClink();
      sceneInteractives.forEach(el => {
        el.classList.remove('disabled-by-dialog');
        el.removeAttribute('tabindex');
      });
      activeDialog.hidden = true;
      activeDialog.setAttribute('aria-hidden', 'true');
      if (activeTrigger) {
        activeTrigger.setAttribute('aria-expanded', 'false');
        activeTrigger.focus({ preventScroll: true });
      }
      activeDialog = null;
      activeTrigger = null;
      document.removeEventListener('keydown', handleKeydown);
    }

    function getFocusableElements(el: HTMLElement): HTMLElement[] {
      return Array.from(el.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])'));
    }

    function handleKeydown(e: KeyboardEvent) {
      if (e.key === 'Escape') {
        closeDialog();
        return;
      }
      if (e.key === 'Tab' && activeDialog) {
        const focusables = getFocusableElements(activeDialog);
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        
        if (e.shiftKey) {
          if (document.activeElement === first) {
            e.preventDefault();
            last.focus();
          }
        } else {
          if (document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      }
    }

    // Setup shield triggers
    document.querySelectorAll('button[id^="trigger-shield-"]').forEach(trigger => {
      if (dialogSkills && trigger instanceof HTMLElement) {
        trigger.setAttribute('aria-haspopup', 'dialog');
        trigger.setAttribute('aria-expanded', 'false');
        trigger.setAttribute('aria-controls', 'dialog-skills');
        trigger.addEventListener('click', (e) => {
          e.preventDefault();
          const filter = trigger.getAttribute('data-filter') || undefined;
          openDialog(dialogSkills, trigger, filter);
        });
      }
    });

    // Setup Innkeeper triggers
    [triggerInnkeeper, narrowInnkeeper].forEach(trigger => {
      if (trigger && dialogInnkeeper) {
        trigger.setAttribute('aria-haspopup', 'dialog');
        trigger.setAttribute('aria-expanded', 'false');
        trigger.setAttribute('aria-controls', 'dialog-innkeeper');
        trigger.addEventListener('click', (e) => {
          e.preventDefault();
          resetInnkeeperDialog();
          document.querySelector('.scene-container')?.classList.add('innkeeper-away');
          openDialog(dialogInnkeeper, trigger);
        });
      }
    });

    // Setup Quest Board trigger
    if (triggerQuestBoard && dialogQuestboard) {
      triggerQuestBoard.addEventListener('click', (e) => {
        e.preventDefault();
        openDialog(dialogQuestboard, triggerQuestBoard);
      });
    }

    document.querySelectorAll('.close-panel-btn, .close-panel-btn-secondary').forEach(btn => {
      btn.addEventListener('click', closeDialog);
      btn.addEventListener('click', () => {
        document.querySelector('.scene-container')?.classList.remove('innkeeper-away');
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelector('.scene-container')?.classList.remove('innkeeper-away');
      }
    });

    const innkeeperDataEl = document.getElementById('innkeeper-data');
    const innkeeperData = innkeeperDataEl ? JSON.parse(innkeeperDataEl.textContent || '{}') : null;
    const innkeeperProse = document.getElementById('innkeeper-prose');
    const innkeeperRepliesList = document.getElementById('innkeeper-replies');
    const innkeeperRepliesInitialHTML = innkeeperRepliesList ? innkeeperRepliesList.innerHTML : '';

    const innkeeperAnnounce = document.getElementById('innkeeper-announce');
    const TYPE_MS = 25;
    const PAUSE_AFTER: Record<string, number> = { '.': 8, '!': 8, '?': 8, ',': 4, ';': 4, ':': 4 };
    let typeTimer: number | null = null;
    let typingDone = true;
    let finishTyping: (() => void) | null = null;

    function stopTyping() {
      if (typeTimer !== null) { clearTimeout(typeTimer); typeTimer = null; }
    }

    function renderProse(html: string) {
      if (!innkeeperProse) return;
      stopTyping();
      finishTyping = null;

      const probe = document.createElement('div');
      probe.innerHTML = html;
      const plain = (probe.textContent || '').replace(/\s+/g, ' ').trim();

      const settle = () => {
        stopTyping();
        finishTyping = null;
        innkeeperProse.innerHTML = html;
        typingDone = true;
        if (innkeeperAnnounce) innkeeperAnnounce.textContent = plain;
        if (innkeeperRepliesList) innkeeperRepliesList.hidden = false;
      };

      if (document.documentElement.dataset.motion !== 'full') {
        settle();
        return;
      }

      typingDone = false;
      finishTyping = settle;
      if (innkeeperRepliesList) innkeeperRepliesList.hidden = true;
      innkeeperProse.innerHTML = html;

      const walker = document.createTreeWalker(innkeeperProse, NodeFilter.SHOW_TEXT);
      const originals: Text[] = [];
      let found: Node | null;
      while ((found = walker.nextNode())) originals.push(found as Text);

      const runs: Array<{ shown: HTMLElement; hidden: HTMLElement; text: string }> = [];
      for (const original of originals) {
        const text = original.nodeValue || '';
        if (!text.trim()) continue;
        const shown = document.createElement('span');
        shown.setAttribute('aria-hidden', 'true');
        const rest = document.createElement('span');
        rest.setAttribute('aria-hidden', 'true');
        rest.className = 'dialogue-unread';
        rest.textContent = text;
        const frag = document.createDocumentFragment();
        frag.appendChild(shown);
        frag.appendChild(rest);
        original.parentNode?.replaceChild(frag, original);
        runs.push({ shown, hidden: rest, text });
      }

      if (!runs.length) { settle(); return; }

      let ri = 0;
      let ci = 0;
      const step = () => {
        const run = runs[ri];
        ci += 1;
        run.shown.textContent = run.text.slice(0, ci);
        run.hidden.textContent = run.text.slice(ci);
        const ch = run.text[ci - 1];
        if (ci >= run.text.length) { ri += 1; ci = 0; }
        if (ri >= runs.length) { settle(); return; }
        typeTimer = window.setTimeout(step, TYPE_MS * (PAUSE_AFTER[ch] ?? 1));
      };
      typeTimer = window.setTimeout(step, TYPE_MS);
    }

    const innkeeperBand = document.querySelector('#dialog-innkeeper .dialogue-band');
    if (innkeeperBand) {
      innkeeperBand.addEventListener('click', () => {
        if (!typingDone && finishTyping) finishTyping();
      });
    }

    document.addEventListener('keydown', (e) => {
      const panel = document.getElementById('dialog-innkeeper');
      if (!panel || panel.hidden) return;
      if (typingDone || !finishTyping) return;
      if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') {
        e.preventDefault();
        finishTyping();
      }
    });

    function resetInnkeeperDialog() {
      stopTyping();
      typingDone = true;
      if (!innkeeperProse || !innkeeperRepliesList || !innkeeperData) return;
      renderProse(innkeeperData.beats.map((line: string) => `<p>${line}</p>`).join(''));
      innkeeperRepliesList.innerHTML = innkeeperRepliesInitialHTML;
    }

    if (innkeeperRepliesList) {
      innkeeperRepliesList.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.reply-btn');
        if (!btn || !innkeeperProse || !innkeeperData) return;

        if (btn.classList.contains('farewell-btn')) {
          renderProse(`<p>${innkeeperData.farewell.answer}</p>`);
          innkeeperRepliesList.innerHTML = '';
          innkeeperProse.focus();
        } else {
          const indexStr = btn.getAttribute('data-reply-index');
          if (indexStr !== null) {
            const idx = parseInt(indexStr, 10);
            const reply = innkeeperData.replies[idx];
            if (reply) {
              renderProse(`
                <p>${reply.answer}</p>
                ${reply.offerHref ? `<p><a href="${reply.offerHref}">${reply.offerLabel}</a></p>` : ''}
                ${reply.followUp ? `<p class="dialogue-followup">${reply.followUp}</p>` : ''}
              `);
              btn.classList.add('reply-visited');
            }
          }
        }
      });
    }

    // F19: Orientation Prompt Session Dismissal
    const promptEl = document.getElementById('tavern-orientation-prompt');
    const dismissBtn = document.getElementById('dismiss-orientation-prompt');
    const PROMPT_STORAGE_KEY = 'tavern_orientation_dismissed';

    if (promptEl && dismissBtn) {
      try {
        if (sessionStorage.getItem(PROMPT_STORAGE_KEY) === 'true') {
          promptEl.setAttribute('data-dismissed', 'true');
        }
      } catch (e) {
        // Gracefully ignore storage restrictions
      }

      dismissBtn.addEventListener('click', () => {
        promptEl.setAttribute('data-dismissed', 'true');
        try {
          sessionStorage.setItem(PROMPT_STORAGE_KEY, 'true');
        } catch (e) {}
      });
    }
  }

  document.addEventListener('astro:page-load', initTavernPage);
</script>
