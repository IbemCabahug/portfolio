  }

  .orientation-dismiss-btn:hover,
  .orientation-dismiss-btn:focus-visible {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.1);
    outline: 2px solid var(--brass, #c5a059);
  }

  :root[data-motion="reduced"] .orientation-prompt-visual,
  :root[data-motion="reduced"] .orientation-dismiss-btn {
    transition: none;
    animation: none;
  }
  
  /* Panels styling */
  .tavern-panel {
    position: fixed;
    background: rgba(15, 10, 5, 0.96);
    border: 2px solid #8b6b4a;
    border-radius: 8px;
