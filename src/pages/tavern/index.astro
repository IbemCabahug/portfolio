  .beer-bottle-hotspot:hover .beer-bottle-sprite,
  .beer-bottle-hotspot:focus-visible .beer-bottle-sprite {
    filter: drop-shadow(0 0 12px rgba(239, 68, 68, 0.8)) drop-shadow(0 0 4px rgba(245, 158, 11, 0.9)) brightness(1.15);
    transform: scale(1.1) translateY(-2px);
  }

  /* Red Horse Senti Black Screen Overlay */
  .beer-blackout-overlay {
    background-color: #000000;
    transition: opacity 0.3s ease-in-out;
  }
  .beer-blackout-overlay:not([hidden]) {
    opacity: 1;
    pointer-events: auto;
  }
  .beer-flash-burst {
    animation: flashBurstAnim 0.45s ease-out forwards;
  }
  @keyframes flashBurstAnim {
    0% { opacity: 0; }
    25% { opacity: 1; }
    100% { opacity: 0; }
  }
  .beer-lyric-text {
    font-family: 'Courier Prime', 'Courier New', Courier, monospace;
    font-weight: 700;
    color: #ffffff;
    text-shadow: 0 0 20px rgba(255, 255, 255, 0.45), 0 0 40px rgba(255, 255, 255, 0.2);
    transition: opacity 0.28s ease, transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .beer-lyric-text.lyric-switching {
    opacity: 0;
    transform: translateY(8px) scale(0.98);
  }
  .beer-outro-container {
    opacity: 0;
    transform: scale(0.94);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }
  .beer-outro-container.outro-visible {
    opacity: 1;
    transform: scale(1);
  }
  .beer-outro-container.outro-fading-out {
    opacity: 0;
    transform: scale(0.96);
    transition: opacity 0.9s ease-out, transform 0.9s ease-out;
  }
  .beer-lyrics-container.hidden {
    display: none !important;
  }
  .beer-outro-container.hidden {
    display: none !important;
  }
  .beer-outro-card {
    max-width: min(88vw, 445px);
    max-height: 75vh;
  }
  .beer-outro-img {
    width: 100%;
    height: auto;
    max-height: 65vh;
    aspect-ratio: 445 / 449;
    border-radius: 1rem;
    box-shadow: none;
  }
</style>

<script>
  import { initPerformanceGovernor } from '../../lib/perf-governor';
  import { soundEngine } from '../../lib/sound-engine';
  import { recordMilestone } from '../../store/questlog';
  import { getSound, setSound } from '../../store/preferences';

  function initTavernPage() {
    initPerformanceGovernor();
    soundEngine.init();
    const triggerInnkeeper = document.getElementById('trigger-innkeeper');
    const narrowInnkeeper = document.getElementById('narrow-innkeeper');
    const triggerRegular = document.getElementById('trigger-regular');
    const narrowRegular = document.getElementById('narrow-regular');
    const triggerQuestBoard = document.getElementById('trigger-quest-board');
    
    const dialogSkills = document.getElementById('dialog-skills');
    const dialogInnkeeper = document.getElementById('dialog-innkeeper');
    const dialogRegular = document.getElementById('dialog-regular');
    const dialogArchivist = document.getElementById('dialog-archivist');
    const dialogQuestboard = document.getElementById('dialog-questboard');

    const triggerArchivist = document.getElementById('trigger-archivist');
    const narrowArchivist = document.getElementById('narrow-archivist');

    const sceneInteractives = document.querySelectorAll<HTMLElement>('.scene-object, .scene-papers, .scene-door');
    let activeDialog: HTMLElement | null = null;
    let activeTrigger: HTMLElement | null = null;

    function openDialog(dialog: HTMLElement, trigger: HTMLElement, filterCategory?: string) {
      soundEngine.playParchmentRustle();
      sceneInteractives.forEach(el => {
        el.classList.add('disabled-by-dialog');
        el.setAttribute('tabindex', '-1');
      });
      
      // Handle filtering for skills dialog
      if (dialog === dialogSkills) {
        const categories = dialog.querySelectorAll('.skill-category');
        categories.forEach(cat => {
          if (filterCategory && cat.getAttribute('data-category') !== filterCategory) {
            cat.classList.add('filtered-out');
          } else {
            cat.classList.remove('filtered-out');
          }
        });
      }
      
      const backdrop = document.getElementById('dialog-backdrop');
      if (backdrop) {
        backdrop.hidden = false;
        backdrop.setAttribute('aria-hidden', 'false');
      }

      dialog.hidden = false;
      dialog.setAttribute('aria-hidden', 'false');
      trigger.setAttribute('aria-expanded', 'true');
      activeDialog = dialog;
      activeTrigger = trigger;
      
      if (dialog === dialogSkills) {
        const icon = dialog.querySelector('.panel-icon');
        if (icon) {
          if (filterCategory) {
            const shieldId = trigger.id.replace('trigger-', '');
            icon.setAttribute('src', `/art/${shieldId}-256.webp`);
            icon.removeAttribute('srcset');
          } else {
            icon.setAttribute('src', '/art/adventurers-badge-384.webp');
          }
        }
        const title = dialog.querySelector('#skills-title');
        if (title) {
          title.textContent = filterCategory ? filterCategory : 'Skills & Arsenal';
        }
      }
      
      const focusables = getFocusableElements(dialog);
      if (focusables.length) focusables[0].focus({ preventScroll: true });
      
      document.addEventListener('keydown', handleKeydown);
    }

    function closeDialog() {
      if (!activeDialog) return;
      if ((activeDialog as any).__stopDialogue) {
        (activeDialog as any).__stopDialogue();
      }
      soundEngine.playWoodClink();
      sceneInteractives.forEach(el => {
        el.classList.remove('disabled-by-dialog');
        el.removeAttribute('tabindex');
      });
      const backdrop = document.getElementById('dialog-backdrop');
      if (backdrop) {
        backdrop.hidden = true;
        backdrop.setAttribute('aria-hidden', 'true');
      }
      activeDialog.hidden = true;
      activeDialog.setAttribute('aria-hidden', 'true');
      if (activeTrigger) {
        activeTrigger.setAttribute('aria-expanded', 'false');
        activeTrigger.focus({ preventScroll: true });
      }
      activeDialog = null;
      activeTrigger = null;
      document.removeEventListener('keydown', handleKeydown);
    }

    function getFocusableElements(el: HTMLElement): HTMLElement[] {
      return Array.from(el.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])'));
    }

    function handleKeydown(e: KeyboardEvent) {
      if (e.key === 'Escape') {
        closeDialog();
        return;
      }
      if (e.key === 'Tab' && activeDialog) {
        const focusables = getFocusableElements(activeDialog);
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        
        if (e.shiftKey) {
          if (document.activeElement === first) {
            e.preventDefault();
            last.focus();
          }
        } else {
          if (document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      }
    }

    // Setup shield triggers
    document.querySelectorAll('button[id^="trigger-shield-"]').forEach(trigger => {
      if (dialogSkills && trigger instanceof HTMLElement) {
        trigger.setAttribute('aria-haspopup', 'dialog');
        trigger.setAttribute('aria-expanded', 'false');
        trigger.setAttribute('aria-controls', 'dialog-skills');
        trigger.addEventListener('click', (e) => {
          e.preventDefault();
          const filter = trigger.getAttribute('data-filter') || undefined;
          openDialog(dialogSkills, trigger, filter);
        });
      }
    });

    // Setup Innkeeper triggers
    [triggerInnkeeper, narrowInnkeeper].forEach(trigger => {
      if (trigger && dialogInnkeeper) {
        trigger.setAttribute('aria-haspopup', 'dialog');
        trigger.setAttribute('aria-expanded', 'false');
        trigger.setAttribute('aria-controls', 'dialog-innkeeper');
        trigger.addEventListener('click', (e) => {
          e.preventDefault();
          document.querySelector('.scene-container')?.classList.add('innkeeper-away');
          openDialog(dialogInnkeeper, trigger);
          if ((dialogInnkeeper as any).__resetDialogue) {
            (dialogInnkeeper as any).__resetDialogue(true);
          }
        });
      }
    });

    // Setup Tavern Regular triggers
    [triggerRegular, narrowRegular].forEach(trigger => {
      if (trigger && dialogRegular) {
        trigger.setAttribute('aria-haspopup', 'dialog');
        trigger.setAttribute('aria-expanded', 'false');
        trigger.setAttribute('aria-controls', 'dialog-regular');
        trigger.addEventListener('click', (e) => {
          e.preventDefault();
          openDialog(dialogRegular, trigger);
          if ((dialogRegular as any).__resetDialogue) {
            (dialogRegular as any).__resetDialogue(true);
          }
        });
      }
    });

    // Setup The Hooded Archivist triggers
    [triggerArchivist, narrowArchivist].forEach(trigger => {
      if (trigger && dialogArchivist) {
        trigger.setAttribute('aria-haspopup', 'dialog');
        trigger.setAttribute('aria-expanded', 'false');
        trigger.setAttribute('aria-controls', 'dialog-archivist');
        trigger.addEventListener('click', (e) => {
          e.preventDefault();
          document.querySelector('.scene-container')?.classList.add('archivist-away');
          openDialog(dialogArchivist, trigger);
          if ((dialogArchivist as any).__resetDialogue) {
            (dialogArchivist as any).__resetDialogue(true);
          }
        });
      }
    });

    // Setup Quest Board trigger
    if (triggerQuestBoard && dialogQuestboard) {
      triggerQuestBoard.addEventListener('click', (e) => {
        e.preventDefault();
        openDialog(dialogQuestboard, triggerQuestBoard);
      });
    }

    // Setup Narrow Viewport Triggers for Portrait Mode
    const narrowSkills = document.getElementById('narrow-skills');
    const narrowQuestboard = document.getElementById('narrow-questboard');
    if (narrowSkills && dialogSkills) {
      narrowSkills.addEventListener('click', (e) => {
        e.preventDefault();
        openDialog(dialogSkills, narrowSkills);
      });
    }
    if (narrowQuestboard && dialogQuestboard) {
      narrowQuestboard.addEventListener('click', (e) => {
        e.preventDefault();
        openDialog(dialogQuestboard, narrowQuestboard);
      });
    }

    // Backdrop click closes dialog
    document.getElementById('dialog-backdrop')?.addEventListener('click', () => {
      closeDialog();
      document.querySelector('.scene-container')?.classList.remove('innkeeper-away', 'archivist-away');
    });

    document.querySelectorAll('.close-panel-btn, .close-panel-btn-secondary').forEach(btn => {
      btn.addEventListener('click', closeDialog);
      btn.addEventListener('click', () => {
        document.querySelector('.scene-container')?.classList.remove('innkeeper-away', 'archivist-away');
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelector('.scene-container')?.classList.remove('innkeeper-away', 'archivist-away');
      }
    });

    // F19: Orientation Prompt Session Dismissal
    const promptEl = document.getElementById('tavern-orientation-prompt');
    const dismissBtn = document.getElementById('dismiss-orientation-prompt');
    const PROMPT_STORAGE_KEY = 'tavern_orientation_dismissed';

    if (promptEl && dismissBtn) {
      try {
        if (sessionStorage.getItem(PROMPT_STORAGE_KEY) === 'true') {
          promptEl.setAttribute('data-dismissed', 'true');
        }
      } catch (e) {
        // Gracefully ignore storage restrictions
      }

      dismissBtn.addEventListener('click', () => {
        promptEl.setAttribute('data-dismissed', 'true');
        try {
          sessionStorage.setItem(PROMPT_STORAGE_KEY, 'true');
        } catch (e) {}
      });
    }

    // ── Red Horse Beer Easter Egg Controller ─────────────────────
    const triggerBeer = document.getElementById('trigger-beer');
    const narrowBeer = document.getElementById('narrow-beer');
    const dialogBeer = document.getElementById('dialog-beer-blackout');
    const lyricsBoxEl = document.getElementById('beer-lyrics-box');
    const lyricEl = document.getElementById('beer-active-lyric');
    const outroContainerEl = document.getElementById('beer-outro-container');
    const flashEl = document.getElementById('beer-flash');
    const btnCloseBeer = document.getElementById('btn-close-beer-blackout');
    const audioStatusEl = document.getElementById('beer-audio-status');

    let beerAudio: HTMLAudioElement | null = null;
    let beerTimerIds: number[] = [];
    let beerAnimFrameId: number | null = null;
    let isBeerActive = false;
    let beerSynthCtx: AudioContext | null = null;
    let synthActiveNodes: (AudioNode | number)[] = [];

    function showOutro() {
      if (!isBeerActive) return;
      if (lyricEl) {
        lyricEl.textContent = '';
      }
      if (lyricsBoxEl) {
        lyricsBoxEl.classList.add('opacity-0', 'pointer-events-none', 'hidden');
        lyricsBoxEl.style.display = 'none';
      }
      if (outroContainerEl) {
        outroContainerEl.style.display = 'flex';
        outroContainerEl.style.transition = '';
        outroContainerEl.style.opacity = '';
        outroContainerEl.style.transform = '';
        outroContainerEl.classList.remove('hidden', 'outro-fading-out');
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            if (!isBeerActive) return;
            outroContainerEl?.classList.add('outro-visible');
          });
        });
      }
    }

    function resetLyricsAndOutro() {
      if (lyricEl) lyricEl.textContent = '';
      if (lyricsBoxEl) {
        lyricsBoxEl.style.display = '';
        lyricsBoxEl.classList.remove('hidden', 'opacity-0', 'pointer-events-none');
      }
      if (outroContainerEl) {
        outroContainerEl.style.transition = '';
        outroContainerEl.style.opacity = '';
        outroContainerEl.style.transform = '';
        outroContainerEl.style.display = 'none';
        outroContainerEl.classList.remove('outro-visible', 'outro-fading-out');
        outroContainerEl.classList.add('hidden');
      }
    }

    function setLyric(text: string, immediate = false) {
      if (!lyricEl) return;
      if (lyricsBoxEl) {
        lyricsBoxEl.style.display = '';
        lyricsBoxEl.classList.remove('hidden', 'opacity-0', 'pointer-events-none');
      }
      if (outroContainerEl) {
        outroContainerEl.style.display = 'none';
        outroContainerEl.classList.remove('outro-visible', 'outro-fading-out');
        outroContainerEl.classList.add('hidden');
      }
      if (immediate || !lyricEl.textContent || lyricEl.textContent === '...') {
        lyricEl.textContent = text;
        lyricEl.classList.remove('lyric-switching');
        return;
      }
      lyricEl.classList.add('lyric-switching');
      const timer = window.setTimeout(() => {
        if (!isBeerActive) return;
        lyricEl.textContent = text;
        lyricEl.classList.remove('lyric-switching');
      }, 120);
      beerTimerIds.push(timer);
    }

    function playProceduralBeerMelody() {
      if (typeof window === 'undefined') return;
      const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
      if (!AudioCtx) return;

      try {
        beerSynthCtx = new AudioCtx();
        if (beerSynthCtx.state === 'suspended') {
          beerSynthCtx.resume();
        }
        const ctx = beerSynthCtx;
        const now = ctx.currentTime + 0.04;

        // Master output & warm acoustic room simulation
        const master = ctx.createGain();
        master.gain.setValueAtTime(0.001, now);
        master.gain.linearRampToValueAtTime(0.28, now + 0.25);
        master.connect(ctx.destination);
        synthActiveNodes.push(master);

        // Acoustic body warmth filter (peaking filter for wooden soundboard resonance)
        const bodyResonance = ctx.createBiquadFilter();
        bodyResonance.type = 'peaking';
        bodyResonance.frequency.setValueAtTime(220, now);
        bodyResonance.Q.setValueAtTime(2.2, now);
        bodyResonance.gain.setValueAtTime(3.5, now);
        bodyResonance.connect(master);

        // Warm high-cut filter for natural nylon/steel string character
        const acousticWarmth = ctx.createBiquadFilter();
        acousticWarmth.type = 'lowpass';
        acousticWarmth.frequency.setValueAtTime(3200, now);
        acousticWarmth.connect(bodyResonance);

        // Vocal presence filter
        const vocalPresence = ctx.createBiquadFilter();
        vocalPresence.type = 'peaking';
        vocalPresence.frequency.setValueAtTime(1400, now);
        vocalPresence.Q.setValueAtTime(1.8, now);
        vocalPresence.gain.setValueAtTime(2.0, now);
        vocalPresence.connect(master);

        // Note frequencies for authentic Key of G Major
        const N = {
          G2: 98.00, A2: 110.00, B2: 123.47, C3: 130.81, D3: 146.83, E3: 164.81, Fs3: 185.00, G3: 196.00,
          A3: 220.00, B3: 246.94, C4: 261.63, Cs4: 277.18, D4: 293.66, Ds4: 311.13, E4: 329.63,
          Fs4: 369.99, G4: 392.00, A4: 440.00, B4: 493.88, C5: 523.25, Cs5: 554.37, D5: 587.33,
          Ds5: 622.25, E5: 659.25, Fs5: 739.99, G5: 783.99, A5: 880.00, B5: 987.77
        };

        const BPM = 72;
        const BEAT = 60 / BPM; // ~0.8333s per beat

        function pluckChord(timeOffset: number, freqs: number[], isSustained = false) {
          freqs.forEach((freq, idx) => {
            const strumTime = now + timeOffset + (idx * 0.032);
            const osc = ctx.createOscillator();
            const pluckSnap = ctx.createOscillator();
            const gain = ctx.createGain();
            const snapGain = ctx.createGain();

            // Main string body
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(freq, strumTime);

            // Initial pick contact transient
            pluckSnap.type = 'sawtooth';
            pluckSnap.frequency.setValueAtTime(freq, strumTime);

            const duration = isSustained ? 3.6 : 2.4;

            gain.gain.setValueAtTime(0.0001, strumTime);
            gain.gain.linearRampToValueAtTime(0.12, strumTime + 0.008);
            gain.gain.exponentialRampToValueAtTime(0.05, strumTime + 0.08);
            gain.gain.exponentialRampToValueAtTime(0.0001, strumTime + duration);

            snapGain.gain.setValueAtTime(0.04, strumTime);
            snapGain.gain.exponentialRampToValueAtTime(0.0001, strumTime + 0.04);

            osc.connect(gain);
            pluckSnap.connect(snapGain);
            gain.connect(acousticWarmth);
            snapGain.connect(acousticWarmth);

            osc.start(strumTime);
            pluckSnap.start(strumTime);
            osc.stop(strumTime + duration + 0.05);
            pluckSnap.stop(strumTime + 0.05);
            synthActiveNodes.push(osc, pluckSnap, gain, snapGain);
          });
        }

        function playMelodyNote(timeOffset: number, freq: number, duration: number) {
          const startTime = now + timeOffset;
          const osc = ctx.createOscillator();
          const harmonic = ctx.createOscillator();
          const vibrato = ctx.createOscillator();
          const vibratoGain = ctx.createGain();
          const mainGain = ctx.createGain();
          const harmGain = ctx.createGain();

          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, startTime);

          harmonic.type = 'triangle';
          harmonic.frequency.setValueAtTime(freq * 2, startTime);

          // Humanized expressive vocal vibrato blooming after 120ms
          vibrato.frequency.setValueAtTime(5.2, startTime);
          vibratoGain.gain.setValueAtTime(0, startTime);
          vibratoGain.gain.setValueAtTime(0, startTime + Math.min(0.15, duration * 0.35));
          vibratoGain.gain.linearRampToValueAtTime(4.2, startTime + Math.min(0.35, duration * 0.7));
          vibrato.connect(osc.frequency);

          // Soft vocal envelope
          mainGain.gain.setValueAtTime(0.0001, startTime);
          mainGain.gain.linearRampToValueAtTime(0.16, startTime + 0.035);
          mainGain.gain.setValueAtTime(0.14, startTime + duration - 0.06);
          mainGain.gain.exponentialRampToValueAtTime(0.0001, startTime + duration);

          harmGain.gain.setValueAtTime(0.0001, startTime);
          harmGain.gain.linearRampToValueAtTime(0.03, startTime + 0.035);
          harmGain.gain.setValueAtTime(0.02, startTime + duration - 0.06);
          harmGain.gain.exponentialRampToValueAtTime(0.0001, startTime + duration);

          osc.connect(mainGain);
          harmonic.connect(harmGain);
          mainGain.connect(vocalPresence);
          harmGain.connect(vocalPresence);

          vibrato.start(startTime);
          osc.start(startTime);
          harmonic.start(startTime);
          vibrato.stop(startTime + duration + 0.05);
          osc.stop(startTime + duration + 0.05);
          harmonic.stop(startTime + duration + 0.05);
          synthActiveNodes.push(osc, harmonic, vibrato, vibratoGain, mainGain, harmGain);
        }

        function playSoftThump(timeOffset: number) {
          const t = now + timeOffset;
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(65, t);
          osc.frequency.exponentialRampToValueAtTime(35, t + 0.08);
          gain.gain.setValueAtTime(0.06, t);
          gain.gain.exponentialRampToValueAtTime(0.0001, t + 0.08);
          osc.connect(gain);
          gain.connect(master);
          osc.start(t);
          osc.stop(t + 0.09);
          synthActiveNodes.push(osc, gain);
        }

        function playBottleClink(timeOffset: number) {
          const t = now + timeOffset;
          const osc1 = ctx.createOscillator();
          const osc2 = ctx.createOscillator();
          const gain = ctx.createGain();

          osc1.type = 'sine';
          osc1.frequency.setValueAtTime(2780, t);
          osc2.type = 'sine';
          osc2.frequency.setValueAtTime(3920, t);

          gain.gain.setValueAtTime(0.07, t);
          gain.gain.exponentialRampToValueAtTime(0.0001, t + 0.28);

          osc1.connect(gain);
          osc2.connect(gain);
          gain.connect(master);

          osc1.start(t);
          osc2.start(t);
          osc1.stop(t + 0.3);
          osc2.stop(t + 0.3);
          synthActiveNodes.push(osc1, osc2, gain);
        }

        // ── Authentic Chorus Chords: G Major (C - G - Em - Bm ...) ──
        // Measure 1: C -> G
        pluckChord(0.0 * BEAT, [N.C3, N.G3, N.C4, N.E4, N.G4]);
        pluckChord(1.0 * BEAT, [N.G3, N.C4, N.E4]);
        pluckChord(2.0 * BEAT, [N.G2, N.D3, N.G3, N.B3, N.D4]);
        pluckChord(3.0 * BEAT, [N.D3, N.G3, N.B3]);

        // Measure 2: Em -> Bm
        pluckChord(4.0 * BEAT, [N.E3, N.B3, N.E4, N.G4]);
        pluckChord(5.0 * BEAT, [N.B3, N.E4, N.G4]);
        pluckChord(6.0 * BEAT, [N.B2, N.Fs3, N.B3, N.D4, N.Fs4]);
        pluckChord(7.0 * BEAT, [N.Fs3, N.B3, N.D4]);

        // Measure 3: C -> G
        pluckChord(8.0 * BEAT, [N.C3, N.G3, N.C4, N.E4, N.G4]);
        pluckChord(9.0 * BEAT, [N.G3, N.C4, N.E4]);
        pluckChord(10.0 * BEAT, [N.G2, N.D3, N.G3, N.B3, N.D4]);
        pluckChord(11.0 * BEAT, [N.D3, N.G3, N.B3]);

        // Measure 4: Em -> Bm
        pluckChord(12.0 * BEAT, [N.E3, N.B3, N.E4, N.G4]);
        pluckChord(13.0 * BEAT, [N.B3, N.E4, N.G4]);
        pluckChord(14.0 * BEAT, [N.B2, N.Fs3, N.B3, N.D4, N.Fs4]);
        pluckChord(15.0 * BEAT, [N.Fs3, N.B3, N.D4]);

        // Measure 5: C -> B7
        pluckChord(16.0 * BEAT, [N.C3, N.G3, N.C4, N.E4, N.G4]);
        pluckChord(17.0 * BEAT, [N.G3, N.C4, N.E4]);
        pluckChord(18.0 * BEAT, [N.B2, N.Ds4, N.Fs4, N.A4, N.B4]);
        pluckChord(19.0 * BEAT, [N.Fs3, N.Ds4, N.Fs4, N.A4]);

        // Measure 6: Em -> Em/D -> A7
        pluckChord(20.0 * BEAT, [N.E3, N.B3, N.E4, N.G4]);
        pluckChord(21.0 * BEAT, [N.D3, N.B3, N.E4, N.G4]); // Em/D bass walkdown
        pluckChord(22.0 * BEAT, [N.A2, N.E3, N.G3, N.Cs4, N.E4]); // A7
        pluckChord(23.0 * BEAT, [N.E3, N.G3, N.Cs4]);

        // Measure 7: Am -> D7
        pluckChord(24.0 * BEAT, [N.A2, N.E3, N.A3, N.C4, N.E4]);
        pluckChord(25.0 * BEAT, [N.E3, N.A3, N.C4]);
        pluckChord(26.0 * BEAT, [N.D3, N.A3, N.C4, N.Fs4]);
        pluckChord(27.0 * BEAT, [N.A3, N.C4, N.Fs4]);

        // Measure 8: G Major resolution
        pluckChord(28.0 * BEAT, [N.G2, N.D3, N.G3, N.B3, N.D4, N.G4], true);
        pluckChord(30.0 * BEAT, [N.D3, N.G3, N.B3, N.D4]);
        pluckChord(31.0 * BEAT, [N.G2, N.D3, N.G3, N.B3, N.G4], true);

        // Soft rhythmic boot-thumps on downbeats
        [0, 4, 8, 12, 16, 20, 24, 28].forEach(b => playSoftThump(b * BEAT));

        // ── Note-by-Note Authentic Vocal Melody ─────────────────────
        // Measure 1: "I-bu-hos na ang beer"
        playMelodyNote(0.0 * BEAT, N.B4, 0.35);
        playMelodyNote(0.45 * BEAT, N.C5, 0.35);
        playMelodyNote(0.9 * BEAT, N.D5, 0.45);
        playMelodyNote(1.4 * BEAT, N.E5, 0.38);
        playMelodyNote(1.85 * BEAT, N.C5, 0.38);
        playMelodyNote(2.3 * BEAT, N.B4, 1.25);

        // Measure 2: "Sa a-king la-la-mu-nan"
        playMelodyNote(4.0 * BEAT, N.B4, 0.32);
        playMelodyNote(4.4 * BEAT, N.D5, 0.32);
        playMelodyNote(4.8 * BEAT, N.Fs5, 0.40);
        playMelodyNote(5.3 * BEAT, N.G5, 0.35);
        playMelodyNote(5.75 * BEAT, N.Fs5, 0.35);
        playMelodyNote(6.2 * BEAT, N.E5, 0.35);
        playMelodyNote(6.65 * BEAT, N.D5, 0.95);

        // Measure 3: "U-pang ma-lu-nod na ang"
        playMelodyNote(8.0 * BEAT, N.B4, 0.35);
        playMelodyNote(8.45 * BEAT, N.C5, 0.35);
        playMelodyNote(8.9 * BEAT, N.D5, 0.45);
        playMelodyNote(9.4 * BEAT, N.E5, 0.38);
        playMelodyNote(9.85 * BEAT, N.C5, 0.38);
        playMelodyNote(10.3 * BEAT, N.B4, 0.50);
        playMelodyNote(10.9 * BEAT, N.A4, 0.65);

        // Measure 4: "Pu-so kong na-hi-hi-ra-pan"
        playMelodyNote(12.0 * BEAT, N.B4, 0.32);
        playMelodyNote(12.4 * BEAT, N.D5, 0.32);
        playMelodyNote(12.8 * BEAT, N.Fs5, 0.40);
        playMelodyNote(13.3 * BEAT, N.G5, 0.35);
        playMelodyNote(13.75 * BEAT, N.Fs5, 0.35);
        playMelodyNote(14.2 * BEAT, N.E5, 0.35);
        playMelodyNote(14.65 * BEAT, N.D5, 0.35);
        playMelodyNote(15.1 * BEAT, N.B4, 0.85);

        // Measure 5: "Ba-wat pa-tak, a-nong sa-rap"
        playMelodyNote(16.0 * BEAT, N.G4, 0.32);
        playMelodyNote(16.35 * BEAT, N.D5, 0.35);
        playMelodyNote(16.75 * BEAT, N.E5, 0.35);
        playMelodyNote(17.15 * BEAT, N.E5, 0.55);
        playMelodyNote(18.0 * BEAT, N.A4, 0.32);
        playMelodyNote(18.35 * BEAT, N.E5, 0.35);
        playMelodyNote(18.75 * BEAT, N.Fs5, 0.38);
        playMelodyNote(19.2 * BEAT, N.Fs5, 0.60);

        // Measure 6: "A-no ba ta-la-gang mas gus-to ko"
        playMelodyNote(20.0 * BEAT, N.B4, 0.28);
        playMelodyNote(20.32 * BEAT, N.D5, 0.28);
        playMelodyNote(20.65 * BEAT, N.G5, 0.35);
        playMelodyNote(21.05 * BEAT, N.Fs5, 0.28);
        playMelodyNote(21.38 * BEAT, N.E5, 0.28);
        playMelodyNote(21.72 * BEAT, N.D5, 0.32);
        playMelodyNote(22.1 * BEAT, N.E5, 0.28);
        playMelodyNote(22.45 * BEAT, N.Fs5, 0.28);
        playMelodyNote(22.8 * BEAT, N.G5, 0.35);
        playMelodyNote(23.2 * BEAT, N.A5, 0.85);

        // Measures 7 & 8: "Ang beer na 'to, o ang pag-i-big mo"
        playMelodyNote(24.0 * BEAT, N.G4, 0.30);
        playMelodyNote(24.35 * BEAT, N.B4, 0.40);
        playMelodyNote(24.8 * BEAT, N.C5, 0.35);
        playMelodyNote(25.2 * BEAT, N.B4, 0.55);
        playMelodyNote(26.0 * BEAT, N.A4, 0.32);
        playMelodyNote(26.35 * BEAT, N.G4, 0.32);
        playMelodyNote(26.7 * BEAT, N.Fs4, 0.32);
        playMelodyNote(27.05 * BEAT, N.A4, 0.35);
        playMelodyNote(27.45 * BEAT, N.C5, 0.38);
        playMelodyNote(27.9 * BEAT, N.B4, 0.70);
        playMelodyNote(28.7 * BEAT, N.G4, 1.85);

        // Cold amber bottle toast clink before "Ito ang tama"
        playBottleClink(31.6 * BEAT);
      } catch (e) {}
    }

    function stopProceduralBeerMelody() {
      if (beerSynthCtx) {
        try {
          synthActiveNodes.forEach(node => {
            if (node && typeof (node as any).stop === 'function') {
              try { (node as any).stop(); } catch (e) {}
            }
            if (node && typeof (node as any).disconnect === 'function') {
              try { (node as any).disconnect(); } catch (e) {}
            }
          });
          synthActiveNodes = [];
          beerSynthCtx.close();
          beerSynthCtx = null;
        } catch (e) {}
      }
    }

    interface LyricCue {
      time: number;
      text?: string;
      isOutro?: boolean;
    }

    const LYRIC_CUES: LyricCue[] = [
      { time: 0.10, text: "Ibuhos na ang beer" },
      { time: 4.00, text: "Sa aking lalamunan" },
      { time: 11.50, text: "Upang malunod na ang" },
      { time: 16.50, text: "Puso kong nahihirapan" },
      { time: 22.60, text: "Bawat patak, anong sarap" },
      { time: 27.60, text: "Ano ba talagang mas gusto ko" },
      { time: 34.30, isOutro: true }
    ];

    function startAudioAndLyrics() {
      if (!isBeerActive) return;

      let lyricsStarted = false;
      let currentCueIdx = -1;

      function syncLyricsLoop(getTimeSec: () => number, getSongDuration: () => number) {
        if (!isBeerActive) return;

        const currentSec = getTimeSec();
        const songDuration = getSongDuration();

        // Determine which lyric cue should currently be active
        let activeIdx = -1;
        for (let i = LYRIC_CUES.length - 1; i >= 0; i--) {
          if (currentSec >= LYRIC_CUES[i].time) {
            activeIdx = i;
            break;
          }
        }

        if (activeIdx !== -1 && activeIdx !== currentCueIdx) {
          currentCueIdx = activeIdx;
          const cue = LYRIC_CUES[activeIdx];
          if (cue.isOutro) {
            showOutro();
          } else if (cue.text) {
            setLyric(cue.text, activeIdx === 0);
          }
        }

        // Gradually fade out outro image while song is still playing so it finishes exactly when song ends
        const FADE_OUT_DURATION = 4.2; // 4.2s gradual fade matching the ending chords and resolution
        const fadeStartTime = Math.max(35.2, songDuration - FADE_OUT_DURATION);

        if (outroContainerEl && currentSec >= fadeStartTime) {
          outroContainerEl.style.transition = 'none';
          const progress = Math.min(1, Math.max(0, (currentSec - fadeStartTime) / (songDuration - fadeStartTime)));
          // Smooth cosine ease-in-out S-curve for natural, gradual dissolution
          const easeProgress = 0.5 - 0.5 * Math.cos(progress * Math.PI);
          const opacity = Math.max(0, Math.min(1, 1 - easeProgress));
          outroContainerEl.style.opacity = opacity.toFixed(4);
          outroContainerEl.style.transform = `scale(${(1 - 0.03 * easeProgress).toFixed(4)})`;
        }

        // Auto-close when song finishes naturally and fade-out is complete
        if (currentSec >= songDuration + 0.35) {
          closeBeerBlackout();
          return;
        }

        beerAnimFrameId = requestAnimationFrame(() => syncLyricsLoop(getTimeSec, getSongDuration));
      }

      function launchWithAudio(audioEl: HTMLAudioElement) {
        if (lyricsStarted || !isBeerActive) return;
        lyricsStarted = true;
        beerAudio = audioEl;
        (window as any).__beerAudio = audioEl;
        if (audioStatusEl) audioStatusEl.textContent = '🎵 Playing studio recording';
        syncLyricsLoop(
          () => audioEl.currentTime,
          () => (audioEl.duration && !isNaN(audioEl.duration) ? audioEl.duration : 42.48)
        );
      }

      function launchWithSynth() {
        if (lyricsStarted || !isBeerActive) return;
        lyricsStarted = true;
        playProceduralBeerMelody();
        if (audioStatusEl) audioStatusEl.textContent = '🎵 Playing acoustic tavern melody';
        const startTime = performance.now();
        syncLyricsLoop(
          () => (performance.now() - startTime) / 1000,
          () => 40.0
        );
      }

      try {
        const testAudio = new Audio('/audio/beer.mp3');
        testAudio.volume = 0.92;
        testAudio.preload = 'auto';

        testAudio.addEventListener('playing', () => {
          launchWithAudio(testAudio);
        }, { once: true });

        testAudio.addEventListener('ended', () => {
          if (isBeerActive) {
            // When song ends, ensure opacity is 0 and close smoothly after brief silence
            if (outroContainerEl) {
              outroContainerEl.style.opacity = '0';
            }
            const endTimer = window.setTimeout(() => {
              if (isBeerActive) closeBeerBlackout();
            }, 300);
            beerTimerIds.push(endTimer);
          }
        }, { once: true });

        const playPromise = testAudio.play();
        if (playPromise) {
          playPromise.then(() => {
            launchWithAudio(testAudio);
          }).catch(() => {
            launchWithSynth();
          });
        } else {
          launchWithSynth();
        }
      } catch (e) {
        launchWithSynth();
      }
    }

    function openBeerBlackout() {
      if (!dialogBeer || isBeerActive) return;
      isBeerActive = true;

      // Award Wayfarer's Journal feat
      recordMilestone('feat_red_horse');

      // Duck tavern ambient sound
      soundEngine.duckAmbient(true);

      // Automatically activate sound if currently muted so the musical purpose is achieved
      if (getSound() !== 'on') {
        setSound('on');
      }

      // Initial clean state: reset lyrics and outro
      resetLyricsAndOutro();

      // Show black screen overlay
      dialogBeer.hidden = false;
      dialogBeer.setAttribute('aria-hidden', 'false');
      requestAnimationFrame(() => {
        dialogBeer.classList.remove('opacity-0', 'pointer-events-none');
        dialogBeer.classList.add('opacity-100', 'pointer-events-auto');
      });

      // 1. Fire bright white flash burst immediately
      if (flashEl) {
        flashEl.classList.add('beer-flash-burst');
        const flashTid = window.setTimeout(() => {
          flashEl?.classList.remove('beer-flash-burst');
        }, 460);
        beerTimerIds.push(flashTid);
      }

      // 2. Wait at least 1 second after flash in pitch black void (450ms flash + 1000ms pause = 1450ms)
      const startTid = window.setTimeout(() => {
        if (!isBeerActive) return;
        startAudioAndLyrics();
      }, 1450);
      beerTimerIds.push(startTid);

      // Focus close button for keyboard accessibility
      btnCloseBeer?.focus({ preventScroll: true });
    }

    function closeBeerBlackout() {
      if (!dialogBeer || !isBeerActive) return;
      isBeerActive = false;

      // Cancel sync animation frame
      if (beerAnimFrameId !== null) {
        cancelAnimationFrame(beerAnimFrameId);
        beerAnimFrameId = null;
      }

      // Stop audio
      if (beerAudio) {
        try {
          beerAudio.pause();
          beerAudio.currentTime = 0;
          beerAudio = null;
        } catch (e) {}
      }
      stopProceduralBeerMelody();

      // Clear all timers
      beerTimerIds.forEach(tid => clearTimeout(tid));
      beerTimerIds = [];

      // Restore tavern ambient sound
      soundEngine.duckAmbient(false);

      // Fade out overlay
      dialogBeer.classList.remove('opacity-100', 'pointer-events-auto');
      dialogBeer.classList.add('opacity-0', 'pointer-events-none');

      const hideTimer = window.setTimeout(() => {
        dialogBeer.hidden = true;
        dialogBeer.setAttribute('aria-hidden', 'true');
        resetLyricsAndOutro();
        triggerBeer?.focus({ preventScroll: true });
      }, 300);
      beerTimerIds.push(hideTimer);
    }

    function handleBeerTrigger(e: Event) {
      e.preventDefault();
      // Auto turn on sound on user interaction
      if (getSound() !== 'on') {
        setSound('on');
      }
      soundEngine.init();
      openBeerBlackout();
    }

    triggerBeer?.addEventListener('click', handleBeerTrigger);
    triggerBeer?.addEventListener('touchend', handleBeerTrigger, { passive: false });

    narrowBeer?.addEventListener('click', handleBeerTrigger);

    btnCloseBeer?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeBeerBlackout();
    });

    dialogBeer?.addEventListener('click', () => {
      closeBeerBlackout();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isBeerActive) {
        e.preventDefault();
        e.stopPropagation();
        closeBeerBlackout();
      }
    });

    // Teardown any playing audio, animation frames, and synthesizer contexts when navigating away
    document.addEventListener('astro:before-swap', () => {
      closeBeerBlackout();
    }, { once: true });
  }

  document.addEventListener('astro:page-load', initTavernPage);
</script>
