---
import TavernLayout from '../../layouts/TavernLayout.astro';
import NpcDialogue from '../../components/NpcDialogue.astro';
import { getCollection } from 'astro:content';

const archivistEntries = await getCollection('archivist');
const introEntry = archivistEntries.find(e => e.data.type === 'intro');
const branchEntries = archivistEntries
  .filter(e => e.data.type === 'branch')
  .sort((a, b) => a.data.order - b.data.order);

const initialBeats = introEntry?.data.lines || [
  "Peace to your footsteps, traveller. I am the Archivist.",
  "I maintain the chronicle of Nhovem's works, decisions, and technical disciplines.",
  "Select a line of inquiry below, and I shall guide you through the records."
];

const dialogueReplies = branchEntries.map(b => ({
  id: b.id,
  question: b.data.question || '',
  lead: b.data.lead || '',
  answer: b.data.lead || '',
  inquiries: b.data.inquiries || []
}));
---

<TavernLayout
  title="The Hooded Archivist - Portfolio Navigator"
  description="Consult the Hooded Archivist for guided architectural navigation through Nhovem Cabahug's engineering works, technical case studies, and development philosophy."
  location="tavern"
>
  <div class="archivist-page">
    <!-- Scene Artwork & Character Representation -->
    <picture>
      <source media="(min-width: 1024px)" srcset="/art/tavern-room-2560.webp" />
      <img
        class="archivist-scene-art"
        src="/art/tavern-room-1280.webp"
        width="2560"
        height="1431"
        alt=""
        loading="eager"
        decoding="async"
      />
    </picture>

    <!-- Archivist Full Sprite -->
    <div class="archivist-character-wrap" aria-hidden="true">
      <div class="ground-shadow"></div>
      <img
        class="archivist-sprite"
        src="/art/archivist-neutral-520.webp"
        srcset="/art/archivist-neutral-260.webp 260w, /art/archivist-neutral-520.webp 520w"
        sizes="(max-width: 768px) 260px, 520px"
        width="520"
        height="1263"
        alt=""
        loading="eager"
        decoding="async"
      />
    </div>

    <!-- No-JS Fallback: Semantic HTML structured outline for zero-JS readers -->
    <div class="archivist-fallback" id="npc-fallback">
      <div class="archivist-fallback-card">
        <header class="archivist-fallback-header">
          <span class="badge-label">TAVERN ARCHIVES</span>
          <h1 class="archivist-title">The Hooded Archivist</h1>
          <p class="archivist-subtitle">Keeper of Records & Portfolio Navigator</p>
        </header>

        <div class="archivist-intro">
          {initialBeats.map((line) => (
            <p>{line}</p>
          ))}
        </div>

        <div class="archivist-branches">
          {branchEntries.map((branch) => (
            <section class="qa-pair archivist-branch-section">
              <h2 class="branch-question">{branch.data.question}</h2>
              <p class="branch-lead">{branch.data.lead}</p>
              {branch.data.inquiries && branch.data.inquiries.length > 0 && (
                <ul class="branch-inquiries-list">
                  {branch.data.inquiries.map((inq) => (
                    <li class="inquiry-item">
                      <h3 class="inquiry-label">{inq.label}</h3>
                      <p class="inquiry-response">{inq.response}</p>
                      {inq.offerHref && (
                        <p class="inquiry-action">
                          <a href={inq.offerHref} class="archivist-dossier-link">
                            {inq.offerLabel || 'Inspect Record →'}
                          </a>
                        </p>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))}
        </div>

        <footer class="archivist-fallback-footer">
          <a href="/tavern" class="archivist-nav-btn primary">← Back to the Tavern</a>
          <a href="/quests" class="archivist-nav-btn">Quest Board</a>
          <a href="/simple" class="archivist-nav-btn">Field Ledger (0-JS)</a>
        </footer>
      </div>
    </div>

    <!-- Rotationally Responsive Dialogue Engine -->
    <NpcDialogue
      npcId="archivist"
      title="The Hooded Archivist"
      showCloseIcon={false}
      initialBeats={initialBeats}
      replies={dialogueReplies}
      farewell={{ question: "Conclude inquiry", href: "/tavern" }}
      closeLabel="Back to the Tavern"
      closeHref="/tavern"
      mode="page"
      stackId="archivist-stack"
      repliesId="archivist-replies"
    />
  </div>
</TavernLayout>

<style>
  html, body {
    background-color: var(--wood-deep, #140d07);
  }

  .archivist-page {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    height: auto;
    align-self: stretch;
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    overflow: hidden;
    background-color: var(--wood-deep, #140d07);
  }

  .archivist-page > picture {
    display: contents;
  }

  .archivist-scene-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 100%;
    filter: brightness(0.65) saturate(0.9);
  }

  .archivist-character-wrap {
    position: absolute;
    left: 8%;
    bottom: 2%;
    width: 28%;
    max-width: 380px;
    height: 82%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    pointer-events: none;
    z-index: 2;
  }

  .archivist-sprite {
    max-height: 96%;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.9));
  }

  .ground-shadow {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 75%;
    height: 18px;
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0) 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  /* No-JS Fallback Styling */
  .archivist-fallback {
    position: relative;
    z-index: 10;
    max-width: 860px;
    margin: 32px auto;
    padding: 0 16px;
  }

  .archivist-fallback-card {
    background: rgba(15, 10, 5, 0.96);
    border: 2px solid var(--brass, #a87a27);
    border-radius: 8px;
    padding: 24px;
    color: var(--parchment, #f4ebd9);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.85);
  }

  .badge-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--candle, #ffe4a0);
    border-bottom: 1px solid var(--brass, #a87a27);
    padding-bottom: 2px;
    margin-bottom: 8px;
  }

  .archivist-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--candle, #ffe4a0);
    margin: 0 0 4px 0;
    font-family: serif;
  }

  .archivist-subtitle {
    font-size: 0.95rem;
    color: var(--parchment, #f4ebd9);
    opacity: 0.85;
    margin: 0 0 16px 0;
  }

  .archivist-intro {
    font-size: 1.05rem;
    line-height: 1.6;
    border-bottom: 1px solid rgba(168, 122, 39, 0.35);
    padding-bottom: 16px;
    margin-bottom: 24px;
  }
  .archivist-intro p {
    margin: 0 0 8px 0;
  }

  .archivist-branch-section {
    background: rgba(25, 18, 11, 0.85);
    border: 1px solid rgba(168, 122, 39, 0.45);
    border-radius: 6px;
    padding: 16px 20px;
    margin-bottom: 18px;
  }

  .branch-question {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--candle, #ffe4a0);
    margin: 0 0 8px 0;
  }

  .branch-lead {
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--parchment, #f4ebd9);
    margin: 0 0 14px 0;
  }

  .branch-inquiries-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .inquiry-item {
    background: rgba(10, 7, 4, 0.7);
    border-left: 3px solid var(--brass, #a87a27);
    padding: 10px 14px;
    border-radius: 0 4px 4px 0;
  }

  .inquiry-label {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--candle, #ffe4a0);
    margin: 0 0 4px 0;
  }

  .inquiry-response {
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--parchment, #f4ebd9);
    margin: 0 0 8px 0;
  }

  .inquiry-action {
    margin: 0;
  }

  .archivist-dossier-link {
    display: inline-block;
    color: var(--candle, #ffe4a0);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: underline;
  }
  .archivist-dossier-link:hover {
    color: #ffffff;
  }

  .archivist-fallback-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid rgba(168, 122, 39, 0.35);
  }

  .archivist-nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 8px 18px;
    background: rgba(30, 20, 12, 0.9);
    border: 1.5px solid var(--brass, #a87a27);
    color: var(--parchment, #f4ebd9);
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .archivist-nav-btn.primary {
    background: rgba(168, 122, 39, 0.25);
    color: var(--candle, #ffe4a0);
  }
  .archivist-nav-btn:hover {
    background: var(--brass, #a87a27);
    color: #140d07;
  }

  @media (max-width: 900px) {
    .archivist-character-wrap {
      display: none;
    }
  }
</style>
