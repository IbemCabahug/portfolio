---
import BaseLayout from './BaseLayout.astro';

import PreferenceControls from '../components/PreferenceControls.astro';
import LocationIndicator from '../components/LocationIndicator.astro';

interface Props {
  title: string;
  description: string;
  location: 'messenger' | 'tavern' | 'quests' | 'skills' | 'npc';
}

const { title, description, location } = Astro.props;

type Scene = {
  left?: { label: string; link: string; };
  current: string;
  right?: { label: string; link: string; };
};

const scenes: Record<string, Scene> = {
  'messenger': {
    current: "Messenger's Corner",
    right: { label: 'Main Tavern', link: '/tavern' },
  },
  'tavern': {
    left: { label: "Messenger's Corner", link: '/messenger' },
    current: "Main Tavern",
    right: { label: 'Quest Board', link: '/quests' },
  },
  'quests': {
    left: { label: 'Main Tavern', link: '/tavern' },
    current: "Quest Board",
  },
  'skills': {
    left: { label: 'Main Tavern', link: '/tavern' },
    current: "Adventurer's Badge",
  },
  'npc': {
    left: { label: 'Main Tavern', link: '/tavern' },
    current: "Tavern Regular",
  }
};

const currentScene = scenes[location];
---
<BaseLayout title={title} description={description} hideDefaultNav={true}>

  
  <div class="tavern-shell">
  <header class="p-2 sm:p-4 bg-[var(--wood-deep)] text-[var(--parchment)] flex flex-col sm:flex-row flex-wrap justify-between items-center border-b border-[var(--brass)] gap-2 sm:gap-4">
    <nav aria-label="Main Navigation" class="w-full sm:w-auto">
      <details class="sm:hidden group">
        <summary class="flex items-center justify-center min-h-[44px] px-4 font-semibold cursor-pointer hover:text-[var(--candle)] focus-visible:outline-2 focus-visible:outline-[var(--brass)]">
          Menu
        </summary>
        <ul class="flex flex-col gap-2 p-2 mt-2 border-t border-[var(--brass)] text-sm font-semibold">
          <li><a href="/" class="flex items-center min-h-[44px] hover:text-[var(--candle)] focus-visible:outline-2 focus-visible:outline-[var(--brass)] px-2">Home</a></li>
          <li><a href="/about" class="flex items-center min-h-[44px] hover:text-[var(--candle)] focus-visible:outline-2 focus-visible:outline-[var(--brass)] px-2">About</a></li>
          <li><a href="/resume" class="flex items-center min-h-[44px] hover:text-[var(--candle)] focus-visible:outline-2 focus-visible:outline-[var(--brass)] px-2">Résumé</a></li>
          <li><a href="/tavern" class="flex items-center min-h-[44px] hover:text-[var(--candle)] focus-visible:outline-2 focus-visible:outline-[var(--brass)] px-2">Main Tavern</a></li>
          <li><a href="/tavern/skills" class="flex items-center min-h-[44px] hover:text-[var(--candle)] focus-visible:outline-2 focus-visible:outline-[var(--brass)] px-2">Adventurer's Badge</a></li>
          <li><a href="/tavern/npc" class="flex items-center min-h-[44px] hover:text-[var(--candle)] focus-visible:outline-2 focus-visible:outline-[var(--brass)] px-2">Tavern Regular</a></li>
          <li><a href="/quests" class="flex items-center min-h-[44px] hover:text-[var(--candle)] focus-visible:outline-2 focus-visible:outline-[var(--brass)] px-2">Quest Board</a></li>
          <li><a href="/messenger" class="flex items-center min-h-[44px] hover:text-[var(--candle)] focus-visible:outline-2 focus-visible:outline-[var(--brass)] px-2">Messenger's Corner</a></li>
        </ul>
      </details>
      <ul class="hidden sm:flex flex-wrap justify-center sm:justify-start gap-2 sm:gap-4 text-xs sm:text-sm font-semibold">
        <li><a href="/" class="flex items-center min-h-[44px] hover:text-[var(--candle)] focus-visible:outline-2 focus-visible:outline-[var(--brass)] px-2">Home</a></li>
        <li><a href="/about" class="flex items-center min-h-[44px] hover:text-[var(--candle)] focus-visible:outline-2 focus-visible:outline-[var(--brass)] px-2">About</a></li>
        <li><a href="/resume" class="flex items-center min-h-[44px] hover:text-[var(--candle)] focus-visible:outline-2 focus-visible:outline-[var(--brass)] px-2">Résumé</a></li>
        <li><a href="/tavern" class="flex items-center min-h-[44px] hover:text-[var(--candle)] focus-visible:outline-2 focus-visible:outline-[var(--brass)] px-2">Main Tavern</a></li>
        <li><a href="/tavern/skills" class="flex items-center min-h-[44px] hover:text-[var(--candle)] focus-visible:outline-2 focus-visible:outline-[var(--brass)] px-2">Adventurer's Badge</a></li>
        <li><a href="/tavern/npc" class="flex items-center min-h-[44px] hover:text-[var(--candle)] focus-visible:outline-2 focus-visible:outline-[var(--brass)] px-2">Tavern Regular</a></li>
        <li><a href="/quests" class="flex items-center min-h-[44px] hover:text-[var(--candle)] focus-visible:outline-2 focus-visible:outline-[var(--brass)] px-2">Quest Board</a></li>
        <li><a href="/messenger" class="flex items-center min-h-[44px] hover:text-[var(--candle)] focus-visible:outline-2 focus-visible:outline-[var(--brass)] px-2">Messenger's Corner</a></li>
      </ul>
    </nav>
    <div class="flex flex-wrap justify-center sm:justify-end gap-2 sm:gap-4 items-center w-full sm:w-auto">
      <PreferenceControls />
      <a href="/simple" class="flex items-center min-h-[44px] underline hover:text-[var(--candle)] font-semibold px-2 focus-visible:outline-2 focus-visible:outline-[var(--brass)]">Simple portfolio mode</a>
    </div>
  </header>

  <LocationIndicator
    currentLabel={currentScene.current}
    leftLabel={currentScene.left?.label}
    leftLink={currentScene.left?.link}
    rightLabel={currentScene.right?.label}
    rightLink={currentScene.right?.link}
  />

  <div class="p-4 sm:p-8 bg-[var(--wood-deep)] text-[var(--parchment)] min-h-screen tavern-content">
    <slot />
  </div>
  </div>

  <script>
    document.addEventListener('keydown', (e) => {
      const active = document.activeElement;
      if (active) {
        const tag = active.tagName.toLowerCase();
        const role = active.getAttribute('role');
        const isEditable = active.hasAttribute('contenteditable');
        
        const isScrollable = active.scrollHeight > active.clientHeight || active.scrollWidth > active.clientWidth;
        
        if (tag === 'input' || tag === 'textarea' || tag === 'select' || role === 'textbox' || isEditable || isScrollable) {
          return;
        }
      }

      if (e.key === 'ArrowLeft') {
        const leftLink = document.getElementById('nav-left');
        if (leftLink) leftLink.click();
      } else if (e.key === 'ArrowRight') {
        const rightLink = document.getElementById('nav-right');
        if (rightLink) rightLink.click();
      }
    });
  </script>
</BaseLayout>
