---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
  description: string;
  location: 'messenger' | 'tavern' | 'quests' | 'skills' | 'npc' | 'archivist';
}

const { title, description, location } = Astro.props;

type Scene = {
  left?: { label: string; link: string; };
  current: string;
  right?: { label: string; link: string; };
};

const scenes: Record<string, Scene> = {
  'messenger': {
    current: "Messenger's Corner",
    right: { label: 'Main Tavern', link: '/tavern' },
  },
  'tavern': {
    left: { label: "Messenger's Corner", link: '/messenger' },
    current: "Main Tavern",
    right: { label: 'Quest Board', link: '/quests' },
  },
  'quests': {
    left: { label: 'Main Tavern', link: '/tavern' },
    current: "Quest Board",
  },
  'skills': {
    left: { label: 'Main Tavern', link: '/tavern' },
    current: "Adventurer's Badge",
  },
  'npc': {
    left: { label: 'Main Tavern', link: '/tavern' },
    current: "Tavern Regular",
  },
  'archivist': {
    left: { label: 'Main Tavern', link: '/tavern' },
    current: "The Archivist",
  }
};

const currentScene = scenes[location];
const isScene = location === 'tavern' || location === 'messenger';
---
<BaseLayout title={title} description={description} hideDefaultNav={true}>
  <div
    class={`tavern-shell ${isScene ? 'scene-layout' : 'document-layout'}`}
    data-left-link={currentScene.left?.link || ''}
    data-right-link={currentScene.right?.link || ''}
  >
    {/* Single-Row Unified Tavern HUD */}
    <SiteHeader currentLocation={currentScene.current} isTavernHud={true} />

    {/* Floating Exit Fullscreen Pill (Visible ONLY in Fullscreen) */}
    <button
      type="button"
      id="fullscreen-exit-pill"
      class="fullscreen-exit-pill"
      aria-label="Exit Fullscreen Mode"
      title="Exit Fullscreen Mode (Esc)"
    >
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
      <span>Exit Fullscreen</span>
    </button>

    <div class={isScene ? 'scene-wrapper' : 'p-4 sm:p-8 bg-[var(--wood-deep)] text-[var(--parchment)] min-h-screen tavern-content'}>
      <slot />
    </div>
  </div>

  <style>
    :root {
      --hud-height: 48px;
    }

    .tavern-hud {
      height: var(--hud-height);
      padding-left: max(0.5rem, env(safe-area-inset-left));
      padding-right: max(0.5rem, env(safe-area-inset-right));
    }

    @media (max-height: 500px), (max-width: 860px) {
      :root {
        --hud-height: 40px;
      }
      .tavern-hud {
        height: var(--hud-height) !important;
        min-height: var(--hud-height) !important;
      }
      .tavern-hud a[href="/simple"] {
        display: none !important;
      }
      .tavern-hud details summary {
        min-height: 34px !important;
        padding-left: 8px !important;
        padding-right: 8px !important;
      }
    }

    .tavern-shell.scene-layout {
      min-height: 100dvh;
      min-height: 100vh;
      overflow-y: auto;
      overflow-x: hidden;
      display: flex;
      flex-direction: column;
      background-color: var(--wood-deep, #1a1005);
    }

    .tavern-shell.scene-layout .scene-wrapper {
      flex: 1 1 0;
      min-height: calc(100dvh - var(--hud-height, 48px));
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      padding: 0;
      position: relative;
    }

    /* Floating Exit Fullscreen Pill */
    .fullscreen-exit-pill {
      display: none;
    }

    :global(:fullscreen) .fullscreen-exit-pill,
    :global(:-webkit-full-screen) .fullscreen-exit-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      position: fixed;
      top: 16px;
      right: 16px;
      z-index: 1000;
      background: rgba(15, 10, 5, 0.88);
      border: 1px solid rgba(213, 128, 59, 0.6);
      color: var(--candle, #ffe4a0);
      font-size: 0.75rem;
      font-weight: 700;
      padding: 6px 14px;
      border-radius: 9999px;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.7);
      cursor: pointer;
      backdrop-filter: blur(4px);
      opacity: 0.8;
      transition: opacity 0.2s, background 0.2s, border-color 0.2s;
    }

    :global(:fullscreen) .fullscreen-exit-pill:hover,
    :global(:-webkit-full-screen) .fullscreen-exit-pill:hover {
      opacity: 1;
      background: rgba(26, 16, 5, 0.98);
      border-color: #ffd782;
    }

    /* Pure Canvas Fullscreen: completely remove the HUD navigation */
    :global(:fullscreen) .tavern-hud,
    :global(:-webkit-full-screen) .tavern-hud {
      display: none !important;
    }

    :global(:fullscreen) .tavern-shell.scene-layout,
    :global(:-webkit-full-screen) .tavern-shell.scene-layout {
      height: 100vh !important;
      height: 100dvh !important;
      overflow: hidden !important;
    }

    :global(:fullscreen) .scene-container,
    :global(:-webkit-full-screen) .scene-container {
      max-height: 100vh !important;
      max-height: 100dvh !important;
      max-width: calc(100vh * (2560 / 1431)) !important;
    }

    @media (max-width: 768px) and (orientation: portrait) {
      .tavern-shell.scene-layout {
        height: auto;
        min-height: 100dvh;
        overflow-y: auto;
      }
      .tavern-shell.scene-layout .scene-wrapper {
        min-height: 0;
        height: auto;
        overflow-y: auto;
        justify-content: flex-start;
      }
    }
  </style>

  <script>
    import { navigate } from 'astro:transitions/client';

    function initTavernHud() {
      const fsBtn = document.getElementById('menu-toggle-fullscreen');
      const fsText = document.getElementById('fullscreen-btn-text');
      const exitPill = document.getElementById('fullscreen-exit-pill');

      function updateFsState() {
        if (document.fullscreenElement) {
          if (fsText) fsText.textContent = 'Exit Fullscreen';
          sessionStorage.setItem('tavern_fullscreen', 'true');
        } else {
          if (fsText) fsText.textContent = 'Enter Fullscreen';
          sessionStorage.removeItem('tavern_fullscreen');
        }
      }

      updateFsState();

      fsBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        if (!document.fullscreenElement) {
          document.documentElement.requestFullscreen().catch(() => {});
        } else {
          if (document.exitFullscreen) {
            document.exitFullscreen().catch(() => {});
          }
        }
      });

      exitPill?.addEventListener('click', () => {
        if (document.exitFullscreen) {
          document.exitFullscreen().catch(() => {});
        }
      });
    }

    // Bind on every astro page load
    document.addEventListener('astro:page-load', initTavernHud);

    // Track fullscreen changes globally
    document.addEventListener('fullscreenchange', () => {
      const fsText = document.getElementById('fullscreen-btn-text');
      if (document.fullscreenElement) {
        if (fsText) fsText.textContent = 'Exit Fullscreen';
        sessionStorage.setItem('tavern_fullscreen', 'true');
      } else {
        if (fsText) fsText.textContent = 'Enter Fullscreen';
        sessionStorage.removeItem('tavern_fullscreen');
      }
    });

    // Keyboard Chamber Arrow Navigation (Client-side route swap keeps Fullscreen active)
    document.addEventListener('keydown', (e) => {
      const active = document.activeElement;
      if (active) {
        const tag = active.tagName.toLowerCase();
        const role = active.getAttribute('role');
        const isEditable = active.hasAttribute('contenteditable');
        const isScrollable = active.scrollHeight > active.clientHeight || active.scrollWidth > active.clientWidth;
        
        if (tag === 'input' || tag === 'textarea' || tag === 'select' || role === 'textbox' || isEditable || isScrollable) {
          return;
        }
      }

      const shell = document.querySelector('.tavern-shell');
      const leftLink = shell?.getAttribute('data-left-link');
      const rightLink = shell?.getAttribute('data-right-link');

      if (e.key === 'ArrowLeft' && leftLink) {
        navigate(leftLink);
      } else if (e.key === 'ArrowRight' && rightLink) {
        navigate(rightLink);
      }
    });
  </script>
</BaseLayout>
