---
import '../styles/global.css';
import ThemeInit from '../components/ThemeInit.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  hideDefaultNav?: boolean;
  noScript?: boolean;
}

const { title, description, hideDefaultNav, noScript = false } = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || '';
const canonicalUrl = siteUrl ? new URL(Astro.url.pathname, siteUrl).href : Astro.url.href;
const sitemapUrl = siteUrl ? new URL('/sitemap-index.xml', siteUrl).href : '/sitemap-index.xml';
---

<!doctype html>
<html lang="en">
  <head>
    {!noScript && <ClientRouter />}
    {!noScript && <ThemeInit />}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href={sitemapUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content">Skip to content</a>
    {!hideDefaultNav && (
      <header class="no-print print:hidden bg-[var(--wood-deep)] text-[var(--parchment)] border-b border-[var(--brass)] sticky top-0 z-30 shadow-md">
        <div class="max-w-6xl mx-auto px-4 py-1.5 sm:py-2 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
          {Astro.url.pathname.startsWith('/simple') ? (
            <div class="w-full flex flex-wrap items-center justify-between gap-2">
              <div class="flex items-center gap-2">
                <a
                  href="/"
                  class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-[var(--candle)] hover:text-white transition-colors min-h-[44px] px-2 focus-visible:outline-2 focus-visible:outline-[var(--candle)]"
                  title="Return to Home / Entrance"
                >
                  <span class="font-serif tracking-wide">&larr; Home / Entrance</span>
                </a>
                <span class="text-xs font-semibold px-2 py-0.5 rounded bg-[#140c05] border border-[var(--brass)] text-[var(--candle)]">
                  Field Ledger
                </span>
              </div>

              <nav aria-label="Field Ledger Sections" class="flex items-center">
                <ul class="flex flex-wrap items-center gap-1 text-xs sm:text-sm font-semibold">
                  <li>
                    <a
                      href="#about-heading"
                      class="inline-flex items-center min-h-[44px] px-2.5 py-1 rounded text-[var(--parchment)] hover:text-[var(--candle)] hover:bg-[var(--brass)]/20 transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)]"
                    >
                      Overview
                    </a>
                  </li>
                  <li>
                    <a
                      href="#projects-heading"
                      class="inline-flex items-center min-h-[44px] px-2.5 py-1 rounded text-[var(--parchment)] hover:text-[var(--candle)] hover:bg-[var(--brass)]/20 transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)]"
                    >
                      Proof of Work
                    </a>
                  </li>
                  <li>
                    <a
                      href="#competencies-heading"
                      class="inline-flex items-center min-h-[44px] px-2.5 py-1 rounded text-[var(--parchment)] hover:text-[var(--candle)] hover:bg-[var(--brass)]/20 transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)]"
                    >
                      Competencies
                    </a>
                  </li>
                  <li>
                    <a
                      href="#resume-card-heading"
                      class="inline-flex items-center min-h-[44px] px-2.5 py-1 rounded text-[var(--parchment)] hover:text-[var(--candle)] hover:bg-[var(--brass)]/20 transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)]"
                    >
                      Resume
                    </a>
                  </li>
                  <li>
                    <a
                      href="#contact-heading"
                      class="inline-flex items-center min-h-[44px] px-2.5 py-1 rounded text-[var(--parchment)] hover:text-[var(--candle)] hover:bg-[var(--brass)]/20 transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)]"
                    >
                      Contact
                    </a>
                  </li>
                  <li>
                    <a
                      href="/tavern"
                      class="inline-flex items-center min-h-[44px] px-2.5 py-1 ml-1 rounded border border-[var(--brass)] text-[var(--candle)] hover:bg-[var(--brass)] hover:text-[var(--wood-deep)] transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)] text-xs font-bold"
                      title="Switch to Illustrated Tavern (Interactive Mode)"
                    >
                      Interactive Tavern &rarr;
                    </a>
                  </li>
                </ul>
              </nav>
            </div>
          ) : (
            <div class="w-full flex flex-wrap items-center justify-between gap-2">
              <div class="flex items-center gap-2">
                <a
                  href="/"
                  class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-[var(--candle)] hover:text-white transition-colors min-h-[44px] px-2 focus-visible:outline-2 focus-visible:outline-[var(--candle)]"
                  title="Return to Home / Entrance"
                >
                  <span class="font-serif tracking-wide">Ibem's Tavern</span>
                </a>
                <span class="text-xs font-semibold px-2 py-0.5 rounded bg-[#140c05] border border-[var(--brass)] text-[var(--candle)]">
                  {Astro.url.pathname.startsWith('/resume') ? 'Resume' : Astro.url.pathname.startsWith('/about') ? 'About' : 'Navigation'}
                </span>
              </div>

              <nav aria-label="Main Navigation" class="flex items-center">
                <ul class="flex flex-wrap items-center gap-1 text-xs font-semibold">
                  <li>
                    <a
                      href="/"
                      class={`inline-flex items-center min-h-[44px] px-2.5 py-1 rounded transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)] ${Astro.url.pathname === '/' ? 'text-[var(--candle)] bg-[var(--brass)]/20 font-bold' : 'text-[var(--parchment)] hover:text-[var(--candle)] hover:bg-[var(--brass)]/20'}`}
                    >
                      Home
                    </a>
                  </li>
                  <li>
                    <a
                      href="/about"
                      class={`inline-flex items-center min-h-[44px] px-2.5 py-1 rounded transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)] ${Astro.url.pathname.startsWith('/about') ? 'text-[var(--candle)] bg-[var(--brass)]/20 font-bold' : 'text-[var(--parchment)] hover:text-[var(--candle)] hover:bg-[var(--brass)]/20'}`}
                    >
                      About
                    </a>
                  </li>
                  <li>
                    <a
                      href="/resume"
                      class={`inline-flex items-center min-h-[44px] px-2.5 py-1 rounded transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)] ${Astro.url.pathname.startsWith('/resume') ? 'text-[var(--candle)] bg-[var(--brass)]/20 font-bold' : 'text-[var(--parchment)] hover:text-[var(--candle)] hover:bg-[var(--brass)]/20'}`}
                    >
                      Resume
                    </a>
                  </li>
                  <li>
                    <a
                      href="/quests"
                      class={`inline-flex items-center min-h-[44px] px-2.5 py-1 rounded transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)] ${Astro.url.pathname.startsWith('/quests') ? 'text-[var(--candle)] bg-[var(--brass)]/20 font-bold' : 'text-[var(--parchment)] hover:text-[var(--candle)] hover:bg-[var(--brass)]/20'}`}
                      title="Quest Board"
                    >
                      Quest Board
                    </a>
                  </li>
                  <li>
                    <a
                      href="/tavern"
                      class={`inline-flex items-center min-h-[44px] px-2.5 py-1 rounded transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)] ${Astro.url.pathname === '/tavern' ? 'text-[var(--candle)] bg-[var(--brass)]/20 font-bold' : 'text-[var(--parchment)] hover:text-[var(--candle)] hover:bg-[var(--brass)]/20'}`}
                      title="Main Tavern"
                    >
                      Main Tavern
                    </a>
                  </li>
                  <li>
                    <a
                      href="/tavern/skills"
                      class={`inline-flex items-center min-h-[44px] px-2.5 py-1 rounded transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)] ${Astro.url.pathname.startsWith('/tavern/skills') ? 'text-[var(--candle)] bg-[var(--brass)]/20 font-bold' : 'text-[var(--parchment)] hover:text-[var(--candle)] hover:bg-[var(--brass)]/20'}`}
                      title="Adventurer's Badge"
                    >
                      Adventurer's Badge
                    </a>
                  </li>
                  <li>
                    <a
                      href="/tavern/npc"
                      class={`inline-flex items-center min-h-[44px] px-2.5 py-1 rounded transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)] ${Astro.url.pathname.startsWith('/tavern/npc') ? 'text-[var(--candle)] bg-[var(--brass)]/20 font-bold' : 'text-[var(--parchment)] hover:text-[var(--candle)] hover:bg-[var(--brass)]/20'}`}
                      title="Tavern Regular"
                    >
                      Tavern Regular
                    </a>
                  </li>
                  <li>
                    <a
                      href="/messenger"
                      class={`inline-flex items-center min-h-[44px] px-2.5 py-1 rounded transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)] ${Astro.url.pathname.startsWith('/messenger') ? 'text-[var(--candle)] bg-[var(--brass)]/20 font-bold' : 'text-[var(--parchment)] hover:text-[var(--candle)] hover:bg-[var(--brass)]/20'}`}
                      title="Messenger's Corner"
                    >
                      Messenger's Corner
                    </a>
                  </li>
                  <li>
                    <a
                      href="/simple"
                      class="inline-flex items-center min-h-[44px] px-2.5 py-1 ml-1 rounded border border-[var(--brass)] text-[var(--candle)] hover:bg-[var(--brass)] hover:text-[var(--wood-deep)] transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)] text-xs font-bold"
                      title="Switch to Field Ledger"
                    >
                      Field Ledger &rarr;
                    </a>
                  </li>
                </ul>
              </nav>
            </div>
          )}
        </div>
      </header>
    )}
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
  </body>
</html>
