---
import '../styles/global.css';
import ThemeInit from '../components/ThemeInit.astro';
import SiteHeader from '../components/SiteHeader.astro';
import PwaRegister from '../components/PwaRegister.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  hideDefaultNav?: boolean;
  noScript?: boolean;
}

const { title, description, hideDefaultNav, noScript = false } = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || '';
const canonicalUrl = siteUrl ? new URL(Astro.url.pathname, siteUrl).href : Astro.url.href;
const sitemapUrl = siteUrl ? new URL('/sitemap-index.xml', siteUrl).href : '/sitemap-index.xml';
---

<!doctype html>
<html lang="en">
  <head>
    {!noScript && <ClientRouter />}
    {!noScript && <ThemeInit />}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href={sitemapUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#1e1208" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Nhovem" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <slot name="head" />
    <script is:inline>
      // Self-XSS Console Security Warning
      try {
        const titleStyle = 'color: #ef4444; font-size: 32px; font-weight: 900; -webkit-text-stroke: 1px black; text-shadow: 2px 2px 0 #000; font-family: system-ui, sans-serif;';
        const bodyStyle = 'color: #f59e0b; font-size: 14px; font-weight: 600; line-height: 1.6; font-family: system-ui, sans-serif;';
        const subStyle = 'color: #94a3b8; font-size: 11px; font-family: monospace;';
        
        console.log('%c⚠️ STOP!', titleStyle);
        console.log(
          '%cThis browser console is intended exclusively for developers.\n' +
          'If someone told you to copy and paste code or a script here to unlock features, trigger easter eggs, or gain admin privileges, DO NOT DO IT.\n' +
          'This is an attack vector known as Self-XSS designed to hijack client data or execute unauthorized code.',
          bodyStyle
        );
        console.log('%c🛡️ Client Security & Self-XSS Shield Active', subStyle);
      } catch (e) {}
    </script>
  </head>
  <body>
    <a href="#main-content">Skip to content</a>
    {!hideDefaultNav && (
      Astro.url.pathname.startsWith('/simple') ? (
        <header class="no-print print:hidden bg-[var(--wood-deep)] text-[var(--parchment)] border-b border-[var(--brass)] h-12 sticky top-0 z-30 shadow-md flex items-center justify-between px-2 sm:px-4 select-none">
          {/* LEFT: Home / Entrance + Badge */}
          <div class="flex items-center gap-2 shrink-0">
            <a
              href="/"
              class="inline-flex items-center gap-1.5 h-8 text-xs sm:text-sm font-bold text-[var(--candle)] hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)]"
              title="Return to Home / Entrance"
            >
              <span class="font-serif tracking-wide">&larr; Home / Entrance</span>
            </a>
            <span class="hidden sm:inline-flex items-center text-[11px] font-semibold px-2 py-0.5 rounded bg-[#140c05] border border-[var(--brass)]/60 text-[var(--candle)]">
              Field Ledger
            </span>
          </div>

          {/* RIGHT: Section Links + Interactive Tavern */}
          <div class="flex items-center gap-1 shrink-0">
            <nav aria-label="Field Ledger Sections" class="hidden md:flex items-center">
              <ul class="flex items-center gap-0.5 text-xs font-semibold">
                <li>
                  <a
                    href="#about-heading"
                    class="inline-flex items-center h-8 px-2 rounded text-[var(--parchment)]/80 hover:text-[var(--candle)] hover:bg-[var(--brass)]/10 transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)]"
                  >
                    Overview
                  </a>
                </li>
                <li>
                  <a
                    href="#projects-heading"
                    class="inline-flex items-center h-8 px-2 rounded text-[var(--parchment)]/80 hover:text-[var(--candle)] hover:bg-[var(--brass)]/10 transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)]"
                  >
                    Proof of Work
                  </a>
                </li>
                <li>
                  <a
                    href="#competencies-heading"
                    class="inline-flex items-center h-8 px-2 rounded text-[var(--parchment)]/80 hover:text-[var(--candle)] hover:bg-[var(--brass)]/10 transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)]"
                  >
                    Competencies
                  </a>
                </li>
                <li>
                  <a
                    href="#resume-card-heading"
                    class="inline-flex items-center h-8 px-2 rounded text-[var(--parchment)]/80 hover:text-[var(--candle)] hover:bg-[var(--brass)]/10 transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)]"
                  >
                    Resume
                  </a>
                </li>
                <li>
                  <a
                    href="#contact-heading"
                    class="inline-flex items-center h-8 px-2 rounded text-[var(--parchment)]/80 hover:text-[var(--candle)] hover:bg-[var(--brass)]/10 transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)]"
                  >
                    Contact
                  </a>
                </li>
              </ul>
            </nav>
            <a
              href="/tavern"
              class="inline-flex items-center h-8 px-2.5 rounded-md border border-[var(--brass)] bg-[#1e1208] text-[var(--candle)] text-xs font-bold hover:bg-[var(--brass)] hover:text-[var(--wood-deep)] transition-colors focus-visible:outline-2 focus-visible:outline-[var(--candle)] shadow-xs"
              title="Switch to Illustrated Tavern (Interactive Mode)"
            >
              Interactive Tavern &rarr;
            </a>
          </div>
        </header>
      ) : (
        <SiteHeader />
      )
    )}
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    {!noScript && <PwaRegister />}
  </body>
</html>
