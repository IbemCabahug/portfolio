---
import '../styles/global.css';
import ThemeInit from '../components/ThemeInit.astro';

interface Props {
  title: string;
  description: string;
  hideDefaultNav?: boolean;
}

const { title, description, hideDefaultNav } = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || '';
const canonicalUrl = siteUrl ? new URL(Astro.url.pathname, siteUrl).href : Astro.url.href;
const sitemapUrl = siteUrl ? new URL('/sitemap-index.xml', siteUrl).href : '/sitemap-index.xml';
---

<!doctype html>
<html lang="en">
  <head>
    <ThemeInit />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href={sitemapUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content">Skip to content</a>
    {!hideDefaultNav && (
      <nav>
        <ul class="flex flex-col gap-2">
          {Astro.url.pathname.startsWith('/simple') ? (
            <>
              <li><a href="#about-heading" class="inline-flex items-center min-h-[44px] px-2">Overview</a></li>
              <li><a href="#projects-heading" class="inline-flex items-center min-h-[44px] px-2">Proof of Work</a></li>
              <li><a href="#competencies-heading" class="inline-flex items-center min-h-[44px] px-2">Competencies</a></li>
              <li><a href="#resume-card-heading" class="inline-flex items-center min-h-[44px] px-2">Résumé</a></li>
              <li><a href="#contact-heading" class="inline-flex items-center min-h-[44px] px-2">Contact</a></li>
            </>
          ) : (
            <>
              <li><a href="/" class="inline-flex items-center min-h-[44px] px-2">Home</a></li>
              <li><a href="/about" class="inline-flex items-center min-h-[44px] px-2">About</a></li>
              <li><a href="/resume" class="inline-flex items-center min-h-[44px] px-2">Résumé</a></li>
              <li><a href="/quests" class="inline-flex items-center min-h-[44px] px-2">Quest Board</a></li>
              <li><a href="/tavern" class="inline-flex items-center min-h-[44px] px-2">Main Tavern</a></li>
              <li><a href="/tavern/skills" class="inline-flex items-center min-h-[44px] px-2">Adventurer's Badge</a></li>
              <li><a href="/tavern/npc" class="inline-flex items-center min-h-[44px] px-2">Tavern Regular</a></li>
              <li><a href="/messenger" class="inline-flex items-center min-h-[44px] px-2">Messenger's Corner</a></li>
              <li><a href="/simple" class="inline-flex items-center min-h-[44px] px-2">Field Ledger (Simple Mode)</a></li>
            </>
          )}
        </ul>
      </nav>
    )}
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
  </body>
</html>
