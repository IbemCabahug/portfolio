---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  hideDefaultNav?: boolean;
}

const { title, description, hideDefaultNav } = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || '';
const canonicalUrl = siteUrl ? new URL(Astro.url.pathname, siteUrl).href : Astro.url.href;
const sitemapUrl = siteUrl ? new URL('/sitemap-index.xml', siteUrl).href : '/sitemap-index.xml';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href={sitemapUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content">Skip to content</a>
    {!hideDefaultNav && (
      <nav>
        <ul>
          {Astro.url.pathname.startsWith('/simple') ? (
            <>
              <li><a href="#about-heading">About</a></li>
              <li><a href="#skills-heading">Skills</a></li>
              <li><a href="#projects-heading">Projects</a></li>
              <li><a href="#contact-heading">Contact</a></li>
            </>
          ) : (
            <>
              <li><a href="/">Home</a></li>
              <li><a href="/about">About</a></li>
              <li><a href="/resume">Résumé</a></li>
              <li><a href="/quests">Quest Board</a></li>
              <li><a href="/tavern">Main Tavern</a></li>
              <li><a href="/tavern/skills">Adventurer's Badge</a></li>
              <li><a href="/tavern/npc">Tavern Regular</a></li>
              <li><a href="/messenger">Messenger's Corner</a></li>
              <li><a href="/simple">Simple portfolio mode</a></li>
            </>
          )}
        </ul>
      </nav>
    )}
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
  </body>
</html>
