---
---

<div class="interactive-avatar-root flex-shrink-0 flex flex-col items-center pt-2 lg:pt-4">
  <button
    type="button"
    id="avatar-toggle-btn"
    class="relative group cursor-pointer focus-visible:outline-2 focus-visible:outline-[var(--candle)] focus-visible:outline-offset-4 rounded-full bg-transparent border-0 p-0"
    aria-label="Adventurer guild medallion: 3D voxel avatar. Click or hover to reveal real developer photo"
    aria-expanded="false"
  >
    {/* Circular Brass Guild Medallion Frame */}
    <div class="w-48 h-48 sm:w-56 sm:h-56 rounded-full border-2 border-[var(--brass)] bg-[#1e1208] p-2 shadow-2xl shadow-black/80 flex items-center justify-center overflow-hidden transition-all duration-300 group-hover:border-[var(--candle)] group-hover:shadow-[0_0_20px_rgba(255,228,160,0.25)]">
      <div class="relative w-full h-full rounded-full overflow-hidden bg-[#120a04] flex items-center justify-center">
        
        {/* Layer 1: 3D Voxel Pixel-Art Adventurer Avatar (Default View) */}
        <img
          src="/art/profile-pixel-3d.jpg"
          alt="Nhovem Cabahug — 3D Voxel Pixel-Art Adventurer portrait"
          width="224"
          height="224"
          class="avatar-pixel-img absolute inset-0 w-full h-full object-cover rounded-full opacity-100 scale-100 transition-all duration-350 ease-out"
          loading="eager"
          decoding="async"
        />

        {/* Layer 2: Real Profile Photo (Revealed on Hover / Click / Tap) */}
        <img
          src="/art/profile.jpg"
          alt="Nhovem Cabahug — Real photograph in formal suit and tie"
          width="224"
          height="224"
          class="avatar-real-img absolute inset-0 w-full h-full object-cover rounded-full opacity-0 scale-95 transition-all duration-350 ease-out pointer-events-none"
          loading="eager"
          decoding="async"
        />

      </div>
    </div>

    {/* Guild Medallion Tag Indicator */}
    <div class="avatar-tag absolute -bottom-3 left-1/2 -translate-x-1/2 whitespace-nowrap bg-[var(--wood-deep)] border border-[var(--brass)] text-[var(--candle)] text-[11px] font-extrabold uppercase tracking-wider px-3.5 py-0.5 rounded-full shadow-md flex items-center gap-1.5 transition-all duration-200">
      <span class="avatar-dot w-1.5 h-1.5 rounded-full bg-amber-400" aria-hidden="true"></span>
      <span class="avatar-label">Guild Engineer (Voxel)</span>
    </div>
  </button>
</div>

<style>
  /* Hover & Focus Interactions: Fade in the real photo over the voxel avatar */
  .interactive-avatar-root:hover .avatar-real-img,
  .interactive-avatar-root:focus-within .avatar-real-img,
  .interactive-avatar-root.is-revealed .avatar-real-img {
    opacity: 1;
    transform: scale(1);
  }

  .interactive-avatar-root:hover .avatar-pixel-img,
  .interactive-avatar-root:focus-within .avatar-pixel-img,
  .interactive-avatar-root.is-revealed .avatar-pixel-img {
    opacity: 0;
    transform: scale(1.05);
  }

  .interactive-avatar-root:hover .avatar-tag,
  .interactive-avatar-root:focus-within .avatar-tag,
  .interactive-avatar-root.is-revealed .avatar-tag {
    border-color: var(--candle);
    box-shadow: 0 0 10px rgba(255, 228, 160, 0.3);
  }

  .interactive-avatar-root:hover .avatar-dot,
  .interactive-avatar-root:focus-within .avatar-dot,
  .interactive-avatar-root.is-revealed .avatar-dot {
    background-color: #34d399; /* emerald-400 */
  }
</style>

<script>
  function setupInteractiveAvatar() {
    const root = document.querySelector('.interactive-avatar-root');
    const button = document.getElementById('avatar-toggle-btn');
    const label = document.querySelector('.avatar-label');
    if (!root || !button || !label) return;

    const rootEl = root;
    const buttonEl = button;
    const labelEl = label;
    let isRevealed = false;

    function updateState(revealed: boolean) {
      isRevealed = revealed;
      buttonEl.setAttribute('aria-expanded', String(isRevealed));
      if (isRevealed) {
        rootEl.classList.add('is-revealed');
        labelEl.textContent = 'Real Engineer (Nhovem)';
      } else {
        rootEl.classList.remove('is-revealed');
        labelEl.textContent = 'Guild Engineer (Voxel)';
      }
    }

    // Toggle on click / tap for desktop locking and natural mobile interaction
    buttonEl.addEventListener('click', (e) => {
      e.preventDefault();
      updateState(!isRevealed);
    });

    // Keyboard support (Enter or Space)
    buttonEl.addEventListener('keydown', (e: Event) => {
      const keyEvent = e as KeyboardEvent;
      if (keyEvent.key === 'Enter' || keyEvent.key === ' ') {
        keyEvent.preventDefault();
        updateState(!isRevealed);
      }
    });

    // Label sync on hover if not locked
    rootEl.addEventListener('mouseenter', () => {
      if (!isRevealed) {
        labelEl.textContent = 'Real Engineer (Nhovem)';
      }
    });

    rootEl.addEventListener('mouseleave', () => {
      if (!isRevealed) {
        labelEl.textContent = 'Guild Engineer (Voxel)';
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupInteractiveAvatar);
  } else {
    setupInteractiveAvatar();
  }
  document.addEventListener('astro:page-load', setupInteractiveAvatar);
</script>
