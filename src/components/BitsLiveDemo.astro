---
import QuestDemoShell, { type QuestDemoViewConfig } from './QuestDemoShell.astro';
import { demoUrl } from '../lib/bits-demo-url';

interface Props {
  liveUrl: string;
  title: string;
  instanceId?: string;
}

const { liveUrl, title, instanceId = 'bits' } = Astro.props;
const projectName = title.split('—')[0].trim() || 'BITS';
const dashboardUrl = demoUrl(liveUrl, import.meta.env.DEV);
const terminalUrl = demoUrl(import.meta.env.PUBLIC_ZK_SIMULATOR_URL, import.meta.env.DEV);

const views: QuestDemoViewConfig[] = [
  {
    key: 'dashboard',
    label: 'BITS Dashboard',
    url: dashboardUrl,
    iframeTitle: 'BITS attendance dashboard',
    displayMode: 'responsive',
    sandbox: 'allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox',
    referrerPolicy: 'strict-origin-when-cross-origin',
    reloadLabel: 'Reload view',
    loadingStatus: 'Loading external view. Connection and attendance delivery are not yet verified.',
    loadedStatus:
      'External view requested. If it is blank or unavailable, reload view or open it in a new tab. Confirm scans in BITS Attendance.',
    unavailableStatus:
      'This view is not configured for this deployment. BITS remains available in the Dashboard tab.',
  },
  {
    key: 'terminal',
    label: 'ZKTeco Simulator',
    url: terminalUrl,
    iframeTitle: 'ZKTeco virtual terminal',
    displayMode: 'responsive',
    sandbox: 'allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox',
    referrerPolicy: 'strict-origin-when-cross-origin',
    reloadLabel: 'Reload view',
    loadingStatus: 'Loading external view. Connection and attendance delivery are not yet verified.',
    loadedStatus:
      'External view requested. If it is blank or unavailable, reload view or open it in a new tab. Confirm scans in BITS Attendance.',
    unavailableStatus:
      'This view is not configured for this deployment. BITS remains available in the Dashboard tab.',
    footnote:
      'Simulated scans are not real biometric capture. Return to BITS to confirm that attendance was received.',
  },
];
---

<QuestDemoShell
  instanceId={instanceId}
  projectName={projectName}
  ariaLabel="BITS interactive live demo"
  icon="code"
  intro="Explore the external BITS attendance dashboard and virtual ZKTeco terminal without leaving this project dossier."
  hint="Launch loads the BITS dashboard first; the terminal loads only when selected. Use sample identities only and verify scan results in BITS Attendance."
  secondaryNote="Use the Simulator tab above the dashboard to stay in this demo. Buttons inside BITS retain their original behavior and may open another browser tab."
  activeNotice="To stay here, use these tabs. BITS’s own terminal button may open a separate browser tab."
  views={views}
  hostTag="bits-live-demo"
  hostDataset={{
    'data-dashboard-url': dashboardUrl,
    'data-terminal-url': terminalUrl,
  }}
/>

<style>
  /* Preserved for empty frame slot collapse verification (UX-09) */
  .frame-slot:empty { display: none; }
</style>