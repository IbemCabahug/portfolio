---
interface Props {
  currentLabel: string;
  leftLabel?: string;
  leftLink?: string;
  rightLabel?: string;
  rightLink?: string;
}

const { currentLabel, leftLabel, leftLink, rightLabel, rightLink } = Astro.props;
---
<nav aria-label="Scene navigation" class="flex items-center justify-center gap-4 py-4 text-[var(--parchment)] font-semibold bg-[var(--wood-deep)]">
  {leftLink && leftLabel ? (
    <a href={leftLink} class="hover:text-[var(--candle)] focus-visible:outline-2 focus-visible:outline-[var(--brass)] px-2 py-1" id="nav-left">
      {leftLabel} &larr;
    </a>
  ) : (
    <span class="opacity-0 px-2 py-1 pointer-events-none" aria-hidden="true">None &larr;</span>
  )}

  <span class="text-xl font-bold border-b-2 border-[var(--brass)] px-4 text-[var(--candle)]" aria-current="page">
    {currentLabel}
  </span>

  {rightLink && rightLabel ? (
    <a href={rightLink} class="hover:text-[var(--candle)] focus-visible:outline-2 focus-visible:outline-[var(--brass)] px-2 py-1" id="nav-right">
      &rarr; {rightLabel}
    </a>
  ) : (
    <span class="opacity-0 px-2 py-1 pointer-events-none" aria-hidden="true">&rarr; None</span>
  )}
</nav>
