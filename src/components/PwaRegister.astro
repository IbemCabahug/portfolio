---
// src/components/PwaRegister.astro
const isDev = import.meta.env.DEV;
---

{/* Subtle Offline / Online / Update Notification Toast */}
<div
  id="pwa-network-toast"
  role="status"
  aria-live="polite"
  class="fixed bottom-4 right-4 z-50 transform translate-y-16 opacity-0 transition-all duration-300 pointer-events-none"
>
  <div
    id="pwa-toast-inner"
    class="flex items-center gap-2.5 px-3.5 py-2 rounded-lg bg-[#1a1005]/95 border border-[var(--brass)] text-[var(--parchment)] text-xs font-medium shadow-xl backdrop-blur-sm"
  >
    <span id="pwa-toast-dot" class="w-2 h-2 rounded-full bg-amber-400"></span>
    <span id="pwa-toast-msg">Network status</span>
    <button
      id="pwa-toast-action"
      type="button"
      class="hidden ml-1 px-2.5 py-1 rounded bg-[var(--brass)] text-black font-bold text-[11px] hover:bg-[var(--candle)] transition-colors cursor-pointer min-h-[32px]"
    >
      Reload
    </button>
  </div>
</div>

<script is:inline define:vars={{ isDev }}>
  (() => {
    if (window.__pwaRegistered) return;
    window.__pwaRegistered = true;

    // In local development, unregister any active service worker and purge caches so dev edits are never stale
    if (isDev) {
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then((registrations) => {
          for (const registration of registrations) {
            registration.unregister();
          }
        });
      }
      if ('caches' in window) {
        caches.keys().then((names) => {
          for (const name of names) {
            caches.delete(name);
          }
        });
      }
      return;
    }

    // Check whether user has unsaved form input or an active interactive demo/modal open (UX-07)
    function isUserBusyWithActiveWork() {
      if (document.body && document.body.dataset.demoActive === 'true') return true;
      if (document.querySelector('form[data-dirty="true"]')) return true;
      if (document.querySelector('[data-quest-demo-shell] [data-active]:not([hidden]), bits-live-demo [data-active]:not([hidden])')) return true;
      if (document.querySelector('#arena-frame-container:not(.hidden), #transceiver-frame-container:not(.hidden)')) return true;
      if (document.querySelector('[role="dialog"]:not([hidden])')) return true;
      const desktopBody = document.getElementById('desktop-missive-body');
      const mobileBody = document.getElementById('mobile-missive-body');
      if ((desktopBody && desktopBody.value && desktopBody.value.trim()) || (mobileBody && mobileBody.value && mobileBody.value.trim())) {
        return true;
      }
      return false;
    }

    function showUpdateAvailableBanner(waitingWorker) {
      const toast = document.getElementById('pwa-network-toast');
      const msg = document.getElementById('pwa-toast-msg');
      const dot = document.getElementById('pwa-toast-dot');
      const actionBtn = document.getElementById('pwa-toast-action');
      if (!toast || !msg || !dot || !actionBtn) return;

      clearTimeout(window.__pwaToastTimer);
      msg.textContent = 'Update available for this portfolio';
      dot.className = 'w-2 h-2 rounded-full bg-amber-400 animate-pulse';
      actionBtn.textContent = 'Reload now';
      actionBtn.classList.remove('hidden');

      toast.classList.remove('translate-y-16', 'opacity-0', 'pointer-events-none');
      toast.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');

      actionBtn.onclick = () => {
        actionBtn.disabled = true;
        actionBtn.textContent = 'Updating…';
        window.__pwaAllowReload = true;
        if (waitingWorker) {
          waitingWorker.postMessage({ type: 'SKIP_WAITING' });
        } else {
          window.location.reload();
        }
      };
    }

    // 1. Service Worker Registration (Production)
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker
          .register('/sw.js', { scope: '/' })
          .then((registration) => {
            if (registration.waiting && navigator.serviceWorker.controller) {
              if (isUserBusyWithActiveWork()) {
                showUpdateAvailableBanner(registration.waiting);
              } else {
                window.__pwaAllowReload = true;
                registration.waiting.postMessage({ type: 'SKIP_WAITING' });
              }
            }

            registration.addEventListener('updatefound', () => {
              const installingWorker = registration.installing;
              if (!installingWorker) return;
              installingWorker.addEventListener('statechange', () => {
                if (installingWorker.state === 'installed' && navigator.serviceWorker.controller) {
                  if (isUserBusyWithActiveWork()) {
                    showUpdateAvailableBanner(installingWorker);
                  } else {
                    window.__pwaAllowReload = true;
                    installingWorker.postMessage({ type: 'SKIP_WAITING' });
                  }
                }
              });
            });

            const hadController = !!navigator.serviceWorker.controller;
            let refreshing = false;
            navigator.serviceWorker.addEventListener('controllerchange', () => {
              if (refreshing || !hadController) return;
              if (isUserBusyWithActiveWork() && !window.__pwaAllowReload) {
                showUpdateAvailableBanner(null);
                return;
              }
              refreshing = true;
              window.location.reload();
            });

            setInterval(() => {
              registration.update().catch(() => {});
            }, 60 * 60 * 1000);
          })
          .catch((error) => {
            console.error('[PWA] Service Worker registration failed:', error);
          });
      });
    }

    // 2. Network Connectivity Status Handlers
    function showNetworkToast(isOnline) {
      const toast = document.getElementById('pwa-network-toast');
      const msg = document.getElementById('pwa-toast-msg');
      const dot = document.getElementById('pwa-toast-dot');
      const actionBtn = document.getElementById('pwa-toast-action');
      if (!toast || !msg || !dot) return;

      if (actionBtn) actionBtn.classList.add('hidden');

      if (isOnline) {
        msg.textContent = 'Connection restored — Tavern in sync';
        dot.className = 'w-2 h-2 rounded-full bg-emerald-400';
      } else {
        msg.textContent = 'Offline mode — Cached tavern rooms available';
        dot.className = 'w-2 h-2 rounded-full bg-amber-400 animate-pulse';
      }

      toast.classList.remove('translate-y-16', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');

      clearTimeout(window.__pwaToastTimer);
      window.__pwaToastTimer = setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
        toast.classList.add('translate-y-16', 'opacity-0', 'pointer-events-none');
      }, 3500);
    }

    window.addEventListener('online', () => showNetworkToast(true));
    window.addEventListener('offline', () => showNetworkToast(false));

    // 3. Capture PWA Install Prompt
    window.addEventListener('beforeinstallprompt', (e) => {
      window.deferredPwaPrompt = e;
      window.dispatchEvent(new CustomEvent('pwa:installable'));
    });
  })();
</script>
