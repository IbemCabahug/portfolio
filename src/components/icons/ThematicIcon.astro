---
export interface Props {
  name:
    | 'ledger'
    | 'tavern'
    | 'scroll'
    | 'play'
    | 'code'
    | 'raven'
    | 'terminal'
    | 'resume'
    | 'swords'
    | 'external';
  class?: string;
  size?: number | string;
}

const { name, class: className = 'w-5 h-5 inline-block', size = 20 } = Astro.props;
---

{name === 'ledger' && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    width={size}
    height={size}
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={className}
    aria-hidden="true"
  >
    <!-- Bound Guild Ledger / Inscribed Tome -->
    <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z" />
    <path d="M6 2v20" />
    <path d="M10 7h6" />
    <path d="M10 11h6" />
    <path d="M10 15h4" />
    <!-- Brass bookmark ribbon -->
    <path d="M16 2v6l-2-1.5L12 8V2" stroke-width="1.5" />
  </svg>
)}

{name === 'tavern' && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    width={size}
    height={size}
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={className}
    aria-hidden="true"
  >
    <!-- Tavern Tankard / Mug -->
    <path d="M5 8h10v11a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V8Z" />
    <path d="M15 10h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-3" />
    <!-- Foam crest -->
    <path d="M5 8c-.6-1 0-2.5 1-3 1.5-.7 3 .5 4 0 1-.5 1-2 2.5-2s2 1.5 2.5 2.5c.5 1 0 2.5 0 2.5" />
    <!-- Wooden plank bands -->
    <line x1="5" y1="12" x2="15" y2="12" />
    <line x1="5" y1="16" x2="15" y2="16" />
  </svg>
)}

{name === 'scroll' && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    width={size}
    height={size}
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={className}
    aria-hidden="true"
  >
    <!-- Parchment Quest Scroll -->
    <path d="M8 2h10a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h12" />
    <path d="M18 18a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12" opacity="0.3" />
    <path d="M4 6a2 2 0 0 1 2-2h12" />
    <line x1="8" y1="8" x2="15" y2="8" />
    <line x1="8" y1="12" x2="16" y2="12" />
    <line x1="8" y1="16" x2="13" y2="16" />
  </svg>
)}

{name === 'play' && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    width={size}
    height={size}
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={className}
    aria-hidden="true"
  >
    <!-- Screen / Live Demo Action Portal -->
    <rect width="20" height="14" x="2" y="3" rx="2" />
    <polygon points="10 8 15 10 10 12 10 8" fill="currentColor" stroke="none" />
    <line x1="8" y1="21" x2="16" y2="21" />
    <line x1="12" y1="17" x2="12" y2="21" />
  </svg>
)}

{name === 'code' && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    width={size}
    height={size}
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={className}
    aria-hidden="true"
  >
    <!-- Git Branch / Source Code Brackets -->
    <polyline points="16 18 22 12 16 6" />
    <polyline points="8 6 2 12 8 18" />
    <line x1="14" y1="4" x2="10" y2="20" />
  </svg>
)}

{name === 'raven' && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    width={size}
    height={size}
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={className}
    aria-hidden="true"
  >
    <!-- Raven Feather Quill & Wax-Sealed Letter -->
    <rect width="18" height="13" x="3" y="6" rx="2" />
    <path d="m3 8 9 6 9-6" />
    <!-- Feather quill accent -->
    <path d="M19 2c-1.5 1-3.5 3-4 5.5l1.5 1.5C18 7.5 20 5.5 21 4l-2-2Z" fill="currentColor" opacity="0.4" />
  </svg>
)}

{name === 'terminal' && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    width={size}
    height={size}
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={className}
    aria-hidden="true"
  >
    <!-- Developer Terminal Prompt -->
    <polyline points="4 17 10 11 4 5" />
    <line x1="12" y1="19" x2="20" y2="19" />
  </svg>
)}

{name === 'resume' && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    width={size}
    height={size}
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={className}
    aria-hidden="true"
  >
    <!-- Formal Manuscript / Résumé with Wax Seal -->
    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
    <polyline points="14 2 14 8 20 8" />
    <line x1="16" y1="13" x2="8" y2="13" />
    <line x1="16" y1="17" x2="8" y2="17" />
    <circle cx="9" cy="9" r="1.5" fill="currentColor" />
  </svg>
)}

{name === 'swords' && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    width={size}
    height={size}
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={className}
    aria-hidden="true"
  >
    <!-- Crossed Blades / Guild Quest Emblem -->
    <line x1="4" y1="20" x2="19" y2="5" />
    <line x1="16" y1="4" x2="20" y2="8" />
    <line x1="3" y1="16" x2="7" y2="20" />
    <line x1="5" y1="17" x2="7" y2="19" />
    <line x1="20" y1="20" x2="5" y2="5" />
    <line x1="4" y1="8" x2="8" y2="4" />
    <line x1="17" y1="20" x2="21" y2="16" />
    <line x1="17" y1="19" x2="19" y2="17" />
  </svg>
)}

{name === 'external' && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    width={size}
    height={size}
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={className}
    aria-hidden="true"
  >
    <!-- Clean External Portal Link Arrow -->
    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
    <polyline points="15 3 21 3 21 9" />
    <line x1="10" y1="14" x2="21" y2="3" />
  </svg>
)}
