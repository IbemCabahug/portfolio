---
import ThematicIcon from './icons/ThematicIcon.astro';
import { JOURNAL_MILESTONES } from '../store/questlog';

const chambers = JOURNAL_MILESTONES.filter((m) => m.category === 'chamber');
const dossiers = JOURNAL_MILESTONES.filter((m) => m.category === 'dossier');
const totalCount = JOURNAL_MILESTONES.length;
---

<div class="quest-log-wrapper">
  {/* HUD Trigger Button in Header */}
  <button
    type="button"
    id="trigger-quest-log"
    class="inline-flex items-center gap-2 min-h-[44px] px-3.5 py-1.5 rounded-md bg-[#1e1208] border-2 border-[var(--brass)] text-xs font-semibold text-[var(--candle)] hover:bg-black hover:border-[var(--candle)] transition-all shadow-xs cursor-pointer focus-visible:outline-2 focus-visible:outline-[var(--candle)] focus-visible:outline-offset-2"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="journal-dialog"
    title="Open Wayfarer's Journal (Exploration & Fast-Travel Log)"
  >
    <ThematicIcon name="ledger" class="w-4 h-4 text-[var(--candle)] shrink-0" />
    <span class="font-serif tracking-wide hidden md:inline">Wayfarer's Journal</span>
    <span class="font-serif tracking-wide md:hidden">Journal</span>
    <span
      id="journal-counter-badge"
      class="px-2 py-0.5 rounded-full bg-[var(--brass)]/20 border border-[var(--brass)]/60 text-[var(--candle)] font-mono text-[11px] font-bold"
    >
      0/{totalCount}
    </span>
  </button>

  {/* Journal Modal Backdrop */}
  <div
    id="journal-dialog-backdrop"
    class="fixed inset-0 bg-black/80 backdrop-blur-xs z-50 transition-opacity"
    hidden
    aria-hidden="true"
  ></div>

  {/* Journal Modal Tome */}
  <div
    id="journal-dialog"
    class="fixed inset-x-4 top-[5%] sm:inset-auto sm:left-1/2 sm:top-1/2 sm:-translate-x-1/2 sm:-translate-y-1/2 z-50 w-full max-w-2xl max-h-[90vh] overflow-y-auto bg-[#f6eee0] text-[var(--ink)] border-2 border-[var(--brass)] rounded-lg shadow-2xl p-5 sm:p-7 transition-transform"
    style="background-image: radial-gradient(#e2d5be 1px, transparent 1px); background-size: 20px 20px;"
    role="dialog"
    aria-modal="true"
    aria-labelledby="journal-dialog-title"
    hidden
  >
    {/* Journal Header */}
    <div class="border-b-2 border-[var(--brass)] pb-4 mb-5">
      <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-[var(--wood-deep)] border border-[var(--brass)] flex items-center justify-center shrink-0 shadow">
            <ThematicIcon name="ledger" class="w-6 h-6 text-[var(--candle)]" />
          </div>
          <div>
            <span class="text-xs uppercase font-extrabold tracking-widest text-[#7c531d]">Traveler's Chronicles</span>
            <h2 id="journal-dialog-title" class="text-xl sm:text-2xl font-bold text-[var(--ink)] font-serif leading-tight">
              The Wayfarer's Journal
            </h2>
          </div>
        </div>
      </div>

      <p class="text-xs sm:text-sm text-[var(--ink)]/85 mt-2.5 leading-relaxed">
        An inscribed chronicle of the chambers you have explored and technical dossiers you have inspected across the tavern. Select any inscribed entry to fast-travel instantly.
      </p>

      {/* Exploration Progress Bar */}
      <div class="mt-4 pt-3 border-t border-[var(--brass)]/30">
        <div class="flex items-center justify-between text-xs font-mono mb-1.5">
          <span class="font-bold text-[#633a0e]">Realm Discovery Status</span>
          <span id="journal-progress-text" class="font-bold text-[var(--ink)]">0 of {totalCount} Inscribed (0%)</span>
        </div>
        <div class="w-full h-3 rounded-full bg-[#e3d7c1] border border-[var(--brass)]/60 overflow-hidden shadow-inner p-0.5">
          <div
            id="journal-progress-bar"
            class="h-full rounded-full bg-gradient-to-r from-[#b37424] via-[var(--brass)] to-[#8c5210] transition-all duration-300 w-0"
            role="progressbar"
            aria-valuenow="0"
            aria-valuemin="0"
            aria-valuemax="100"
          ></div>
        </div>
      </div>
    </div>

    {/* Section 1: Chambers of the Tavern */}
    <div class="space-y-4 mb-6">
      <h3 class="text-xs uppercase font-extrabold tracking-widest text-[#7c531d] flex items-center gap-2">
        <ThematicIcon name="tavern" class="w-4 h-4 text-[var(--brass)]" />
        <span>Chambers of the Realm</span>
      </h3>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
        {chambers.map((chamber) => (
          <div
            id={`journal-card-${chamber.id}`}
            class="journal-milestone-card p-3 rounded-md border border-[var(--brass)]/50 bg-[#ede4d3]/70 hover:bg-[#ede4d3] transition-colors flex flex-col justify-between gap-2 shadow-2xs"
            data-milestone-id={chamber.id}
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-1">
                <span class="font-bold text-sm text-[var(--ink)] font-serif flex items-center gap-1.5">
                  <ThematicIcon name={chamber.iconName as any} class="w-3.5 h-3.5 text-[var(--brass)]" />
                  <span>{chamber.title}</span>
                </span>
                <span class="milestone-status-badge text-[10px] font-mono font-bold px-1.5 py-0.5 rounded border border-stone-400/50 text-stone-600 bg-stone-200/50">
                  ○ Unexplored
                </span>
              </div>
              <p class="text-[11px] text-[var(--ink)]/80 leading-snug">
                {chamber.tagline}
              </p>
            </div>

            <div class="pt-1.5 border-t border-[var(--brass)]/20 flex items-center justify-between">
              <a
                href={chamber.path}
                class="inline-flex items-center gap-1 text-xs font-bold text-[#633a0e] hover:underline"
              >
                <span>Travel to Chamber &rarr;</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

    {/* Section 2: Case Study Dossiers */}
    <div class="space-y-4 mb-6">
      <h3 class="text-xs uppercase font-extrabold tracking-widest text-[#7c531d] flex items-center gap-2">
        <ThematicIcon name="scroll" class="w-4 h-4 text-[var(--brass)]" />
        <span>Inscribed Case Study Dossiers</span>
      </h3>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
        {dossiers.map((dossier) => (
          <div
            id={`journal-card-${dossier.id}`}
            class="journal-milestone-card p-3 rounded-md border border-[var(--brass)]/50 bg-[#ede4d3]/70 hover:bg-[#ede4d3] transition-colors flex flex-col justify-between gap-2 shadow-2xs"
            data-milestone-id={dossier.id}
          >
            <div>
              <div class="flex items-center justify-between gap-1 mb-1">
                <span class="font-bold text-xs text-[var(--ink)] font-serif truncate" title={dossier.title}>
                  {dossier.title}
                </span>
                <span class="milestone-status-badge text-[9px] font-mono font-bold px-1.5 py-0.5 rounded border border-stone-400/50 text-stone-600 bg-stone-200/50 shrink-0">
                  ○ Unread
                </span>
              </div>
              <p class="text-[11px] text-[var(--ink)]/80 leading-snug">
                {dossier.tagline}
              </p>
            </div>

            <div class="pt-1.5 border-t border-[var(--brass)]/20 flex items-center justify-between">
              <a
                href={dossier.path}
                class="inline-flex items-center gap-1 text-xs font-bold text-[#633a0e] hover:underline"
              >
                <span>Read Dossier &rarr;</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

    {/* Actions Footer */}
    <div class="pt-4 border-t-2 border-[var(--brass)] flex flex-wrap items-center justify-between gap-3">
      <button
        type="button"
        id="journal-reset-btn"
        class="text-xs font-bold text-stone-600 hover:text-stone-900 underline transition-colors cursor-pointer min-h-[44px] px-2"
        title="Reset recorded exploration milestones in localStorage"
      >
        Clear Inscriptions
      </button>

      <button
        type="button"
        id="journal-close-btn"
        class="inline-flex items-center justify-center min-h-[44px] px-6 py-2 bg-[var(--wood-deep)] text-[var(--candle)] border border-[var(--brass)] font-bold text-sm rounded hover:bg-black transition-colors shadow-md cursor-pointer focus-visible:outline-2 focus-visible:outline-[var(--brass)] ml-auto"
      >
        Close Journal (Esc)
      </button>
    </div>
  </div>
</div>

<script>
  import {
    JOURNAL_MILESTONES,
    getVisitedMilestones,
    recordMilestone,
    clearJournalMilestones,
    detectMilestoneFromPath,
    subscribeQuestLog,
  } from '../store/questlog';

  function initJournal() {
    const trigger = document.getElementById('trigger-quest-log');
    const backdrop = document.getElementById('journal-dialog-backdrop');
    const dialog = document.getElementById('journal-dialog');
    const closeBtn = document.getElementById('journal-close-btn');
    const resetBtn = document.getElementById('journal-reset-btn');
    const counterBadge = document.getElementById('journal-counter-badge');
    const progressBar = document.getElementById('journal-progress-bar');
    const progressText = document.getElementById('journal-progress-text');

    if (!trigger || !dialog || !backdrop) return;

    const safeTrigger = trigger;
    const safeBackdrop = backdrop;
    const safeDialog = dialog;

    // Automatically record current location on page visit
    const currentMilestone = detectMilestoneFromPath(window.location.pathname);
    if (currentMilestone) {
      recordMilestone(currentMilestone);
    }

    function updateView() {
      const visited = getVisitedMilestones();
      const count = visited.size;
      const total = JOURNAL_MILESTONES.length;
      const pct = Math.round((count / total) * 100);

      // Update badge
      if (counterBadge) {
        counterBadge.textContent = `${count}/${total}`;
      }

      // Update progress bar
      if (progressBar) {
        progressBar.style.width = `${pct}%`;
        progressBar.setAttribute('aria-valuenow', String(pct));
      }
      if (progressText) {
        progressText.textContent = `${count} of ${total} Inscribed (${pct}%)`;
      }

      // Update milestone cards
      JOURNAL_MILESTONES.forEach((milestone) => {
        const card = document.getElementById(`journal-card-${milestone.id}`);
        if (!card) return;

        const badge = card.querySelector('.milestone-status-badge');
        const isVisited = visited.has(milestone.id);

        if (isVisited) {
          card.classList.remove('bg-[#ede4d3]/70', 'border-[var(--brass)]/50');
          card.classList.add('bg-emerald-950/5', 'border-emerald-700/60');

          if (badge) {
            badge.textContent = milestone.category === 'chamber' ? '✓ Inscribed' : '✓ Reviewed';
            badge.className =
              'milestone-status-badge text-[10px] font-mono font-bold px-1.5 py-0.5 rounded border border-emerald-600/70 text-emerald-800 bg-emerald-100/80 shrink-0';
          }
        } else {
          card.classList.remove('bg-emerald-950/5', 'border-emerald-700/60');
          card.classList.add('bg-[#ede4d3]/70', 'border-[var(--brass)]/50');

          if (badge) {
            badge.textContent = milestone.category === 'chamber' ? '○ Unexplored' : '○ Unread';
            badge.className =
              'milestone-status-badge text-[10px] font-mono font-bold px-1.5 py-0.5 rounded border border-stone-400/50 text-stone-600 bg-stone-200/50 shrink-0';
          }
        }
      });
    }

    function openDialog() {
      safeBackdrop.removeAttribute('hidden');
      safeDialog.removeAttribute('hidden');
      safeTrigger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      if (closeBtn) closeBtn.focus();
    }

    function closeDialog() {
      safeBackdrop.setAttribute('hidden', '');
      safeDialog.setAttribute('hidden', '');
      safeTrigger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      safeTrigger.focus();
    }

    trigger.addEventListener('click', openDialog);
    backdrop.addEventListener('click', closeDialog);
    if (closeBtn) closeBtn.addEventListener('click', closeDialog);

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (window.confirm('Clear your recorded traveler inscriptions and start fresh?')) {
          clearJournalMilestones();
          // Re-record current page
          if (currentMilestone) {
            recordMilestone(currentMilestone);
          }
        }
      });
    }

    // Keyboard support: Escape key to close
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !dialog.hasAttribute('hidden')) {
        closeDialog();
      }
    });

    // Subscribe to store updates
    subscribeQuestLog(updateView);

    // Initial render
    updateView();
  }

  // Initialize on load and on view transitions if any
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initJournal);
  } else {
    initJournal();
  }
</script>
