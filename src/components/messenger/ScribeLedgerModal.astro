---
import { getEntry } from 'astro:content';

// Scribe's Ledger Modal: Verified Academic & Professional Credentials
const profileEntry = await getEntry('profile', 'main');
const profile = profileEntry?.data;
---

<div
  id="dialog-desk"
  class="tavern-panel"
  role="dialog"
  aria-modal="true"
  aria-labelledby="desk-dialog-title"
  hidden
>
  <div class="panel-header">
    <div class="flex items-center gap-3">
      <span class="panel-badge-icon" aria-hidden="true">
        <svg class="w-7 h-7 text-[var(--brass)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
          <line x1="16" y1="13" x2="8" y2="13"/>
          <line x1="16" y1="17" x2="8" y2="17"/>
          <polyline points="10 9 9 9 8 9"/>
        </svg>
      </span>
      <div>
        <span class="text-xs uppercase font-extrabold tracking-widest text-[var(--ember)]">Master Ledger</span>
        <h2 id="desk-dialog-title" class="text-xl sm:text-2xl font-bold text-[var(--candle)]">The Scribe's Ledger</h2>
      </div>
    </div>
  </div>

  <div class="panel-body space-y-3">
    <p class="text-xs sm:text-sm text-[var(--parchment)]/90 leading-relaxed">
      Inscribed with meticulous care under the candlelight rests Nhovem's verified academic credentials, software development history, and core technical proficiencies.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs">
      <!-- Academic Credential -->
      <div class="p-2.5 rounded bg-[var(--wood-deep)]/80 border border-[var(--brass)]/30 space-y-1">
        <span class="text-[var(--brass)] uppercase tracking-wider font-extrabold block">Academic Credential</span>
        <strong class="text-[var(--candle)] text-xs sm:text-sm block">Bachelor of Industrial Technology</strong>
        <span class="text-[var(--parchment)]/90 block font-medium">Major in Computer Technology</span>
        <span class="text-[var(--parchment)]/70 block text-[11px]">Cebu Technological University – Danao Campus (2022–2026)</span>
        <div class="pt-1 flex flex-wrap gap-1">
          <span class="px-1.5 py-0.5 rounded bg-[var(--stone)]/80 text-[var(--candle)] font-mono text-[10px] border border-[var(--brass)]/30">Academic Distinction</span>
          <span class="px-1.5 py-0.5 rounded bg-[var(--stone)]/80 text-[var(--candle)] font-mono text-[10px] border border-[var(--brass)]/30">Dean's Lister</span>
        </div>
      </div>

      <!-- Title, Discipline & Training -->
      <div class="p-2.5 rounded bg-[var(--wood-deep)]/80 border border-[var(--brass)]/30 space-y-1">
        <span class="text-[var(--brass)] uppercase tracking-wider font-extrabold block">Discipline & Training</span>
        <strong class="text-[var(--candle)] text-xs sm:text-sm block">{profile?.title || 'AI-Assisted Developer'}</strong>
        <span class="text-[var(--parchment)]/90 block font-medium">Computer Technology & Web Systems</span>
        <span class="text-[var(--parchment)]/70 block text-[11px]">Vocational: Creative Web Design (TESDA, 102 Hours)</span>
        <div class="pt-1">
          <span class="text-emerald-400 font-mono text-[10px]">&bull; Focus: TypeScript, Accessible UX, Performance</span>
        </div>
      </div>
    </div>

    <!-- Verified Experience -->
    <div class="p-2.5 rounded bg-black/30 border border-[var(--brass)]/30 space-y-1.5 text-xs">
      <span class="text-xs uppercase tracking-wider text-[var(--brass)] font-semibold block">Production Work Experience</span>
      <div class="space-y-1 text-[11px] text-[var(--parchment)]/85">
        <p>
          <strong class="text-[var(--candle)] font-mono">BITS Biometric Timekeeping:</strong> Contributed biometric overtime check-in routing, resolved multi-shift edge cases, and normalized punch times for active company operations.
        </p>
        <p>
          <strong class="text-[var(--candle)] font-mono">Avega Bros. Integrated Shipping Corp.:</strong> IT & Administrative Support Intern (1,800 hours), handling hardware/software installation, troubleshooting, and data systems.
        </p>
      </div>
    </div>

    <!-- Core Arsenal -->
    <div class="p-2.5 rounded bg-black/30 border border-[var(--brass)]/30 space-y-1">
      <span class="text-xs uppercase tracking-wider text-[var(--brass)] font-semibold block">Core Arsenal</span>
      <div class="flex flex-wrap gap-1.5">
        <span class="px-2 py-0.5 rounded bg-[var(--wood-deep)] border border-[var(--brass)]/40 text-[var(--candle)] text-xs font-mono">TypeScript</span>
        <span class="px-2 py-0.5 rounded bg-[var(--wood-deep)] border border-[var(--brass)]/40 text-[var(--candle)] text-xs font-mono">React / Next.js</span>
        <span class="px-2 py-0.5 rounded bg-[var(--wood-deep)] border border-[var(--brass)]/40 text-[var(--candle)] text-xs font-mono">Astro</span>
        <span class="px-2 py-0.5 rounded bg-[var(--wood-deep)] border border-[var(--brass)]/40 text-[var(--candle)] text-xs font-mono">Node.js</span>
        <span class="px-2 py-0.5 rounded bg-[var(--wood-deep)] border border-[var(--brass)]/40 text-[var(--candle)] text-xs font-mono">Tailwind CSS</span>
        <span class="px-2 py-0.5 rounded bg-[var(--wood-deep)] border border-[var(--brass)]/40 text-[var(--candle)] text-xs font-mono">PostgreSQL</span>
        <span class="px-2 py-0.5 rounded bg-[var(--wood-deep)] border border-[var(--brass)]/40 text-[var(--candle)] text-xs font-mono">REST / GraphQL</span>
        <span class="px-2 py-0.5 rounded bg-[var(--wood-deep)] border border-[var(--brass)]/40 text-[var(--candle)] text-xs font-mono">Git & CI/CD</span>
      </div>
    </div>
  </div>

  <div class="panel-actions flex flex-wrap items-center justify-between gap-3 pt-3">
    <div class="flex flex-wrap items-center gap-2">
      <a
        href="/resume"
        class="inline-flex items-center justify-center min-h-[44px] px-5 py-2 bg-[var(--wood-deep)] text-[var(--candle)] border border-[var(--brass)] font-bold text-xs sm:text-sm rounded hover:bg-black hover:border-[var(--candle)] transition-colors shadow-md"
      >
        View Full Web Resume &rarr;
      </a>
      <a
        href="/resume.pdf"
        download
        class="inline-flex items-center justify-center min-h-[44px] px-4 py-2 bg-[var(--wood-deep)] text-[var(--candle)] border border-[var(--brass)]/70 text-xs sm:text-sm font-semibold rounded hover:bg-black hover:border-[var(--candle)] transition-colors"
      >
        Download PDF &darr;
      </a>
    </div>
    <button
      type="button"
      class="close-panel-btn inline-flex items-center justify-center min-h-[44px] px-6 py-2 bg-[var(--brass)] text-black font-bold text-xs sm:text-sm rounded hover:bg-[var(--candle)] transition-colors cursor-pointer ml-auto"
    >
      Close Ledger (Esc)
    </button>
  </div>
</div>
