---
interface Props {
  mailAddress: string;
}

const { mailAddress } = Astro.props;
---

<div
  id="dialog-raven"
  class="tavern-panel"
  role="dialog"
  aria-modal="true"
  aria-labelledby="raven-dialog-title"
  hidden
>
  <div class="panel-header flex items-center justify-between">
    <div class="flex items-center gap-3">
      <span class="panel-badge-icon" aria-hidden="true">
        <svg class="w-7 h-7 text-[var(--brass)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"/>
          <line x1="16" y1="8" x2="2" y2="22"/>
          <line x1="17.5" y1="15" x2="9" y2="15"/>
        </svg>
      </span>
      <div>
        <span class="text-xs uppercase font-extrabold tracking-widest text-[var(--ember)]">Priority Dispatch &bull; Contact Form</span>
        <h2 id="raven-dialog-title" class="text-xl sm:text-2xl font-bold text-[var(--candle)]">Send a Message (Dispatch Raven)</h2>
      </div>
    </div>
  </div>

  <!-- Composer View -->
  <div id="raven-composer-view" class="panel-body space-y-3">
    <p class="text-xs sm:text-sm text-[var(--parchment)]/90 leading-relaxed">
      Write your message below. Selecting a category pre-fills a subject template, or you can write your own.
    </p>

    <!-- Template Categories (ARIA Radio Group - UX-04) -->
    <div>
      <span id="desktop-template-group-label" class="block text-xs uppercase tracking-wider text-[var(--brass)] font-semibold mb-1.5">Select Message Template</span>
      <div class="grid grid-cols-3 gap-1.5" role="radiogroup" aria-labelledby="desktop-template-group-label">
        <button
          type="button"
          role="radio"
          aria-checked="true"
          tabindex="0"
          class="template-pill active"
          data-template="quest"
          data-prefix="[Quest Offer]"
          data-subject="Frontend / Web Project Inquiry"
          data-placeholder="Describe the project, target timeline, technology stack, and how you'd like to collaborate..."
        >
          📜 Project / Quest
        </button>
        <button
          type="button"
          role="radio"
          aria-checked="false"
          tabindex="-1"
          class="template-pill"
          data-template="role"
          data-prefix="[Guild Recruitment]"
          data-subject="AI-Assisted Developer Role Opportunity"
          data-placeholder="Share details about the developer role, team structure, remote/hybrid requirements, and company mission..."
        >
          ⚔️ Job / Hiring
        </button>
        <button
          type="button"
          role="radio"
          aria-checked="false"
          tabindex="-1"
          class="template-pill"
          data-template="general"
          data-prefix="[Tavern Greetings]"
          data-subject="Greetings from a Fellow Traveler"
          data-placeholder="Share your thoughts on the portfolio, say hello, or connect with Nhovem..."
        >
          🍺 General Chat
        </button>
      </div>
    </div>

    <!-- Form Fields -->
    <form id="desktop-raven-form" class="space-y-2.5" novalidate>
      <input type="checkbox" name="botcheck" id="desktop-botcheck" class="hidden" style="display:none !important;position:absolute;left:-9999px;" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <div id="desktop-raven-error" class="hidden text-xs text-red-300 bg-red-950/60 border border-red-400/60 rounded px-3 py-2" role="alert" aria-live="assertive"></div>
      <div id="desktop-raven-status" class="hidden text-xs text-[var(--candle)] bg-[var(--wood-deep)]/80 border border-[var(--brass)]/60 rounded px-3 py-2" role="status" aria-live="polite"></div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
        <div>
          <label for="desktop-sender-name" class="block text-xs text-[var(--parchment)]/80 font-medium mb-1">Your Name <span class="text-[var(--ember)]" aria-hidden="true">*</span></label>
          <input
            type="text"
            id="desktop-sender-name"
            name="senderName"
            autocomplete="name"
            required
            maxlength="120"
            aria-invalid="false"
            aria-describedby="desktop-sender-name-error"
            placeholder="e.g. Alex Rivera"
            class="tavern-input w-full px-3 py-1.5 text-xs sm:text-sm rounded bg-black/40 border border-[var(--brass)]/40 text-[var(--candle)] focus:border-[var(--candle)] focus:outline-none transition-colors"
          />
          <p id="desktop-sender-name-error" class="field-error hidden text-xs text-red-300 mt-1" role="status"></p>
        </div>
        <div>
          <label for="desktop-sender-email" class="block text-xs text-[var(--parchment)]/80 font-medium mb-1">Your Email Address <span class="text-[var(--ember)]" aria-hidden="true">*</span></label>
          <input
            type="email"
            id="desktop-sender-email"
            name="senderEmail"
            autocomplete="email"
            required
            maxlength="254"
            aria-invalid="false"
            aria-describedby="desktop-sender-email-error"
            placeholder="e.g. alex@company.com"
            class="tavern-input w-full px-3 py-1.5 text-xs sm:text-sm rounded bg-black/40 border border-[var(--brass)]/40 text-[var(--candle)] focus:border-[var(--candle)] focus:outline-none transition-colors"
          />
          <p id="desktop-sender-email-error" class="field-error hidden text-xs text-red-300 mt-1" role="status"></p>
        </div>
      </div>

      <div>
        <label for="desktop-missive-subject" class="block text-xs text-[var(--parchment)]/80 font-medium mb-1">Subject <span class="text-[var(--ember)]" aria-hidden="true">*</span></label>
        <input
          type="text"
          id="desktop-missive-subject"
          name="subject"
          autocomplete="off"
          required
          maxlength="200"
          aria-invalid="false"
          aria-describedby="desktop-missive-subject-error"
          value="[Quest Offer] Frontend / Web Project Inquiry"
          class="tavern-input w-full px-3 py-1.5 text-xs sm:text-sm rounded bg-black/40 border border-[var(--brass)]/40 text-[var(--candle)] focus:border-[var(--candle)] focus:outline-none transition-colors"
        />
        <p id="desktop-missive-subject-error" class="field-error hidden text-xs text-red-300 mt-1" role="status"></p>
      </div>

      <div>
        <label for="desktop-missive-body" class="block text-xs text-[var(--parchment)]/80 font-medium mb-1">Message <span class="text-[var(--ember)]" aria-hidden="true">*</span></label>
        <textarea
          id="desktop-missive-body"
          name="message"
          required
          maxlength="5000"
          rows="3"
          aria-invalid="false"
          aria-describedby="desktop-missive-body-error"
          placeholder="Describe the project, target timeline, technology stack, and how you'd like to collaborate..."
          class="tavern-input w-full px-3 py-2 text-xs sm:text-sm rounded bg-black/40 border border-[var(--brass)]/40 text-[var(--candle)] focus:border-[var(--candle)] focus:outline-none transition-colors resize-none"
        ></textarea>
        <p id="desktop-missive-body-error" class="field-error hidden text-xs text-red-300 mt-1" role="status"></p>
      </div>

      <div class="flex flex-wrap items-center justify-between text-[11px] text-[var(--parchment)]/70 pt-0.5">
        <span>Destination: <strong class="text-[var(--candle)] font-mono">{mailAddress}</strong></span>
        <span>Typical reply: 24–48 hours</span>
      </div>

      <p class="text-[11px] text-[var(--parchment)]/75 leading-snug bg-black/25 border border-[var(--brass)]/25 rounded px-2.5 py-1.5">
        <strong>Privacy &amp; delivery notice:</strong> Submitting checks your email domain via DNS-over-HTTPS (Google/Cloudflare), verifies anti-bot status via Cloudflare Turnstile, and routes your message through Web3Forms to <span class="font-mono">{mailAddress}</span>. Prefer not to use the form? <a href={`mailto:${mailAddress}`} class="underline text-[var(--candle)] hover:text-white">Email directly</a>.
      </p>

      <!-- Cloudflare Turnstile Anti-Spam Gate -->
      <div class="turnstile-container my-2 flex flex-col items-center justify-center min-h-[70px] w-full">
        <div id="desktop-turnstile-slot" class="cf-turnstile-wrapper flex justify-center items-center min-w-[300px] min-h-[65px]"></div>
      </div>

      <div class="panel-actions pt-2 flex flex-wrap items-center justify-between gap-3">
        <button
          type="submit"
          class="inline-flex items-center justify-center min-h-[44px] px-6 py-2 bg-[var(--brass)] text-black font-bold text-sm rounded hover:bg-[var(--candle)] transition-colors shadow-md cursor-pointer"
        >
          Send Message (Dispatch Raven) &rarr;
        </button>
        <button
          type="button"
          class="close-panel-btn inline-flex items-center justify-center min-h-[44px] px-6 py-2 bg-[var(--brass)] text-black font-bold text-xs sm:text-sm rounded hover:bg-[var(--candle)] transition-colors cursor-pointer ml-auto"
        >
          Close (Esc)
        </button>
      </div>
    </form>
  </div>

  <!-- Dispatch Receipt / Confirmation View (Hidden by default) -->
  <div id="raven-receipt-view" class="panel-body space-y-3 hidden" aria-live="polite">
    <div class="p-4 rounded bg-emerald-950/40 border border-emerald-500/40 text-center space-y-1.5">
      <span class="inline-flex items-center justify-center w-11 h-11 rounded-full bg-emerald-500/20 text-emerald-400 mx-auto" aria-hidden="true">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"/>
          <line x1="16" y1="8" x2="2" y2="22"/>
          <line x1="17.5" y1="15" x2="9" y2="15"/>
        </svg>
      </span>
      <h3 class="text-base sm:text-lg font-bold text-emerald-400" id="receipt-heading">Message Submitted!</h3>
      <p class="text-xs text-[var(--parchment)]/90 max-w-md mx-auto" id="receipt-desc">
        Your message has been accepted for delivery. A copy of your message is shown below for your records:
      </p>
    </div>

    <div class="p-3 rounded bg-black/40 border border-[var(--brass)]/30 font-mono text-xs text-[var(--parchment)]/90 space-y-1">
      <div class="text-[var(--brass)] font-bold mb-1 border-b border-[var(--brass)]/20 pb-1">DISPATCH RECORD</div>
      <p><strong class="text-[var(--candle)]">To:</strong> {mailAddress}</p>
      <p><strong class="text-[var(--candle)]">Subject:</strong> <span id="receipt-subject"></span></p>
      <p><strong class="text-[var(--candle)]">From:</strong> <span id="receipt-from"></span></p>
      <div class="mt-2 pt-2 border-t border-[var(--brass)]/20 whitespace-pre-wrap" id="receipt-body"></div>
    </div>

    <div class="panel-actions pt-2 flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap items-center gap-2">
        <button
          type="button"
          id="receipt-copy-btn"
          class="inline-flex items-center justify-center min-h-[44px] px-4 py-2 bg-[var(--wood-deep)] text-[var(--candle)] border border-[var(--brass)] font-bold text-xs sm:text-sm rounded hover:bg-black transition-colors cursor-pointer"
        >
          Copy Formatted Missive
        </button>
        <a
          id="receipt-gmail-link"
          href={`https://mail.google.com/mail/?view=cm&fs=1&to=${mailAddress}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center min-h-[44px] px-4 py-2 bg-[var(--wood-deep)] text-[var(--candle)] border border-[var(--brass)] font-bold text-xs sm:text-sm rounded hover:bg-black transition-colors"
        >
          Open in Gmail Webmail &rarr;
        </a>
        <a
          id="receipt-mailto-link"
          href={`mailto:${mailAddress}`}
          class="inline-flex items-center justify-center min-h-[44px] px-4 py-2 bg-[var(--wood-deep)] text-[var(--candle)] border border-[var(--brass)] font-bold text-xs sm:text-sm rounded hover:bg-black transition-colors"
        >
          Open in Mail App &rarr;
        </a>
        <button
          type="button"
          id="receipt-reset-btn"
          class="min-h-[44px] px-3 py-2 text-xs sm:text-sm text-[var(--candle)]/80 hover:text-[var(--candle)] hover:underline cursor-pointer"
        >
          Write Another Missive
        </button>
      </div>

      <button
        type="button"
        class="close-panel-btn inline-flex items-center justify-center min-h-[44px] px-6 py-2 bg-[var(--brass)] text-black font-bold text-xs sm:text-sm rounded hover:bg-[var(--candle)] transition-colors cursor-pointer ml-auto"
      >
        Return to Roost (Esc)
      </button>
    </div>
  </div>
</div>
