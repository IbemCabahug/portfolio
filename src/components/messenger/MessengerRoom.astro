<script>
  import { initPerformanceGovernor } from '../../lib/perf-governor';
  import { sendMissive } from '../../lib/contact';
  import { validateEmail } from '../../lib/email-validator';
  import {
    getFocusableElements,
    setBackgroundInert,
    setupTemplateRadioGroup,
    showFormError,
    clearFormError,
    setFormStatus,
    setFieldError,
    clearFieldError,
  } from '../../lib/messenger-ui';
  import { soundEngine } from '../../lib/sound-engine';
  import { recordMilestone } from '../../store/questlog';
  import { navigate } from 'astro:transitions/client';
  import { saveMissiveDraft, getMissiveDraft, clearMissiveDraft } from '../../lib/messenger-draft';

  let messengerAbort: AbortController | null = null;
  let currentSnapshotDraftFn: (() => void) | null = null;

  function initMessengerPage() {
    const pageWrapper = document.querySelector('.roost-page-wrapper') as HTMLElement | null;
    if (!pageWrapper) return;

    messengerAbort?.abort();
    messengerAbort = new AbortController();
    const { signal } = messengerAbort;

    initPerformanceGovernor();
    soundEngine.init();

    // ── Anti-Abuse Shield ──────────────────────────────
    const RATE_LIMIT_KEY = 'raven_sends';
    const COOLDOWN_MS = 60_000;  // 60 seconds between sends
    const MAX_PER_HOUR = 3;      // max 3 sends per hour

    function getRateLimitData(): { timestamps: number[] } {
      try {
        const raw = localStorage.getItem(RATE_LIMIT_KEY);
        if (raw) return JSON.parse(raw);
      } catch {}
      return { timestamps: [] };
    }

    function checkRateLimit(): { allowed: boolean; reason?: string } {
      const data = getRateLimitData();
      const now = Date.now();
      const oneHourAgo = now - 3_600_000;
      data.timestamps = data.timestamps.filter(t => t > oneHourAgo);
      try {
        localStorage.setItem(RATE_LIMIT_KEY, JSON.stringify(data));
      } catch {}

      if (data.timestamps.length >= MAX_PER_HOUR) {
        return { allowed: false, reason: 'You have reached the hourly dispatch limit (3 messages per hour). Please try again later or use direct email.' };
      }
      if (data.timestamps.length > 0) {
        const lastSend = Math.max(...data.timestamps);
        const elapsed = now - lastSend;
        if (elapsed < COOLDOWN_MS) {
          const waitSec = Math.ceil((COOLDOWN_MS - elapsed) / 1000);
          return { allowed: false, reason: `Please wait ${waitSec}s before sending another message.` };
        }
      }
      return { allowed: true };
    }

    function recordSendSuccess() {
      const data = getRateLimitData();
      data.timestamps.push(Date.now());
      try {
        localStorage.setItem(RATE_LIMIT_KEY, JSON.stringify(data));
      } catch {}
    }
    // ── End Anti-Abuse Shield ──────────────────────────

    // Interactive Scene Hotspots and Modal Management
    const triggers = [
      { triggerId: 'trigger-perch-raven', dialogId: 'dialog-raven' },
      { triggerId: 'trigger-arcane-machine', dialogId: 'dialog-machine' },
      { triggerId: 'trigger-scribe-desk', dialogId: 'dialog-desk' },
      { triggerId: 'trigger-courier-satchel', dialogId: 'dialog-satchel' }
    ];

    const backdrop = document.getElementById('dialog-backdrop');
    const sceneObjects = document.querySelectorAll('.scene-object');
    let activeDialog: HTMLElement | null = null;
    let activeTrigger: HTMLElement | null = null;
    let unloadTransceiverFn: (() => void) | null = null;

    function snapshotFromDesktop() {
      const desktopName = (document.getElementById('desktop-sender-name') as HTMLInputElement | null)?.value || '';
      const desktopEmail = (document.getElementById('desktop-sender-email') as HTMLInputElement | null)?.value || '';
      const desktopSubject = (document.getElementById('desktop-missive-subject') as HTMLInputElement | null)?.value || '';
      const desktopBody = (document.getElementById('desktop-missive-body') as HTMLTextAreaElement | null)?.value || '';

      saveMissiveDraft({
        name: desktopName,
        email: desktopEmail,
        subject: desktopSubject,
        body: desktopBody,
      });

      const mobileName = document.getElementById('mobile-sender-name') as HTMLInputElement | null;
      const mobileEmail = document.getElementById('mobile-sender-email') as HTMLInputElement | null;
      const mobileSubject = document.getElementById('mobile-missive-subject') as HTMLInputElement | null;
      const mobileBody = document.getElementById('mobile-missive-body') as HTMLTextAreaElement | null;
      if (mobileName) mobileName.value = desktopName;
      if (mobileEmail) mobileEmail.value = desktopEmail;
      if (mobileSubject) mobileSubject.value = desktopSubject;
      if (mobileBody) mobileBody.value = desktopBody;
    }

    function snapshotFromMobile() {
      const mobileName = (document.getElementById('mobile-sender-name') as HTMLInputElement | null)?.value || '';
      const mobileEmail = (document.getElementById('mobile-sender-email') as HTMLInputElement | null)?.value || '';
      const mobileSubject = (document.getElementById('mobile-missive-subject') as HTMLInputElement | null)?.value || '';
      const mobileBody = (document.getElementById('mobile-missive-body') as HTMLTextAreaElement | null)?.value || '';

      saveMissiveDraft({
        name: mobileName,
        email: mobileEmail,
        subject: mobileSubject,
        body: mobileBody,
      });

      const desktopName = document.getElementById('desktop-sender-name') as HTMLInputElement | null;
      const desktopEmail = document.getElementById('desktop-sender-email') as HTMLInputElement | null;
      const desktopSubject = document.getElementById('desktop-missive-subject') as HTMLInputElement | null;
      const desktopBody = document.getElementById('desktop-missive-body') as HTMLTextAreaElement | null;
      if (desktopName) desktopName.value = mobileName;
      if (desktopEmail) desktopEmail.value = mobileEmail;
      if (desktopSubject) desktopSubject.value = mobileSubject;
      if (desktopBody) desktopBody.value = mobileBody;
    }

    function snapshotCurrentDraft() {
      if (activeDialog?.id === 'dialog-raven') {
        snapshotFromDesktop();
        return;
      }
      const isMobileView = window.innerWidth <= 600 && window.matchMedia('(orientation: portrait)').matches;
      if (isMobileView) {
        snapshotFromMobile();
      } else {
        snapshotFromDesktop();
      }
    }

    currentSnapshotDraftFn = snapshotCurrentDraft;

    function openDialog(dialog: HTMLElement, trigger: HTMLElement | null) {
      if (activeDialog) closeDialog(true);

      soundEngine.playParchmentRustle();
      activeDialog = dialog;
      activeTrigger = trigger;
      dialog.removeAttribute('hidden');
      dialog.setAttribute('aria-hidden', 'false');
      if (trigger) {
        trigger.setAttribute('aria-expanded', 'true');
      }

      sceneObjects.forEach((el) => {
        el.classList.add('disabled-by-dialog');
        el.setAttribute('tabindex', '-1');
      });

      if (backdrop) {
        backdrop.hidden = false;
        backdrop.setAttribute('aria-hidden', 'false');
      }

      dialog.hidden = false;
      dialog.scrollTop = 0;
      setBackgroundInert(dialog, true);

      // Focus meaningful composer heading or first interactive element
      const heading = dialog.querySelector<HTMLElement>('h2[id], h3[id]');
      if (heading) {
        heading.focus({ preventScroll: true });
      } else {
        const focusables = getFocusableElements(dialog);
        if (focusables.length > 0) {
          focusables[0].focus({ preventScroll: true });
        }
      }

      if (dialog.id === 'dialog-raven') {
        const mobileName = (document.getElementById('mobile-sender-name') as HTMLInputElement | null)?.value;
        const mobileBody = (document.getElementById('mobile-missive-body') as HTMLTextAreaElement | null)?.value;
        if (mobileName || mobileBody) {
          snapshotCurrentDraft();
        }
        const savedDraft = getMissiveDraft();
        const desktopName = document.getElementById('desktop-sender-name') as HTMLInputElement | null;
        const desktopEmail = document.getElementById('desktop-sender-email') as HTMLInputElement | null;
        const desktopSubject = document.getElementById('desktop-missive-subject') as HTMLInputElement | null;
        const desktopBody = document.getElementById('desktop-missive-body') as HTMLTextAreaElement | null;
        if (desktopName) desktopName.value = savedDraft?.name || '';
        if (desktopEmail) desktopEmail.value = savedDraft?.email || '';
        if (desktopSubject) desktopSubject.value = savedDraft?.subject || '';
        if (desktopBody) desktopBody.value = savedDraft?.body || '';
        renderTurnstile();
      }

      document.addEventListener('keydown', handleKeydown, { signal });
    }

    function closeDialog(fromRavenRouteExit = false) {
      if (!activeDialog) return;

      if (document.fullscreenElement) {
        document.exitFullscreen().catch(() => {});
      }

      if (activeDialog.id === 'dialog-machine' && unloadTransceiverFn) {
        unloadTransceiverFn();
      }

      if (activeDialog.id === 'dialog-raven') {
        snapshotCurrentDraft();
      }

      soundEngine.playWoodClink();
      setBackgroundInert(activeDialog, false);

      sceneObjects.forEach((el) => {
        el.classList.remove('disabled-by-dialog');
        el.removeAttribute('tabindex');
      });

      if (backdrop) {
        backdrop.hidden = true;
        backdrop.setAttribute('aria-hidden', 'true');
      }

      activeDialog.hidden = true;
      activeDialog.setAttribute('aria-hidden', 'true');

      const isRavenDialog = activeDialog.id === 'dialog-raven';
      const prevTrigger = activeTrigger;
      activeDialog = null;
      activeTrigger = null;
      document.removeEventListener('keydown', handleKeydown);

      const isRavenRoute = window.location.pathname.replace(/\/$/, '') === '/messenger/raven';
      if (isRavenDialog && isRavenRoute && !fromRavenRouteExit) {
        navigate('/messenger', { history: 'replace' });
        return;
      }

      if (prevTrigger && typeof prevTrigger.focus === 'function') {
        const isVisible = prevTrigger.offsetWidth > 0 || prevTrigger.offsetHeight > 0 || prevTrigger.getClientRects().length > 0;
        if (isVisible) {
          prevTrigger.setAttribute('aria-expanded', 'false');
          prevTrigger.focus({ preventScroll: true });
        } else {
          const fallback = document.getElementById('roost-heading') || document.getElementById('mobile-dispatch-heading');
          fallback?.focus({ preventScroll: true });
        }
      } else {
        const fallback = document.getElementById('roost-heading') || document.getElementById('mobile-dispatch-heading');
        fallback?.focus({ preventScroll: true });
      }
    }

    function handleKeydown(e: KeyboardEvent) {
      if (e.key === 'Escape') {
        closeDialog();
        return;
      }
      if (e.key === 'Tab' && activeDialog) {
        const focusables = getFocusableElements(activeDialog);
        if (focusables.length === 0) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];

        if (e.shiftKey) {
          if (document.activeElement === first || !activeDialog.contains(document.activeElement)) {
            e.preventDefault();
            last.focus();
          }
        } else {
          if (document.activeElement === last || !activeDialog.contains(document.activeElement)) {
            e.preventDefault();
            first.focus();
          }
        }
      }
    }

    // Bind trigger buttons to their respective modals
    triggers.forEach(({ triggerId, dialogId }) => {
      const trigger = document.getElementById(triggerId);
      const dialog = document.getElementById(dialogId);
      if (trigger && dialog) {
        trigger.addEventListener('click', (e) => {
          e.preventDefault();
          openDialog(dialog, trigger);
        }, { signal });
      }
    });

    // Satchel modal shortcut to Raven modal
    const satchelDispatchBtn = document.getElementById('satchel-dispatch-btn');
    const ravenDialog = document.getElementById('dialog-raven');
    const ravenTrigger = document.getElementById('trigger-perch-raven');
    if (satchelDispatchBtn && ravenDialog && ravenTrigger) {
      satchelDispatchBtn.addEventListener('click', () => {
        closeDialog();
        setTimeout(() => {
          openDialog(ravenDialog, ravenTrigger);
        }, 50);
      }, { signal });
    }

    // Bind all close buttons inside panels
    document.querySelectorAll('.close-panel-btn, .close-panel-btn-secondary').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        closeDialog();
      }, { signal });
    });

    // Clicking backdrop closes active dialog
    if (backdrop) {
      backdrop.addEventListener('click', () => {
        closeDialog();
      }, { signal });
    }

    // Accessible Missive Template Radio Group (UX-04)
    setupTemplateRadioGroup('.template-pill', 'desktop-missive-subject', 'desktop-missive-body', signal);
    setupTemplateRadioGroup('.mobile-template-pill', 'mobile-missive-subject', 'mobile-missive-body', signal);

    // Continuous draft coordination across responsive viewports
    const desktopFormEl = document.getElementById('desktop-raven-form');
    const mobileFormEl = document.getElementById('mobile-raven-form');
    desktopFormEl?.addEventListener('input', () => snapshotFromDesktop(), { signal });
    mobileFormEl?.addEventListener('input', () => snapshotFromMobile(), { signal });

    // Scalable Transceiver Project Simulations Registry
    interface TransceiverProject {
      id: string;
      name: string;
      subtitle: string;
