    // Setup Arcane Transceiver Scalable Simulation Browser
    function setupTransceiverSimulation() {
      const launchBtn = document.getElementById('transceiver-launch-btn');
      const unloadBtn = document.getElementById('transceiver-unload-btn');
      const fullscreenBtn = document.getElementById('transceiver-fullscreen-btn');
      const restingView = document.getElementById('transceiver-resting-view');
      const activeControls = document.getElementById('transceiver-active-controls');
      const frameContainer = document.getElementById('transceiver-frame-container');
      const machineDialog = document.getElementById('dialog-machine');

      const prevBtn = document.getElementById('transceiver-prev-btn');
      const nextBtn = document.getElementById('transceiver-next-btn');
      const subtitleEl = document.getElementById('transceiver-subtitle');
      const titleEl = document.getElementById('machine-dialog-title');
      const versionEl = document.getElementById('transceiver-version-text');
      const descEl = document.getElementById('transceiver-description');
      const badgesEl = document.getElementById('transceiver-badges');
      const launchLabelEl = document.getElementById('transceiver-launch-label');
      const standaloneLink = document.getElementById('transceiver-standalone-link') as HTMLAnchorElement | null;
      const standaloneLabel = document.getElementById('transceiver-standalone-label');
      const dossierLink = document.getElementById('transceiver-dossier-link') as HTMLAnchorElement | null;
      const indicatorsContainer = document.getElementById('transceiver-indicators');
      const contentEl = document.getElementById('transceiver-project-content');

      // In-world HUD screen elements
      const hudThumb = document.getElementById('transceiver-screen-thumb') as HTMLImageElement | null;
      const hudStatus = document.getElementById('transceiver-hud-status');
      const hudCommit = document.getElementById('transceiver-hud-commit');

      if (!launchBtn || !restingView || !activeControls || !frameContainer) return;

      const STORAGE_KEY = 'transceiver_last_project';
      let currentProjectIndex = 0;
      let watchdogTimer: ReturnType<typeof setTimeout> | null = null;

      function clearWatchdog() {
        if (watchdogTimer) {
          clearTimeout(watchdogTimer);
          watchdogTimer = null;
        }
      }

      function renderTimeoutDiagnostic(proj: (typeof TRANSCEIVER_PROJECTS)[number]) {
        if (!frameContainer) return;
        frameContainer.innerHTML = '';

        const card = document.createElement('div');
        card.id = 'transceiver-diagnostic-card';
        card.className = 'absolute inset-0 z-20 flex flex-col items-center justify-center p-6 text-center bg-[var(--wood-deep)] text-[var(--parchment)] overflow-y-auto';
        card.innerHTML = `
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded bg-amber-950/80 border border-amber-500/60 text-amber-300 font-mono text-[11px] sm:text-xs font-bold mb-3 shadow-sm">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse" aria-hidden="true"></span>
            <span>SIGNAL INTERFERENCE DETECTED</span>
          </div>
          <h3 class="text-base sm:text-lg font-bold text-[var(--candle)] mb-2 font-serif">Arcane Uplink Timed Out</h3>
          <p class="text-xs sm:text-sm text-[var(--parchment)]/85 max-w-md leading-relaxed mb-6 font-mono">
            The transmission link to <strong class="text-[var(--candle)]">${proj.name}</strong> did not respond within the 12s threshold. The remote chamber may be warming from cold sleep, or third-party authentication/network policies require direct interaction.
          </p>
          <div class="flex flex-wrap items-center justify-center gap-3">
            <button
              type="button"
              id="transceiver-retry-btn"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded bg-[var(--brass)] text-black font-bold text-xs sm:text-sm hover:bg-[var(--candle)] transition-colors cursor-pointer min-h-[44px] shadow"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
              </svg>
              <span>Retry Uplink</span>
            </button>
            <a
              href="${proj.standaloneUrl}"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded border border-[var(--brass)] text-[var(--candle)] font-bold text-xs sm:text-sm hover:bg-black transition-colors min-h-[44px]"
            >
              <span>Launch in Standalone Window</span>
            </a>
            <button
              type="button"
              id="transceiver-diagnostic-disengage-btn"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded bg-red-950/60 border border-red-500/50 text-red-200 text-xs sm:text-sm font-semibold hover:bg-red-900 transition-colors cursor-pointer min-h-[44px]"
            >
              <span>Disengage Chamber</span>
            </button>
          </div>
        `;

        // Reuse the shared themed icon instead of a platform-rendered arrow glyph.
        const standaloneIcon = standaloneLink?.querySelector('svg');
        if (standaloneIcon) {
          card.querySelector('a[target="_blank"]')?.appendChild(standaloneIcon.cloneNode(true));
        }
        frameContainer.appendChild(card);

        const retryBtn = card.querySelector('#transceiver-retry-btn');
        const disengageBtn = card.querySelector('#transceiver-diagnostic-disengage-btn');

        if (retryBtn) {
          retryBtn.addEventListener('click', () => {
            soundEngine.playWoodClink();
            launchArena();
          });
        }
        if (disengageBtn) {
          disengageBtn.addEventListener('click', () => {
            unloadArena();
          });
        }
      }

      // Restore saved project preference
      try {
        const savedId = localStorage.getItem(STORAGE_KEY);
        if (savedId) {
          const idx = TRANSCEIVER_PROJECTS.findIndex(p => p.id === savedId);
          if (idx !== -1) currentProjectIndex = idx;
        }
      } catch {}

      function saveProjectPreference() {
        try {
          const proj = TRANSCEIVER_PROJECTS[currentProjectIndex];
          if (proj) {
            localStorage.setItem(STORAGE_KEY, proj.id);
          }
        } catch {}
      }

      function renderIndicators() {
        if (!indicatorsContainer) return;
        indicatorsContainer.innerHTML = '';
        TRANSCEIVER_PROJECTS.forEach((proj, idx) => {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = `transceiver-indicator-dot ${idx === currentProjectIndex ? 'active' : ''}`;
          dot.setAttribute('aria-label', `Navigate to ${proj.name} simulation`);
          dot.setAttribute('title', proj.name);
          dot.addEventListener('click', () => {
            if (currentProjectIndex !== idx) {
              soundEngine.playWoodClink();
              setProject(idx);
            }
          });
          indicatorsContainer.appendChild(dot);
        });
      }

      function updateIndicators() {
        if (!indicatorsContainer) return;
        const dots = indicatorsContainer.querySelectorAll('.transceiver-indicator-dot');
        dots.forEach((dot, idx) => {
          if (idx === currentProjectIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      function renderProject(animate = true) {
        const proj = TRANSCEIVER_PROJECTS[currentProjectIndex];
        if (!proj) return;

        if (subtitleEl) subtitleEl.textContent = proj.subtitle;
        if (titleEl) titleEl.textContent = proj.modalTitle;
        if (versionEl) versionEl.textContent = proj.version;
        if (descEl) descEl.textContent = proj.description;

        if (badgesEl) {
          badgesEl.innerHTML = proj.badges
            .map(b => `<span class="px-2 py-0.5 rounded bg-black/40 text-[var(--candle)] border border-[var(--brass)]/40 font-mono text-[10px]">${b}</span>`)
            .join('');
        }

        if (launchLabelEl) launchLabelEl.textContent = proj.launchLabel;

        if (standaloneLink) {
          standaloneLink.href = proj.standaloneUrl;
          if (standaloneLabel) standaloneLabel.textContent = proj.standaloneLabel;
        }

        if (dossierLink) {
          dossierLink.href = proj.dossierPath;
        }

        if (hudThumb) {
          hudThumb.src = proj.thumbnail;
        }
        if (hudStatus) hudStatus.textContent = proj.hudStatus;
        if (hudCommit) hudCommit.textContent = proj.hudCommit;

        updateIndicators();
        saveProjectPreference();

        if (animate && contentEl) {
          contentEl.classList.remove('transceiver-content-fade');
          void contentEl.offsetWidth;
          contentEl.classList.add('transceiver-content-fade');
        }
      }

      function setProject(index: number) {
        currentProjectIndex = (index + TRANSCEIVER_PROJECTS.length) % TRANSCEIVER_PROJECTS.length;
        renderProject(true);
      }

      function prevProject() {
        soundEngine.playWoodClink();
        setProject(currentProjectIndex - 1);
      }

      function nextProject() {
        soundEngine.playWoodClink();
        setProject(currentProjectIndex + 1);
      }

      if (prevBtn) prevBtn.addEventListener('click', prevProject, { signal });
      if (nextBtn) nextBtn.addEventListener('click', nextProject, { signal });

      // Keyboard arrow navigation when resting view is active
      window.addEventListener('keydown', (e) => {
        if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
        if (!machineDialog || machineDialog.hidden) return;
        if (restingView.classList.contains('hidden')) return;

        const target = e.target as HTMLElement | null;
        if (target && (['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName) || target.isContentEditable)) {
          return;
        }

        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          prevProject();
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          nextProject();
        }
      }, { signal });

      function fitArena() {
        if (!frameContainer) return;
        const iframe = frameContainer.querySelector('iframe');
        if (!iframe) return;

        const proj = TRANSCEIVER_PROJECTS[currentProjectIndex];
        if (!proj) return;

        if (proj.scalingMode === 'fit-canvas') {
          const cw = frameContainer.clientWidth;
          const ch = frameContainer.clientHeight;
          if (!cw || !ch) return;

          const baseW = proj.baseWidth || 800;
          const baseH = proj.baseHeight || 600;

          const isPortraitMobile = proj.id === 'arcanetyper' && (window.matchMedia('(orientation: portrait)').matches || ch > cw) && cw <= 600;

          if (isPortraitMobile) {
            const scale = Math.min(cw / baseW, (ch * 0.54) / baseH);
            iframe.style.width = `${baseW}px`;
            iframe.style.height = `${baseH}px`;
            iframe.style.position = 'absolute';
            iframe.style.left = '50%';
            iframe.style.top = '0px';
            iframe.style.transform = `translateX(-50%) scale(${scale})`;
            iframe.style.transformOrigin = 'top center';

            let tray = frameContainer.querySelector('#transceiver-portrait-tray') as HTMLElement | null;
            if (!tray) {
              tray = document.createElement('div');
              tray.id = 'transceiver-portrait-tray';
              tray.className = 'absolute inset-x-0 bottom-0 flex flex-col items-center justify-center p-3 text-center pointer-events-none z-10';
              tray.innerHTML = `
                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--wood-deep)]/90 border border-[var(--brass)]/60 text-[var(--candle)] text-[11px] font-mono shadow-md">
                  <span>⌨️</span>
                  <span class="font-bold">Portrait Typing Arena Active</span>
                </div>
                <p class="text-[10px] text-[var(--parchment)]/70 mt-1 max-w-xs font-mono">
                  Tap canvas above to engage native keyboard without blocking words
                </p>
              `;
              frameContainer.appendChild(tray);
            }
            const renderedH = Math.ceil(baseH * scale);
            tray.style.top = `${renderedH}px`;
            tray.style.display = 'flex';
          } else {
            const scale = Math.min(cw / baseW, ch / baseH);
            iframe.style.width = `${baseW}px`;
            iframe.style.height = `${baseH}px`;
            iframe.style.position = 'absolute';
            iframe.style.left = '50%';
            iframe.style.top = '50%';
            iframe.style.transform = `translate(-50%, -50%) scale(${scale})`;
            iframe.style.transformOrigin = 'center center';

            const tray = frameContainer.querySelector('#transceiver-portrait-tray') as HTMLElement | null;
            if (tray) {
              tray.style.display = 'none';
            }
          }
        } else {
          const tray = frameContainer.querySelector('#transceiver-portrait-tray') as HTMLElement | null;
          if (tray) {
            tray.style.display = 'none';
          }
          iframe.style.width = '100%';
          iframe.style.height = '100%';
          iframe.style.minHeight = '100%';
          iframe.style.position = 'relative';
          iframe.style.left = 'auto';
          iframe.style.top = 'auto';
          iframe.style.transform = 'none';
          iframe.style.transformOrigin = 'initial';
          iframe.style.display = 'block';
          frameContainer.style.overflow = 'auto';
        }
      }

      function launchArena() {
        if (!frameContainer || !restingView || !activeControls) return;
        clearWatchdog();
        soundEngine.playWoodClink();
        soundEngine.duckAmbient(true);
        recordMilestone('feat_transceiver');
        const proj = TRANSCEIVER_PROJECTS[currentProjectIndex];
        if (!proj) return;

        const targetUrl = proj.liveUrl;
        frameContainer.innerHTML = '';

        const loader = document.createElement('div');
        loader.id = 'transceiver-loading-screen';
        loader.className = 'absolute inset-0 z-10 flex flex-col items-center justify-center p-6 text-center bg-[var(--wood-deep)] text-[var(--parchment)]';
        loader.innerHTML = `
          <div class="w-8 h-8 rounded-full border-2 border-[var(--brass)]/30 border-t-[var(--candle)] animate-spin mb-3" aria-hidden="true"></div>
          <p class="font-mono text-xs uppercase tracking-widest text-[var(--candle)] font-bold mb-1">Synchronizing Arcane Link...</p>
          <p class="text-xs text-[var(--parchment)]/70 max-w-xs font-mono">Establishing transmission frequency with ${proj.name} chamber</p>
        `;
        frameContainer.appendChild(loader);

        const iframe = document.createElement('iframe');
        iframe.src = targetUrl;
        iframe.title = `Live Simulation of ${proj.name} inside Arcane Transceiver`;
        iframe.className = 'border-0 w-full h-full opacity-0 transition-opacity duration-300';
        if (proj.scalingMode === 'fit-canvas') {
          iframe.setAttribute('scrolling', proj.id === 'arcanetyper' ? 'no' : 'auto');
        } else {
          iframe.setAttribute('scrolling', 'auto');
          iframe.style.overflow = 'auto';
        }
        iframe.setAttribute('allow', 'autoplay; fullscreen');
        iframe.setAttribute('sandbox', 'allow-scripts allow-same-origin allow-popups allow-forms');
        iframe.loading = 'eager';

        let isLoaded = false;

        iframe.onload = () => {
          isLoaded = true;
          clearWatchdog();
          if (loader && loader.parentElement) {
            loader.remove();
          }
          iframe.classList.remove('opacity-0');
          fitArena();
          requestAnimationFrame(fitArena);
        };

        iframe.onerror = () => {
          if (!isLoaded) {
            clearWatchdog();
            renderTimeoutDiagnostic(proj);
          }
        };

        frameContainer.appendChild(iframe);

        restingView.classList.add('hidden');
        activeControls.classList.remove('hidden');
        activeControls.classList.add('flex');
        frameContainer.classList.remove('hidden');
        document.body.dataset.demoActive = 'true';

        watchdogTimer = setTimeout(() => {
          if (!isLoaded) {
            renderTimeoutDiagnostic(proj);
          }
        }, 12000);

        fitArena();
        requestAnimationFrame(fitArena);
        setTimeout(fitArena, 150);
      }

      function unloadArena() {
        clearWatchdog();
        if (document.fullscreenElement) {
          document.exitFullscreen().catch(() => {});
        }
        if (!frameContainer || !restingView || !activeControls) return;
        soundEngine.playWoodClink();
        soundEngine.duckAmbient(false);
        frameContainer.innerHTML = '';
        frameContainer.classList.add('hidden');
        activeControls.classList.add('hidden');
        activeControls.classList.remove('flex');
        restingView.classList.remove('hidden');
        delete document.body.dataset.demoActive;
      }

      function toggleFullscreen() {
        soundEngine.playWoodClink();
        const target = machineDialog || frameContainer;
        if (!document.fullscreenElement) {
          if (target && target.requestFullscreen) {
            target.requestFullscreen().catch(() => {});
          }
        } else {
          if (document.exitFullscreen) {
            document.exitFullscreen().catch(() => {});
          }
        }
      }

      function updateTransceiverFullscreenState() {
        const isFs = Boolean(
          document.fullscreenElement &&
          (document.fullscreenElement === machineDialog || machineDialog?.contains(document.fullscreenElement))
        );
        const icon = document.getElementById('transceiver-fs-icon');
        const text = document.getElementById('transceiver-fs-text');
        if (fullscreenBtn) {
          if (isFs) {
            fullscreenBtn.title = 'Exit Fullscreen Mode (Esc)';
            if (icon) icon.textContent = '⤓';
            if (text) text.textContent = 'Exit Fullscreen';
          } else {
            fullscreenBtn.title = 'Toggle Fullscreen Mode';
            if (icon) icon.textContent = '⛶';
            if (text) text.textContent = 'Fullscreen';
          }
        }
        fitArena();
      }

      const transceiverEmergencyExitBtn = document.getElementById('transceiver-fullscreen-exit-pill');
      if (transceiverEmergencyExitBtn) {
        transceiverEmergencyExitBtn.addEventListener('click', () => {
          if (document.fullscreenElement) {
            document.exitFullscreen().catch(() => {});
          }
        }, { signal });
      }

      document.addEventListener('fullscreenchange', updateTransceiverFullscreenState, { signal });
      document.addEventListener('webkitfullscreenchange', updateTransceiverFullscreenState, { signal });

      const resizeObserver = new ResizeObserver(() => {
        if (!frameContainer.classList.contains('hidden')) {
          fitArena();
        }
      });
      resizeObserver.observe(frameContainer);
      window.addEventListener('resize', fitArena, { signal });
      window.addEventListener('orientationchange', () => {
        setTimeout(fitArena, 100);
        setTimeout(fitArena, 300);
      }, { signal });
      if (window.visualViewport) {
        window.visualViewport.addEventListener('resize', fitArena, { signal });
      }

      signal.addEventListener('abort', () => {
        clearWatchdog();
        resizeObserver.disconnect();
        delete document.body.dataset.demoActive;
      }, { once: true });

      // Bind direct mobile dispatch stack triggers
      const mobileTriggers = document.querySelectorAll<HTMLElement>('.mobile-transceiver-trigger');
      mobileTriggers.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const pIdx = parseInt(btn.dataset.projectIndex || '0', 10);
          if (machineDialog) {
            openDialog(machineDialog, btn);
            setProject(pIdx);
            launchArena();
          }
        }, { signal });
      });

      launchBtn.addEventListener('click', () => launchArena(), { signal });
      if (unloadBtn) unloadBtn.addEventListener('click', unloadArena, { signal });
      if (fullscreenBtn) fullscreenBtn.addEventListener('click', toggleFullscreen, { signal });

      unloadTransceiverFn = unloadArena;

      renderIndicators();
      renderProject(false);
    }

    setupTransceiverSimulation();

    // Cloudflare Turnstile Management (SEC-04)
    const resolvedTurnstileSiteKey = pageWrapper.dataset.turnstileSitekey || '';
    let desktopTurnstileId: string | null = null;
    let mobileTurnstileId: string | null = null;

    function renderTurnstileUnavailableNotice(slot: HTMLElement | null) {
      if (!slot || slot.hasChildNodes()) return;
      const notice = document.createElement('p');
      notice.className = 'text-xs font-mono text-[var(--parchment)]/80 bg-black/30 border border-[var(--brass)]/30 rounded px-3 py-2 text-center';
      notice.textContent = 'Anti-bot verification is not configured for this environment. Direct email links remain available.';
      slot.appendChild(notice);
    }

    function renderTurnstile() {
      const desktopSlot = document.getElementById('desktop-turnstile-slot');
      const mobileSlot = document.getElementById('mobile-turnstile-slot');

      if (!resolvedTurnstileSiteKey) {
        renderTurnstileUnavailableNotice(desktopSlot);
        renderTurnstileUnavailableNotice(mobileSlot);
        return;
      }

      if (typeof window === 'undefined' || !(window as any).turnstile) return;
      const turnstile = (window as any).turnstile;

      if (desktopSlot && desktopTurnstileId === null && !desktopSlot.hasChildNodes()) {
        try {
          desktopTurnstileId = turnstile.render('#desktop-turnstile-slot', {
            sitekey: resolvedTurnstileSiteKey,
            theme: 'dark',
            size: 'normal',
            action: 'contact-missive',
          });
        } catch (e) {
          console.warn('Desktop Turnstile render error:', e);
        }
      }

      if (mobileSlot && mobileTurnstileId === null && !mobileSlot.hasChildNodes()) {
        try {
          mobileTurnstileId = turnstile.render('#mobile-turnstile-slot', {
            sitekey: resolvedTurnstileSiteKey,
            theme: 'dark',
            size: 'normal',
            action: 'contact-missive',
          });
        } catch (e) {
          console.warn('Mobile Turnstile render error:', e);
        }
      }
    }

    if (typeof window !== 'undefined') {
      if (!resolvedTurnstileSiteKey || (window as any).turnstile) {
        renderTurnstile();
      } else {
        const turnstilePoller = setInterval(() => {
          if ((window as any).turnstile) {
            clearInterval(turnstilePoller);
            renderTurnstile();
          }
        }, 200);
        const pollerTimeout = setTimeout(() => clearInterval(turnstilePoller), 8000);
        signal.addEventListener('abort', () => {
          clearInterval(turnstilePoller);
          clearTimeout(pollerTimeout);
        }, { once: true });
      }
    }

    // Form Handling and Missive Dispatching (UX-02, UX-03)
    const recipientEmail = 'cabahugnhovem@gmail.com';

    function handleMissiveSubmission(
      formId: string,
      nameId: string,
      emailId: string,
      subjectId: string,
      bodyId: string,
      isDesktop: boolean
    ) {
      const form = document.getElementById(formId) as HTMLFormElement | null;
      if (!form) return;

      const nameInput = document.getElementById(nameId) as HTMLInputElement | null;
      const emailInput = document.getElementById(emailId) as HTMLInputElement | null;
      const subjectInput = document.getElementById(subjectId) as HTMLInputElement | null;
      const bodyInput = document.getElementById(bodyId) as HTMLTextAreaElement | null;

      const nameErrorId = `${nameId}-error`;
      const emailErrorId = `${emailId}-error`;
      const subjectErrorId = `${subjectId}-error`;
      const bodyErrorId = `${bodyId}-error`;

      const errorContainerId = isDesktop ? 'desktop-raven-error' : 'mobile-raven-error';
      const statusContainerId = isDesktop ? 'desktop-raven-status' : 'mobile-raven-status';

      let isSubmitting = false;

      function syncDirtyState() {
        if (!form) return;
        const hasContent = Boolean(
          nameInput?.value.trim() ||
          emailInput?.value.trim() ||
          bodyInput?.value.trim()
        );
        if (hasContent) {
          form.dataset.dirty = 'true';
        } else {
          delete form.dataset.dirty;
        }
      }

      [
        { input: nameInput, id: nameId, errId: nameErrorId },
        { input: emailInput, id: emailId, errId: emailErrorId },
        { input: subjectInput, id: subjectId, errId: subjectErrorId },
        { input: bodyInput, id: bodyId, errId: bodyErrorId },
      ].forEach(({ input, id, errId }) => {
        if (!input) return;
        input.addEventListener('input', () => {
          clearFieldError(id, errId);
          clearFormError(errorContainerId);
          syncDirtyState();
        }, { signal });
      });

      if (emailInput) {
        emailInput.addEventListener('blur', async () => {
          const val = emailInput.value.trim();
          if (val) {
            const check = await validateEmail(val);
            if (!check.valid) {
              setFieldError(emailId, emailErrorId, check.reason || 'Please provide a valid email address.');
            } else {
              clearFieldError(emailId, emailErrorId);
            }
          }
        }, { signal });
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (isSubmitting) return;

        clearFormError(errorContainerId);
        clearFieldError(nameId, nameErrorId);
        clearFieldError(emailId, emailErrorId);
        clearFieldError(subjectId, subjectErrorId);
        clearFieldError(bodyId, bodyErrorId);

        const rawName = nameInput?.value.trim() || '';
        const email = emailInput?.value.trim() || '';
        const rawSubject = subjectInput?.value.trim() || '';
        const body = bodyInput?.value.trim() || '';

        if (rawName.length > 120) {
          setFieldError(nameId, nameErrorId, 'Name must be 120 characters or fewer.');
          nameInput?.focus();
          return;
        }
        if (!email) {
          setFieldError(emailId, emailErrorId, 'Please enter your return email address.');
          emailInput?.focus();
          return;
        }
        if (rawSubject.length > 200) {
          setFieldError(subjectId, subjectErrorId, 'Subject must be 200 characters or fewer.');
          subjectInput?.focus();
          return;
        }
        if (!body) {
          setFieldError(bodyId, bodyErrorId, 'Please enter a message before sending.');
          bodyInput?.focus();
          return;
        }
        if (body.length > 5000) {
          setFieldError(bodyId, bodyErrorId, 'Message must be 5,000 characters or fewer.');
          bodyInput?.focus();
          return;
        }

        // Anti-abuse: client rate limiting
        const rateCheck = checkRateLimit();
        if (!rateCheck.allowed) {
          showFormError(errorContainerId, rateCheck.reason || 'Rate limit exceeded.');
          return;
        }

        // Synchronous submission lock before first await (UX-02)
        isSubmitting = true;
        const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
        const originalBtnText = submitBtn ? submitBtn.textContent : 'Send Message';
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.setAttribute('aria-busy', 'true');
          submitBtn.textContent = 'Checking your message…';
        }
        setFormStatus(statusContainerId, 'Checking email and anti-bot verification…');

        try {
          // Pre-flight email authenticity validation (syntax, disposable domains, DNS MX)
          const emailValidation = await validateEmail(email);
          if (!emailValidation.valid) {
            const msg = emailValidation.reason || 'Please provide a valid email address.';
            setFieldError(emailId, emailErrorId, msg);
            showFormError(errorContainerId, msg);
            setFormStatus(statusContainerId, '');
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = originalBtnText;
            }
            emailInput?.focus();
            return;
          }

          // Anti-abuse: honeypot check
          const honeypotId = isDesktop ? 'desktop-botcheck' : 'mobile-botcheck';
          const honeypot = document.getElementById(honeypotId) as HTMLInputElement | null;
          const botcheckValue = honeypot?.checked ? 'filled' : '';

          // Anti-abuse: Cloudflare Turnstile token
          let turnstileToken = '';
          if (typeof window !== 'undefined' && (window as any).turnstile) {
            const widgetId = isDesktop ? desktopTurnstileId : mobileTurnstileId;
            if (widgetId !== null) {
              turnstileToken = (window as any).turnstile.getResponse(widgetId) || '';
            }
          }
          if (!turnstileToken) {
            const tokenInput = form.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement | null;
            if (tokenInput) turnstileToken = tokenInput.value;
          }

          if (!turnstileToken && resolvedTurnstileSiteKey && typeof window !== 'undefined' && (window as any).turnstile) {
            const widgetId = isDesktop ? desktopTurnstileId : mobileTurnstileId;
            if (widgetId !== null) {
              showFormError(errorContainerId, 'Security challenge is still verifying. Please complete the anti-bot check and try again.');
              setFormStatus(statusContainerId, '');
              if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.textContent = originalBtnText;
              }
              return;
            }
          }

          const name = rawName || 'Traveler';
          const subject = rawSubject || 'Tavern Dispatch';
          const fullFormattedBody = `Sender: ${name}\nReturn Address: ${email}\n\n--------------------------------------------------\n${body}\n--------------------------------------------------\n(Dispatched via Ibem's Tavern Messenger Roost)`;

          if (submitBtn) {
            submitBtn.textContent = 'Sending Message…';
          }
          setFormStatus(statusContainerId, 'Sending your message…');

          const result = await sendMissive({
            name,
            email,
            subject,
            message: body,
            botcheck: botcheckValue,
            turnstileToken,
          });

          // Reset Turnstile challenge token after submission attempt
          if (typeof window !== 'undefined' && (window as any).turnstile) {
            const widgetId = isDesktop ? desktopTurnstileId : mobileTurnstileId;
            if (widgetId !== null) {
              try {
                (window as any).turnstile.reset(widgetId);
              } catch {}
            }
          }

          // If backend validation failed, restore submit button and show persistent error
          if (result.isValidationError) {
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = originalBtnText;
            }
            setFormStatus(statusContainerId, '');
            const errMsg = result.message || 'Please check your form entries and try again.';
            showFormError(errorContainerId, errMsg);
            if (/email/i.test(errMsg)) {
              setFieldError(emailId, emailErrorId, errMsg);
              emailInput?.focus();
            } else if (/message/i.test(errMsg)) {
              setFieldError(bodyId, bodyErrorId, errMsg);
              bodyInput?.focus();
            }
            return;
          }

          if (result.success) {
            delete form.dataset.dirty;
            recordSendSuccess();
            clearMissiveDraft();
            // Clear both synchronized composers so closing the receipt cannot
            // snapshot the delivered message back into draft memory.
            for (const formId of ['desktop-raven-form', 'mobile-raven-form']) {
              const composer = document.getElementById(formId) as HTMLFormElement | null;
              composer?.reset();
              if (composer) delete composer.dataset.dirty;
            }
            setFormStatus(statusContainerId, 'Message delivered.');
          } else {
            setFormStatus(statusContainerId, '');
          }

          if (isDesktop) {
            const composerView = document.getElementById('raven-composer-view');
            const receiptView = document.getElementById('raven-receipt-view');
            const receiptHeading = document.getElementById('receipt-heading');
            const receiptDesc = document.getElementById('receipt-desc');
            const receiptSubject = document.getElementById('receipt-subject');
            const receiptFrom = document.getElementById('receipt-from');
            const receiptBody = document.getElementById('receipt-body');
            const receiptGmailLink = document.getElementById('receipt-gmail-link') as HTMLAnchorElement | null;

            if (composerView && receiptView) {
              recordMilestone('feat_raven_missive');
              composerView.classList.add('hidden');
              receiptView.classList.remove('hidden');

              const receiptMailtoLink = document.getElementById('receipt-mailto-link') as HTMLAnchorElement | null;
              if (receiptMailtoLink && result.fallbackMailto) {
                receiptMailtoLink.href = result.fallbackMailto;
              }

              if (result.success) {
                if (receiptHeading) receiptHeading.textContent = 'Missive Delivered to Nhovem!';
                if (receiptDesc) {
                  receiptDesc.textContent = 'The raven has delivered your message to Nhovem at cabahugnhovem@gmail.com. A copy of your message is shown below for your records:';
                }
                if (receiptGmailLink) receiptGmailLink.classList.add('hidden');
                if (receiptMailtoLink) receiptMailtoLink.classList.add('hidden');
              } else {
                if (receiptHeading) receiptHeading.textContent = 'Direct Email Fallback Ready';
                if (receiptDesc) {
                  receiptDesc.textContent = result.message || 'We could not dispatch automatically. You may copy your message below or open your email client:';
                }
                if (receiptGmailLink) receiptGmailLink.classList.remove('hidden');
                if (receiptMailtoLink) receiptMailtoLink.classList.remove('hidden');
              }

              if (receiptSubject) receiptSubject.textContent = subject;
              if (receiptFrom) receiptFrom.textContent = `${name} <${email}>`;
              if (receiptBody) receiptBody.textContent = body;

              if (receiptGmailLink && result.fallbackGmailUrl) {
                receiptGmailLink.href = result.fallbackGmailUrl;
              }

              const receiptCopyBtn = document.getElementById('receipt-copy-btn');
              if (receiptCopyBtn) {
                receiptCopyBtn.onclick = async () => {
                  try {
                    await navigator.clipboard.writeText(fullFormattedBody);
                  } catch {
                    const textarea = document.createElement('textarea');
                    textarea.value = fullFormattedBody;
                    document.body.appendChild(textarea);
                    textarea.select();
                    document.execCommand('copy');
                    document.body.removeChild(textarea);
                  }
                  const oldText = receiptCopyBtn.textContent;
                  receiptCopyBtn.textContent = 'Copied to Clipboard!';
                  setTimeout(() => {
                    receiptCopyBtn.textContent = oldText;
                  }, 2500);
                };
              }

              const resetBtn = document.getElementById('receipt-reset-btn');
              if (resetBtn) {
                resetBtn.onclick = () => {
                  clearMissiveDraft();
                  receiptView.classList.add('hidden');
                  composerView.classList.remove('hidden');
                  form.reset();
                  (document.getElementById('mobile-raven-form') as HTMLFormElement | null)?.reset();
                  delete form.dataset.dirty;
                  setFormStatus(statusContainerId, '');
                  if (typeof window !== 'undefined' && (window as any).turnstile && desktopTurnstileId !== null) {
                    try {
                      (window as any).turnstile.reset(desktopTurnstileId);
                    } catch {}
                  }
                  if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.textContent = originalBtnText;
                  }
                };
              }
            }
          } else {
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = result.success ? '✓ Message Sent!' : originalBtnText;
              if (!result.success) {
                showFormError(errorContainerId, result.message || 'Automatic delivery was unavailable. You can copy your message or use the direct email buttons above.');
              }
            }
          }
        } finally {
          isSubmitting = false;
          submitBtn?.removeAttribute('aria-busy');
        }
      }, { signal });
    }

    handleMissiveSubmission(
      'desktop-raven-form',
      'desktop-sender-name',
      'desktop-sender-email',
      'desktop-missive-subject',
      'desktop-missive-body',
      true
    );

    handleMissiveSubmission(
      'mobile-raven-form',
      'mobile-sender-name',
      'mobile-sender-email',
      'mobile-missive-subject',
      'mobile-missive-body',
      false
    );

    // Mobile address copy button
    const mobileCopyBtn = document.getElementById('mobile-copy-email-btn');
    const mobileEmail = document.getElementById('mobile-email-address');
    const mobileStatus = document.getElementById('mobile-copy-status');

    if (mobileCopyBtn && mobileEmail && mobileStatus) {
      mobileCopyBtn.addEventListener('click', async () => {
        const email = mobileEmail.textContent?.trim() || recipientEmail;
        try {
          await navigator.clipboard.writeText(email);
        } catch {
          const textarea = document.createElement('textarea');
          textarea.value = email;
          document.body.appendChild(textarea);
          textarea.select();
          document.execCommand('copy');
          document.body.removeChild(textarea);
        }
        mobileStatus.classList.remove('hidden');
        mobileCopyBtn.textContent = 'Copied!';
        setTimeout(() => {
          mobileStatus.classList.add('hidden');
          mobileCopyBtn.textContent = 'Copy Address';
        }, 2500);
      }, { signal });
    }

    // Restore preserved draft if available
    const savedDraft = getMissiveDraft();
    if (savedDraft) {
      const desktopName = document.getElementById('desktop-sender-name') as HTMLInputElement | null;
      const desktopEmail = document.getElementById('desktop-sender-email') as HTMLInputElement | null;
      const desktopSubject = document.getElementById('desktop-missive-subject') as HTMLInputElement | null;
      const desktopBody = document.getElementById('desktop-missive-body') as HTMLTextAreaElement | null;
      if (desktopName && savedDraft.name) desktopName.value = savedDraft.name;
      if (desktopEmail && savedDraft.email) desktopEmail.value = savedDraft.email;
      if (desktopSubject && savedDraft.subject) desktopSubject.value = savedDraft.subject;
      if (desktopBody && savedDraft.body) desktopBody.value = savedDraft.body;

      const mobileName = document.getElementById('mobile-sender-name') as HTMLInputElement | null;
      const mobileEmail = document.getElementById('mobile-sender-email') as HTMLInputElement | null;
      const mobileSubject = document.getElementById('mobile-missive-subject') as HTMLInputElement | null;
      const mobileBody = document.getElementById('mobile-missive-body') as HTMLTextAreaElement | null;
      if (mobileName && savedDraft.name) mobileName.value = savedDraft.name;
      if (mobileEmail && savedDraft.email) mobileEmail.value = savedDraft.email;
      if (mobileSubject && savedDraft.subject) mobileSubject.value = savedDraft.subject;
      if (mobileBody && savedDraft.body) mobileBody.value = savedDraft.body;
    }

    // Auto-open compose modal if arriving via initialComposerOpen prop, /messenger/raven route, or ?compose=true / #compose
    const urlParams = new URLSearchParams(window.location.search);
    const initialComposerOpen = pageWrapper.dataset.initialComposerOpen === 'true';
    const isRavenRoute = window.location.pathname.replace(/\/$/, '') === '/messenger/raven';
    const hasComposeParam = urlParams.get('compose') === 'true' || window.location.hash === '#compose';

    if ((initialComposerOpen || isRavenRoute || hasComposeParam) && ravenDialog) {
      openDialog(ravenDialog, ravenTrigger);
    }
  }

  document.addEventListener('astro:page-load', initMessengerPage);
  document.addEventListener('astro:before-swap', () => {
    try {
      currentSnapshotDraftFn?.();
    } catch {}
    messengerAbort?.abort();
    messengerAbort = null;
    currentSnapshotDraftFn = null;
  });
</script>
