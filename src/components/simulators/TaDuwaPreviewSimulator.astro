<script>
  let taduwaPreviewAbort: AbortController | null = null;
  const activeTimers = new Set<number>();

  function clearTaduwaTimers() {
    activeTimers.forEach((id) => window.clearInterval(id));
    activeTimers.clear();
  }

  function formatDuration(totalSec: number): string {
    const mins = Math.floor(totalSec / 60);
    const secs = totalSec % 60;
    return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
  }

  function initTaDuwaPreview() {
    taduwaPreviewAbort?.abort();
    clearTaduwaTimers();
    taduwaPreviewAbort = new AbortController();
    const { signal } = taduwaPreviewAbort;

    const roots = document.querySelectorAll<HTMLElement>('[data-taduwa-preview]');
    roots.forEach((root) => {
      type ViewName = 'hub' | 'studio' | 'boost';
      type PresetName = 'cool' | 'warm';
      type RecMode = 'smooth30' | 'auto60' | 'lightweight' | 'highfps';

      let view: ViewName = 'hub';
      let preset: PresetName = 'cool';
      let recording: 'idle' | 'active' | 'paused' = 'idle';
      let recSeconds = 0;
      let recTimerId: number | null = null;
      let recMode: RecMode = 'smooth30';
      let orient: 'Landscape' | 'Portrait' = 'Landscape';
      let audio: 'Game Audio' | 'Mic / Speaker' | 'Mute' = 'Game Audio';
      let popEnabled = true;
      let popExpanded = false;
      let tcpRunCount = 0;
      let shizukuGranted = false;
      let boostProfile = 'Off';
      let quietBg = true;
      let netStable = true;
      let dnsChoice = 'System';

      const statusPill = root.querySelector<HTMLElement>('[data-taduwa-status-pill]');
      const popBar = root.querySelector<HTMLElement>('[data-taduwa-pop-bar]');
      const popLabel = root.querySelector<HTMLElement>('[data-taduwa-pop-label]');
      const popExpandBtn = root.querySelector<HTMLButtonElement>('[data-taduwa-pop-expand]');
      const popStopBtn = root.querySelector<HTMLButtonElement>('[data-taduwa-pop-stop]');

      const safetyNote = root.querySelector<HTMLElement>('[data-taduwa-safety-note]');
      const recIdleControls = root.querySelector<HTMLElement>('[data-taduwa-rec-idle-controls]');
      const recActiveControls = root.querySelector<HTMLElement>('[data-taduwa-rec-active-controls]');
      const recStatusEl = root.querySelector<HTMLElement>('[data-taduwa-rec-status]');
      const pauseRecBtn = root.querySelector<HTMLButtonElement>('[data-taduwa-pause-rec]');
      const hubFeedback = root.querySelector<HTMLElement>('[data-taduwa-hub-feedback]');
      const homeBoostLabel = root.querySelector<HTMLElement>('[data-taduwa-home-boost-label]');

      const metricRam = root.querySelector<HTMLElement>('[data-taduwa-metric-ram]');
      const metricRamSub = root.querySelector<HTMLElement>('[data-taduwa-metric-ram-sub]');
      const metricHeat = root.querySelector<HTMLElement>('[data-taduwa-metric-heat]');
      const metricHeatSub = root.querySelector<HTMLElement>('[data-taduwa-metric-heat-sub]');
      const metricDisplay = root.querySelector<HTMLElement>('[data-taduwa-metric-display]');
      const metricPower = root.querySelector<HTMLElement>('[data-taduwa-metric-power]');
      const metricNet = root.querySelector<HTMLElement>('[data-taduwa-metric-net]');
      const tcpOutput = root.querySelector<HTMLElement>('[data-taduwa-tcp-output]');

      const targetReadout = root.querySelector<HTMLElement>('[data-taduwa-target-readout]');
      const modeNoteEl = root.querySelector<HTMLElement>('[data-taduwa-mode-note]');
      const popToggleBtn = root.querySelector<HTMLButtonElement>('[data-taduwa-pop-toggle]');

      const boostPill = root.querySelector<HTMLElement>('[data-taduwa-boost-pill]');
      const shizukuStatusEl = root.querySelector<HTMLElement>('[data-taduwa-shizuku-status]');
      const shizukuConnectBtn = root.querySelector<HTMLButtonElement>('[data-taduwa-shizuku-connect]');
      const boostNoteEl = root.querySelector<HTMLElement>('[data-taduwa-boost-note]');
      const quietToggleBtn = root.querySelector<HTMLButtonElement>('[data-taduwa-toggle-quiet]');
      const netToggleBtn = root.querySelector<HTMLButtonElement>('[data-taduwa-toggle-net]');
      const boostLogEl = root.querySelector<HTMLElement>('[data-taduwa-boost-log]');

      const modeCopy: Record<RecMode, { res: string; fps: string; note: string }> = {
        smooth30: {
          res: '720p',
          fps: '30 FPS',
          note: 'Gameplay-first default: locks recording target to 720p/30 FPS (halving GPU & encoder load vs. 60 FPS) to reduce game frame drops.',
        },
        auto60: {
          res: '720p',
          fps: '60 FPS',
          note: 'Auto (60): prefers 720p/60 FPS on >=6 GiB phones with healthy memory and heat; uses more GPU/encoder headroom than Smooth 30.',
        },
        lightweight: {
          res: '480p',
          fps: '24 FPS',
          note: 'Lightweight: targets 480p/24 FPS (480p/30 fallback) to keep thermal and memory pressure minimal.',
        },
        highfps: {
          res: '720p',
          fps: '120 FPS (Exp)',
          note: 'Experimental opt-in: tries 720p/120 (then 90/60) only with >=120 Hz display, >=8 GiB RAM, healthy heat, and hardware H.264.',
        },
      };

      const profileNotes: Record<string, string> = {
        Off: 'Off: leaves the target game and Android resolution at default system behavior.',
        Performance: 'Performance: switches Android Game Mode to Performance for the target game at full 100% render scale.',
        'Smooth GPU (85%)': 'Smooth GPU (85%): Performance mode + 85% render scale (~28% less GPU work in dummy benchmark model). Restart game after changing.',
        'Cooling GPU (75%)': 'Cooling GPU (75%): Performance mode + 75% render scale (~44% less GPU work) for warm sessions.',
      };

      const setPressedGroup = (selector: string, attr: string, value: string) => {
        root.querySelectorAll<HTMLButtonElement>(selector).forEach((btn) => {
          btn.setAttribute('aria-pressed', btn.getAttribute(attr) === value ? 'true' : 'false');
        });
      };

      const effectiveRecTarget = () => {
        if (preset === 'warm') {
          return { res: '480p', fps: '24 FPS (Safety Cap)' };
        }
        const info = modeCopy[recMode];
        return { res: info.res, fps: info.fps };
      };

      const syncStatusPill = () => {
        if (!statusPill) return;
        statusPill.className = 'taduwa-pill px-2.5 py-1 rounded-full text-[11px] font-mono tracking-wider shrink-0';
        if (recording === 'active') {
          statusPill.classList.add('taduwa-pill-rec');
          statusPill.textContent = 'REC';
        } else if (recording === 'paused') {
          statusPill.classList.add('taduwa-pill-warn');
          statusPill.textContent = 'PAUSED';
        } else if (preset === 'warm') {
          statusPill.classList.add('taduwa-pill-warn');
          statusPill.textContent = 'WARM';
        } else {
          statusPill.classList.add('taduwa-pill-ready');
          statusPill.textContent = 'READY';
        }
      };

      const syncPopBar = () => {
        if (!popBar) return;
        const showPop = recording !== 'idle' && popEnabled;
        popBar.hidden = !showPop;
        if (!showPop) return;

        if (popLabel) {
          popLabel.textContent = popExpanded
            ? `Pop Icon [+] · ${formatDuration(recSeconds)} · ${recording === 'paused' ? 'Paused' : 'Live Dummy Rec'}`
            : 'Pop Icon [+] · Collapsed over game';
        }
        if (popExpandBtn) {
          popExpandBtn.setAttribute('aria-expanded', popExpanded ? 'true' : 'false');
          popExpandBtn.textContent = popExpanded ? 'Collapse' : 'Expand';
        }
        if (popStopBtn) {
          popStopBtn.hidden = !popExpanded;
        }
      };

      const syncRecordingControls = () => {
        const isIdle = recording === 'idle';
        if (recIdleControls) recIdleControls.hidden = !isIdle;
        if (recActiveControls) recActiveControls.hidden = isIdle;
        if (!isIdle && recStatusEl) {
          const target = effectiveRecTarget();
          const stateLabel = recording === 'paused' ? 'Dummy Recording paused' : 'Dummy Recording active';
          recStatusEl.textContent = `${stateLabel} (${target.res} @ ${target.fps}) · ${formatDuration(recSeconds)}`;
        }
        if (pauseRecBtn) {
          pauseRecBtn.textContent = recording === 'paused' ? 'Resume' : 'Pause';
        }
        syncStatusPill();
        syncPopBar();
      };

      const syncPresetMetrics = () => {
        const isWarm = preset === 'warm';
        if (safetyNote) safetyNote.hidden = !isWarm;
        if (metricRam) metricRam.textContent = isWarm ? '1.4 / 6.0 GiB' : '4.8 / 8.0 GiB';
        if (metricRamSub) metricRamSub.textContent = isWarm ? 'Tight memory (dummy)' : 'Healthy headroom';
        if (metricHeat) metricHeat.textContent = isWarm ? 'Warm (MODERATE)' : 'Cool (NONE)';
        if (metricHeatSub) metricHeatSub.textContent = isWarm ? 'Safety cap active' : 'No throttling';
        if (metricDisplay) metricDisplay.textContent = isWarm ? '1080x2400 @ 60Hz' : '1080x2400 @ 120Hz';
        if (metricPower) metricPower.textContent = isWarm ? 'Battery Saver: ON' : 'Battery Saver: OFF';
        if (metricNet) metricNet.textContent = isWarm ? 'Wi-Fi · 2.4 GHz' : 'Wi-Fi · 5 GHz';

        const target = effectiveRecTarget();
        if (targetReadout) {
          targetReadout.textContent = `Target (not measured output): ${target.res} @ ${target.fps} · ${orient} [${audio}]`;
        }
        if (modeNoteEl) {
          modeNoteEl.textContent = modeCopy[recMode].note;
        }
        syncRecordingControls();
      };

      const syncShizukuUI = () => {
        if (boostPill) {
          boostPill.className = 'taduwa-pill px-2 py-0.5 rounded-full text-[10px] font-mono';
          boostPill.classList.add(shizukuGranted ? 'taduwa-pill-ready' : 'taduwa-pill-warn');
          boostPill.textContent = shizukuGranted ? 'READY' : 'SETUP';
        }
        if (shizukuStatusEl) {
          shizukuStatusEl.textContent = shizukuGranted
            ? 'Demo Shizuku connected (UID 2000 Mock). Controls update simulated logs only.'
            : 'Demo bridge is idle. Tap below to simulate granting Shizuku UID 2000 permission.';
        }
        if (shizukuConnectBtn) {
          shizukuConnectBtn.textContent = shizukuGranted
            ? 'Disconnect Demo Bridge'
            : 'Simulate Grant Permission';
        }
        if (homeBoostLabel) {
          homeBoostLabel.textContent = shizukuGranted
            ? `Shizuku Game Boost · READY (${boostProfile} · Dummy)`
            : 'Shizuku Game Boost · Tap to inspect (Dummy)';
        }
      };

      const applyView = (nextView: ViewName) => {
        view = nextView;
        root.dataset.taduwaView = nextView;
        root.querySelectorAll<HTMLElement>('[data-taduwa-panel]').forEach((panel) => {
          panel.hidden = panel.getAttribute('data-taduwa-panel') !== nextView;
        });
        setPressedGroup('[data-taduwa-set-view]', 'data-taduwa-set-view', nextView);
        root.querySelectorAll<HTMLButtonElement>('[data-taduwa-tab]').forEach((tab) => {
          tab.setAttribute('aria-selected', tab.getAttribute('data-taduwa-tab') === nextView ? 'true' : 'false');
        });
      };

      const stopRecordingTimer = () => {
        if (recTimerId !== null) {
          window.clearInterval(recTimerId);
          activeTimers.delete(recTimerId);
          recTimerId = null;
        }
      };

      const startRecordingTimer = () => {
        stopRecordingTimer();
        recTimerId = window.setInterval(() => {
          if (recording === 'active') {
            recSeconds += 1;
            syncRecordingControls();
          }
        }, 1000);
        activeTimers.add(recTimerId);
      };

      const stopDemoRecording = (feedbackText: string) => {
        stopRecordingTimer();
        recording = 'idle';
        popExpanded = false;
        syncRecordingControls();
        if (hubFeedback) {
          hubFeedback.textContent = feedbackText;
          hubFeedback.hidden = false;
        }
      };

      // Outer view controls
      root.querySelectorAll<HTMLButtonElement>('[data-taduwa-set-view]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const val = btn.getAttribute('data-taduwa-set-view');
          const nextView: ViewName = val === 'studio' || val === 'boost' ? val : 'hub';
          applyView(nextView);
        }, { signal });
      });

      // Bottom tabs inside phone
      root.querySelectorAll<HTMLButtonElement>('[data-taduwa-tab]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const val = btn.getAttribute('data-taduwa-tab');
          const nextView: ViewName = val === 'studio' || val === 'boost' ? val : 'hub';
          applyView(nextView);
        }, { signal });
      });

      // Device condition preset
      root.querySelectorAll<HTMLButtonElement>('[data-taduwa-set-preset]').forEach((btn) => {
        btn.addEventListener('click', () => {
          preset = btn.getAttribute('data-taduwa-set-preset') === 'warm' ? 'warm' : 'cool';
          root.dataset.taduwaPreset = preset;
          setPressedGroup('[data-taduwa-set-preset]', 'data-taduwa-set-preset', preset);
          syncPresetMetrics();
        }, { signal });
      });

      // Play Hub actions
      root.querySelector<HTMLButtonElement>('[data-taduwa-start-rec]')?.addEventListener('click', () => {
        recording = 'active';
        recSeconds = 0;
        popExpanded = false;
        startRecordingTimer();
        syncRecordingControls();
        if (hubFeedback) {
          hubFeedback.textContent =
            'Dummy simulation: launched recorder preview (no real screen capture or game intent sent).';
          hubFeedback.hidden = false;
        }
      }, { signal });

      root.querySelector<HTMLButtonElement>('[data-taduwa-play-only]')?.addEventListener('click', () => {
        if (hubFeedback) {
          hubFeedback.textContent =
            'Dummy simulation: Play only launches the target game normally via standard Android intent without recording or modifying binaries.';
          hubFeedback.hidden = false;
        }
      }, { signal });

      root.querySelector<HTMLButtonElement>('[data-taduwa-stop-rec]')?.addEventListener('click', () => {
        stopDemoRecording(
          `Dummy simulation stopped after ${formatDuration(recSeconds)} — real app saves MP4 locally under Movies/TaDuwa.`,
        );
      }, { signal });

      pauseRecBtn?.addEventListener('click', () => {
        recording = recording === 'paused' ? 'active' : 'paused';
        syncRecordingControls();
      }, { signal });

      root.querySelector<HTMLButtonElement>('[data-taduwa-screenshot]')?.addEventListener('click', () => {
        if (hubFeedback) {
          hubFeedback.textContent =
            'Dummy simulation: screenshot captured (real app saves PNG locally under Pictures/TaDuwa).';
          hubFeedback.hidden = false;
        }
      }, { signal });

      // Pop Icon overlay strip controls
      popExpandBtn?.addEventListener('click', () => {
        popExpanded = !popExpanded;
        syncPopBar();
      }, { signal });

      popStopBtn?.addEventListener('click', () => {
        stopDemoRecording(
          `Stopped via Floating Pop Icon preview (${formatDuration(recSeconds)}) — dummy simulation only.`,
        );
      }, { signal });

      root.querySelector<HTMLButtonElement>('[data-taduwa-open-boost]')?.addEventListener('click', () => {
        applyView('boost');
      }, { signal });

      root.querySelector<HTMLButtonElement>('[data-taduwa-boost-back]')?.addEventListener('click', () => {
        applyView('hub');
      }, { signal });

      // Device Check TCP & Refresh
      root.querySelector<HTMLButtonElement>('[data-taduwa-run-tcp]')?.addEventListener('click', () => {
        tcpRunCount += 1;
        if (tcpOutput) {
          tcpOutput.textContent =
            preset === 'warm'
              ? `Dummy Check #${tcpRunCount}: 1.1.1.1:443 avg 38 ms (attempts: 31, 44, 39 ms) · 13 ms spread — NOT in-game ping.`
              : `Dummy Check #${tcpRunCount}: 1.1.1.1:443 avg 18 ms (attempts: 17, 19, 18 ms) · 2 ms spread — NOT in-game ping.`;
        }
      }, { signal });

      root.querySelector<HTMLButtonElement>('[data-taduwa-refresh-check]')?.addEventListener('click', () => {
        syncPresetMetrics();
        if (tcpOutput) {
          tcpOutput.textContent =
            preset === 'warm'
              ? 'Refreshed dummy snapshot: Warm thermal & Battery Saver active.'
              : 'Refreshed dummy snapshot: Cool thermal & 120Hz display ready.';
        }
      }, { signal });

      // Recording Studio controls
      root.querySelectorAll<HTMLButtonElement>('[data-taduwa-rec-mode]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const mode = btn.getAttribute('data-taduwa-rec-mode') as RecMode | null;
          if (!mode || !modeCopy[mode]) return;
          recMode = mode;
          setPressedGroup('[data-taduwa-rec-mode]', 'data-taduwa-rec-mode', mode);
          syncPresetMetrics();
        }, { signal });
      });

      root.querySelectorAll<HTMLButtonElement>('[data-taduwa-orient]').forEach((btn) => {
        btn.addEventListener('click', () => {
          orient = btn.getAttribute('data-taduwa-orient') === 'Portrait' ? 'Portrait' : 'Landscape';
          setPressedGroup('[data-taduwa-orient]', 'data-taduwa-orient', orient);
          syncPresetMetrics();
        }, { signal });
      });

      root.querySelectorAll<HTMLButtonElement>('[data-taduwa-audio]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const val = btn.getAttribute('data-taduwa-audio');
          audio = val === 'Mic / Speaker' || val === 'Mute' ? val : 'Game Audio';
          setPressedGroup('[data-taduwa-audio]', 'data-taduwa-audio', audio);
          syncPresetMetrics();
        }, { signal });
      });

      popToggleBtn?.addEventListener('click', () => {
        popEnabled = !popEnabled;
        popToggleBtn.setAttribute('aria-pressed', popEnabled ? 'true' : 'false');
        popToggleBtn.textContent = popEnabled
          ? 'Floating Pop Icon: ON (Tap to toggle)'
          : 'Floating Pop Icon: OFF (Tap to enable)';
        syncPopBar();
      }, { signal });

      // Shizuku Game Boost controls
      shizukuConnectBtn?.addEventListener('click', () => {
        shizukuGranted = !shizukuGranted;
        syncShizukuUI();
        if (boostLogEl) {
          boostLogEl.textContent = shizukuGranted
            ? '[DUMMY] Shizuku UserService bound (UID 2000 Mock) · Ready for preview commands.'
            : '[DUMMY] Shizuku demo bridge disconnected. All settings remain untouched.';
        }
      }, { signal });

      root.querySelectorAll<HTMLButtonElement>('[data-taduwa-boost-profile]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const profile = btn.getAttribute('data-taduwa-boost-profile') || 'Off';
          boostProfile = profile;
          setPressedGroup('[data-taduwa-boost-profile]', 'data-taduwa-boost-profile', profile);
          if (boostNoteEl && profileNotes[profile]) {
            boostNoteEl.textContent = profileNotes[profile];
          }
          syncShizukuUI();
        }, { signal });
      });

      quietToggleBtn?.addEventListener('click', () => {
        quietBg = !quietBg;
        quietToggleBtn.setAttribute('aria-pressed', quietBg ? 'true' : 'false');
        quietToggleBtn.textContent = `Quiet heavy background apps: ${quietBg ? 'ON' : 'OFF'}`;
      }, { signal });

      netToggleBtn?.addEventListener('click', () => {
        netStable = !netStable;
        netToggleBtn.setAttribute('aria-pressed', netStable ? 'true' : 'false');
        netToggleBtn.textContent = `Network stability (scan lock + bg data): ${netStable ? 'ON' : 'OFF'}`;
      }, { signal });

      root.querySelectorAll<HTMLButtonElement>('[data-taduwa-dns]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const val = btn.getAttribute('data-taduwa-dns') || 'System';
          dnsChoice = val;
          setPressedGroup('[data-taduwa-dns]', 'data-taduwa-dns', val);
        }, { signal });
      });

      root.querySelector<HTMLButtonElement>('[data-taduwa-apply-boost]')?.addEventListener('click', () => {
        if (!shizukuGranted) {
          if (boostLogEl) {
            boostLogEl.textContent =
              '[DUMMY] Permission needed first: tap "Simulate Grant Permission" above to preview Shizuku output.';
          }
          return;
        }
        if (boostLogEl) {
          boostLogEl.textContent = [
            `[DUMMY] Game Mode profile: ${boostProfile}`,
            `[DUMMY] Quiet heavy third-party apps: ${quietBg ? 'applied (whitelisted system/target app)' : 'skipped'}`,
            `[DUMMY] Network stability (scan lock + Data Saver): ${netStable ? 'enabled' : 'off'} · DNS: ${dnsChoice}`,
            '[DUMMY] Note: simulated output only — zero real Android commands executed.',
          ].join('\n');
        }
      }, { signal });

      root.querySelector<HTMLButtonElement>('[data-taduwa-reset-boost]')?.addEventListener('click', () => {
        boostProfile = 'Off';
        quietBg = false;
        netStable = false;
        dnsChoice = 'System';
        setPressedGroup('[data-taduwa-boost-profile]', 'data-taduwa-boost-profile', 'Off');
        setPressedGroup('[data-taduwa-dns]', 'data-taduwa-dns', 'System');
        if (boostNoteEl) boostNoteEl.textContent = profileNotes.Off;
        if (quietToggleBtn) {
          quietToggleBtn.setAttribute('aria-pressed', 'false');
          quietToggleBtn.textContent = 'Quiet heavy background apps: OFF';
        }
        if (netToggleBtn) {
          netToggleBtn.setAttribute('aria-pressed', 'false');
          netToggleBtn.textContent = 'Network stability (scan lock + bg data): OFF';
        }
        syncShizukuUI();
        if (boostLogEl) {
          boostLogEl.textContent =
            '[DUMMY] Reset All Tweaks requested: Game Mode=Off, Downscale=100%, Scans=Restored, Private DNS=System, EXIT=0 (mock).';
        }
      }, { signal });

      root.querySelector<HTMLButtonElement>('[data-taduwa-jitter-demo]')?.addEventListener('click', () => {
        if (boostLogEl) {
          boostLogEl.textContent = [
            '[DUMMY] Wi-Fi Link (mock): RSSI -54 dBm · 433 Mbps (5 GHz)',
            '[DUMMY] 12-Probe TCP Jitter to 1.1.1.1:443 — avg 19 ms, min 15 ms, max 24 ms (NOT in-game server ping).',
          ].join('\n');
        }
      }, { signal });

      // Initial sync
      syncPresetMetrics();
      syncShizukuUI();
    });
  }

  document.addEventListener('astro:page-load', initTaDuwaPreview);
  document.addEventListener('astro:before-swap', () => {
    taduwaPreviewAbort?.abort();
    taduwaPreviewAbort = null;
    clearTaduwaTimers();
  });
</script>
