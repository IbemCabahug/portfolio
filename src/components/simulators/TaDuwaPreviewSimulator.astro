---
---

<style>
  .taduwa-preview-card {
    --fiesta-bg: #FFF2D9;
    --fiesta-panel: #FFF8EA;
    --fiesta-soft: #E8DEFF;
    --fiesta-ink: #211B26;
    --fiesta-muted: #554A59;
    --fiesta-accent: #D7FA62;
    --fiesta-warning: #FFD477;
    --fiesta-record: #FF979A;
    --fiesta-dot: #FF6B70;
  }

  .taduwa-phone-screen {
    background-color: var(--fiesta-bg);
    color: var(--fiesta-ink);
  }

  .taduwa-card {
    background-color: var(--fiesta-panel);
    border: 2px solid var(--fiesta-ink);
    border-radius: 14px;
    padding: 12px;
    box-shadow: 0 3px 0 var(--fiesta-ink);
  }

  .taduwa-tile {
    background-color: var(--fiesta-bg);
    border: 2px solid var(--fiesta-ink);
    border-radius: 10px;
    padding: 8px 10px;
  }

  .taduwa-muted {
    color: var(--fiesta-muted);
  }

  .taduwa-btn {
    border: 2px solid var(--fiesta-ink);
    box-shadow: 0 2px 0 var(--fiesta-ink);
    color: var(--fiesta-ink);
    font-weight: 700;
    transition: transform 0.1s ease, filter 0.12s ease;
  }

  .taduwa-btn:hover {
    filter: brightness(0.97);
  }

  .taduwa-btn:active {
    transform: translateY(1px);
    box-shadow: 0 1px 0 var(--fiesta-ink);
  }

  .taduwa-btn-primary {
    background-color: var(--fiesta-accent);
  }

  .taduwa-btn-secondary {
    background-color: var(--fiesta-soft);
  }

  .taduwa-btn-warning {
    background-color: var(--fiesta-warning);
  }

  .taduwa-btn-stop {
    background-color: var(--fiesta-record);
  }

  .taduwa-mode-btn {
    border: 2px solid var(--fiesta-ink);
    font-weight: 700;
    transition: background-color 0.12s ease, color 0.12s ease;
  }

  .taduwa-mode-btn[aria-pressed="true"] {
    background-color: var(--fiesta-ink);
    color: var(--fiesta-panel);
  }

  .taduwa-mode-btn[aria-pressed="false"] {
    background-color: var(--fiesta-panel);
    color: var(--fiesta-ink);
  }

  .taduwa-mode-btn[aria-pressed="false"]:hover {
    background-color: var(--fiesta-soft);
  }

  .taduwa-pill {
    border: 2px solid var(--fiesta-ink);
    color: var(--fiesta-ink);
    font-weight: 800;
  }

  .taduwa-pill-ready {
    background-color: var(--fiesta-accent);
  }

  .taduwa-pill-warn {
    background-color: var(--fiesta-warning);
  }

  .taduwa-pill-rec {
    background-color: var(--fiesta-record);
  }

  .taduwa-pill-soft {
    background-color: var(--fiesta-soft);
  }

  .taduwa-tab-bar {
    background-color: var(--fiesta-panel);
    border-top: 2px solid var(--fiesta-ink);
  }

  .taduwa-nav-tab {
    border: 2px solid transparent;
    color: var(--fiesta-muted);
    transition: background-color 0.12s ease, color 0.12s ease, border-color 0.12s ease;
  }

  .taduwa-nav-tab[aria-selected="true"] {
    background-color: var(--fiesta-accent);
    border-color: var(--fiesta-ink);
    color: var(--fiesta-ink);
    font-weight: 800;
  }

  .taduwa-nav-tab[aria-selected="false"]:hover {
    background-color: var(--fiesta-soft);
    color: var(--fiesta-ink);
  }

  .taduwa-ctrl-btn[aria-pressed="true"] {
    background-color: #D7FA62;
    border-color: #D7FA62;
    color: #211B26;
    font-weight: 800;
  }

  .taduwa-ctrl-btn[aria-pressed="false"] {
    background-color: #1f1a26;
    border-color: #4a3f57;
    color: #e8e1f0;
  }

  .taduwa-ctrl-btn[aria-pressed="false"]:hover {
    background-color: #2c2536;
    color: #ffffff;
  }
</style>

<section
  class="taduwa-preview-card my-8 p-3 sm:p-7 rounded-2xl border-2 border-lime-400/45 bg-[#15121a] text-stone-100 shadow-2xl"
  data-taduwa-preview
  data-taduwa-view="hub"
  data-taduwa-preset="cool"
  aria-labelledby="taduwa-preview-heading"
>
  {/* Header */}
  <div class="flex flex-wrap items-center justify-between gap-3 pb-4 mb-5 border-b border-lime-400/25">
    <div class="flex items-center gap-3 min-w-0">
      <div class="w-11 h-11 rounded-xl bg-[#211B26] border border-lime-300/60 p-1 flex items-center justify-center shrink-0 shadow-md overflow-hidden">
        <img
          src="/art/projects/taduwa-icon.webp"
          alt=""
          width="44"
          height="44"
          class="w-full h-full object-contain rounded-lg"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-[10px] sm:text-xs uppercase font-extrabold tracking-widest text-lime-300">
            Android App UI Preview
          </span>
          <span class="px-2 py-0.5 rounded-full bg-[#241e2e] border border-lime-300/40 text-[10px] font-mono text-lime-200">
            Java 17 / XML Views
          </span>
        </div>
        <h3 id="taduwa-preview-heading" class="text-lg sm:text-2xl font-bold font-serif text-amber-100 leading-tight">
          TaDuwa Companion — Interactive Preview
        </h3>
      </div>
    </div>

    <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-emerald-950/75 border border-emerald-500/50 text-xs font-mono text-emerald-200">
      <span class="w-2 h-2 rounded-full bg-emerald-400" aria-hidden="true"></span>
      <span>Dummy Data Only · 0 Device Access</span>
    </div>
  </div>

  {/* Static Browser Simulation Clarification Notice */}
  <div
    data-taduwa-simulation-notice
    class="mb-5 p-3.5 sm:p-4 rounded-xl bg-[#1e1926] border border-amber-400/45 text-sm text-stone-200 flex items-start gap-3 shadow-sm"
  >
    <div aria-hidden="true" class="w-7 h-7 rounded-full bg-amber-500/15 text-[var(--candle)] flex items-center justify-center shrink-0 mt-0.5">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" focusable="false">
        <circle cx="12" cy="12" r="9" />
        <path d="M12 11v6" />
        <path d="M12 7h.01" />
      </svg>
    </div>
    <div class="min-w-0 space-y-1">
      <strong class="block text-amber-200 text-sm font-semibold">Browser simulation — dummy data only</strong>
      <p class="leading-relaxed text-xs sm:text-sm text-stone-300">
        All memory readings, thermal states, TCP latency values, recording timers, and Shizuku outputs shown inside this simulator are 100% dummy placeholder data. It runs strictly in your browser with zero Shizuku execution, screen capture, or Android settings access — download the Android APK above to test the real app on a device.
      </p>
    </div>
  </div>

  {/* Outer Interactive Controls Bar */}
  <div class="mb-6 p-3 rounded-xl bg-[#0e0b13] border border-lime-400/25 grid grid-cols-1 md:grid-cols-2 gap-3">
    <div class="flex flex-col gap-1.5">
      <span class="text-[11px] font-mono uppercase tracking-wider text-lime-300 font-bold">Screen View</span>
      <div class="flex flex-wrap gap-2" role="group" aria-label="Preview screen">
        <button
          type="button"
          class="taduwa-ctrl-btn inline-flex items-center gap-1.5 min-h-[44px] px-3 py-2 rounded-lg border text-xs font-mono cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-lime-300 focus-visible:outline-offset-2"
          data-taduwa-set-view="hub"
          aria-pressed="true"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="3" y="3" width="8" height="8" rx="1.5" />
            <rect x="13" y="3" width="8" height="8" rx="1.5" />
            <rect x="3" y="13" width="8" height="8" rx="1.5" />
            <rect x="13" y="13" width="8" height="8" rx="1.5" />
          </svg>
          <span>Play Hub &amp; Check</span>
        </button>
        <button
          type="button"
          class="taduwa-ctrl-btn inline-flex items-center gap-1.5 min-h-[44px] px-3 py-2 rounded-lg border text-xs font-mono cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-lime-300 focus-visible:outline-offset-2"
          data-taduwa-set-view="studio"
          aria-pressed="false"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <rect x="2" y="6" width="14" height="12" rx="2" />
            <path d="m16 10 6-3v10l-6-3Z" />
          </svg>
          <span>Recording Studio</span>
        </button>
        <button
          type="button"
          class="taduwa-ctrl-btn inline-flex items-center gap-1.5 min-h-[44px] px-3 py-2 rounded-lg border text-xs font-mono cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-lime-300 focus-visible:outline-offset-2"
          data-taduwa-set-view="boost"
          aria-pressed="false"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M13 2 4 14h7l-1 8 10-12h-7l0-8Z" />
          </svg>
          <span>Shizuku Boost</span>
        </button>
      </div>
    </div>

    <div class="flex flex-col gap-1.5">
      <span class="text-[11px] font-mono uppercase tracking-wider text-lime-300 font-bold">Device Condition (Dummy)</span>
      <div class="flex flex-wrap gap-2" role="group" aria-label="Dummy device condition">
        <button
          type="button"
          class="taduwa-ctrl-btn inline-flex items-center gap-1.5 min-h-[44px] px-3 py-2 rounded-lg border text-xs font-mono cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-lime-300 focus-visible:outline-offset-2"
          data-taduwa-set-preset="cool"
          aria-pressed="true"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M12 2v20M4.93 7l14.14 10M19.07 7 4.93 17" />
          </svg>
          <span>Cool / Ready</span>
        </button>
        <button
          type="button"
          class="taduwa-ctrl-btn inline-flex items-center gap-1.5 min-h-[44px] px-3 py-2 rounded-lg border text-xs font-mono cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-lime-300 focus-visible:outline-offset-2"
          data-taduwa-set-preset="warm"
          aria-pressed="false"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M14 4v10.54a4 4 0 1 1-4 0V4a2 2 0 1 1 4 0Z" />
          </svg>
          <span>Warm / Battery Saver</span>
        </button>
      </div>
    </div>
  </div>

  {/* Smartphone Chassis */}
  <div class="flex justify-center my-2">
    <div class="taduwa-phone-chassis relative w-full max-w-[390px] rounded-[36px] sm:rounded-[42px] p-2.5 sm:p-3.5 bg-gradient-to-b from-stone-800 via-stone-900 to-black border-4 border-stone-700/80 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.85)]">
      {/* Screen Glass */}
      <div class="taduwa-phone-screen relative rounded-[28px] sm:rounded-[32px] overflow-hidden flex flex-col border-2 border-[#211B26]">
        {/* Mobile Status Bar */}
        <div class="h-7 px-4 sm:px-5 flex items-center justify-between text-[11px] font-mono shrink-0 border-b border-[#211B26]/20 bg-[#FFF8EA]">
          <span class="font-bold">9:41</span>
          <div class="w-12 sm:w-14 h-3.5 rounded-full bg-[#211B26]" aria-hidden="true"></div>
          <div class="flex items-center gap-1.5 text-[10px]">
            <span class="px-1.5 py-0.5 rounded font-extrabold bg-[#D7FA62] text-[#211B26] border border-[#211B26]">Dummy</span>
            <span class="font-semibold">Wi-Fi</span>
          </div>
        </div>

        {/* In-Simulator Dummy Data Banner */}
        <div
          data-taduwa-dummy-banner
          class="px-3 py-1.5 text-[11px] leading-snug flex items-center justify-center gap-1.5 text-center border-b-2 border-[#211B26] bg-[#FFD477] text-[#211B26]"
        >
          <span class="font-extrabold uppercase tracking-wider shrink-0">Dummy Preview</span>
          <span aria-hidden="true">·</span>
          <span class="font-semibold">All metrics, timers, and Shizuku outputs inside this simulator are dummy placeholder data.</span>
        </div>

        {/* App Top Header */}
        <div class="px-3.5 pt-3.5 pb-2.5 flex items-center justify-between gap-2 border-b-2 border-[#211B26]/15 bg-[#FFF2D9]">
          <div class="flex items-center gap-2.5 min-w-0">
            <img
              src="/art/projects/taduwa-icon.webp"
              alt=""
              width="32"
              height="32"
              class="w-8 h-8 rounded-lg border-2 border-[#211B26] object-contain bg-[#FFF8EA] shrink-0"
              loading="lazy"
              decoding="async"
            />
            <div class="min-w-0">
              <p class="text-base font-extrabold tracking-tight leading-none text-[#211B26]">TaDuwa</p>
              <p class="text-[11px] taduwa-muted font-medium truncate mt-0.5">Duwa ta. Play smart.</p>
            </div>
          </div>

          <span
            data-taduwa-status-pill
            class="taduwa-pill taduwa-pill-ready px-2.5 py-1 rounded-full text-[11px] font-mono tracking-wider shrink-0"
          >
            READY
          </span>
        </div>

        {/* Simulated Floating Pop Icon Overlay Strip (Shown when recording + Pop Icon ON) */}
        <div
          data-taduwa-pop-bar
          hidden
          class="px-3.5 py-2 bg-[#211B26] text-[#FFF8EA] flex flex-wrap items-center justify-between gap-2 border-b-2 border-[#211B26]"
        >
          <div class="flex items-center gap-2 min-w-0">
            <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-[#FFF8EA] border border-[#211B26] shrink-0" aria-hidden="true">
              <span class="w-2.5 h-2.5 rounded-full bg-[#FF6B70]"></span>
            </span>
            <span data-taduwa-pop-label class="text-[11px] font-mono font-bold truncate">
              Pop Icon [+] · Collapsed over game
            </span>
          </div>
          <div class="flex items-center gap-1.5 shrink-0">
            <button
              type="button"
              data-taduwa-pop-expand
              aria-expanded="false"
              class="px-2 py-1 rounded bg-[#D7FA62] text-[#211B26] text-[10px] font-extrabold cursor-pointer"
            >
              Expand
            </button>
            <button
              type="button"
              data-taduwa-pop-stop
              hidden
              class="px-2 py-1 rounded bg-[#FF979A] text-[#211B26] text-[10px] font-extrabold cursor-pointer"
            >
              Stop
            </button>
          </div>
        </div>

        {/* Screen Body */}
        <div class="p-3.5 space-y-3.5">
          {/* PANEL 1: PLAY HUB & DEVICE CHECK (Visible by default even without JS) */}
          <div data-taduwa-panel="hub" class="space-y-3.5">
            {/* 01 / LAUNCH DECK */}
            <div class="taduwa-card space-y-2.5">
              <div class="flex items-center justify-between gap-2">
                <span class="text-[10px] font-mono font-extrabold tracking-widest uppercase taduwa-muted">
                  01 / Launch Deck
                </span>
                <span class="taduwa-pill taduwa-pill-soft px-2 py-0.5 rounded-full text-[10px] font-mono">
                  MLBB · All-App Roadmap
                </span>
              </div>

              <div>
                <h4 class="text-base font-extrabold leading-tight">Play Hub</h4>
                <p class="text-[11px] taduwa-muted mt-1 leading-snug">
                  Launches Mobile Legends: Bang Bang normally without modifying the game. Broader all-app game boost support is planned.
                </p>
              </div>

              {/* Warm / Battery Saver Override Banner */}
              <div
                data-taduwa-safety-note
                hidden
                class="p-2 rounded-lg bg-[#FFD477] border-2 border-[#211B26] text-[11px] font-semibold leading-snug text-[#211B26]"
              >
                Warm thermal / Battery Saver detected (dummy): recording target capped at Lightweight (480p / 24 FPS). Play only stays unaffected.
              </div>

              {/* Idle Launch Buttons */}
              <div data-taduwa-rec-idle-controls class="grid grid-cols-2 gap-2 pt-0.5">
                <button
                  type="button"
                  data-taduwa-start-rec
                  class="taduwa-btn taduwa-btn-primary min-h-[44px] px-2.5 py-2 rounded-xl text-xs cursor-pointer flex items-center justify-center gap-1.5"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true" focusable="false">
                    <circle cx="12" cy="12" r="7" />
                  </svg>
                  <span>Record &amp; Play</span>
                </button>
                <button
                  type="button"
                  data-taduwa-play-only
                  class="taduwa-btn taduwa-btn-secondary min-h-[44px] px-2.5 py-2 rounded-xl text-xs cursor-pointer flex items-center justify-center gap-1.5"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true" focusable="false">
                    <path d="m7 4 13 8-13 8V4Z" />
                  </svg>
                  <span>Play only</span>
                </button>
              </div>

              {/* Active Recording Controls */}
              <div data-taduwa-rec-active-controls hidden class="space-y-2 pt-0.5">
                <div
                  data-taduwa-rec-status
                  class="px-2.5 py-1.5 rounded-lg bg-[#FF979A]/35 border-2 border-[#211B26] text-[11px] font-mono font-bold text-[#211B26]"
                >
                  Dummy Recording active (1280x720 @ 30 FPS) · 00:00
                </div>
                <div class="grid grid-cols-3 gap-1.5">
                  <button
                    type="button"
                    data-taduwa-stop-rec
                    class="taduwa-btn taduwa-btn-stop min-h-[42px] px-2 py-1.5 rounded-xl text-[11px] cursor-pointer"
                  >
                    Stop
                  </button>
                  <button
                    type="button"
                    data-taduwa-pause-rec
                    class="taduwa-btn taduwa-btn-warning min-h-[42px] px-2 py-1.5 rounded-xl text-[11px] cursor-pointer"
                  >
                    Pause
                  </button>
                  <button
                    type="button"
                    data-taduwa-screenshot
                    class="taduwa-btn taduwa-btn-secondary min-h-[42px] px-2 py-1.5 rounded-xl text-[11px] cursor-pointer"
                  >
                    Shot
                  </button>
                </div>
              </div>

              {/* Play Hub Feedback Pill */}
              <p
                data-taduwa-hub-feedback
                hidden
                class="p-2 rounded-lg bg-[#E8DEFF] border border-[#211B26] text-[11px] font-semibold leading-snug text-[#211B26]"
              ></p>
            </div>

            {/* Shizuku Quick Entry Card Button */}
            <button
              type="button"
              data-taduwa-open-boost
              class="taduwa-card taduwa-btn taduwa-btn-secondary w-full text-left flex items-center justify-between gap-2 min-h-[46px] px-3 py-2.5 rounded-xl text-xs cursor-pointer"
            >
              <span data-taduwa-home-boost-label class="font-extrabold">
                Shizuku Game Boost · Tap to inspect (Dummy)
              </span>
              <span aria-hidden="true" class="font-mono font-extrabold text-sm">&gt;</span>
            </button>

            {/* 02 / SNAPSHOT — Device Check */}
            <div class="taduwa-card space-y-2.5">
              <div class="flex items-center justify-between gap-2">
                <span class="text-[10px] font-mono font-extrabold tracking-widest uppercase taduwa-muted">
                  02 / Snapshot
                </span>
                <span class="text-[10px] font-mono font-bold taduwa-muted">Dummy Telemetry</span>
              </div>

              <h4 class="text-base font-extrabold leading-tight">Device check</h4>

              <div class="grid grid-cols-2 gap-2 text-[11px]">
                <div class="taduwa-tile">
                  <span class="block text-[9px] font-mono font-extrabold tracking-wider uppercase taduwa-muted">
                    Memory
                  </span>
                  <strong data-taduwa-metric-ram class="block text-xs font-extrabold mt-0.5">
                    4.8 / 8.0 GiB
                  </strong>
                  <span data-taduwa-metric-ram-sub class="block text-[10px] taduwa-muted">
                    Healthy headroom
                  </span>
                </div>
                <div class="taduwa-tile">
                  <span class="block text-[9px] font-mono font-extrabold tracking-wider uppercase taduwa-muted">
                    Thermal
                  </span>
                  <strong data-taduwa-metric-heat class="block text-xs font-extrabold mt-0.5">
                    Cool (NONE)
                  </strong>
                  <span data-taduwa-metric-heat-sub class="block text-[10px] taduwa-muted">
                    No throttling
                  </span>
                </div>
                <div class="taduwa-tile">
                  <span class="block text-[9px] font-mono font-extrabold tracking-wider uppercase taduwa-muted">
                    Display &amp; Power
                  </span>
                  <strong data-taduwa-metric-display class="block text-xs font-extrabold mt-0.5">
                    1080x2400 @ 120Hz
                  </strong>
                  <span data-taduwa-metric-power class="block text-[10px] taduwa-muted">
                    Battery Saver: OFF
                  </span>
                </div>
                <div class="taduwa-tile">
                  <span class="block text-[9px] font-mono font-extrabold tracking-wider uppercase taduwa-muted">
                    Network
                  </span>
                  <strong data-taduwa-metric-net class="block text-xs font-extrabold mt-0.5">
                    Wi-Fi · 5 GHz
                  </strong>
                  <span class="block text-[10px] taduwa-muted">Dummy reading</span>
                </div>
              </div>

              <div class="grid grid-cols-2 gap-2 pt-0.5">
                <button
                  type="button"
                  data-taduwa-run-tcp
