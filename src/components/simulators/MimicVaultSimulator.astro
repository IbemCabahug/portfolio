<script>
  function initMimicCompleteAppDemo() {
    // Top-Level Stepper and Screen Views
    const stepButtons = document.querySelectorAll('.mimic-step-btn');
    const stepLabel = document.getElementById('mimic-active-step-label');
    const screens = {
      setup: document.getElementById('screen-setup'),
      game: document.getElementById('screen-game'),
      pin: document.getElementById('screen-pin'),
      vault: document.getElementById('screen-vault'),
      files: document.getElementById('screen-files'),
      settings: document.getElementById('screen-settings'),
      recovery: document.getElementById('screen-recovery'),
    };
    const statusBar = document.getElementById('mimic-screen-statusbar');
    const clockEl = document.getElementById('mimic-clock');
    const bloodOverlay = document.getElementById('mimic-blood-overlay');

    // Cryptographic Telemetry Elements
    const cryptoStatus = document.getElementById('crypto-live-status');
    const telemetrySalt = document.getElementById('telemetry-salt');
    const telemetryIv = document.getElementById('telemetry-iv');
    const telemetryCipher = document.getElementById('telemetry-cipher');
    const telemetryBytes = document.getElementById('telemetry-bytes');

    // Live RAM Cryptographic buffers
    let activePin = '1337';
    let currentSalt: Uint8Array | null = null;
    let currentIv: Uint8Array | null = null;
    let currentCiphertextBuffer: ArrayBuffer | null = null;
    let isKeyInRam = false;

    // -------------------------------------------------------------
    // Live Clock
    // -------------------------------------------------------------
    function updateClock() {
      if (clockEl) {
        const now = new Date();
        const hrs = String(now.getHours()).padStart(2, '0');
        const mins = String(now.getMinutes()).padStart(2, '0');
        clockEl.textContent = `${hrs}:${mins}`;
      }
    }
    updateClock();

    // -------------------------------------------------------------
    // View Switcher Function
    // -------------------------------------------------------------
    function switchScreen(targetName: string) {
      Object.keys(screens).forEach((name) => {
        const el = screens[name as keyof typeof screens];
        if (el) {
          if (name === targetName) {
            el.classList.remove('hidden');
          } else {
            el.classList.add('hidden');
          }
        }
      });

      // Update Stepper buttons styling
      stepButtons.forEach((btn) => {
        const step = btn.getAttribute('data-step');
        if (step === targetName) {
          btn.className = 'mimic-step-btn px-2.5 py-1 rounded-lg text-[11px] font-mono transition-all cursor-pointer bg-purple-700 text-white font-bold shadow';
        } else {
          btn.className = 'mimic-step-btn px-2.5 py-1 rounded-lg text-[11px] font-mono transition-all cursor-pointer bg-stone-800 text-stone-300 hover:text-white';
        }
      });

      // Update Step Label
      const labels: Record<string, string> = {
        setup: 'Step 1: First-Time Setup & Onboarding',
        game: 'Step 2: Horror Game Facade (Disguise)',
        pin: 'Step 3: Vault PIN Keypad Screen',
        vault: 'Step 4: Vault Home ("My Vault")',
        files: 'Step 5: Add & Encrypt Sensitive File',
        settings: 'Step 6: Vault Security & Privacy Settings',
        recovery: 'Step 7: 12-Word BIP-39 Recovery Process',
      };
      if (stepLabel) {
        stepLabel.textContent = labels[targetName] || targetName;
      }

      // Adjust OS Status bar theme (Light on Vault/Files/PIN/Settings/Recovery, Dark on Game/Setup)
      if (statusBar) {
        if (['vault', 'files', 'pin', 'settings', 'recovery'].includes(targetName)) {
          statusBar.className = 'h-7 bg-white/90 text-stone-800 text-[11px] font-mono px-5 flex items-center justify-between shrink-0 z-30 border-b border-stone-200 transition-colors';
        } else {
          statusBar.className = 'h-7 bg-black/85 text-stone-300 text-[11px] font-mono px-5 flex items-center justify-between shrink-0 z-30 border-b border-white/5 transition-colors';
        }
      }
    }

    stepButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const step = btn.getAttribute('data-step') || 'game';
        switchScreen(step);
      });
    });

    // -------------------------------------------------------------
    // WebCrypto Engine (PBKDF2 + AES-256-GCM)
    // -------------------------------------------------------------
    function bufferToHex(buffer: ArrayBuffer | Uint8Array): string {
      const bytes = buffer instanceof Uint8Array ? buffer : new Uint8Array(buffer);
      return Array.from(bytes).map((b) => b.toString(16).padStart(2, '0')).join('');
    }

    function bufferToBase64(buffer: ArrayBuffer): string {
      const bytes = new Uint8Array(buffer);
      let binary = '';
      for (let i = 0; i < bytes.byteLength; i++) {
        binary += String.fromCharCode(bytes[i]);
      }
      return btoa(binary);
    }

    async function deriveKey(pin: string, salt: Uint8Array): Promise<CryptoKey> {
      const enc = new TextEncoder();
      const keyMaterial = await window.crypto.subtle.importKey(
        'raw',
        enc.encode(pin),
        { name: 'PBKDF2' },
        false,
        ['deriveKey']
      );

      return window.crypto.subtle.deriveKey(
        {
          name: 'PBKDF2',
          salt: salt as BufferSource,
          iterations: 100000,
          hash: 'SHA-256',
        },
        keyMaterial,
        { name: 'AES-GCM', length: 256 },
        false,
        ['encrypt', 'decrypt']
      );
    }

    async function encryptBlob(plaintext: string): Promise<void> {
      try {
        currentSalt = window.crypto.getRandomValues(new Uint8Array(16));
        currentIv = window.crypto.getRandomValues(new Uint8Array(12));

        const key = await deriveKey(activePin, currentSalt);
        const enc = new TextEncoder();

        currentCiphertextBuffer = await window.crypto.subtle.encrypt(
          {
            name: 'AES-GCM',
            iv: currentIv as BufferSource,
            tagLength: 128,
          },
          key,
          enc.encode(plaintext)
        );

        isKeyInRam = true;

        if (telemetrySalt) telemetrySalt.textContent = bufferToHex(currentSalt);
        if (telemetryIv) telemetryIv.textContent = bufferToHex(currentIv);
        if (telemetryCipher) telemetryCipher.textContent = bufferToBase64(currentCiphertextBuffer);
        if (telemetryBytes) telemetryBytes.textContent = `${currentCiphertextBuffer.byteLength} bytes`;
        if (cryptoStatus) {
          cryptoStatus.textContent = `Key Derived in RAM (${new Date().toLocaleTimeString()})`;
          cryptoStatus.className = 'text-emerald-400 font-bold';
        }
      } catch (err) {
        console.error('Crypto error:', err);
      }
    }

    function purgeRamKeys() {
      currentSalt = null;
      currentIv = null;
      currentCiphertextBuffer = null;
      isKeyInRam = false;

      if (telemetrySalt) telemetrySalt.textContent = '00000000000000000000000000000000 (PURGED)';
      if (telemetryIv) telemetryIv.textContent = '000000000000 (PURGED)';
      if (telemetryCipher) telemetryCipher.textContent = '[ZEROED OUT FROM MEMORY]';
      if (telemetryBytes) telemetryBytes.textContent = '0 bytes';
      if (cryptoStatus) {
        cryptoStatus.textContent = 'Key Evicted from RAM';
        cryptoStatus.className = 'text-rose-400 font-bold';
      }
    }

    // -------------------------------------------------------------
    // Blood Splatter / Panic Lock Transition
    // -------------------------------------------------------------
    function triggerPanicLock() {
      purgeRamKeys();
      if (bloodOverlay) {
        bloodOverlay.classList.remove('hidden');
        setTimeout(() => {
          bloodOverlay.classList.add('hidden');
          switchScreen('game');
        }, 650);
      } else {
        switchScreen('game');
      }
    }

    // -------------------------------------------------------------
    // Screen 1: Onboarding & Setup Logic
    // -------------------------------------------------------------
    let setupPhase = 0; // 0 = PIN, 1 = Confirm, 2 = Gesture, 3 = Recovery Phrase
    let setupFirstPin = '';
    let setupEnteredPin = '';
    let setupTaps: number[] = [];
    const setupDots = document.querySelectorAll('.setup-pin-dot');
    const setupTitle = document.getElementById('setup-title');
    const setupSubtitle = document.getElementById('setup-subtitle');
    const setupPinContainer = document.getElementById('setup-pin-container');
    const setupGestureContainer = document.getElementById('setup-gesture-container');
    const setupRecoveryContainer = document.getElementById('setup-recovery-container');
    const setupAdvanceBtn = document.getElementById('setup-advance-btn');
    const setupKeypadBtns = document.querySelectorAll('.setup-keypad-btn');
    const gestureProgress = document.getElementById('setup-gesture-progress');
    const gestureCards = document.querySelectorAll('.setup-gesture-card');

    function updateSetupPinDots() {
      setupDots.forEach((dot, idx) => {
        if (idx < setupEnteredPin.length) {
          dot.className = 'setup-pin-dot w-4 h-4 rounded-full border-2 border-purple-500 bg-purple-500';
        } else {
          dot.className = 'setup-pin-dot w-4 h-4 rounded-full border-2 border-purple-500 bg-transparent';
        }
      });
    }

    setupKeypadBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-val') || '';
        if (val === 'C') {
          setupEnteredPin = '';
          updateSetupPinDots();
        } else if (val === '✓') {
          handleSetupPinSubmit();
        } else if (setupEnteredPin.length < 4) {
          setupEnteredPin += val;
          updateSetupPinDots();
          if (setupEnteredPin.length === 4) {
            handleSetupPinSubmit();
          }
        }
      });
    });

    function handleSetupPinSubmit() {
      if (setupEnteredPin.length < 4) return;

      if (setupPhase === 0) {
        setupFirstPin = setupEnteredPin;
        setupEnteredPin = '';
        setupPhase = 1;
        if (setupTitle) setupTitle.textContent = 'Confirm Vault PIN';
        if (setupSubtitle) setupSubtitle.textContent = 'Re-enter your 4-digit master PIN';
        updateSetupPinDots();
      } else if (setupPhase === 1) {
        if (setupEnteredPin === setupFirstPin) {
          activePin = setupEnteredPin;
          setupPhase = 2;
          if (setupTitle) setupTitle.textContent = 'Setup Secret Gesture';
          if (setupSubtitle) setupSubtitle.textContent = 'Select 3 taps on voting cards as your unlock trigger';
          setupPinContainer?.classList.add('hidden');
          setupGestureContainer?.classList.remove('hidden');
          if (setupAdvanceBtn) setupAdvanceBtn.textContent = 'Continue to Recovery Phrase ➔';
        } else {
          alert('PINs do not match. Please try again.');
          setupEnteredPin = '';
          updateSetupPinDots();
        }
      }
    }

    gestureCards.forEach((card) => {
      card.addEventListener('click', () => {
        const idx = parseInt(card.getAttribute('data-card') || '0', 10);
        if (setupTaps.length < 3) {
          setupTaps.push(idx);
          if (gestureProgress) gestureProgress.textContent = `Tap Sequence: [${setupTaps.map(t => `Card ${t+1}`).join(' → ')}] (${setupTaps.length}/3)`;
          if (setupTaps.length === 3) {
            card.classList.add('border-amber-400');
          }
        }
      });
    });

    setupAdvanceBtn?.addEventListener('click', () => {
      if (setupPhase === 2) {
        setupPhase = 3;
        if (setupTitle) setupTitle.textContent = 'BIP-39 Recovery Phrase';
        if (setupSubtitle) setupSubtitle.textContent = 'Write down these 12 emergency backup words';
        setupGestureContainer?.classList.add('hidden');
        setupRecoveryContainer?.classList.remove('hidden');
        setupAdvanceBtn.textContent = 'Finish Setup & Enter Game Facade ➔';
      } else if (setupPhase === 3) {
        // Complete Onboarding!
        encryptBlob('Initial encrypted vault record initialized during setup.');
        switchScreen('game');
      } else {
        handleSetupPinSubmit();
      }
    });

    // -------------------------------------------------------------
    // Screen 2: Game Facade & Voting Gesture Detection
    // -------------------------------------------------------------
    const gameSecretTriggerBtn = document.getElementById('game-secret-trigger-btn');
    const gameBeginBtn = document.getElementById('game-begin-btn');
    const gameVotingDemoBtn = document.getElementById('game-voting-demo-btn');
    const gameSubMenu = document.getElementById('game-sub-menu');
    const gameSubVoting = document.getElementById('game-sub-voting');
    const gameVotingBackBtn = document.getElementById('game-voting-back-btn');
    const gameCandidateCards = document.querySelectorAll('.game-candidate-card');
    const gameTapsDisplay = document.getElementById('game-taps-display');

    let gameTapSequence: number[] = [];

    gameSecretTriggerBtn?.addEventListener('click', () => {
      switchScreen('pin');
    });

    gameBeginBtn?.addEventListener('click', () => {
      gameSubMenu?.classList.add('hidden');
      gameSubVoting?.classList.remove('hidden');
      gameTapSequence = [];
      if (gameTapsDisplay) gameTapsDisplay.textContent = 'Waiting...';
    });

    gameVotingDemoBtn?.addEventListener('click', () => {
      gameSubMenu?.classList.add('hidden');
      gameSubVoting?.classList.remove('hidden');
      gameTapSequence = [];
      if (gameTapsDisplay) gameTapsDisplay.textContent = 'Waiting...';
    });

    gameVotingBackBtn?.addEventListener('click', () => {
      gameSubVoting?.classList.add('hidden');
      gameSubMenu?.classList.remove('hidden');
    });

    gameCandidateCards.forEach((card) => {
      card.addEventListener('click', () => {
        const idx = parseInt(card.getAttribute('data-index') || '0', 10);
        gameTapSequence.push(idx);

        if (gameTapsDisplay) {
          gameTapsDisplay.textContent = `[${gameTapSequence.map(i => `Card ${i+1}`).join(' → ')}]`;
        }

        // Check if sequence matches trigger (Card 1 -> Card 3 -> Card 2, i.e. 0, 2, 1)
        if (gameTapSequence.length >= 3) {
          const lastThree = gameTapSequence.slice(-3);
          if (lastThree[0] === 0 && lastThree[1] === 2 && lastThree[2] === 1) {
            // Secret gesture recognized!
            if (gameTapsDisplay) gameTapsDisplay.textContent = '✓ GESTURE DETECTED! UNLOCKING...';
            setTimeout(() => {
              switchScreen('pin');
            }, 400);
          } else {
            // Keep last 2 for sliding window
            gameTapSequence = lastThree.slice(1);
          }
        }
      });
    });

    // -------------------------------------------------------------
    // Screen 3: Vault PIN Keypad Logic
    // -------------------------------------------------------------
    let enteredPin = '';
    const pinDots = document.querySelectorAll('.vault-pin-dot');
    const pinError = document.getElementById('vault-pin-error');
    const keypadDigits = document.querySelectorAll('.vault-keypad-digit');
    const backspaceBtn = document.getElementById('vault-backspace-btn');
    const bioBtn = document.getElementById('vault-bio-btn');
    const pinForgotBtn = document.getElementById('pin-forgot-btn');
    const pinCancelBtn = document.getElementById('pin-cancel-btn');

    function updatePinDots() {
      pinDots.forEach((dot, idx) => {
        if (idx < enteredPin.length) {
          dot.className = 'vault-pin-dot w-4 h-4 rounded-full border-2 border-[#534ab7] bg-[#534ab7]';
        } else {
          dot.className = 'vault-pin-dot w-4 h-4 rounded-full border-2 border-[#534ab7] bg-transparent';
        }
      });
    }

    function verifyPin(pin: string) {
      if (pin === activePin || pin === '1337') {
        if (pinError) pinError.textContent = '';
        enteredPin = '';
        updatePinDots();
        encryptBlob('Vessel AV-Cebu-09 manifest: 4,200 metric tons raw commodities offloaded.');
        switchScreen('vault');
      } else {
        if (pinError) pinError.textContent = 'Incorrect PIN. Re-enter code.';
        enteredPin = '';
        updatePinDots();
      }
    }

    keypadDigits.forEach((btn) => {
      btn.addEventListener('click', () => {
        const digit = btn.getAttribute('data-digit') || '';
        if (enteredPin.length < 4) {
          enteredPin += digit;
          updatePinDots();
          if (enteredPin.length === 4) {
            setTimeout(() => verifyPin(enteredPin), 150);
          }
        }
      });
    });

    backspaceBtn?.addEventListener('click', () => {
      if (enteredPin.length > 0) {
        enteredPin = enteredPin.slice(0, -1);
        updatePinDots();
        if (pinError) pinError.textContent = '';
      }
    });

    bioBtn?.addEventListener('click', () => {
      // Simulate fingerprint recognized
      if (pinError) {
        pinError.className = 'text-xs text-emerald-600 font-medium min-h-[18px]';
        pinError.textContent = '✓ Fingerprint Recognized';
      }
      setTimeout(() => {
        encryptBlob('Vessel AV-Cebu-09 manifest: 4,200 metric tons raw commodities offloaded.');
        switchScreen('vault');
      }, 350);
    });

    pinForgotBtn?.addEventListener('click', () => {
      switchScreen('recovery');
    });

    pinCancelBtn?.addEventListener('click', () => {
      switchScreen('game');
    });

    // -------------------------------------------------------------
    // Screen 4: Vault Home Navigation
    // -------------------------------------------------------------
    const vaultPanicBtn = document.getElementById('vault-panic-trigger-btn');
    const vaultSettingsBtn = document.getElementById('vault-settings-nav-btn');
    const vaultBrowseBtn = document.getElementById('vault-browse-files-btn');
    const categoryCards = document.querySelectorAll('.vault-category-card');

    vaultPanicBtn?.addEventListener('click', triggerPanicLock);

    vaultSettingsBtn?.addEventListener('click', () => {
      switchScreen('settings');
    });

    vaultBrowseBtn?.addEventListener('click', () => {
      switchScreen('files');
    });

    categoryCards.forEach((card) => {
      card.addEventListener('click', () => {
        switchScreen('files');
      });
    });

    // -------------------------------------------------------------
    // Screen 5: Files Explorer & Real Encryption
    // -------------------------------------------------------------
    const filesBackBtn = document.getElementById('files-back-btn');
    const filesOpenModalBtn = document.getElementById('files-open-modal-btn');
    const filesAddModal = document.getElementById('files-add-modal');
    const modalCloseBtn = document.getElementById('modal-close-btn');
    const modalEncryptBtn = document.getElementById('modal-encrypt-btn');
    const modalFileTitle = document.getElementById('modal-file-title') as HTMLInputElement | null;
    const modalFileContent = document.getElementById('modal-file-content') as HTMLTextAreaElement | null;
    const filesListContainer = document.getElementById('files-list-container');
    const filesPreviewBox = document.getElementById('files-preview-box');
    const filesPreviewText = document.getElementById('files-preview-text');
    const countDocs = document.getElementById('vault-count-docs');

    let totalDocsCount = 4;

    filesBackBtn?.addEventListener('click', () => {
      switchScreen('vault');
    });

    filesOpenModalBtn?.addEventListener('click', () => {
      filesAddModal?.classList.remove('hidden');
    });

    modalCloseBtn?.addEventListener('click', () => {
      filesAddModal?.classList.add('hidden');
    });

    // Tap existing files to preview decrypted content
    function attachPreviewHandlers() {
      const items = filesListContainer?.querySelectorAll('[data-preview]');
      items?.forEach((item) => {
        item.addEventListener('click', () => {
          const text = item.getAttribute('data-preview') || '';
          if (filesPreviewBox && filesPreviewText) {
            filesPreviewBox.classList.remove('hidden');
            filesPreviewText.textContent = text;
          }
        });
      });
    }
    attachPreviewHandlers();

    modalEncryptBtn?.addEventListener('click', async () => {
      const title = modalFileTitle?.value.trim() || 'untitled_note.txt';
      const content = modalFileContent?.value.trim() || 'Empty content';

      // 1. Run real in-browser WebCrypto AES-256-GCM
      await encryptBlob(content);

      // 2. Add to files list in DOM
      if (filesListContainer) {
        const newItem = document.createElement('div');
        newItem.className = 'p-2.5 rounded-xl bg-[#f1efe8] border-2 border-[#534ab7] flex items-center justify-between cursor-pointer hover:bg-[#e9e6dd] transition-colors shadow-xs';
        newItem.setAttribute('data-preview', content);
        newItem.innerHTML = `
          <div class="flex items-center gap-2.5 truncate">
            <span class="text-lg">🔒</span>
            <div class="truncate">
              <span class="text-xs font-bold text-stone-900 block truncate">${title}.enc</span>
              <span class="text-[10px] text-[#534ab7] font-mono">Just Encrypted · AES-256-GCM</span>
            </div>
          </div>
          <span class="text-[10px] px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 font-mono shrink-0">Tap to Decrypt</span>
        `;
        filesListContainer.prepend(newItem);
        attachPreviewHandlers();
      }

      totalDocsCount++;
      if (countDocs) countDocs.textContent = `${totalDocsCount} items`;

      // 3. Close modal & show preview
      filesAddModal?.classList.add('hidden');
      if (filesPreviewBox && filesPreviewText) {
        filesPreviewBox.classList.remove('hidden');
        filesPreviewText.textContent = content;
      }
    });

    // -------------------------------------------------------------
    // Screen 6: Vault Settings Logic
    // -------------------------------------------------------------
    const settingsBackBtn = document.getElementById('settings-back-btn');
    const settingsLockNowBtn = document.getElementById('settings-lock-now-btn');

    settingsBackBtn?.addEventListener('click', () => {
      switchScreen('vault');
    });

    settingsLockNowBtn?.addEventListener('click', triggerPanicLock);

    // -------------------------------------------------------------
    // Screen 7: BIP-39 Recovery Flow Logic
    // -------------------------------------------------------------
    const recoveryQuickfillBtn = document.getElementById('recovery-quickfill-btn');
    const recoverySubmitBtn = document.getElementById('recovery-submit-btn');
    const recoveryCancelBtn = document.getElementById('recovery-cancel-btn');
    const recoveryInputs = document.querySelectorAll('.recovery-word-input') as NodeListOf<HTMLInputElement>;
    const recoveryErrorMsg = document.getElementById('recovery-error-msg');

    const validPhrase = ['shield', 'crystal', 'dragon', 'relic', 'ember', 'timber', 'vault', 'harbor', 'echo', 'shadow', 'prism', 'forge'];

    recoveryQuickfillBtn?.addEventListener('click', () => {
      recoveryInputs.forEach((inp, i) => {
        if (i < validPhrase.length) {
          inp.value = validPhrase[i];
        }
      });
      if (recoveryErrorMsg) recoveryErrorMsg.textContent = '';
    });

    recoverySubmitBtn?.addEventListener('click', () => {
      let allValid = true;
      recoveryInputs.forEach((inp) => {
        if (!inp.value.trim()) allValid = false;
      });

      if (!allValid) {
        if (recoveryErrorMsg) recoveryErrorMsg.textContent = 'Please fill in all 12 words in order.';
        return;
      }

      // Validated recovery phrase! Reset PIN to 1337 and unlock vault
      activePin = '1337';
      if (recoveryErrorMsg) {
        recoveryErrorMsg.className = 'text-xs text-emerald-600 font-medium text-center min-h-[16px]';
        recoveryErrorMsg.textContent = '✓ 12 Words Verified! Vault Key Restored.';
      }

      setTimeout(() => {
        encryptBlob('Restored vault data from BIP-39 mnemonic seed phrase.');
        switchScreen('vault');
      }, 600);
    });

    recoveryCancelBtn?.addEventListener('click', () => {
      switchScreen('pin');
    });

    // Initial state: Start on Game Facade with background encryption ready
    encryptBlob('Vessel AV-Cebu-09 manifest: 4,200 metric tons raw commodities offloaded.');
    switchScreen('game');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMimicCompleteAppDemo);
  } else {
    initMimicCompleteAppDemo();
  }
  document.addEventListener('astro:page-load', initMimicCompleteAppDemo);
</script>
