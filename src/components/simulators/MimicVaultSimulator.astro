---
import ThematicIcon from '../icons/ThematicIcon.astro';
---

<div class="mimic-simulator-card my-8 p-4 sm:p-7 rounded-2xl border-2 border-emerald-700/60 bg-[#09120e] text-emerald-100 shadow-2xl">
  {/* Header & Recruiter Control Hub */}
  <div class="flex flex-wrap items-center justify-between gap-4 pb-4 mb-6 border-b border-emerald-800/50">
    <div class="flex items-center gap-3">
      <div class="w-11 h-11 rounded-xl bg-[#112219] border border-emerald-600/60 flex items-center justify-center shrink-0 shadow-md">
        <ThematicIcon name="swords" class="w-6 h-6 text-emerald-400" />
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-[10px] sm:text-xs uppercase font-extrabold tracking-widest text-emerald-400">Android Interactive Sandbox</span>
          <span class="px-2 py-0.5 rounded-full bg-emerald-950 border border-emerald-700 text-[10px] font-mono text-emerald-300">Dual-State Architecture</span>
        </div>
        <h3 class="text-lg sm:text-2xl font-bold font-serif text-emerald-200">
          Mimic Mobile Application Simulator
        </h3>
      </div>
    </div>

    {/* Mode Toggle Controls for Fast Navigation */}
    <div class="flex items-center gap-2 p-1.5 rounded-xl bg-[#060c09] border border-emerald-800/70 shadow-inner">
      <button
        type="button"
        id="mimic-nav-game-btn"
        class="px-3 py-1.5 rounded-lg text-xs font-mono font-bold transition-all cursor-pointer bg-emerald-600 text-black shadow"
        title="Switch to Party Game disguise"
      >
        🎮 State A: Party Game
      </button>
      <button
        type="button"
        id="mimic-nav-vault-btn"
        class="px-3 py-1.5 rounded-lg text-xs font-mono font-bold transition-all cursor-pointer bg-transparent text-emerald-400 hover:text-emerald-200"
        title="Switch to Encrypted Vault"
      >
        🔒 State B: Encrypted Vault
      </button>
    </div>
  </div>

  {/* Description and Telemetry Bar */}
  <p class="text-xs sm:text-sm text-emerald-200/90 mb-5 leading-relaxed">
    Experience how <strong>Mimic</strong> functions as a live mobile application. On the surface, it is a fully playable pass-and-play social deduction game. Underneath, a secret trigger unlocks an authenticated <strong>AES-256-GCM vault</strong> running real in-browser <code class="px-1 py-0.5 rounded bg-emerald-950 border border-emerald-800 font-mono text-emerald-300">crypto.subtle</code> cryptography.
  </p>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-6 text-xs font-mono">
    <div class="p-2.5 rounded-lg bg-[#0e1c15] border border-emerald-800/50 flex flex-col">
      <span class="text-[10px] text-stone-400">Current Surface State</span>
      <span class="text-emerald-300 font-bold" id="mimic-status-state">State A (Party Game)</span>
    </div>
    <div class="p-2.5 rounded-lg bg-[#0e1c15] border border-emerald-800/50 flex flex-col">
      <span class="text-[10px] text-stone-400">Network Permissions</span>
      <span class="text-emerald-300 font-bold">0 (No INTERNET)</span>
    </div>
    <div class="p-2.5 rounded-lg bg-[#0e1c15] border border-emerald-800/50 flex flex-col">
      <span class="text-[10px] text-stone-400">Cipher Pipeline</span>
      <span class="text-emerald-300 font-bold">PBKDF2 + AES-GCM</span>
    </div>
    <div class="p-2.5 rounded-lg bg-[#0e1c15] border border-emerald-800/50 flex flex-col">
      <span class="text-[10px] text-stone-400">Emergency Panic Lock</span>
      <span class="text-emerald-300 font-bold">Zero-RAM Ready</span>
    </div>
  </div>

  {/* MAIN CHASSIS: Realistic Smartphone Device */}
  <div class="flex justify-center my-4">
    <div class="phone-chassis relative w-full max-w-[390px] rounded-[42px] p-3.5 bg-gradient-to-b from-stone-800 via-stone-900 to-black border-4 border-stone-700/80 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.9),0_0_20px_rgba(16,185,129,0.15)]">
      {/* Phone Hardware Shell Accents */}
      <div class="absolute -left-1 top-24 w-1 h-10 bg-stone-700 rounded-l"></div>
      <div class="absolute -left-1 top-38 w-1 h-12 bg-stone-700 rounded-l"></div>
      <div class="absolute -right-1 top-28 w-1 h-14 bg-stone-700 rounded-r"></div>

      {/* Screen Bezel */}
      <div class="phone-screen relative rounded-[32px] overflow-hidden bg-stone-950 text-stone-100 flex flex-col h-[620px] select-none border border-stone-800">
        
        {/* Dynamic Android OS Status Bar */}
        <div class="phone-status-bar h-7 bg-black/80 backdrop-blur text-[11px] font-mono px-5 flex items-center justify-between text-stone-300 shrink-0 z-30 border-b border-white/5">
          <span id="mimic-phone-clock" class="font-bold">15:12</span>
          {/* Punch-hole camera notch */}
          <div class="w-3.5 h-3.5 rounded-full bg-black border border-stone-800 flex items-center justify-center">
            <span class="w-1.5 h-1.5 rounded-full bg-stone-900"></span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[9px] px-1 rounded bg-stone-800 text-stone-400" title="Air-gapped device: no internet permission">Offline</span>
            <span>4G</span>
            <span>100% ⚡</span>
          </div>
        </div>

        {/* ========================================================================= */}
        {/* STATE A: SOCIAL DEDUCTION PARTY GAME */}
        {/* ========================================================================= */}
        <div id="mimic-view-game" class="phone-view flex-1 flex flex-col bg-gradient-to-b from-[#1a1423] via-[#120e1a] to-[#0d0914] text-amber-50 overflow-y-auto">
          {/* Game App Header */}
          <div class="p-3.5 flex items-center justify-between border-b border-purple-900/40 bg-purple-950/40 backdrop-blur sticky top-0 z-20">
            <div class="flex items-center gap-2">
              <span class="text-xl">🎭</span>
              <div>
                <h4 class="text-sm font-bold tracking-wide text-amber-200 uppercase font-sans">MIMIC PARTY</h4>
                <p class="text-[10px] text-purple-300/80">Pass & Play Social Deduction</p>
              </div>
            </div>
            {/* Discreet Secret Trigger Padlock */}
            <button
              type="button"
              id="mimic-game-secret-trigger"
              class="w-8 h-8 rounded-full bg-purple-900/40 hover:bg-purple-800/80 border border-purple-500/30 flex items-center justify-center text-purple-300 hover:text-amber-200 transition-colors cursor-pointer"
              title="Discreet Security Trigger: Unlock Encrypted Vault"
              aria-label="Secret Vault Trigger"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            </button>
          </div>

          {/* Subview A1: Game Lobby */}
          <div id="mimic-game-sub-lobby" class="p-4 flex-1 flex flex-col justify-between space-y-4">
            <div class="space-y-4">
              <div class="text-center pt-2">
                <div class="inline-block px-3 py-1 rounded-full bg-purple-900/50 border border-purple-700/50 text-[10px] font-mono text-purple-200 uppercase tracking-widest mb-1.5">
                  Party Game Disguise
                </div>
                <h5 class="text-lg font-bold font-serif text-amber-100">Round Setup</h5>
                <p class="text-xs text-purple-200/70 mt-0.5">Find the Mimic before they decipher the secret word!</p>
              </div>

              {/* Category Selector */}
              <div class="p-3 rounded-xl bg-purple-950/40 border border-purple-800/40">
                <label class="block text-[11px] font-mono font-bold uppercase text-purple-300 mb-1.5">
                  Secret Word Category:
                </label>
                <select id="mimic-game-category" class="w-full p-2 rounded-lg bg-stone-900 border border-purple-700/50 text-amber-100 text-xs font-sans focus:outline-none focus:border-amber-400">
                  <option value="fantasy">Fantasy Stronghold (Word: Dragon Keep)</option>
                  <option value="maritime">Maritime Fleet (Word: Galleon Flagship)</option>
                  <option value="cyber">Cyber Underground (Word: Quantum Node)</option>
                </select>
              </div>

              {/* Player Count */}
              <div class="p-3 rounded-xl bg-purple-950/40 border border-purple-800/40">
                <div class="flex justify-between items-center mb-2">
                  <label class="text-[11px] font-mono font-bold uppercase text-purple-300">
                    Players in Room:
                  </label>
                  <span id="mimic-player-count-display" class="text-xs font-bold text-amber-300 font-mono">4 Players</span>
                </div>
                <div class="grid grid-cols-4 gap-1.5">
                  <button type="button" class="mimic-player-btn py-1.5 rounded bg-purple-900/40 border border-purple-700/40 text-xs font-mono text-purple-200 hover:bg-purple-800" data-players="3">3</button>
                  <button type="button" class="mimic-player-btn py-1.5 rounded bg-amber-600 font-bold border border-amber-400 text-xs font-mono text-black shadow" data-players="4">4</button>
                  <button type="button" class="mimic-player-btn py-1.5 rounded bg-purple-900/40 border border-purple-700/40 text-xs font-mono text-purple-200 hover:bg-purple-800" data-players="5">5</button>
                  <button type="button" class="mimic-player-btn py-1.5 rounded bg-purple-900/40 border border-purple-700/40 text-xs font-mono text-purple-200 hover:bg-purple-800" data-players="6">6</button>
                </div>
              </div>

              {/* How it plays card */}
              <div class="p-3 rounded-xl bg-stone-900/60 border border-white/5 text-[11px] text-stone-300 space-y-1">
                <div class="font-bold text-amber-300 flex items-center gap-1.5">
                  <span>ℹ️ Game Rules:</span>
                </div>
                <p>Pass the phone to each player. Civilians see the secret word. <strong>One player is The Mimic</strong> and gets no word. Each player gives one clue!</p>
              </div>
            </div>

            <button
              type="button"
              id="mimic-game-start-btn"
              class="w-full py-3 rounded-xl bg-gradient-to-r from-amber-600 to-amber-500 hover:from-amber-500 hover:to-amber-400 text-stone-950 font-bold text-sm tracking-wide transition-all shadow-lg cursor-pointer"
            >
              🎲 Start Pass & Play Round
            </button>
          </div>

          {/* Subview A2: Pass & Play Role Reveal */}
          <div id="mimic-game-sub-reveal" class="p-4 flex-1 flex flex-col justify-between space-y-4 hidden">
            <div class="text-center space-y-2 pt-2">
              <span id="mimic-reveal-step" class="inline-block px-3 py-1 rounded-full bg-purple-900/50 border border-purple-700/50 text-[11px] font-mono text-purple-200">
                Player 1 of 4
              </span>
              <h5 id="mimic-reveal-title" class="text-base font-bold text-amber-100">
                Pass Device to Player 1
              </h5>
              <p class="text-xs text-purple-200/70">Ensure no other players can see the screen!</p>
            </div>

            {/* Secret Identity Card (Tap to reveal) */}
            <div
              id="mimic-reveal-card"
              class="p-5 rounded-2xl bg-purple-950/60 border-2 border-dashed border-purple-500/60 text-center flex flex-col items-center justify-center min-h-[200px] cursor-pointer transition-all hover:border-amber-400 shadow-inner"
            >
              <div id="mimic-card-hidden-state" class="space-y-2">
                <span class="text-3xl block animate-bounce">👆</span>
                <span class="font-bold text-sm text-amber-300 block">Tap to Reveal Your Role</span>
                <span class="text-[10px] text-purple-300/70 block">Tap again to hide</span>
              </div>

              <div id="mimic-card-revealed-state" class="space-y-3 hidden">
                <div id="mimic-card-badge" class="inline-block px-3 py-1 rounded-full text-xs font-mono font-bold">
                  CIVILIAN
                </div>
                <div>
                  <span class="text-[10px] uppercase tracking-wider text-stone-400 block">Secret Word:</span>
                  <span id="mimic-card-secret-word" class="text-lg font-bold font-serif text-amber-200 block">
                    Dragon Keep
                  </span>
                </div>
                <p id="mimic-card-instructions" class="text-[11px] text-stone-300 leading-tight px-2">
                  Give a subtle clue during discussion without exposing the word to the Mimic!
                </p>
              </div>
            </div>

            <div class="space-y-2">
              <button
                type="button"
                id="mimic-reveal-next-btn"
                class="w-full py-2.5 rounded-xl bg-purple-700 hover:bg-purple-600 text-amber-50 font-bold text-xs font-mono transition-colors cursor-pointer"
              >
                Next Player ➔
              </button>
              <button
                type="button"
                id="mimic-reveal-cancel-btn"
                class="w-full py-1.5 text-stone-400 hover:text-stone-200 text-[11px] font-mono cursor-pointer"
              >
                Cancel Game
              </button>
            </div>
          </div>

          {/* Subview A3: Discussion Timer & Voting */}
          <div id="mimic-game-sub-discuss" class="p-4 flex-1 flex flex-col justify-between space-y-4 hidden">
            <div class="text-center space-y-2 pt-2">
              <span class="inline-block px-3 py-1 rounded-full bg-amber-950/60 border border-amber-600/50 text-[10px] font-mono text-amber-300 uppercase tracking-widest">
                All Roles Assigned
              </span>
              <h5 class="text-base font-bold text-amber-100">Discussion & Deduction</h5>
              <p class="text-xs text-stone-300">Each player speaks one clue. The Mimic must blend in!</p>
            </div>

            {/* Countdown Clock */}
            <div class="p-5 rounded-2xl bg-black/60 border border-purple-800/40 text-center flex flex-col items-center justify-center space-y-2">
              <span class="text-xs font-mono text-purple-300 uppercase">Discussion Timer</span>
              <span id="mimic-timer-display" class="text-4xl font-bold font-mono text-amber-300 tracking-wider">
                01:00
              </span>
              <div class="flex items-center gap-2 pt-1">
                <button
                  type="button"
                  id="mimic-timer-toggle-btn"
                  class="px-3 py-1 rounded-lg bg-purple-900/60 hover:bg-purple-800 text-purple-200 border border-purple-600/40 text-xs font-mono cursor-pointer"
                >
                  ▶ Start Timer
                </button>
                <button
                  type="button"
                  id="mimic-timer-reset-btn"
                  class="px-3 py-1 rounded-lg bg-stone-900 hover:bg-stone-800 text-stone-300 border border-stone-700 text-xs font-mono cursor-pointer"
                >
                  ↺ Reset
                </button>
              </div>
            </div>

            {/* Discussion guidelines */}
            <div class="p-3 rounded-xl bg-purple-950/30 border border-purple-800/30 text-xs space-y-1.5">
              <span class="font-bold text-amber-300 block">Round Resolution:</span>
              <p class="text-stone-300 text-[11px]">1. Vote on who the Mimic is.</p>
              <p class="text-stone-300 text-[11px]">2. If Civilians find the Mimic, the Mimic gets 1 guess at the secret word to steal victory!</p>
            </div>

            <button
              type="button"
              id="mimic-game-new-round-btn"
              class="w-full py-2.5 rounded-xl bg-stone-800 hover:bg-stone-700 text-amber-200 font-bold text-xs font-mono transition-colors cursor-pointer border border-stone-700"
            >
              🔄 Finish & Return to Lobby
            </button>
          </div>
        </div>

        {/* ========================================================================= */}
        {/* STATE B: ENCRYPTED PERSONAL VAULT */}
        {/* ========================================================================= */}
        <div id="mimic-view-vault" class="phone-view flex-1 flex flex-col bg-gradient-to-b from-[#07130c] via-[#0b1c13] to-[#040a06] text-emerald-100 overflow-y-auto hidden">
          {/* Vault App Header with Emergency Panic Lock */}
          <div class="p-3 flex items-center justify-between border-b border-emerald-800/60 bg-[#08150e]/90 backdrop-blur sticky top-0 z-20">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <div>
                <h4 class="text-xs font-bold font-mono tracking-wider text-emerald-300 uppercase">MIMIC VAULT</h4>
                <p class="text-[9px] font-mono text-emerald-500">AES-256-GCM · AIR-GAPPED</p>
              </div>
            </div>

            {/* Emergency Panic Lock */}
            <button
              type="button"
              id="mimic-panic-lock-btn"
              class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-rose-950 hover:bg-rose-900 border border-rose-600 text-rose-200 font-mono text-[10px] font-bold transition-all shadow-md cursor-pointer animate-pulse"
              title="Emergency Panic: Immediately wipe cryptographic keys from RAM and snap back to the party game"
            >
              <span>🚨 Panic Lock</span>
            </button>
          </div>

          {/* Vault Body Content */}
          <div class="p-3 space-y-3.5 flex-1">
            
            {/* Vault Stored Sensitive Documents */}
            <div class="rounded-xl bg-[#09170f] border border-emerald-800/60 p-2.5 space-y-2">
              <div class="flex items-center justify-between text-[11px] font-mono pb-1 border-b border-emerald-900/60">
                <span class="text-emerald-400 font-bold">Encrypted Vault Storage (3 Files)</span>
                <span class="text-[9px] px-1.5 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-800">Keystore Sealed</span>
              </div>
              <div class="space-y-1 text-[11px] font-mono">
                <div class="p-1.5 rounded bg-[#0f2418] border border-emerald-800/40 flex items-center justify-between">
                  <div class="flex items-center gap-2 truncate">
                    <span>🔒</span>
                    <span class="truncate text-emerald-200">cargo_manifest_cebu_v9.enc</span>
                  </div>
                  <span class="text-[9px] text-emerald-400 shrink-0">4.2 KB</span>
                </div>
                <div class="p-1.5 rounded bg-[#0f2418] border border-emerald-800/40 flex items-center justify-between">
                  <div class="flex items-center gap-2 truncate">
                    <span>🔒</span>
                    <span class="truncate text-emerald-200">root_server_ssh_keys.enc</span>
                  </div>
                  <span class="text-[9px] text-emerald-400 shrink-0">1.8 KB</span>
                </div>
                <div class="p-1.5 rounded bg-[#0f2418] border border-emerald-800/40 flex items-center justify-between">
                  <div class="flex items-center gap-2 truncate">
                    <span>🔒</span>
                    <span class="truncate text-emerald-200">client_escrow_audit_2026.enc</span>
                  </div>
                  <span class="text-[9px] text-emerald-400 shrink-0">12.6 KB</span>
                </div>
              </div>
            </div>

            {/* Live WebCrypto Encrypter */}
            <div class="rounded-xl bg-[#0a1810] border border-emerald-800/60 p-2.5 space-y-2">
              <span class="text-[11px] font-mono font-bold text-emerald-300 block">
                Live Note Encrypter (WebCrypto):
              </span>

              <div>
                <label for="mimic-live-note" class="text-[10px] text-stone-400 font-mono block mb-1">Plaintext Note:</label>
                <textarea
                  id="mimic-live-note"
                  rows="2"
                  class="w-full p-2 rounded bg-[#06100a] border border-emerald-800/70 text-emerald-100 text-[11px] font-mono focus:border-emerald-400 focus:outline-none"
                >Vessel AV-Cebu-09 manifest: Verified 4,200 metric tons offloaded without customs incident.</textarea>
              </div>

              <div>
                <label for="mimic-live-pass" class="text-[10px] text-stone-400 font-mono block mb-1">Master Passphrase:</label>
                <input
                  type="text"
                  id="mimic-live-pass"
                  value="ScribeVault#2026"
                  class="w-full p-1.5 rounded bg-[#06100a] border border-emerald-800/70 text-emerald-100 text-[11px] font-mono focus:border-emerald-400 focus:outline-none"
                />
              </div>

              <button
                type="button"
                id="mimic-live-encrypt-btn"
                class="w-full py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-black font-bold font-mono text-xs transition-colors cursor-pointer shadow"
              >
                🔒 Encrypt to AES-256-GCM
              </button>
            </div>

            {/* Live RAM Cryptographic Artifacts */}
            <div class="rounded-xl bg-[#060e09] border border-emerald-900/80 p-2.5 font-mono text-[10px] space-y-2">
              <div class="flex items-center justify-between pb-1 border-b border-emerald-900/60">
                <span class="text-emerald-400 font-bold">Active RAM State:</span>
                <span id="mimic-live-ram-status" class="text-emerald-500">Key derived</span>
              </div>
              <div class="space-y-1">
                <div>
                  <span class="text-stone-400">Salt (256-bit Keystore):</span>
                  <div id="mimic-live-salt" class="text-emerald-300 break-all bg-black/40 p-1 rounded">...</div>
                </div>
                <div>
                  <span class="text-stone-400">Unique Nonce / IV (96-bit):</span>
                  <div id="mimic-live-iv" class="text-emerald-300 break-all bg-black/40 p-1 rounded">...</div>
                </div>
                <div>
                  <span class="text-stone-400">Ciphertext + 128-bit Auth Tag (Base64):</span>
                  <div id="mimic-live-cipher" class="text-emerald-200 break-all bg-black/40 p-1 rounded max-h-14 overflow-y-auto">...</div>
                </div>
              </div>
            </div>

            {/* Decryption & Tamper Verification */}
            <div class="rounded-xl bg-[#0a1810] border border-emerald-800/60 p-2.5 space-y-2">
              <span class="text-[11px] font-mono font-bold text-emerald-300 block">
                Test Decryption & AEAD Verification:
              </span>
              <div class="flex gap-1.5">
                <input
                  type="text"
                  id="mimic-live-test-pass"
                  value="ScribeVault#2026"
                  class="flex-1 p-1.5 rounded bg-[#06100a] border border-emerald-800/70 text-emerald-100 text-[11px] font-mono focus:border-emerald-400 focus:outline-none"
                  placeholder="Passphrase"
                />
                <button
                  type="button"
                  id="mimic-live-decrypt-btn"
                  class="px-2.5 py-1.5 rounded bg-emerald-700 hover:bg-emerald-600 text-black font-bold font-mono text-[10px] cursor-pointer"
                >
                  Verify
                </button>
                <button
                  type="button"
                  id="mimic-live-tamper-btn"
                  class="px-2 py-1.5 rounded bg-rose-950 hover:bg-rose-900 border border-rose-700/60 text-rose-200 font-mono text-[10px] cursor-pointer"
                  title="Test wrong key authentication rejection"
                >
                  Bad Key
                </button>
              </div>

              {/* Decrypt Result Notification Box */}
              <div id="mimic-live-decrypt-output" class="p-2 rounded text-[10px] font-mono bg-emerald-950/70 border border-emerald-700/50 text-emerald-200">
                Awaiting decryption test...
              </div>
            </div>

          </div>
        </div>

        {/* ========================================================================= */}
        {/* OVERLAY: SECRET VAULT UNLOCK MODAL (Inside Phone) */}
        {/* ========================================================================= */}
        <div id="mimic-unlock-modal" class="absolute inset-0 bg-black/90 backdrop-blur-md z-40 p-5 flex flex-col justify-center items-center space-y-4 hidden">
          <div class="w-12 h-12 rounded-2xl bg-stone-900 border border-emerald-600/50 flex items-center justify-center text-2xl text-emerald-400 shadow-lg">
            🔒
          </div>
          <div class="text-center space-y-1">
            <h5 class="text-base font-bold font-mono text-emerald-300">Security Threshold Triggered</h5>
            <p class="text-xs text-stone-300 max-w-[260px]">Enter the master passphrase to derive the AES-256-GCM symmetric key:</p>
          </div>

          <div class="w-full max-w-[280px] space-y-2">
            <input
              type="text"
              id="mimic-modal-pass-input"
              value="ScribeVault#2026"
              class="w-full p-2.5 rounded-xl bg-stone-900 border border-emerald-600/70 text-emerald-100 text-xs font-mono text-center focus:outline-none focus:border-emerald-400"
              placeholder="Master Passphrase"
            />
            <div id="mimic-modal-error" class="text-[10px] text-rose-400 font-mono text-center hidden">
              ✕ Authentication Failed: Passphrase incorrect.
            </div>
            <button
              type="button"
              id="mimic-modal-unlock-btn"
              class="w-full py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-black font-bold font-mono text-xs transition-colors cursor-pointer shadow-lg"
            >
              🔓 Unlock Vault
            </button>
            <button
              type="button"
              id="mimic-modal-cancel-btn"
              class="w-full py-1.5 text-stone-400 hover:text-stone-200 text-[11px] font-mono text-center block cursor-pointer"
            >
              Return to Party Game
            </button>
          </div>
        </div>

        {/* ========================================================================= */}
        {/* OVERLAY: EMERGENCY PANIC LOCK PURGE SCREEN */}
        {/* ========================================================================= */}
        <div id="mimic-panic-overlay" class="absolute inset-0 bg-rose-950/95 z-50 p-6 flex flex-col items-center justify-center text-center space-y-3 hidden">
          <div class="w-14 h-14 rounded-full bg-rose-900/80 border-2 border-rose-500 flex items-center justify-center text-3xl animate-ping">
            🚨
          </div>
          <h5 class="text-base font-bold font-mono text-rose-100 tracking-wider">PANIC LOCK ENGAGED</h5>
          <p class="text-xs font-mono text-rose-300">
            Cryptographic key in RAM zeroed.<br />Decrypted buffers purged.<br />Snapping to game cover...
          </p>
        </div>

        {/* Android Gesture Bar */}
        <div class="h-4 bg-black flex items-center justify-center shrink-0 z-30">
          <div class="w-24 h-1 rounded-full bg-stone-600/80"></div>
        </div>
      </div>
    </div>
  </div>

  {/* Recruiter Technical Summary Grid */}
  <div class="mt-6 pt-5 border-t border-emerald-800/40 grid grid-cols-1 md:grid-cols-3 gap-4 text-xs font-mono">
    <div class="p-3 rounded-lg bg-[#0e1c15] border border-emerald-800/40 space-y-1">
      <span class="text-emerald-400 font-bold flex items-center gap-1.5">
        <span>🎮</span> 1. Plausible Deniability
      </span>
      <p class="text-stone-300 text-[11px] font-sans leading-relaxed">
        Unlike fake calculator apps that arouse suspicion during physical phone inspections, Mimic is a genuine, engaging social deduction party game that can be handed over to friends or observers.
      </p>
    </div>
    <div class="p-3 rounded-lg bg-[#0e1c15] border border-emerald-800/40 space-y-1">
      <span class="text-emerald-400 font-bold flex items-center gap-1.5">
        <span>🔒</span> 2. Authenticated AEAD Cipher
      </span>
      <p class="text-stone-300 text-[11px] font-sans leading-relaxed">
        AES-256 in Galois/Counter Mode (GCM) provides both high-performance stream encryption and a 128-bit integrity tag that immediately rejects corrupted or tampered file blobs.
      </p>
    </div>
    <div class="p-3 rounded-lg bg-[#0e1c15] border border-emerald-800/40 space-y-1">
      <span class="text-emerald-400 font-bold flex items-center gap-1.5">
        <span>🚨</span> 3. Memory Hygiene & Panic
      </span>
      <p class="text-stone-300 text-[11px] font-sans leading-relaxed">
        Master keys and decrypted file bytes are never persisted to disk and are immediately overwritten in RAM upon panic lock or app suspension, preventing forensic memory extraction.
      </p>
    </div>
  </div>
</div>

<script>
  function initMimicDualStateSimulator() {
    // Top-level View Elements
    const navGameBtn = document.getElementById('mimic-nav-game-btn');
    const navVaultBtn = document.getElementById('mimic-nav-vault-btn');
    const viewGame = document.getElementById('mimic-view-game');
    const viewVault = document.getElementById('mimic-view-vault');
    const statusState = document.getElementById('mimic-status-state');
    const phoneClock = document.getElementById('mimic-phone-clock');

    // Secret Trigger & Modal Elements
    const secretTrigger = document.getElementById('mimic-game-secret-trigger');
    const unlockModal = document.getElementById('mimic-unlock-modal');
    const modalPassInput = document.getElementById('mimic-modal-pass-input') as HTMLInputElement | null;
    const modalUnlockBtn = document.getElementById('mimic-modal-unlock-btn');
    const modalCancelBtn = document.getElementById('mimic-modal-cancel-btn');
    const modalError = document.getElementById('mimic-modal-error');
    const panicLockBtn = document.getElementById('mimic-panic-lock-btn');
    const panicOverlay = document.getElementById('mimic-panic-overlay');

    // Party Game Subview Elements
    const subLobby = document.getElementById('mimic-game-sub-lobby');
    const subReveal = document.getElementById('mimic-game-sub-reveal');
    const subDiscuss = document.getElementById('mimic-game-sub-discuss');
    const categorySelect = document.getElementById('mimic-game-category') as HTMLSelectElement | null;
    const playerCountDisplay = document.getElementById('mimic-player-count-display');
    const playerBtns = document.querySelectorAll('.mimic-player-btn');
    const startGameBtn = document.getElementById('mimic-game-start-btn');

    // Reveal Subview Elements
    const revealStep = document.getElementById('mimic-reveal-step');
    const revealTitle = document.getElementById('mimic-reveal-title');
    const revealCard = document.getElementById('mimic-reveal-card');
    const cardHiddenState = document.getElementById('mimic-card-hidden-state');
    const cardRevealedState = document.getElementById('mimic-card-revealed-state');
    const cardBadge = document.getElementById('mimic-card-badge');
    const cardSecretWord = document.getElementById('mimic-card-secret-word');
    const cardInstructions = document.getElementById('mimic-card-instructions');
    const revealNextBtn = document.getElementById('mimic-reveal-next-btn');
    const revealCancelBtn = document.getElementById('mimic-reveal-cancel-btn');

    // Discussion Subview Elements
    const timerDisplay = document.getElementById('mimic-timer-display');
    const timerToggleBtn = document.getElementById('mimic-timer-toggle-btn');
    const timerResetBtn = document.getElementById('mimic-timer-reset-btn');
    const newRoundBtn = document.getElementById('mimic-game-new-round-btn');

    // Vault Sandbox Elements
    const liveNoteInput = document.getElementById('mimic-live-note') as HTMLTextAreaElement | null;
    const livePassInput = document.getElementById('mimic-live-pass') as HTMLInputElement | null;
    const liveEncryptBtn = document.getElementById('mimic-live-encrypt-btn');
    const liveSalt = document.getElementById('mimic-live-salt');
    const liveIv = document.getElementById('mimic-live-iv');
    const liveCipher = document.getElementById('mimic-live-cipher');
    const liveRamStatus = document.getElementById('mimic-live-ram-status');
    const liveTestPass = document.getElementById('mimic-live-test-pass') as HTMLInputElement | null;
    const liveDecryptBtn = document.getElementById('mimic-live-decrypt-btn');
    const liveTamperBtn = document.getElementById('mimic-live-tamper-btn');
    const liveDecryptOutput = document.getElementById('mimic-live-decrypt-output');

    // -------------------------------------------------------------
    // Live OS Clock
    // -------------------------------------------------------------
    function updateClock() {
      if (phoneClock) {
        const now = new Date();
        const hrs = String(now.getHours()).padStart(2, '0');
        const mins = String(now.getMinutes()).padStart(2, '0');
        phoneClock.textContent = `${hrs}:${mins}`;
      }
    }
    updateClock();

    // -------------------------------------------------------------
    // View Switcher (Party Game vs Vault)
    // -------------------------------------------------------------
    function showGameView() {
      if (viewGame && viewVault && navGameBtn && navVaultBtn && statusState) {
        viewGame.classList.remove('hidden');
        viewVault.classList.add('hidden');
        unlockModal?.classList.add('hidden');
        navGameBtn.className = 'px-3 py-1.5 rounded-lg text-xs font-mono font-bold transition-all cursor-pointer bg-emerald-600 text-black shadow';
        navVaultBtn.className = 'px-3 py-1.5 rounded-lg text-xs font-mono font-bold transition-all cursor-pointer bg-transparent text-emerald-400 hover:text-emerald-200';
        statusState.textContent = 'State A (Party Game)';
      }
    }

    function showVaultView() {
      if (viewGame && viewVault && navGameBtn && navVaultBtn && statusState) {
        viewGame.classList.add('hidden');
        viewVault.classList.remove('hidden');
        unlockModal?.classList.add('hidden');
        navVaultBtn.className = 'px-3 py-1.5 rounded-lg text-xs font-mono font-bold transition-all cursor-pointer bg-emerald-600 text-black shadow';
        navGameBtn.className = 'px-3 py-1.5 rounded-lg text-xs font-mono font-bold transition-all cursor-pointer bg-transparent text-emerald-400 hover:text-emerald-200';
        statusState.textContent = 'State B (Encrypted Vault)';
      }
    }

    navGameBtn?.addEventListener('click', showGameView);
    navVaultBtn?.addEventListener('click', showVaultView);

    // -------------------------------------------------------------
    // Discreet Trigger & Passphrase Modal
    // -------------------------------------------------------------
    secretTrigger?.addEventListener('click', () => {
      unlockModal?.classList.remove('hidden');
      modalError?.classList.add('hidden');
      modalPassInput?.focus();
    });

    modalCancelBtn?.addEventListener('click', () => {
      unlockModal?.classList.add('hidden');
    });

    modalUnlockBtn?.addEventListener('click', () => {
      const pass = modalPassInput?.value.trim() || '';
      if (pass === 'ScribeVault#2026' || pass.length >= 6) {
        unlockModal?.classList.add('hidden');
        showVaultView();
      } else {
        if (modalError) {
          modalError.classList.remove('hidden');
        }
      }
    });

    modalPassInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        modalUnlockBtn?.click();
      }
    });

    // -------------------------------------------------------------
    // Emergency Panic Lock
    // -------------------------------------------------------------
    panicLockBtn?.addEventListener('click', () => {
      // 1. Zero out cryptographic keys and buffers in memory
      currentSalt = null;
      currentIv = null;
      currentCiphertextBuffer = null;

      // 2. Clear UI telemetry
      if (liveSalt) liveSalt.textContent = '00000000000000000000000000000000 (RAM Zeroed)';
      if (liveIv) liveIv.textContent = '0000000000000000 (RAM Zeroed)';
      if (liveCipher) liveCipher.textContent = '[PURGED FROM RAM]';
      if (liveRamStatus) liveRamStatus.textContent = 'WIPED';
      if (liveDecryptOutput) {
        liveDecryptOutput.className = 'p-2 rounded text-[10px] font-mono bg-rose-950/70 border border-rose-700/50 text-rose-200';
        liveDecryptOutput.textContent = 'RAM wiped by emergency panic lock.';
      }

      // 3. Show instant purge splash and snap back to game
      if (panicOverlay) {
        panicOverlay.classList.remove('hidden');
        setTimeout(() => {
          panicOverlay.classList.add('hidden');
          showGameView();
          // Reset game to lobby
          showGameLobby();
        }, 500);
      } else {
        showGameView();
        showGameLobby();
      }
    });

    // -------------------------------------------------------------
    // State A: Party Game Logic
    // -------------------------------------------------------------
    let totalPlayers = 4;
    let currentPlayerIndex = 0;
    let mimicPlayerIndex = 1; // 0-indexed
    let activeSecretWord = 'Dragon Keep';
    let cardIsRevealed = false;

    // Word Bank
    const wordBank: Record<string, string> = {
      fantasy: 'Dragon Keep',
      maritime: 'Galleon Flagship',
      cyber: 'Quantum Node',
    };

    function showGameLobby() {
      subLobby?.classList.remove('hidden');
      subReveal?.classList.add('hidden');
      subDiscuss?.classList.add('hidden');
      stopTimer();
    }

    playerBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const count = parseInt(btn.getAttribute('data-players') || '4', 10);
        totalPlayers = count;
        if (playerCountDisplay) playerCountDisplay.textContent = `${count} Players`;

        playerBtns.forEach((b) => {
          b.className = 'mimic-player-btn py-1.5 rounded bg-purple-900/40 border border-purple-700/40 text-xs font-mono text-purple-200 hover:bg-purple-800';
        });
        btn.className = 'mimic-player-btn py-1.5 rounded bg-amber-600 font-bold border border-amber-400 text-xs font-mono text-black shadow';
      });
    });

    startGameBtn?.addEventListener('click', () => {
      const cat = categorySelect?.value || 'fantasy';
      activeSecretWord = wordBank[cat] || 'Dragon Keep';

      // Pick random player as Mimic
      mimicPlayerIndex = Math.floor(Math.random() * totalPlayers);
      currentPlayerIndex = 0;
      cardIsRevealed = false;

      subLobby?.classList.add('hidden');
      subReveal?.classList.remove('hidden');
      subDiscuss?.classList.add('hidden');

      renderRevealPlayer();
    });

    function renderRevealPlayer() {
      cardIsRevealed = false;
      cardHiddenState?.classList.remove('hidden');
      cardRevealedState?.classList.add('hidden');

      if (revealStep) revealStep.textContent = `Player ${currentPlayerIndex + 1} of ${totalPlayers}`;
      if (revealTitle) revealTitle.textContent = `Pass Device to Player ${currentPlayerIndex + 1}`;

      const isMimic = currentPlayerIndex === mimicPlayerIndex;

      if (cardBadge) {
        if (isMimic) {
          cardBadge.className = 'inline-block px-3 py-1 rounded-full text-xs font-mono font-bold bg-rose-950 text-rose-300 border border-rose-500';
          cardBadge.textContent = '🎭 THE MIMIC';
        } else {
          cardBadge.className = 'inline-block px-3 py-1 rounded-full text-xs font-mono font-bold bg-emerald-950 text-emerald-300 border border-emerald-500';
          cardBadge.textContent = '🛡️ CIVILIAN';
        }
      }

      if (cardSecretWord) {
        cardSecretWord.textContent = isMimic ? 'UNKNOWN!' : activeSecretWord;
      }

      if (cardInstructions) {
        cardInstructions.textContent = isMimic
          ? 'You do NOT know the secret word! Listen carefully to the clues given by others and blend in without getting caught!'
          : 'Give a subtle clue about the secret word during discussion without exposing it directly to the Mimic!';
      }

      if (revealNextBtn) {
        revealNextBtn.textContent = currentPlayerIndex + 1 >= totalPlayers ? 'Start Discussion Round ➔' : 'Next Player ➔';
      }
    }

    revealCard?.addEventListener('click', () => {
      cardIsRevealed = !cardIsRevealed;
      if (cardIsRevealed) {
        cardHiddenState?.classList.add('hidden');
        cardRevealedState?.classList.remove('hidden');
      } else {
        cardHiddenState?.classList.remove('hidden');
        cardRevealedState?.classList.add('hidden');
      }
    });

    revealNextBtn?.addEventListener('click', () => {
      currentPlayerIndex++;
      if (currentPlayerIndex < totalPlayers) {
        renderRevealPlayer();
      } else {
        // All players have seen their cards, advance to Discussion
        subReveal?.classList.add('hidden');
        subDiscuss?.classList.remove('hidden');
        resetTimer();
      }
    });

    revealCancelBtn?.addEventListener('click', showGameLobby);
    newRoundBtn?.addEventListener('click', showGameLobby);

    // Discussion Timer
    let timerSeconds = 60;
    let timerInterval: number | null = null;
    let timerRunning = false;

    function formatTime(s: number) {
      const mins = Math.floor(s / 60);
      const secs = s % 60;
      return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
    }

    function startTimer() {
      if (timerRunning) return;
      timerRunning = true;
      if (timerToggleBtn) timerToggleBtn.textContent = '⏸ Pause';
      timerInterval = window.setInterval(() => {
        if (timerSeconds > 0) {
          timerSeconds--;
          if (timerDisplay) timerDisplay.textContent = formatTime(timerSeconds);
        } else {
          stopTimer();
          if (timerDisplay) timerDisplay.textContent = '00:00 (Vote!)';
        }
      }, 1000);
    }

    function stopTimer() {
      timerRunning = false;
      if (timerInterval) {
        clearInterval(timerInterval);
        timerInterval = null;
      }
      if (timerToggleBtn) timerToggleBtn.textContent = '▶ Start Timer';
    }

    function resetTimer() {
      stopTimer();
      timerSeconds = 60;
      if (timerDisplay) timerDisplay.textContent = formatTime(timerSeconds);
    }

    timerToggleBtn?.addEventListener('click', () => {
      if (timerRunning) {
        stopTimer();
      } else {
        startTimer();
      }
    });

    timerResetBtn?.addEventListener('click', resetTimer);

    // -------------------------------------------------------------
    // State B: Web Crypto API (AES-256-GCM + PBKDF2)
    // -------------------------------------------------------------
    let currentSalt: Uint8Array | null = null;
    let currentIv: Uint8Array | null = null;
    let currentCiphertextBuffer: ArrayBuffer | null = null;

    function bufferToHex(buffer: ArrayBuffer | Uint8Array): string {
      const bytes = buffer instanceof Uint8Array ? buffer : new Uint8Array(buffer);
      return Array.from(bytes)
        .map((b) => b.toString(16).padStart(2, '0'))
        .join('');
    }

    function bufferToBase64(buffer: ArrayBuffer): string {
      const bytes = new Uint8Array(buffer);
      let binary = '';
      for (let i = 0; i < bytes.byteLength; i++) {
        binary += String.fromCharCode(bytes[i]);
      }
      return btoa(binary);
    }

    async function deriveKey(passphrase: string, salt: Uint8Array): Promise<CryptoKey> {
      const enc = new TextEncoder();
      const keyMaterial = await window.crypto.subtle.importKey(
        'raw',
        enc.encode(passphrase),
        { name: 'PBKDF2' },
        false,
        ['deriveKey']
      );

      return window.crypto.subtle.deriveKey(
        {
          name: 'PBKDF2',
          salt: salt as BufferSource,
          iterations: 100000,
          hash: 'SHA-256',
        },
        keyMaterial,
        { name: 'AES-GCM', length: 256 },
        false,
        ['encrypt', 'decrypt']
      );
    }

    async function handleLiveEncrypt() {
      if (!liveNoteInput || !livePassInput) return;
      const text = liveNoteInput.value.trim() || 'Empty note';
      const pass = livePassInput.value.trim() || 'ScribeVault#2026';

      try {
        if (liveEncryptBtn) liveEncryptBtn.textContent = '⏳ Deriving PBKDF2...';

        // 1. Generate random salt and IV
        currentSalt = window.crypto.getRandomValues(new Uint8Array(16));
        currentIv = window.crypto.getRandomValues(new Uint8Array(12));

        // 2. Derive key
        const key = await deriveKey(pass, currentSalt);

        // 3. Encrypt via AES-GCM
        const enc = new TextEncoder();
        currentCiphertextBuffer = await window.crypto.subtle.encrypt(
          {
            name: 'AES-GCM',
            iv: currentIv as BufferSource,
            tagLength: 128,
          },
          key,
          enc.encode(text)
        );

        // Update UI
        if (liveSalt) liveSalt.textContent = bufferToHex(currentSalt);
        if (liveIv) liveIv.textContent = bufferToHex(currentIv);
        if (liveCipher) liveCipher.textContent = bufferToBase64(currentCiphertextBuffer);
        if (liveRamStatus) liveRamStatus.textContent = `Sealed at ${new Date().toLocaleTimeString()}`;

        if (liveDecryptOutput) {
          liveDecryptOutput.className = 'p-2 rounded text-[10px] font-mono bg-emerald-950/70 border border-emerald-700/50 text-emerald-200';
          liveDecryptOutput.textContent = 'Vault blob sealed with 256-bit symmetric key. Click "Verify" to test authentication.';
        }
      } catch (err: any) {
        if (liveDecryptOutput) {
          liveDecryptOutput.className = 'p-2 rounded text-[10px] font-mono bg-rose-950/70 border border-rose-700/50 text-rose-200';
          liveDecryptOutput.textContent = `Encryption failed: ${err?.message || err}`;
        }
      } finally {
        if (liveEncryptBtn) liveEncryptBtn.textContent = '🔒 Encrypt to AES-256-GCM';
      }
    }

    async function handleLiveDecrypt(testPass: string) {
      if (!currentSalt || !currentIv || !currentCiphertextBuffer || !liveDecryptOutput) {
        if (liveDecryptOutput) {
          liveDecryptOutput.className = 'p-2 rounded text-[10px] font-mono bg-amber-950/70 border border-amber-700/50 text-amber-200';
          liveDecryptOutput.textContent = 'Please encrypt a note first.';
        }
        return;
      }

      try {
        if (liveDecryptBtn) liveDecryptBtn.textContent = '...';

        const key = await deriveKey(testPass, currentSalt);
        const decryptedBuffer = await window.crypto.subtle.decrypt(
          {
            name: 'AES-GCM',
            iv: currentIv as BufferSource,
            tagLength: 128,
          },
          key,
          currentCiphertextBuffer
        );

        const dec = new TextDecoder();
        const decryptedText = dec.decode(decryptedBuffer);

        liveDecryptOutput.className = 'p-2 rounded text-[10px] font-mono bg-emerald-950/90 border border-emerald-500 text-emerald-100 shadow-inner';
        liveDecryptOutput.innerHTML = `
          <div class="font-bold text-emerald-300 pb-0.5 border-b border-emerald-800">
            ✓ AES-GCM Tag Verified
          </div>
          <p class="text-stone-200 mt-1 font-sans">"${decryptedText}"</p>
        `;
      } catch {
        liveDecryptOutput.className = 'p-2 rounded text-[10px] font-mono bg-rose-950/90 border border-rose-500 text-rose-100 shadow-inner';
        liveDecryptOutput.innerHTML = `
          <div class="font-bold text-rose-300 pb-0.5 border-b border-rose-800">
            ✕ Rejection: Auth Tag Mismatch
          </div>
          <p class="text-rose-200 mt-1">Passphrase "${testPass}" rejected. GCM detected corrupt/wrong key and blocked plaintext leakage.</p>
        `;
      } finally {
        if (liveDecryptBtn) liveDecryptBtn.textContent = 'Verify';
      }
    }

    liveEncryptBtn?.addEventListener('click', handleLiveEncrypt);

    liveDecryptBtn?.addEventListener('click', () => {
      const pass = liveTestPass?.value.trim() || '';
      handleLiveDecrypt(pass);
    });

    liveTamperBtn?.addEventListener('click', () => {
      if (liveTestPass) liveTestPass.value = 'WrongKey#999';
      handleLiveDecrypt('WrongKey#999');
    });

    // Auto-run initial encryption for instant live state
    handleLiveEncrypt();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMimicDualStateSimulator);
  } else {
    initMimicDualStateSimulator();
  }
  document.addEventListener('astro:page-load', initMimicDualStateSimulator);
</script>
