---
import ThematicIcon from '../icons/ThematicIcon.astro';
---

<style>
  @import url('https://fonts.googleapis.com/css2?family=Creepster&family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');

  .font-creepster {
    font-family: 'Creepster', cursive, sans-serif;
  }
  .font-inter {
    font-family: 'Inter', sans-serif;
  }
  .font-space {
    font-family: 'Space Grotesk', sans-serif;
  }

  /* Heartbeat Pulse Animation */
  @keyframes heartbeat {
    0%, 100% { transform: scale(1); }
    15% { transform: scale(1.05); }
    30% { transform: scale(1); }
    45% { transform: scale(1.03); }
    60% { transform: scale(1); }
  }
  .animate-heartbeat {
    animation: heartbeat 2.5s infinite ease-in-out;
  }

  /* Fog Drifting */
  @keyframes fogDrift {
    0% { transform: translateX(-20%); opacity: 0.15; }
    50% { transform: translateX(10%); opacity: 0.25; }
    100% { transform: translateX(-20%); opacity: 0.15; }
  }
  .fog-layer {
    background: radial-gradient(ellipse at 50% 50%, rgba(200, 30, 58, 0.15), transparent 70%);
    animation: fogDrift 14s infinite ease-in-out;
  }

  /* Blood Splatter Wipe Animation */
  @keyframes bloodSplatter {
    0% { opacity: 0; transform: scale(0.6); }
    40% { opacity: 0.95; transform: scale(1.05); }
    80% { opacity: 0.85; transform: scale(1); }
    100% { opacity: 0; transform: scale(1.15); }
  }
  .animate-blood {
    animation: bloodSplatter 0.65s forwards ease-out;
  }
</style>

<div class="mimic-simulator-card my-8 p-3 sm:p-7 rounded-2xl border-2 border-purple-900/60 bg-[#080a0f] text-stone-100 shadow-2xl font-inter">
  {/* Header & Journey Stepper Hub */}
  <div class="flex flex-wrap items-center justify-between gap-4 pb-4 mb-5 border-b border-purple-900/40">
    <div class="flex items-center gap-3">
      <div class="w-11 h-11 rounded-xl bg-[#161a26] border border-purple-600/50 flex items-center justify-center shrink-0 shadow-md">
        <ThematicIcon name="swords" class="w-6 h-6 text-purple-400" />
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-[10px] sm:text-xs uppercase font-extrabold tracking-widest text-purple-400">Android Application Sandbox</span>
          <span class="px-2 py-0.5 rounded-full bg-purple-950 border border-purple-700 text-[10px] font-mono text-purple-300">Live Flutter Architecture</span>
        </div>
        <h3 class="text-lg sm:text-2xl font-bold font-serif text-amber-100">
          Mimic Mobile Experience Simulator
        </h3>
      </div>
    </div>

    {/* Live Status Indicators */}
    <div class="flex items-center gap-2 text-xs font-mono">
      <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
      <span class="text-stone-300">Air-Gapped (0 Outbound)</span>
    </div>
  </div>

  <p class="text-xs sm:text-sm text-stone-300 mb-4 leading-relaxed">
    Experience the <strong>complete end-to-end user journey</strong> of Mimic exactly as built in Flutter: from first-time setup and the horror party game facade, to the secret 3-tap gesture trigger, AES-256-GCM encrypted document vault, privacy settings, and BIP-39 recovery.
  </p>

  {/* Recruiter Journey Stepper Navigation */}
  <div class="mb-6 p-2 rounded-xl bg-[#0f1420] border border-purple-900/40 shadow-inner">
    <div class="text-[10px] uppercase font-mono font-bold tracking-wider text-purple-300 mb-1.5 px-2 flex items-center justify-between">
      <span>Interactive User Journey Stepper (Click to jump to any screen):</span>
      <span id="mimic-active-step-label" class="text-amber-300">Step 2: Game Facade</span>
    </div>
    <div class="flex flex-wrap gap-1.5">
      <button type="button" class="mimic-step-btn px-2.5 py-1 rounded-lg text-[11px] font-mono transition-all cursor-pointer bg-stone-800 text-stone-300 hover:text-white" data-step="setup">
        1. 🚀 Setup & Onboarding
      </button>
      <button type="button" class="mimic-step-btn px-2.5 py-1 rounded-lg text-[11px] font-mono transition-all cursor-pointer bg-purple-700 text-white font-bold shadow" data-step="game">
        2. 🎭 Game Facade
      </button>
      <button type="button" class="mimic-step-btn px-2.5 py-1 rounded-lg text-[11px] font-mono transition-all cursor-pointer bg-stone-800 text-stone-300 hover:text-white" data-step="pin">
        3. 🔓 PIN Keypad
      </button>
      <button type="button" class="mimic-step-btn px-2.5 py-1 rounded-lg text-[11px] font-mono transition-all cursor-pointer bg-stone-800 text-stone-300 hover:text-white" data-step="vault">
        4. 🗄️ Vault Home
      </button>
      <button type="button" class="mimic-step-btn px-2.5 py-1 rounded-lg text-[11px] font-mono transition-all cursor-pointer bg-stone-800 text-stone-300 hover:text-white" data-step="files">
        5. ➕ Add/Encrypt File
      </button>
      <button type="button" class="mimic-step-btn px-2.5 py-1 rounded-lg text-[11px] font-mono transition-all cursor-pointer bg-stone-800 text-stone-300 hover:text-white" data-step="settings">
        6. 🛡️ Security Settings
      </button>
      <button type="button" class="mimic-step-btn px-2.5 py-1 rounded-lg text-[11px] font-mono transition-all cursor-pointer bg-stone-800 text-stone-300 hover:text-white" data-step="recovery">
        7. 🔑 BIP-39 Recovery
      </button>
    </div>
  </div>

  {/* MAIN CHASSIS: Smartphone Device Container */}
  <div class="flex justify-center my-4">
    <div class="phone-chassis relative w-full max-w-[390px] rounded-[44px] p-3.5 bg-gradient-to-b from-stone-800 via-stone-900 to-black border-4 border-stone-700/80 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.9),0_0_25px_rgba(127,119,221,0.2)]">
      {/* Hardware Buttons Simulation */}
      <div class="absolute -left-1.5 top-24 w-1.5 h-10 bg-stone-700 rounded-l"></div>
      <div class="absolute -left-1.5 top-38 w-1.5 h-12 bg-stone-700 rounded-l"></div>
      <div class="absolute -right-1.5 top-28 w-1.5 h-14 bg-stone-700 rounded-r"></div>

      {/* Screen Glass */}
      <div class="phone-screen relative rounded-[34px] overflow-hidden bg-black text-stone-100 flex flex-col h-[630px] select-none border border-stone-800">
        
        {/* Dynamic Android Status Bar */}
        <div id="mimic-screen-statusbar" class="h-7 bg-black/85 backdrop-blur text-[11px] font-mono px-5 flex items-center justify-between text-stone-300 shrink-0 z-30 border-b border-white/5 transition-colors">
          <span id="mimic-clock" class="font-bold">15:30</span>
          {/* Punch-hole camera */}
          <div class="w-3.5 h-3.5 rounded-full bg-black border border-stone-800 flex items-center justify-center">
            <span class="w-1.5 h-1.5 rounded-full bg-stone-900"></span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[9px] px-1 rounded bg-stone-800 text-stone-400">Offline</span>
            <span>4G</span>
            <span>100% ⚡</span>
          </div>
        </div>

        {/* ========================================================================= */}
        {/* SCREEN 1: ONBOARDING & SETUP WIZARD */}
        {/* ========================================================================= */}
        <div id="screen-setup" class="mimic-screen flex-1 flex flex-col bg-[#0f0f14] text-white overflow-y-auto p-4 justify-between hidden">
          <div class="space-y-4 pt-2">
            <div class="text-center space-y-1">
              <span class="px-2.5 py-0.5 rounded-full bg-purple-900/60 border border-purple-600 text-[10px] font-mono text-purple-300 uppercase">
                First-Time Setup
              </span>
              <h4 id="setup-title" class="text-xl font-bold font-space text-purple-200">
                Create Vault PIN
              </h4>
              <p id="setup-subtitle" class="text-xs text-stone-400">
                Set a 4-digit master PIN to seal your encrypted vault.
              </p>
            </div>

            {/* Step 1A & 1B: PIN Setup */}
            <div id="setup-pin-container" class="space-y-4 text-center">
              <div class="flex justify-center gap-3 my-3">
                <span class="setup-pin-dot w-4 h-4 rounded-full border-2 border-purple-500 bg-transparent"></span>
                <span class="setup-pin-dot w-4 h-4 rounded-full border-2 border-purple-500 bg-transparent"></span>
                <span class="setup-pin-dot w-4 h-4 rounded-full border-2 border-purple-500 bg-transparent"></span>
                <span class="setup-pin-dot w-4 h-4 rounded-full border-2 border-purple-500 bg-transparent"></span>
              </div>
              <p id="setup-pin-feedback" class="text-xs font-mono text-stone-400">Enter 4 digits using keypad</p>
              <div class="grid grid-cols-3 gap-2 max-w-[240px] mx-auto">
                {['1','2','3','4','5','6','7','8','9','C','0','✓'].map((key) => (
                  <button type="button" class="setup-keypad-btn py-2.5 rounded-xl bg-[#1a1f2e] hover:bg-[#252b3d] text-sm font-space font-bold border border-white/5 transition-colors cursor-pointer" data-val={key}>
                    {key}
                  </button>
                ))}
              </div>
            </div>

            {/* Step 1C: Secret Gesture Chooser (Hidden initially) */}
            <div id="setup-gesture-container" class="space-y-3 hidden">
              <div class="p-3 rounded-xl bg-[#1a1f2e] border border-purple-800/40 text-center">
                <span class="text-xs text-stone-300 block mb-1">Tap 3 candidate cards to set your secret trigger:</span>
                <span id="setup-gesture-progress" class="text-xs font-bold text-amber-300 font-mono">Tap Card (0 / 3)</span>
              </div>
              <div class="grid grid-cols-3 gap-2">
                {[0, 1, 2].map((idx) => (
                  <button type="button" class="setup-gesture-card p-3 rounded-xl bg-[#161a26] border-2 border-purple-700/60 hover:border-purple-400 text-center cursor-pointer transition-all" data-card={idx}>
                    <span class="text-2xl block mb-1">🎴</span>
                    <span class="text-[11px] font-space font-bold text-purple-200">Player {idx + 1}</span>
                  </button>
                ))}
              </div>
            </div>

            {/* Step 1D: BIP-39 Recovery Phrase Display (Hidden initially) */}
            <div id="setup-recovery-container" class="space-y-3 hidden">
              <div class="p-3 rounded-xl bg-[#161a26] border border-amber-600/40 text-center">
                <span class="text-amber-300 font-bold text-xs block mb-0.5">⚠️ 12-Word Recovery Phrase</span>
                <p class="text-[10px] text-stone-400">Save these words in order. If you lose your PIN, this is the only way to recover your vault.</p>
              </div>
              <div class="grid grid-cols-3 gap-1.5 p-2 rounded-xl bg-black/60 border border-white/10 text-[11px] font-mono">
                {['1. shield', '2. crystal', '3. dragon', '4. relic', '5. ember', '6. timber', '7. vault', '8. harbor', '9. echo', '10. shadow', '11. prism', '12. forge'].map((word) => (
                  <span class="p-1 rounded bg-stone-900 text-stone-200 text-center">{word}</span>
                ))}
              </div>
            </div>
          </div>

          <div class="pt-3">
            <button
              type="button"
              id="setup-advance-btn"
              class="w-full py-2.5 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-space font-bold text-xs tracking-wide transition-all shadow-lg cursor-pointer"
            >
              Continue to Gesture Setup ➔
            </button>
          </div>
        </div>

        {/* ========================================================================= */}
        {/* SCREEN 2: HORROR GAME FACADE (Disguise) */}
        {/* ========================================================================= */}
        <div id="screen-game" class="mimic-screen flex-1 flex flex-col bg-[#080a0f] text-[#e8e0d0] overflow-y-auto relative">
          {/* Animated Fog Backdrop */}
          <div class="fog-layer absolute inset-0 pointer-events-none z-0"></div>

          {/* Game Header */}
          <div class="p-3 flex items-center justify-between border-b border-[#2d1b1b] bg-[#0d1117]/80 backdrop-blur z-10">
            <div class="flex items-center gap-2">
              <span class="text-xs px-2 py-0.5 rounded bg-[#1a1f2e] border border-[#c41e3a]/40 text-[#c41e3a] font-mono">
                PASS & PLAY
              </span>
            </div>
            {/* Discreet Trigger Button for Recruiters */}
            <button
              type="button"
              id="game-secret-trigger-btn"
              class="w-7 h-7 rounded-full bg-[#1a1f2e] hover:bg-[#2d1b1b] border border-[#c41e3a]/40 flex items-center justify-center text-stone-400 hover:text-white transition-colors cursor-pointer"
              title="Discreet Trigger: Tap to enter Vault PIN screen"
              aria-label="Secret Trigger"
            >
              🔒
            </button>
          </div>

          {/* Game Subview: Main Menu */}
          <div id="game-sub-menu" class="flex-1 flex flex-col justify-center items-center p-5 text-center z-10 space-y-4">
            <div class="space-y-1">
              {/* Blood-Red Creepster Title with Heartbeat Pulse */}
              <h1 class="font-creepster text-6xl tracking-widest text-[#8b0000] drop-shadow-[0_0_15px_rgba(196,30,58,0.7)] animate-heartbeat">
                MIMIC
              </h1>
              <p class="text-xs text-[#6b7280] italic">
                Someone among you is not what they seem.
              </p>
            </div>

            <div class="w-full max-w-[260px] space-y-2.5 pt-4">
              <button
                type="button"
                id="game-begin-btn"
                class="w-full py-2.5 rounded-lg bg-gradient-to-r from-[#8b0000] to-[#c41e3a] hover:from-[#a00000] hover:to-[#e02040] text-white font-space font-bold text-sm tracking-wider shadow-[0_0_15px_rgba(196,30,58,0.4)] cursor-pointer transition-all"
              >
                BEGIN GAME
              </button>
              <button
                type="button"
                id="game-voting-demo-btn"
                class="w-full py-2 rounded-lg bg-[#1a1f2e] border border-[#c41e3a]/60 hover:border-[#c41e3a] text-xs font-space font-bold text-[#e8e0d0] cursor-pointer"
              >
                VOTING (TEST 3-TAP GESTURE)
              </button>
              <button
                type="button"
                class="w-full py-1.5 rounded-lg bg-transparent text-stone-400 text-xs font-space hover:text-stone-200"
              >
                MULTIPLAYER (AIR-GAPPED LAN)
              </button>
            </div>
          </div>

          {/* Game Subview: Voting Screen with Secret 3-Tap Gesture */}
          <div id="game-sub-voting" class="flex-1 flex flex-col justify-between p-4 z-10 hidden">
            <div class="text-center space-y-1 pt-1">
              <span class="text-[10px] font-mono text-[#c41e3a] uppercase tracking-widest">
                Round 1 · Cast Suspicion
              </span>
              <h5 class="text-base font-bold font-space text-stone-100">
                Vote on the Imposter
              </h5>
              <p class="text-[11px] text-[#6b7280]">
                (Hint: Tap Card 1, then Card 3, then Card 2 to trigger the secret vault entrance!)
              </p>
            </div>

            {/* Candidate Cards */}
            <div class="space-y-2 my-2">
              {[
                { id: 0, name: 'Player 1 (Kaelen)', role: 'Suspect', icon: '👤' },
                { id: 1, name: 'Player 2 (Rowan)', role: 'Suspect', icon: '👤' },
                { id: 2, name: 'Player 3 (Vesper)', role: 'Suspect', icon: '👤' },
              ].map((player) => (
                <div
                  class="game-candidate-card p-3 rounded-xl bg-[#1a1f2e] border border-white/10 hover:border-[#c41e3a] flex items-center justify-between cursor-pointer transition-all"
                  data-index={player.id}
                >
                  <div class="flex items-center gap-3">
                    <span class="text-xl">{player.icon}</span>
                    <div>
                      <span class="font-space font-bold text-xs text-white block">{player.name}</span>
                      <span class="text-[10px] text-stone-400">Word clue: "Galleon Flagship"</span>
                    </div>
                  </div>
                  <span class="text-[10px] px-2 py-0.5 rounded bg-black/40 text-stone-400 font-mono">Vote</span>
                </div>
              ))}
            </div>

            {/* Gesture feedback banner */}
            <div id="game-gesture-feedback" class="p-2 rounded-lg bg-black/60 border border-white/10 text-center text-xs font-mono text-stone-400">
              Tap candidates sequence: <span id="game-taps-display" class="text-amber-400 font-bold">Waiting...</span>
            </div>

            <button
              type="button"
              id="game-voting-back-btn"
              class="w-full py-2 text-xs font-mono text-stone-400 hover:text-stone-200 cursor-pointer"
            >
              &larr; Back to Game Menu
            </button>
          </div>
        </div>

        {/* ========================================================================= */}
        {/* SCREEN 3: VAULT PIN KEYPAD SCREEN */}
        {/* ========================================================================= */}
        <div id="screen-pin" class="mimic-screen flex-1 flex flex-col bg-white text-stone-900 overflow-y-auto p-5 justify-between font-inter hidden">
          <div class="text-center space-y-2 pt-2">
            <div class="w-12 h-12 rounded-full bg-[#534ab7]/10 flex items-center justify-center mx-auto text-[#534ab7]">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            </div>
            <h4 class="text-xl font-bold text-[#1a1818]">Enter Vault PIN</h4>
            <p class="text-xs text-[#6b6b6b]">Enter your 4-digit PIN (Default: <strong>1337</strong>)</p>

            {/* 4 PIN Dots */}
            <div class="flex justify-center gap-3.5 my-3">
              <span class="vault-pin-dot w-4 h-4 rounded-full border-2 border-[#534ab7] bg-transparent"></span>
              <span class="vault-pin-dot w-4 h-4 rounded-full border-2 border-[#534ab7] bg-transparent"></span>
              <span class="vault-pin-dot w-4 h-4 rounded-full border-2 border-[#534ab7] bg-transparent"></span>
              <span class="vault-pin-dot w-4 h-4 rounded-full border-2 border-[#534ab7] bg-transparent"></span>
            </div>

            <div id="vault-pin-error" class="text-xs text-[#d85a30] font-medium min-h-[18px]"></div>
          </div>

          {/* Clean Keypad */}
          <div class="grid grid-cols-3 gap-2.5 max-w-[250px] mx-auto w-full my-2">
            {['1','2','3','4','5','6','7','8','9'].map((digit) => (
              <button
                type="button"
                class="vault-keypad-digit h-12 rounded-2xl bg-[#f1efe8] hover:bg-[#e6e2d8] text-lg font-bold text-stone-800 transition-colors cursor-pointer flex items-center justify-center shadow-xs"
                data-digit={digit}
              >
                {digit}
              </button>
            ))}
            <button
              type="button"
              id="vault-bio-btn"
              class="h-12 rounded-2xl bg-[#f1efe8] hover:bg-[#e6e2d8] text-[#534ab7] transition-colors cursor-pointer flex items-center justify-center shadow-xs"
              title="Simulate Biometric Fingerprint Unlock"
            >
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 11c0 2.5-2 4.5-4.5 4.5"></path>
                <path d="M16.5 15.5c-.8.8-2 1.5-4.5 1.5"></path>
                <path d="M21 12c0-5-4-9-9-9s-9 4-9 9"></path>
                <path d="M5.5 15.5C6.3 14.7 7.5 14 10 14"></path>
                <path d="M12 7c2.8 0 5 2.2 5 5"></path>
              </svg>
            </button>
            <button
              type="button"
              class="vault-keypad-digit h-12 rounded-2xl bg-[#f1efe8] hover:bg-[#e6e2d8] text-lg font-bold text-stone-800 transition-colors cursor-pointer flex items-center justify-center shadow-xs"
              data-digit="0"
            >
              0
            </button>
            <button
              type="button"
              id="vault-backspace-btn"
              class="h-12 rounded-2xl bg-[#f1efe8] hover:bg-[#e6e2d8] text-stone-700 transition-colors cursor-pointer flex items-center justify-center shadow-xs"
              title="Backspace"
            >
              ⌫
            </button>
          </div>

          <div class="text-center pt-2 space-y-1">
            <button
              type="button"
              id="pin-forgot-btn"
              class="text-xs text-[#534ab7] font-semibold hover:underline cursor-pointer block mx-auto"
            >
              Forgot PIN? Recover with 12-word phrase
            </button>
            <button
              type="button"
              id="pin-cancel-btn"
              class="text-[11px] text-stone-500 hover:text-stone-800 cursor-pointer block mx-auto pt-1"
            >
              Return to Game Facade
            </button>
          </div>
        </div>

        {/* ========================================================================= */}
        {/* SCREEN 4: VAULT HOME SCREEN ("My Vault") */}
        {/* ========================================================================= */}
        <div id="screen-vault" class="mimic-screen flex-1 flex flex-col bg-white text-stone-900 overflow-y-auto font-inter hidden">
          {/* Vault Top Bar */}
          <div class="p-3.5 flex items-center justify-between border-b border-stone-200/80 bg-white/95 sticky top-0 z-20">
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
              <span class="text-xs font-bold text-stone-800 font-mono">SEALED IN RAM</span>
            </div>

            <div class="flex items-center gap-2">
              {/* Panic / Shake Action */}
              <button
                type="button"
                id="vault-panic-trigger-btn"
                class="flex items-center gap-1 px-2.5 py-1 rounded-full bg-[#d85a30]/15 hover:bg-[#d85a30]/25 text-[#d85a30] text-[11px] font-bold transition-colors cursor-pointer"
                title="Shake to Hide / Emergency Panic Lock"
              >
                <span>🚨 Shake Lock</span>
              </button>

              {/* Settings Gear */}
              <button
                type="button"
                id="vault-settings-nav-btn"
                class="p-1.5 rounded-lg text-stone-600 hover:text-[#534ab7] hover:bg-[#f1efe8] transition-colors cursor-pointer"
                title="Open Vault Settings"
              >
                ⚙️
              </button>
            </div>
          </div>

          <div class="p-4 flex-1 flex flex-col justify-between space-y-4">
            <div>
              <div class="pt-1 pb-3">
                <h2 class="text-2xl font-bold text-stone-900 tracking-tight">My Vault</h2>
                <p class="text-xs text-stone-500">Your encrypted files are safe here.</p>
              </div>

              {/* 2x2 Category Cards Grid */}
              <div class="grid grid-cols-2 gap-3">
                {/* 1. Photos */}
                <div class="vault-category-card p-4 rounded-2xl bg-[#f1efe8] hover:bg-[#e9e6dd] border border-stone-200 flex flex-col items-center justify-center text-center cursor-pointer transition-all shadow-xs" data-target="files">
                  <div class="w-12 h-12 rounded-full bg-[#534ab7]/10 flex items-center justify-center text-xl mb-2 text-[#534ab7]">
                    📸
                  </div>
                  <span class="font-bold text-sm text-stone-900 block">Photos</span>
