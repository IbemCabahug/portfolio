---
import ThematicIcon from './icons/ThematicIcon.astro';
---
<div class="preference-pod flex items-center h-8 rounded-md border border-[var(--brass)] bg-[#1e1208] text-xs shadow-xs overflow-hidden" role="group" aria-label="Display and sound preferences">
  <button
    id="toggle-motion"
    type="button"
    class="px-2.5 h-full font-semibold text-[var(--parchment)] hover:text-[var(--candle)] hover:bg-[var(--brass)]/20 focus-visible:outline-2 focus-visible:outline-[var(--brass)] focus-visible:outline-offset-[-2px] flex items-center justify-center gap-1.5 whitespace-nowrap transition-colors cursor-pointer"
    aria-pressed="false"
    title="Toggle animations (Full / Reduced)"
  >
    <ThematicIcon name="motion-full" class="w-3.5 h-3.5 text-[var(--brass)] shrink-0 motion-icon-full" />
    <ThematicIcon name="motion-reduced" class="w-3.5 h-3.5 text-[var(--brass)] shrink-0 motion-icon-reduced hidden" />
    <span id="motion-text">Motion: Full</span>
  </button>
  <div class="w-px h-3.5 bg-[var(--brass)]/40 shrink-0" aria-hidden="true"></div>
  <button
    id="toggle-sound"
    type="button"
    class="px-2.5 h-full font-semibold text-[var(--parchment)] hover:text-[var(--candle)] hover:bg-[var(--brass)]/20 focus-visible:outline-2 focus-visible:outline-[var(--brass)] focus-visible:outline-offset-[-2px] flex items-center justify-center whitespace-nowrap transition-colors cursor-pointer"
    aria-pressed="false"
    title="Toggle tavern hearth ambient soundscape"
  >
    Sound: Off
  </button>
</div>

<script>
  import { getMotion, getSound, setMotion, setSound, subscribePreferences } from '../store/preferences';
  import { soundEngine } from '../lib/sound-engine';
  import { recordMilestone } from '../store/questlog';

  let prefAbort: AbortController | null = null;

  function updatePreferenceButtons() {
    const btnMotion = document.getElementById('toggle-motion');
    const btnSound = document.getElementById('toggle-sound');
    const motion = getMotion();
    const sound = getSound();

    if (btnMotion) {
      const isReduced = motion === 'reduced';
      btnMotion.setAttribute('aria-pressed', isReduced ? 'true' : 'false');
      const iconFull = btnMotion.querySelector('.motion-icon-full');
      const iconReduced = btnMotion.querySelector('.motion-icon-reduced');
      const motionText = document.getElementById('motion-text');
      if (iconFull) iconFull.classList.toggle('hidden', isReduced);
      if (iconReduced) iconReduced.classList.toggle('hidden', !isReduced);
      if (motionText) motionText.textContent = isReduced ? 'Motion: Reduced' : 'Motion: Full';
    }

    if (btnSound) {
      if (sound === 'on') {
        btnSound.innerHTML = `<span class="inline-flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse" aria-hidden="true"></span><span>Sound: On</span></span>`;
        btnSound.classList.add('sound-active');
        btnSound.setAttribute('aria-pressed', 'true');
        btnSound.setAttribute('title', 'Tavern hearth ambient soundscape active. Click to mute.');
      } else {
        btnSound.innerHTML = `<span>Sound: Off</span>`;
        btnSound.classList.remove('sound-active');
        btnSound.setAttribute('aria-pressed', 'false');
        btnSound.setAttribute('title', 'Tavern sound muted. Click to enable hearth soundscape.');
      }
    }
  }

  function initPreferences() {
    prefAbort?.abort();
    prefAbort = new AbortController();
    const { signal } = prefAbort;

    soundEngine.init();
    updatePreferenceButtons();

    const btnMotion = document.getElementById('toggle-motion');
    const btnSound = document.getElementById('toggle-sound');

    btnMotion?.addEventListener('click', () => {
      soundEngine.playWoodClink();
      setMotion(getMotion() === 'full' ? 'reduced' : 'full');
    }, { signal });

    btnSound?.addEventListener('click', () => {
      const next = getSound() === 'on' ? 'off' : 'on';
      if (next === 'on') {
        soundEngine.enable();
        soundEngine.playWoodClink();
        recordMilestone('feat_hearth');
      } else {
        soundEngine.disable();
      }
      setSound(next);
    }, { signal });
  }

  document.addEventListener('astro:page-load', initPreferences);
  document.addEventListener('astro:before-swap', () => {
    prefAbort?.abort();
    prefAbort = null;
  });
  subscribePreferences(updatePreferenceButtons);
</script>

<style>
  #toggle-sound.sound-active {
    color: var(--candle);
    background: rgba(201, 168, 76, 0.2);
    text-shadow: 0 0 8px rgba(255, 228, 160, 0.6);
  }

  @media (max-height: 500px), (max-width: 860px) {
    .preference-pod {
      height: 28px;
    }
    #toggle-motion, #toggle-sound {
      padding-left: 6px;
      padding-right: 6px;
      font-size: 11px;
    }
  }

  @media (max-width: 600px) and (orientation: portrait) {
    .preference-pod {
      height: 28px;
    }
    #toggle-motion, #toggle-sound {
      padding-left: 5px;
      padding-right: 5px;
      font-size: 10px;
    }
  }

  @media (pointer: coarse) {
    #toggle-motion, #toggle-sound {
      position: relative;
    }
    #toggle-motion::after, #toggle-sound::after {
      content: '';
      position: absolute;
      top: -8px;
      bottom: -8px;
      left: 0;
      right: 0;
    }
  }
</style>
