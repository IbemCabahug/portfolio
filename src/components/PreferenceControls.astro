---
---
<div class="flex items-center gap-1.5 sm:gap-2">
  <button
    id="toggle-motion"
    type="button"
    class="px-2.5 sm:px-3 py-1 text-xs font-semibold rounded border border-[var(--brass)] bg-[#1e1208] text-[var(--parchment)] hover:border-[var(--candle)] hover:text-[var(--candle)] focus-visible:outline-2 focus-visible:outline-[var(--brass)] focus-visible:outline-offset-2 min-h-[44px] flex items-center justify-center whitespace-nowrap transition-colors"
    aria-pressed="false"
  >
    Motion: Full
  </button>
  <button
    id="toggle-sound"
    type="button"
    class="px-2.5 sm:px-3 py-1 text-xs font-semibold rounded border border-[var(--brass)] bg-[#1e1208] text-[var(--parchment)] hover:border-[var(--candle)] hover:text-[var(--candle)] focus-visible:outline-2 focus-visible:outline-[var(--brass)] focus-visible:outline-offset-2 min-h-[44px] flex items-center justify-center whitespace-nowrap transition-colors"
    aria-pressed="false"
  >
    Sound: Off
  </button>
  <button
    id="toggle-theme"
    type="button"
    class="px-2.5 sm:px-3 py-1 text-xs font-semibold rounded border border-[var(--brass)] bg-[#1e1208] text-[var(--parchment)] hover:border-[var(--candle)] hover:text-[var(--candle)] focus-visible:outline-2 focus-visible:outline-[var(--brass)] focus-visible:outline-offset-2 min-h-[44px] flex items-center justify-center whitespace-nowrap transition-colors"
    aria-pressed="false"
    title="Toggle tavern illumination (Night / Day)"
  >
    Theme: Night
  </button>
</div>

<script>
  import { getMotion, getSound, getTheme, setMotion, setSound, setTheme, subscribePreferences } from '../store/preferences';

  function initPreferences() {
    const btnMotion = document.getElementById('toggle-motion');
    const btnSound = document.getElementById('toggle-sound');
    const btnTheme = document.getElementById('toggle-theme');

    function updateDOM() {
      const motion = getMotion();
      const sound = getSound();
      const theme = getTheme();
      
      if (btnMotion) {
        btnMotion.textContent = motion === 'full' ? 'Motion: Full' : 'Motion: Reduced';
        btnMotion.setAttribute('aria-pressed', motion === 'reduced' ? 'true' : 'false');
      }
      
      if (btnSound) {
        btnSound.textContent = sound === 'on' ? 'Sound: On' : 'Sound: Off';
        btnSound.setAttribute('aria-pressed', sound === 'on' ? 'true' : 'false');
      }

      if (btnTheme) {
        btnTheme.textContent = theme === 'day' ? 'Theme: Day' : 'Theme: Night';
        btnTheme.setAttribute('aria-pressed', theme === 'day' ? 'true' : 'false');
      }
    }

    updateDOM();

    btnMotion?.addEventListener('click', () => {
      setMotion(getMotion() === 'full' ? 'reduced' : 'full');
    });

    btnSound?.addEventListener('click', () => {
      setSound(getSound() === 'on' ? 'off' : 'on');
    });

    btnTheme?.addEventListener('click', () => {
      setTheme(getTheme() === 'night' ? 'day' : 'night');
    });
  }

  document.addEventListener('astro:page-load', initPreferences);
  subscribePreferences(() => {
    const btnMotion = document.getElementById('toggle-motion');
    const btnSound = document.getElementById('toggle-sound');
    const btnTheme = document.getElementById('toggle-theme');
    const motion = getMotion();
    const sound = getSound();
    const theme = getTheme();
    if (btnMotion) {
      btnMotion.textContent = motion === 'full' ? 'Motion: Full' : 'Motion: Reduced';
      btnMotion.setAttribute('aria-pressed', motion === 'reduced' ? 'true' : 'false');
    }
    if (btnSound) {
      btnSound.textContent = sound === 'on' ? 'Sound: On' : 'Sound: Off';
      btnSound.setAttribute('aria-pressed', sound === 'on' ? 'true' : 'false');
    }
    if (btnTheme) {
      btnTheme.textContent = theme === 'day' ? 'Theme: Day' : 'Theme: Night';
      btnTheme.setAttribute('aria-pressed', theme === 'day' ? 'true' : 'false');
    }
  });
</script>
