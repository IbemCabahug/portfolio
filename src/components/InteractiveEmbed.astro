---
import QuestDemoShell, { type QuestDemoViewConfig } from './QuestDemoShell.astro';
import { demoUrl } from '../lib/bits-demo-url';

interface Props {
  liveUrl: string;
  title: string;
  slug?: string;
  instanceId?: string;
  scalingMode?: 'fit-canvas' | 'responsive';
  description?: string;
  hint?: string;
  launchLabel?: string;
}

const {
  liveUrl,
  title,
  slug = 'arcanetyper',
  instanceId = slug,
  scalingMode = 'fit-canvas',
  description = 'Launch an interactive typing trial directly inside this project dossier, or open the standalone application in a new browser tab.',
  hint = 'Physical keyboard recommended for typing trials; landscape orientation is optional on smaller screens.',
  launchLabel = 'Launch demo',
} = Astro.props;

const projectName = slug === 'arcanetyper' ? 'ArcaneTyper' : title.split('—')[0].trim() || 'Live Project';
const validatedUrl = demoUrl(liveUrl, import.meta.env.DEV);

const views: QuestDemoViewConfig[] = [
  {
    key: 'game',
    label: `${projectName} Arena`,
    url: validatedUrl,
    iframeTitle: `${projectName} interactive live demo`,
    displayMode: scalingMode,
    canvasWidth: 1000,
    canvasHeight: 600,
    sandbox: 'allow-scripts allow-same-origin allow-popups allow-forms',
    allow: 'autoplay; fullscreen',
    referrerPolicy: 'strict-origin-when-cross-origin',
    reloadLabel: 'Reload view',
    loadingStatus: 'Loading external view. Connection and application state are not yet verified.',
    loadedStatus:
      'External view requested. If the game is blank or unresponsive, reload view or open it in a new tab.',
    unavailableStatus:
      'This view is not configured for this deployment. Use the standalone project link when available.',
  },
];
---

<QuestDemoShell
  instanceId={instanceId}
  projectName={projectName}
  ariaLabel={`${projectName} interactive live demo`}
  icon={slug === 'bits' ? 'code' : 'swords'}
  intro={description}
  hint={hint}
  launchLabel={launchLabel}
  showPortraitGuidance={scalingMode === 'fit-canvas'}
  views={views}
  hostTag="quest-demo-shell"
  hostDataset={{
    'data-game-url': validatedUrl,
  }}
/>
